# Publish reviewed archive bytes over verified HTTPS using a private credential file.
#
#   diamond publish_registry_seed.d6 REGISTRY_URL --seed DIRECTORY --credentials FILE
#
# Every archive is checked against the reviewed inventory before the first network write.
def parse_base(base)
  unless base.start_with?("https://")
    raise ArgumentError.new("expected an HTTPS registry base URL without credentials/query/fragment")
  end
  rest = base[8, base.length() - 8]
  if rest.include?("@") || rest.include?("?") || rest.include?("#")
    raise ArgumentError.new("expected an HTTPS registry base URL without credentials/query/fragment")
  end
  slash = rest.index("/")
  authority = slash == nil ? rest : rest[0, slash]
  path = slash == nil ? "" : rest[slash, rest.length() - slash]
  host = authority
  port = 443
  colon = authority.index(":")
  if colon != nil
    host = authority[0, colon]
    port = authority[colon + 1, authority.length() - colon - 1].to_i()
  end
  raise ArgumentError.new("expected an HTTPS registry base URL") if host == ""
  while path.end_with?("/")
    path = path[0, path.length() - 1]
  end
  [host, port, path]
end

# One POST of `data` over a fresh verified TLS connection; [status, body].
def post(host, port, path, token, data)
  socket = TLSSocket.connect(host, port,
    {"connect_timeout_ms": 60000, "read_timeout_ms": 60000, "write_timeout_ms": 60000})
  begin
    socket.write("POST #{path} HTTP/1.1\r\nHost: #{host}\r\nAuthorization: Bearer #{token}\r\n" +
      "Content-Type: application/octet-stream\r\nContent-Length: #{data.length()}\r\n" +
      "Connection: close\r\n\r\n" + data)
    status_line = socket.gets()
    raise IOError.new("no response") if status_line == nil
    status = status_line.split(" ")[1].to_i()
    length = nil
    loop do
      header = socket.gets()
      break if header == nil || header.strip() == ""
      if header.downcase().start_with?("content-length:")
        length = header.split(":")[1].strip().to_i()
      end
    end
    body = length == nil ? socket.read(65537) : socket.read(length > 65537 ? 65537 : length)
    [status, body == nil ? "" : body]
  ensure
    socket.close()
  end
end

def check_archive(seed, cut, message)
  data = File.read(seed + "/" + cut["archive"])
  if data.length() != cut["size"] || Digest.sha256(data) != cut["sha256"]
    raise ArgumentError.new(message + cut["name"])
  end
  data
end

def publish(base, seed, credentials)
  target = parse_base(base)
  if (File.mode(credentials) & 0o077) != 0
    raise ArgumentError.new("credential file must be private (mode 0600)")
  end
  token = JSON.parse(File.read(credentials))["token"]
  valid = token.is_a?(String) && token.length() > 0 &&
    token.bytes().all?() do |byte| byte >= 33 && byte <= 126 end
  raise ArgumentError.new("invalid credential") unless valid
  inventory = JSON.parse(File.read(seed + "/inventory.json"))
  unless inventory["format"] == 1 && inventory["cuts"].is_a?(Array) && inventory["cuts"].length() > 0
    raise ArgumentError.new("invalid inventory")
  end
  names = []
  inventory["cuts"].each() do |cut|
    name = cut["name"]
    unless Regexp.new("\\A[a-z][a-z0-9_]*\\z").match?(name) && !names.include?(name) &&
           cut["archive"] == name + ".tar"
      raise ArgumentError.new("invalid or duplicate cut identity")
    end
    names.push(name)
    check_archive(seed, cut, "archive differs from reviewed inventory: ")
  end
  # Every local archive is verified before the first network write.
  inventory["cuts"].each() do |cut|
    data = check_archive(seed, cut, "archive changed while publishing: ")
    status = 0
    body = ""
    6.times() do |attempt|
      answer = post(target[0], target[1], target[2] + "/v1/cuts/" + cut["name"] + "/versions", token, data)
      status = answer[0]
      body = answer[1]
      break if status != 429
      IO.poll([], [], 10100)
    end
    unless (status == 200 || status == 201) && body.length() <= 65536
      raise ArgumentError.new("publish failed for #{cut["name"]}: HTTP #{status}")
    end
    published = JSON.parse(body)
    ["name", "version", "sha256", "size"].each() do |key|
      raise ArgumentError.new("published identity mismatch: " + cut["name"]) if published[key] != cut[key]
    end
    puts("verified published #{cut["name"]} #{cut["version"]} #{cut["sha256"]}")
    IO.poll([], [], 10100)
  end
end

registry = nil
seed = nil
credentials = nil
index = 0
while index < ARGV.length()
  arg = ARGV[index]
  if arg == "--seed" || arg == "--credentials"
    index += 1
    if index >= ARGV.length()
      warn("#{arg} needs a value")
      exit(2)
    end
    seed = ARGV[index] if arg == "--seed"
    credentials = ARGV[index] if arg == "--credentials"
  elsif registry == nil && !arg.start_with?("--")
    registry = arg
  else
    warn("unexpected argument #{arg}")
    exit(2)
  end
  index += 1
end
if registry == nil || seed == nil || credentials == nil
  warn("usage: publish_registry_seed.d6 REGISTRY_URL --seed DIRECTORY --credentials FILE")
  exit(2)
end
begin
  publish(registry, seed, credentials)
rescue e: StandardError
  warn("seed publication failed: #{e.message()}")
  exit(1)
end
exit(0)
