# Run with `diamond test/{{name}}_test.d6`, or `bash test.sh` for every test file.
require_cut "minitest"
require "../lib/{{name}}"

def run_tests()
  def test_ping() = Minitest.assert_equal("PONG", {{Name}}.respond("PING\r"))

  def test_echo() = Minitest.assert_equal("echo: hello", {{Name}}.respond("hello"))

  def test_take_lines_keeps_the_unfinished_line()
    [lines, rest] = {{Name}}.take_lines("one\ntwo\nthr")
    Minitest.assert_equal(["one", "two"], lines)
    Minitest.assert_equal("thr", rest)
  end

  suite = Minitest.new()
  suite.test("PING answers PONG", test_ping)
  suite.test("other lines are echoed", test_echo)
  suite.test("take_lines keeps the unfinished line", test_take_lines_keeps_the_unfinished_line)
  exit(suite.run() ? 0 : 1)
end
run_tests()
