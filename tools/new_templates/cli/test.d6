# Run with `diamond test/{{name}}_test.d6`, or `bash test.sh` for every test file.
require "minitest"
require "../lib/{{name}}"

def run_tests()
  def test_greeting() = Minitest.assert_equal("Hello, Ada!", {{Name}}.greeting("Ada"))

  def test_help_succeeds() = Minitest.assert_equal(0, {{Name}}.main(["--help"]))

  def test_unknown_option_is_a_usage_error() = Minitest.assert_equal(64, {{Name}}.main(["--bogus"]))

  suite = Minitest.new()
  suite.test("greeting names the person", test_greeting)
  suite.test("--help exits 0", test_help_succeeds)
  suite.test("an unknown option exits 64", test_unknown_option_is_a_usage_error)
  exit(suite.run() ? 0 : 1)
end
run_tests()
