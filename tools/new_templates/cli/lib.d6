# {{name}}: greets someone by name.
module {{Name}}
  def self.usage() -> String = "usage: {{name}} [--help] [NAME]"

  def self.greeting(name: String) -> String = "Hello, #{name}!"

  # Runs the command with its arguments and returns the exit status:
  # 0 on success, 64 (EX_USAGE) for arguments it does not understand.
  def self.main(args: Array) -> Int
    if args.length() == 1 && (args[0] == "--help" || args[0] == "-h")
      puts({{Name}}.usage())
      return 0
    end

    if args.length() > 1 || (args.length() == 1 && args[0].start_with?("-"))
      warn({{Name}}.usage())
      return 64
    end

    name = args.length() == 1 ? args[0] : "world"
    puts({{Name}}.greeting(name))
    0
  end
end
