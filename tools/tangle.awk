# Tangle: turn literate Markdown "webs" into source files.
#
#   awk -f tools/tangle.awk -v out=DIR web/one.md web/two.md ...
#
# A web is ordinary Markdown. Code blocks whose opening fence has a chunk definition after the language are chunks:
#
#     ```c <<read one line>>=
#     ...code, which may contain a line holding only <<another chunk>>...
#     ```
#
# A chunk named "file: some/path.h" is a root: it is written to DIR/some/path.h. Every other chunk is only ever
# reached through a <<reference>> on a line of its own, which is replaced by the chunk's lines, indented as the
# reference was. Defining a name again appends to it, in the order the webs are read, so the prose can introduce
# a piece of a function where it is explained and not where the compiler needs it. Fences without a chunk name
# (shell examples, output, diagrams) are prose. Plain, standard awk only: this runs before `diamond` exists.
#
# Roots in C (.c, .h) get a banner and `#line N "web"` directives, so compiler diagnostics, debugger positions and
# sanitizer traces point at the web, not at the generated file. Unknown references, cycles and a name that is defined
# but never reached from a root are errors, so a typo cannot silently drop code.

function fail(message) {
    print "tangle: " message > "/dev/stderr"
    failed = 1
    exit 1
}

function chunk_name(line,    s) {
    s = line
    sub(/^```[^ \t]*[ \t]+<</, "", s)
    sub(/>>=[ \t]*$/, "", s)
    return s
}

function add_line(name, text, file, number) {
    count[name]++
    body[name, count[name]] = text
    from_file[name, count[name]] = file
    from_line[name, count[name]] = number
}

function emit(path, text) {
    print text > path
}

# Writes the lines of chunk `name` to `path`, every line prefixed with `indent`.
function expand(name, indent, path, is_c, depth,    i, text, ref, lead) {
    if (depth > 64) fail("chunk <<" name ">> includes itself")
    if (!(name in count)) fail("chunk <<" name ">> is used but never defined")
    reached[name] = 1
    for (i = 1; i <= count[name]; i++) {
        text = body[name, i]
        if (is_c && (from_file[name, i] != last_file || from_line[name, i] != last_line + 1))
            emit(path, "#line " from_line[name, i] " \"" from_file[name, i] "\"")
        last_file = from_file[name, i]
        last_line = from_line[name, i]
        if (match(text, /^[ \t]*<<.+>>[ \t]*$/)) {
            ref = text
            lead = text
            sub(/<<.*$/, "", lead)
            sub(/^[ \t]*<</, "", ref)
            sub(/>>[ \t]*$/, "", ref)
            expand(ref, indent lead, path, is_c, depth + 1)
        } else if (text == "") {
            emit(path, "")
        } else {
            emit(path, indent text)
        }
    }
}

FNR == 1 { in_chunk = 0; in_prose_fence = 0 }

{
    if (in_chunk) {
        if ($0 ~ /^```[ \t]*$/) { in_chunk = 0; next }
        add_line(current, $0, FILENAME, FNR)
        next
    }
    if (in_prose_fence) {
        if ($0 ~ /^```[ \t]*$/) in_prose_fence = 0
        next
    }
    if ($0 ~ /^```[^ \t]*[ \t]+<<.+>>=[ \t]*$/) {
        current = chunk_name($0)
        in_chunk = 1
        if (current ~ /^file: /) {
            path = current
            sub(/^file: /, "", path)
            if (!(current in is_root)) { is_root[current] = 1; roots[++root_count] = current }
        }
        if (!(current in count)) { count[current] = 0; order[++defined] = current }
        next
    }
    if ($0 ~ /^```/) in_prose_fence = 1
}

END {
    if (failed) exit 1
    if (out == "") fail("usage: awk -f tools/tangle.awk -v out=DIR web.md ...")
    for (r = 1; r <= root_count; r++) {
        name = roots[r]
        rel = name
        sub(/^file: /, "", rel)
        path = out "/" rel
        dir = path
        sub(/\/[^\/]*$/, "", dir)
        system("mkdir -p '" dir "'")
        printf "" > path
        is_c = (rel ~ /\.[ch]$/)
        if (is_c) emit(path, "/* Generated by tools/tangle.awk from " from_file[name, 1] ". Do not edit this file; edit the web. */")
        last_file = ""
        last_line = 0
        expand(name, "", path, is_c, 0)
        close(path)
    }
    for (i = 1; i <= defined; i++)
        if (!(order[i] in reached) && !(order[i] in is_root))
            fail("chunk <<" order[i] ">> is defined but never used")
}
