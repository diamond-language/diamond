# dispatcher: routing work across bounded queues without ever blocking on
# one of them, and a supervisor that gives up instead of retrying forever.
#
#   diamond dispatcher.d6
#
# Four things worth seeing, in order: Channel.select_send picks whichever
# queue has room, Channel.select drains several queues with a priority
# cancel channel, Supervisor#restart_policy bounds a crash loop, and a
# `when` naming a base class covers all its subclasses.
require "./lib/dispatch"

# --- 1. select_send: first queue with room, else shed --------------------
puts("== routing")
# Two bounded queues. The primary is small and preferred; the overflow holds
# what does not fit. select_send tries them in array order and returns the
# index it sent to. A deadline in the past means "never wait": when neither
# has room, nil comes back immediately and the job is shed.
primary = Channel.new(2)
overflow = Channel.new(3)
names = ["primary", "overflow"]
shed = []

(1..7).each() do |job|
  where = Channel.select_send([primary, overflow], job, Time.monotonic() - 1.0)
  if where == nil
    shed.push(job)
    puts("  job #{job} shed")
  else
    puts("  job #{job} -> #{names[where]}")
  end
end
puts("queued: primary #{primary.size()}, overflow #{overflow.size()}, shed #{shed}")

# --- 2. select: drain several queues, cancel first -----------------------
puts("")
puts("== draining")
# One worker thread multiplexes both queues with Channel.select. The cancel
# channel is listed first, so it would win over any queued job. All five jobs
# were queued before the thread started, so primary drains before overflow.
cancel = Channel.new(1)
done = Channel.new(8)
worker = Thread.new(drain, cancel, primary, overflow, done)

5.times() do |_|
  puts("  took #{done.receive()}")
end

# Nothing is left, so the worker is parked in select. Cancelling wakes it.
cancel.send("stop")
puts("  worker #{worker.join()}")

# Priority in action: a pending cancel beats a ready job. select returns the
# cancel channel's index (0) even though the primary queue has work.
stop = Channel.new(1)
busy = Channel.new(1)
stop.send("stop")
busy.send("job")
puts("  with both ready, select picks channel #{Channel.select([stop, busy])[0]}")

# --- 3. restart_policy: give up instead of looping forever ---------------
puts("")
puts("== crash loop")
# Without a policy a child that always crashes restarts forever. Here the
# supervisor allows 2 crashes in the window, then stops and reports failure.
# The 5 ms backoff keeps the demo quick; it must be set before add_child.
supervisor = Supervisor.new()
supervisor.restart_policy({"max_restarts": 2, "within_ms": 5000, "backoff_ms": 5})
child = supervisor.add_child(always_crashes)

begin
  supervisor.join()
rescue error: SupervisorError
  puts("  join raised SupervisorError")
end

puts("  failed?: #{supervisor.failed?()}")
puts("  restarts before giving up: #{supervisor.restart_count(child)}")

# Once failed, the supervisor accepts no more children.
begin
  supervisor.add_child(always_crashes)
rescue error: SupervisorError
  puts("  add_child refused after failure")
end

# --- 4. group coverage in case/when --------------------------------------
puts("")
puts("== outcomes")
# `when Failure` covers both of Failure's subclasses at once, so this case
# over a union needs only two branches. Drop the Failure branch and the
# compiler names the members still uncovered.
class Outcome
end

class Done < Outcome
end

class Failure < Outcome
end

class Shed < Failure
end

class Crashed < Failure
end

def describe(outcome: Done | Shed | Crashed)
  case outcome
  when Done
    "done"
  when Failure
    "failed (#{outcome.class()})"
  end
end

[Done.new(), Shed.new(), Crashed.new()].each() do |outcome|
  puts("  #{describe(outcome)}")
end

exit(0)
