require "./lib/editor"
require "../../lib/minitest"

suite = Minitest.new()
suite.test("insert, backspace and delete work at UTF-8 boundaries and across newlines") do
  editor = BoardEditor.new("éλ")
  Minitest.assert_equal(2, editor.cursor())
  editor.horizontal(-1)
  editor.insert("X")
  Minitest.assert_equal("éXλ", editor.text())
  editor.delete()
  Minitest.assert_equal("éX", editor.text())
  editor.backspace()
  Minitest.assert_equal("é", editor.text())
  editor.insert("\nnext")
  editor.home()
  editor.backspace()
  Minitest.assert_equal("énext", editor.text())
  editor.insert("\n")
  editor.horizontal(-1)
  editor.delete()
  Minitest.assert_equal("énext", editor.text())
  editor.boundary(false)
  editor.backspace()
  editor.horizontal(-1)
  Minitest.assert_equal(0, editor.cursor())
  editor.boundary(true)
  editor.delete()
  editor.horizontal(1)
  Minitest.assert_equal(5, editor.cursor())
  editor.clear()
  editor.delete()
  editor.backspace()
  Minitest.assert_equal("", editor.text())
end

suite.test("vertical navigation preserves the preferred column across short lines") do
  editor = BoardEditor.new("abcdef\nx\nuvwxyz")
  editor.horizontal(-2)
  editor.vertical(-1, 20)
  Minitest.assert_equal(8, editor.cursor())
  editor.vertical(-1, 20)
  Minitest.assert_equal(4, editor.cursor())
  editor.vertical(1, 20)
  editor.vertical(1, 20)
  Minitest.assert_equal(13, editor.cursor())
  editor.home()
  Minitest.assert_equal(9, editor.cursor())
  editor.finish()
  Minitest.assert_equal(15, editor.cursor())
  editor.vertical(1, 20)
  Minitest.assert_equal(15, editor.cursor())
end

suite.test("wrapped lines and resized viewports follow the caret instead of the end") do
  editor = BoardEditor.new("0123456789abcdefghijXYZ")
  view = editor.view(10, 2)
  Minitest.assert_equal(["abcdefghij", "XYZ"], view[0])
  Minitest.assert_equal([1, 3], [view[1], view[2]])
  editor.vertical(-1, 10)
  Minitest.assert_equal(13, editor.cursor())
  editor.vertical(-1, 10)
  view = editor.view(10, 2)
  Minitest.assert_equal([0, 3], [view[1], view[2]])
  editor.insert("!")
  Minitest.assert_equal("012!3456789abcdefghijXYZ", editor.text())
  editor.boundary(true)
  view = editor.view(7, 1)
  Minitest.assert_equal(0, view[1])
  Minitest.assert_equal(3, view[2])
  editor.boundary(false)
  Minitest.assert_equal("012!345", editor.view(7, 1)[0][0])
end
suite.run!()
