require "./lib/store"
require "../../lib/minitest"

suite = Minitest.new()

def board_test_project_name(project: BoardProject) -> String = project.name()
def board_test_project_id(project: BoardProject) -> Int = project.id()

suite.test("model bindings survive projections and reject mismatched rows") do
  db = SQLite3.open(":memory:")
  store = BoardStore.new(db)
  project = store.create_project({"name": "Typed"}).value()
  records = store.project_records()
  query = records.query().order_by("id")
  Minitest.assert_equal(["Typed"], records.map[String](query, board_test_project_name))
  Minitest.assert_equal([project.id()], records.map[Int](query, board_test_project_id))
  Minitest.assert_equal([project.id()], records.all(query).map(board_test_project_id))
  Minitest.assert_equal(project.id(), records.get(project.id()).id())
  Minitest.assert_equal(nil, records.get(999))
  Minitest.assert_raises[TypeError]() do
    records.map[String](query, board_test_project_id)
  end
  schema = Mjolnir::Schema.new("projects", {"id": :int, "name": :string}, build_board_project)
  wrong = BoardRecords[BoardTask].new(Mjolnir::Repo.new(db), schema)
  Minitest.assert_raises[TypeError]() do
    wrong.all(wrong.query())
  end
  Minitest.assert_raises[TypeError]() do
    wrong.get(project.id())
  end
  store.close()
end

suite.test("validated edits preserve stored values and ignore unpermitted IDs") do
  store = BoardStore.new(SQLite3.open(":memory:"))
  project = store.create_project({"name": "Diamond"}).value()
  task = store.create_task({"project_id": "#{project.id()}", "title": "Ship a board", "id": 99}).value()
  Minitest.assert_equal("todo", task.status())
  Minitest.assert(task.id() != 99)
  rejected = store.update_task(task.id(), {"title": "", "status": "unknown"})
  Minitest.assert(rejected.err?())
  Minitest.assert(rejected.error().errors().has_key?("title"))
  Minitest.assert(rejected.error().errors().has_key?("status"))
  Minitest.assert_equal("Ship a board", store.task(task.id()).title())
  updated = store.update_task(task.id(), {"status": "doing", "id": 99}).value()
  Minitest.assert_equal(task.id(), updated.id())
  Minitest.assert_equal("doing", store.task(task.id()).status())
  Minitest.assert_equal("todo", task.status())
  store.close()
end

suite.test("project and status filters combine with explicit association loading") do
  store = BoardStore.new(SQLite3.open(":memory:"))
  first = store.create_project({"name": "Diamond"}).value()
  second = store.create_project({"name": "Other"}).value()
  todo = store.create_task({"project_id": first.id(), "title": "One"}).value()
  store.create_task({"project_id": first.id(), "title": "Two", "status": "done"})
  store.create_task({"project_id": second.id(), "title": "Three"})
  filtered = store.tasks(first.id(), "todo")
  Minitest.assert_equal([todo.id()], filtered[0].map() do |task| task.id() end)
  Minitest.assert_equal("Diamond", filtered[1][todo.id()].name())
  Minitest.assert_equal(2, store.tasks(nil, "todo")[0].length())
  Minitest.assert_equal([], store.tasks(second.id(), "done")[0])
  store.close()
end

suite.test("bad project references and duplicate names become validation errors") do
  store = BoardStore.new(SQLite3.open(":memory:"))
  store.create_project({"name": "Diamond"})
  Minitest.assert(store.create_project({"name": "Diamond"}).err?())
  Minitest.assert(store.create_project({"name": ""}).err?())
  Minitest.assert(store.create_task({"project_id": 999, "title": "Orphan"}).err?())
  Minitest.assert(store.create_task({"project_id": "oops", "title": "Bad ID"}).err?())
  Minitest.assert_equal([], store.tasks()[0])
  store.close()
end

suite.test("notes validate independently and literal search combines with filters") do
  store = BoardStore.new(SQLite3.open(":memory:"))
  project = store.create_project({"name": "Diamond"}).value()
  other = store.create_project({"name": "Other"}).value()
  task = store.create_task({"project_id": project.id(), "title": "Ship [board]"}).value()
  Minitest.assert_equal("", task.notes())
  notes = "First line\nMeasure latency: é\n100%_done"
  updated = store.update_task(task.id(), {"notes": notes}).value()
  Minitest.assert_equal(notes, updated.notes())
  Minitest.assert_equal("", task.notes())
  store.create_task({"project_id": other.id(), "title": "Other", "notes": "latency", "status": "done"})
  Minitest.assert_equal(2, store.tasks(nil, nil, "LATENCY")[0].length())
  Minitest.assert_equal([task.id()], store.tasks(project.id(), "todo", "latency")[0].map() do |t| t.id() end)
  Minitest.assert_equal(1, store.tasks(nil, nil, "[board]")[0].length())
  Minitest.assert_equal(1, store.tasks(nil, nil, "%_")[0].length())
  Minitest.assert_equal(1, store.tasks(nil, nil, "DIAMOND")[0].length())
  Minitest.assert_equal([], store.tasks(nil, "doing", "latency")[0])
  Minitest.assert(store.update_task(task.id(), {"notes": "x" * 10001}).err?())
  Minitest.assert(store.update_task(task.id(), {"notes": nil}).err?())
  Minitest.assert_equal(notes, store.task(task.id()).notes())
  Minitest.assert_equal("", store.update_task(task.id(), {"notes": ""}).value().notes())
  store.close()
end

suite.run!()
