require "./lib/store"
require "./lib/board"

def board_interactive(args)
  if !IO.tty?(:stdin) || !IO.tty?(:stdout) || ENV["BOARD_TERMINAL_HELPER"] == nil
    warn("board: launch interactive mode with examples/task_board/board")
    return 64
  end
  path = ENV.fetch("BOARD_DATABASE_PATH", "task_board.db")
  if args.length() == 2 && args[0] == "--db"
    path = args[1]
  elsif !args.empty?()
    warn("usage: board [--db FILE]")
    return 64
  end
  store = nil
  terminal = nil
  output = nil
  begin
    store = BoardStore.new(SQLite3.open(path))
    board = TaskBoard.new(store)
    terminal = File.open("/dev/tty", "r")
    output = File.open("/dev/tty", "w")
    previous_size = []
    dirty = true
    pending = ""
    expected = 1
    while board.running?()
      size = Process.run(["bash", ENV["BOARD_TERMINAL_HELPER"], "--size"])
      dimensions = size.stdout().strip().split(" ")
      rows = if dimensions.length() == 2 then dimensions[0].to_i() else 24 end
      columns = if dimensions.length() == 2 then dimensions[1].to_i() else 80 end
      if dirty || previous_size != [rows, columns]
        frame = "\e[?25l\e[H\e[2J" + board_frame(board, rows, columns)
        caret = board.screen_caret()
        if caret != nil
          frame += "\e[#{caret[0] + 1};#{caret[1] + 1}H\e[?25h"
        end
        output.write(frame)
        output.flush()
        previous_size = [rows, columns]
        dirty = false
      end
      key = terminal.read(1)
      # VMIN=0/VTIME=1 wakes us on idle timeouts as well as keys, allowing
      # resize redraws without injecting a key or interrupting a draft.
      if key == ""
        if board.finish_key() then dirty = true end
        next
      end
      if pending.empty?()
        byte = key.ord()
        expected = if byte >= 240 then 4 elsif byte >= 224 then 3 elsif byte >= 192 then 2 else 1 end
      end
      pending += key
      if pending.length() == expected
        board.key(pending)
        pending = ""
        dirty = !board.key_pending?()
      end
    end
    0
  rescue error: SQLite3Error
    warn("board: #{error.message()}")
    1
  rescue error: IOError
    warn("board: #{error.message()}")
    1
  ensure
    if terminal != nil then terminal.close() end
    if output != nil then output.close() end
    if store != nil then store.close() end
  end
end

exit(board_interactive(ARGV))
