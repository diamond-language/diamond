# budget: running code under a wall-clock budget, and what each way a program
# can misbehave looks like from the outside. See docs/sandbox.md's
# "Resource limits".
#
#   diamond host.d6 <path-to-diamond-binary>
#
# DIAMOND_MAX_WALL_MILLISECONDS is read once per process, so the host runs
# each guest as its own child process with the budget in that child's
# environment. A blocking wait (a Channel#receive, an IO.poll) sleeps in the
# kernel where a per-instruction clock check cannot run, so the budget also
# bounds the wait itself.

# One guest to run: its file, the budget to give it, and a note on what it
# demonstrates.
struct Scenario(name: String, file: String, wall_ms: Int, note: String)
end

# Everything the host learned about one finished child.
struct Outcome(exit_code: Int, stdout: String, error: String, seconds: Float)
end

# The first line of a runtime error, without the file and position prefix,
# so the report does not depend on where the guest lives.
def error_summary(stderr: String) -> String
  first = stderr.strip().split("\n")[0]
  parts = first.split("runtime error: ")
  parts.length() > 1 ? parts[1] : first
end

# Runs one guest with the wall-clock budget set for just that child.
def run_guest(diamond_bin: String, scenario: Scenario) -> Outcome
  argv = ["env", "DIAMOND_MAX_WALL_MILLISECONDS=#{scenario.wall_ms()}",
          "DIAMOND_NO_CACHE=1", diamond_bin, scenario.file()]
  started = Time.monotonic()
  result = Process.run(argv)
  seconds = Time.monotonic() - started
  Outcome.new(result.exit_code(), result.stdout().strip(),
              error_summary(result.stderr()), seconds)
end

# Reads an outcome the way an operator would: from the exit status.
def verdict(outcome: Outcome) -> String
  case outcome.exit_code()
  when 0 then "exited normally"
  when 70 then "stopped by the hard limit"
  else "failed (exit #{outcome.exit_code()})"
  end
end

def main(argv)
  if argv.empty?()
    puts("usage: host.d6 <path-to-diamond-binary>")
    return 64
  end
  diamond_bin = argv[0]

  scenarios = [
    Scenario.new("quick", "guests/quick.d6", 300,
                 "finishes inside the budget; nothing trips"),
    Scenario.new("blocked receive", "guests/blocked_receive.d6", 300,
                 "Channel#receive with no sender is bounded by the budget"),
    Scenario.new("poll forever", "guests/poll_forever.d6", 300,
                 "IO.poll with no timeout is bounded by the budget"),
    Scenario.new("cleanup", "guests/cleanup.d6", 300,
                 "rescue the error, ensure runs, exit status 0"),
    Scenario.new("rescue then block", "guests/rescue_then_block.d6", 300,
                 "blocking again after the error hits the grace limit"),
  ]

  scenarios.each() do |scenario|
    outcome = run_guest(diamond_bin, scenario)
    puts(scenario.name())
    puts("  #{scenario.note()}")
    puts("  #{verdict(outcome)}")
    outcome.stdout().split("\n").each() do |line|
      puts("  > #{line}") if !line.empty?()
    end
    puts("  ! #{outcome.error()}") if !outcome.error().empty?()
    # Bounded means the child did not hang. Three seconds is far above the
    # 0.3 s budget plus the 1 s grace allowance and is only a sanity check.
    puts("  within 3s: #{outcome.seconds() < 3.0}")
  end
  0
end

exit(main(ARGV))
