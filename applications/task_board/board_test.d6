require "./lib/store"
require "./lib/board"
require "../../lib/minitest"

suite = Minitest.new()

def editor_keys(board, sequence)
  sequence.chars().each() do |key| board.key(key) end
end
suite.test("keyboard flows validate writes and retain selection after moving") do
  store = BoardStore.new(SQLite3.open(":memory:"))
  board = TaskBoard.new(store)
  board.key("a")
  Minitest.assert_equal("project", board.mode())
  "Diamond".split("").each() do |key| board.key(key) end
  board.key("\r")
  board.key("p")
  board.key("a")
  board.key("\r")
  Minitest.assert_equal("add", board.mode())
  Minitest.assert(!board.message().empty?())
  "Ship board".split("").each() do |key| board.key(key) end
  board.key("\r")
  Minitest.assert_equal("board", board.mode())
  Minitest.assert_equal("Ship board", board.selected().title())
  board.key("L")
  Minitest.assert_equal(1, board.column())
  Minitest.assert_equal("doing", store.task(1).status())
  board.key("e")
  board.key("!")
  board.key("\r")
  Minitest.assert_equal("Ship board!", store.task(1).title())
  board.key("e")
  board.key("x")
  board.key("\e")
  Minitest.assert_equal("Ship board!", store.task(1).title())
  board.key("e")
  board.key("é")
  board.key("\x7f")
  Minitest.assert_equal("Ship board!", board.input())
  board.key("\e")
  board.key("\e")
  board.key("[")
  board.key("C")
  Minitest.assert_equal(2, board.column())
  board.key("L")
  board.key("j")
  Minitest.assert_equal(0, board.row())
  board.key("h")
  board.key("H")
  Minitest.assert_equal("todo", store.task(1).status())
  board.key("q")
  Minitest.assert(!board.running?())
  store.close()
end

suite.test("rendering clips unsafe text, scrolls, and handles small terminals") do
  store = BoardStore.new(SQLite3.open(":memory:"))
  store.create_project({"name": "Diamond\e[2J"})
  (1..20).each() do |number|
    store.create_task({"project_id": 1, "title": "Task #{number}"})
  end
  board = TaskBoard.new(store)
  (1..19).each() do |_| board.key("j") end
  frame = board_frame(board, 12, 80)
  Minitest.assert(frame.include?("#20 Task 20"), "selected task visible")
  Minitest.assert(!frame.include?("\e"), "control sequences removed")
  Minitest.assert(frame.split("\r\n").all?() do |line| line.length() < 80 end, "rows fit terminal")
  Minitest.assert(board_frame(board, 5, 20).include?("too small"))
  Minitest.assert_equal("é~ ", board_cell("ééé", 4))
  board.key("p")
  Minitest.assert_equal("Diamond\e[2J", board.project_name())
  board.key("p")
  Minitest.assert_equal("All projects", board.project_name())
  store.close()
end
suite.test("live search cancels cleanly and detail notes save or discard without retargeting") do
  store = BoardStore.new(SQLite3.open(":memory:"))
  store.create_project({"name": "Diamond"})
  first = store.create_task({"project_id": 1, "title": "One"}).value()
  second = store.create_task({"project_id": 1, "title": "Two", "status": "doing"}).value()
  board = TaskBoard.new(store)
  board.key("/")
  board.key("TWO")
  Minitest.assert_equal(second.id(), board.selected().id())
  Minitest.assert_equal(1, board.column())
  board.key("\e")
  Minitest.assert_equal("", board.query())
  Minitest.assert_equal(first.id(), board.selected().id())
  board.key("/")
  board.key("two")
  board.key("\r")
  board.key("\r")
  Minitest.assert_equal("detail", board.mode())
  Minitest.assert_equal(second.id(), board.detail().id())
  board.key("n")
  board.key("First line")
  board.key("\r")
  board.key("Second line")
  board.key("\e")
  board.key("[")
  board.key("D")
  Minitest.assert_equal("notes", board.mode())
  Minitest.assert_equal("First line\nSecond line", board.input())
  board.key("\x13")
  Minitest.assert_equal("detail", board.mode())
  Minitest.assert_equal("First line\nSecond line", store.task(second.id()).notes())
  board.key("n")
  board.key("\x15")
  board.key("Discard this")
  board.key("\e")
  Minitest.assert_equal("detail", board.mode())
  Minitest.assert_equal("First line\nSecond line", store.task(second.id()).notes())
  board.key("e")
  board.key("\x15")
  board.key("Renamed")
  board.key("\r")
  Minitest.assert_equal("detail", board.mode())
  Minitest.assert_equal(second.id(), board.detail().id())
  Minitest.assert_equal(nil, board.selected())
  Minitest.assert(board_frame(board, 12, 80).include?("Renamed"))
  board.key("q")
  board.key("/")
  board.key("\x15")
  board.key("second line")
  board.key("\r")
  Minitest.assert_equal(second.id(), board.selected().id())
  board.key("/")
  board.key("\x15")
  board.key("absent")
  Minitest.assert_equal(nil, board.selected())
  board.key("\r")
  board.key("\r")
  Minitest.assert_equal("board", board.mode())
  store.close()
end

suite.test("detail wrapping and scrolling keep notes safe and validation retains edits") do
  store = BoardStore.new(SQLite3.open(":memory:"))
  store.create_project({"name": "Diamond"})
  store.create_task({"project_id": 1, "title": "Title", "notes": "line\n" * 30 + "END\e[2J"})
  board = TaskBoard.new(store)
  board.key("\r")
  (1..40).each() do |_| board.key("j") end
  frame = board_frame(board, 12, 80)
  Minitest.assert(frame.include?("END?[2J"))
  Minitest.assert(!frame.include?("\e"))
  previous = board.detail_offset()
  board.key("\e")
  board.key("[")
  board.key("A")
  Minitest.assert_equal("detail", board.mode())
  Minitest.assert_equal(previous - 1, board.detail_offset())
  Minitest.assert_equal(["éé", "é"], board_wrap("ééé", 4))
  Minitest.assert_equal(["one", "", ""], board_wrap("one\n\n", 8))
  board.key("n")
  board.key("\x15")
  board.key("x" * 10001)
  board.key("\x13")
  Minitest.assert_equal("notes", board.mode())
  Minitest.assert(board.message().include?("notes:"))
  board.key("\x15")
  board.key("\x13")
  Minitest.assert_equal("", store.task(1).notes())
  board.key("q")
  board.key("P")
  board.key("Other")
  board.key("\r")
  Minitest.assert_equal("board", board.mode())
  store.close()
end
suite.test("terminal navigation edits titles and live search without leaking escape sequences") do
  store = BoardStore.new(SQLite3.open(":memory:"))
  store.create_project({"name": "Diamond"})
  store.create_task({"project_id": 1, "title": "abcdef"})
  board = TaskBoard.new(store)
  board.key("e")
  editor_keys(board, "\e[H")
  board.key("X")
  editor_keys(board, "\e[3~")
  editor_keys(board, "\eOF")
  board.key("\x7f")
  editor_keys(board, "\eOH")
  board.key("é")
  Minitest.assert_equal("éXbcde", board.input())
  board_frame(board, 12, 60)
  Minitest.assert_equal([10, 7], board.screen_caret())
  board.key("\r")
  Minitest.assert_equal("éXbcde", store.task(1).title())
  board_frame(board, 12, 60)
  Minitest.assert_equal(nil, board.screen_caret())
  board.key("/")
  board.key("zéX")
  Minitest.assert_equal(nil, board.selected())
  editor_keys(board, "\e[1~\e[3~")
  Minitest.assert_equal("éX", board.query())
  Minitest.assert_equal(1, board.selected().id())
  editor_keys(board, "\e[999~")
  Minitest.assert_equal("éX", board.input())
  board.key("\r")
  board.key("e")
  editor_keys(board, "\e[4~")
  board.key("Discard")
  board.key("\e")
  Minitest.assert_equal("éXbcde", store.task(1).title())
  editor_keys(board, "\e[123")
  board.key("\x03")
  Minitest.assert(!board.running?())
  store.close()
end

suite.test("notes navigation follows the caret through wrapping, resizing and cancelled edits") do
  store = BoardStore.new(SQLite3.open(":memory:"))
  store.create_project({"name": "Diamond"})
  original = "first\n" + "middle\n" * 25 + "last"
  store.create_task({"project_id": 1, "title": "Title", "notes": original})
  board = TaskBoard.new(store)
  board.key("\r")
  board.key("n")
  frame = board_frame(board, 12, 60)
  Minitest.assert(frame.include?("last"))
  editor_keys(board, "\e[1;5H")
  frame = board_frame(board, 12, 60)
  Minitest.assert(frame.include?("first"))
  Minitest.assert_equal([3, 0], board.screen_caret())
  editor_keys(board, "\e[B\e[F")
  board.key("!")
  board.key("\r")
  board.key("new line")
  board.key("\x13")
  Minitest.assert(store.task(1).notes().start_with?("first\nmiddle!\nnew line\n"))
  saved = store.task(1).notes()
  board.key("n")
  editor_keys(board, "\e[1;5H\e[3~")
  board.key("\e")
  Minitest.assert_equal(saved, store.task(1).notes())
  board.key("n")
  board.key("\x15")
  board.key("x" * 180)
  board_frame(board, 12, 80)
  editor_keys(board, "\e[A")
  position = board.editor().cursor()
  Minitest.assert(position < 180)
  board_frame(board, 10, 60)
  caret = board.screen_caret()
  Minitest.assert(caret[0] >= 3 && caret[0] < 6 && caret[1] >= 0 && caret[1] < 60)
  editor_keys(board, "\e[1;5F")
  Minitest.assert_equal(180, board.editor().cursor())
  board.key("\x13")
  Minitest.assert_equal("x" * 180, store.task(1).notes())
  store.close()
end
suite.run!()
