require "./store"
require "./editor"

# The controller has no terminal dependencies: key handling and validated writes
# can be exercised without a pseudo-terminal.
class TaskBoard
  def initialize(store: BoardStore)
    @store = store
    @column = 0
    @row = 0
    @project = 0
    @mode = "board"
    @editor = BoardEditor.new()
    @edit_width = 79
    @screen_caret = nil
    @message = ""
    @query = ""
    @search_before = ""
    @return_mode = "board"
    @detail = nil
    @detail_offset = 0
    @running = true
    @escape = false
    @sequence = ""
    refresh()
  end

  def running?() = @running
  def mode() = @mode
  def input() = @editor.text()
  def editor() = @editor
  def screen_caret() = @screen_caret
  def place_caret(row, column)
    @screen_caret = [row, column]
  end

  def hide_caret()
    @screen_caret = nil
  end

  def edit_width(width)
    @edit_width = width
  end
  def message() = @message
  def column() = @column
  def row() = @row
  def query() = @query
  def detail() = @detail
  def detail_offset() = @detail_offset
  def detail_view?() = ["detail", "notes"].include?(@mode) || (@mode == "edit" && @return_mode == "detail")

  def limit_detail_offset(limit)
    if @detail_offset > limit then @detail_offset = limit end
  end
  def statuses() = ["todo", "doing", "done"]
  def projects() = @projects
  def project_name() = if @project == 0 then "All projects" else @projects[@project - 1].name() end
  def selected() = if @row < @columns[@column].length() then @columns[@column][@row] else nil end

  def refresh()
    @projects = @store.projects()
    if @project > @projects.length() then @project = 0 end
    id = if @project == 0 then nil else @projects[@project - 1].id() end
    listed = @store.tasks(id, nil, @query)
    @associations = listed[1]
    @columns = statuses().map() do |status|
      listed[0].select() do |task| task.status() == status end
    end
    clamp()
  end

  def clamp()
    count = @columns[@column].length()
    if @row >= count then @row = count - 1 end
    if @row < 0 then @row = 0 end
  end

  def tasks(column) = @columns[column]
  def project_for(task) = @associations[task.id()].name()

  def search_input()
    @query = input()
    @row = 0
    refresh()
    if @columns[@column].empty?()
      index = 0
      while index < 3
        if !@columns[index].empty?()
          @column = index
          break
        end
        index += 1
      end
    end
  end

  def cancel()
    if @mode == "search"
      @query = @search_before
      @column = @search_column
      @row = @search_row
      refresh()
    end
    @mode = if ["notes", "edit"].include?(@mode) then @return_mode else "board" end
    @return_mode = "board"
    @editor = BoardEditor.new()
    @message = ""
  end

  def start_edit(mode)
    task = if @mode == "detail" then @detail else selected() end
    if task == nil then return end
    @return_mode = @mode
    @edit_id = task.id()
    @mode = mode
    @editor = BoardEditor.new(if mode == "notes" then task.notes() else task.title() end)
    @message = ""
  end

  def result(value)
    if value.err?()
      errors = value.error().errors()
      @message = errors.keys().map() do |field| "#{field}: #{errors[field].join(", ")}" end.join("; ")
      return
    end
    entity = value.value()
    @mode = @return_mode
    @editor = BoardEditor.new()
    @message = "Saved ##{entity.id()}"
    refresh()
    if entity.is_a?(BoardTask)
      if @detail != nil && @detail.id() == entity.id() then @detail = entity end
      @column = statuses().index(entity.status())
      @columns[@column].each_with_index() do |task, index|
        if task.id() == entity.id() then @row = index end
      end
      clamp()
    end
    @return_mode = "board"
  end

  def submit()
    case @mode
    when "project"
      result(@store.create_project({"name": input()}))
    when "add"
      result(@store.create_task({"project_id": @projects[@project - 1].id(),
        "title": input(), "status": statuses()[@column]}))
    when "edit"
      result(@store.update_task(@edit_id, {"title": input()}))
    when "notes"
      result(@store.update_task(@edit_id, {"notes": input()}))
    when "search"
      @mode = "board"
      @editor = BoardEditor.new()
    end
  end

  def move(offset)
    task = if @mode == "detail" then @detail else selected() end
    target = if task == nil then -1 else statuses().index(task.status()) + offset end
    if task != nil && target >= 0 && target < 3
      @return_mode = @mode
      result(@store.update_task(task.id(), {"status": statuses()[target]}))
    end
  end

  def key(key)
    if key == "\x03" || key == "\x04"
      @running = false
      return
    end
    # A lone Escape cancels immediately. If it starts an arrow sequence,
    # restore the view/edit before handling that arrow instead.
    if key == "\e"
      @escape_state = [@mode, @editor, @query, @column, @row, @message, @return_mode]
      cancel()
      @escape = true
      @sequence = ""
      return
    end
    if @escape
      @escape = false
      if key == "[" || key == "O"
        @mode = @escape_state[0]
        @editor = @escape_state[1]
        @query = @escape_state[2]
        @column = @escape_state[3]
        @row = @escape_state[4]
        @message = @escape_state[5]
        @return_mode = @escape_state[6]
        refresh()
        @sequence = key
        return
      end
    elsif !@sequence.empty?()
      @sequence += key
      # CSI parameters end in a letter or '~'; consume unknown sequences
      # completely so their digits cannot become edited text or commands.
      if Regexp.new("[A-Za-z~]\\z").match?(key)
        action = {"[A": "up", "OA": "up", "[B": "down", "OB": "down",
          "[C": "right", "OC": "right", "[D": "left", "OD": "left",
          "[H": "home", "OH": "home", "[1~": "home", "[7~": "home",
          "[F": "end", "OF": "end", "[4~": "end", "[8~": "end",
          "[3~": "delete", "[1;5H": "first", "[1;5F": "last"}.fetch(@sequence, "")
        @sequence = ""
        if !["board", "detail"].include?(@mode)
          @editor.action(action, @edit_width, @mode == "notes")
          if @mode == "search" && action == "delete" then search_input() end
          return
        end
        key = {"up": "k", "down": "j", "left": "h", "right": "l"}.fetch(action, "")
      else
        if @sequence.length() > 16 then @sequence = "?" end
        return
      end
    end
    if !["board", "detail"].include?(@mode)
      if @mode == "notes" && key == "\x13"
        submit()
      elsif key == "\r" || key == "\n"
        if @mode == "notes" then @editor.insert("\n") else submit() end
      elsif key == "\x7f" || key == "\x08"
        @editor.backspace()
      elsif key == "\x15"
        @editor.clear()
      elsif key == "\x01"
        @editor.home()
      elsif key == "\x05"
        @editor.finish()
      elsif !key.empty?() && key >= " " && key != "\x7f"
        @editor.insert(key)
      end
      if @mode == "search" then search_input() end
      return
    end
    @message = ""
    if @mode == "detail"
      case key
      when "q" then @mode = "board"
      when "j" then @detail_offset += 1
      when "k" then @detail_offset = if @detail_offset > 0 then @detail_offset - 1 else 0 end
      when "n" then start_edit("notes")
      when "e" then start_edit("edit")
      when "H" then move(-1)
      when "L" then move(1)
      when "r"
        @detail = @store.task(@detail.id())
        refresh()
        if @detail == nil then @mode = "board" end
      end
      return
    end
    case key
    when "q" then @running = false
    when "h" then @column = (@column + 2) % 3
    when "l", "\t" then @column = (@column + 1) % 3
    when "j" then @row += 1
    when "k" then @row -= 1
    when "H" then move(-1)
    when "L" then move(1)
    when "p"
      @project = (@project + 1) % (@projects.length() + 1)
      @row = 0
      refresh()
    when "r" then refresh()
    when "/"
      @search_before = @query
      @search_column = @column
      @search_row = @row
      @mode = "search"
      @editor = BoardEditor.new(@query)
    when "\r", "\n"
      if selected() != nil
        @detail = selected()
        @detail_offset = 0
        @mode = "detail"
      end
    when "P" then @mode = "project"
    when "a"
      if @projects.empty?()
        @mode = "project"
        @message = "Create a project first; then press p to select it."
      elsif @project == 0
        @message = "Press p to select a project before adding a task."
      else
        @mode = "add"
      end
    when "e" then start_edit("edit")
    end
    clamp()
  end
end

# Strip terminal control bytes from persisted/user text before rendering it.
def board_safe(text) = text.gsub(Regexp.new("[\\x00-\\x1f\\x7f-\\x9f]"), "?")

def board_cell(text, width)
  text = board_safe(text)
  if text.length() > width
    cut = width - 1
    while cut > 0 && text[cut].ord() >= 128 && text[cut].ord() < 192
      cut -= 1
    end
    text = text.slice(0, cut) + "~"
  end
  text + " " * (width - text.length())
end

# Wrap instead of truncating detail text, keeping UTF-8 code points whole.
def board_wrap(text, width)
  lines = []
  logical = (text + "\n|").split("\n")
  logical.pop()
  logical.each() do |line|
    line = board_safe(line)
    while line.length() > width
      cut = width
      while cut > 0 && line[cut].ord() >= 128 && line[cut].ord() < 192
        cut -= 1
      end
      lines.push(line.slice(0, cut))
      line = line.slice(cut, line.length())
    end
    lines.push(line)
  end
  if lines.empty?() then lines.push("") end
  lines
end

def board_detail_frame(board, rows, columns)
  if board.mode() == "notes" then return board_notes_frame(board, rows, columns) end
  task = board.detail()
  width = columns - 1
  notes = task.notes()
  if notes.empty?() then notes = "(No notes yet; press n to add them.)" end
  body = board_wrap(task.title(), width) + ["", "Notes:"] + board_wrap(notes, width)
  visible = rows - 5
  limit = if body.length() > visible then body.length() - visible else 0 end
  board.limit_detail_offset(limit)
  start = board.detail_offset()
  lines = [board_cell("Task ##{task.id()} [#{task.status()}] | #{board.project_for(task)}", width)]
  (0...visible).each() do |index|
    text = if start + index < body.length() then body[start + index] else "" end
    lines.push(board_cell(text, width))
  end
  lines.push(board_cell("Esc/q: back  j/k: scroll  n: notes  e: title  H/L: move", width))
  lines.push(board_cell(board.message(), width))
  prompt = if board.mode() == "edit" then board_editor_prompt(board, width, lines.length()) else "" end
  lines.push(if prompt.empty?() then board_cell("", width) else prompt end)
  lines.join("\r\n")
end

def board_editor_prompt(board, width, row)
  prefix = "#{board.mode()}> "
  available = width - prefix.length()
  board.edit_width(available)
  view = board.editor().view(available, 1)
  board.place_caret(row, prefix.length() + view[2])
  prefix + board_editor_cell(view[0][0], available)
end

def board_editor_cell(text, width)
  text = board_safe(text)
  text + " " * (width - text.scan(Regexp.new("(?m).")).length())
end

def board_notes_frame(board, rows, columns)
  task = board.detail()
  width = columns - 1
  height = rows - 7
  board.edit_width(width)
  view = board.editor().view(width, height)
  board.place_caret(3 + view[1], view[2])
  lines = [board_cell("Task ##{task.id()} [#{task.status()}] | #{board.project_for(task)}", width),
    board_cell(task.title(), width), "Notes:"]
  (0...height).each() do |index|
    text = if index < view[0].length() then view[0][index] else "" end
    lines.push(board_editor_cell(text, width))
  end
  lines.push(board_cell("Ctrl-S: save  Esc: cancel  Arrows: move  Home/End  Delete", width))
  lines.push(board_cell(board.message(), width))
  lines.push(board_cell("Enter: newline  Ctrl-U: clear  Ctrl-Home/End: start/end of notes", width))
  lines.join("\r\n")
end

def board_frame(board, rows, columns)
  board.hide_caret()
  if rows < 10 || columns < 60
    return "Terminal too small: need 60 columns x 10 rows. Resize, or q to quit."
  end
  if board.detail_view?() then return board_detail_frame(board, rows, columns) end
  width = (columns - 7) / 3
  lines = [board_cell("Task board | #{board.project_name()} | p: next project  P: new project", columns - 1)]
  search = if board.query().empty?() then "(all tasks)" else board.query() end
  lines.push(board_cell("Search: #{search} | /: change  Ctrl-U in search: clear", columns - 1))
  lines.push((0...3).map() do |column|
    mark = if board.column() == column then ">" else " " end
    board_cell("#{mark} #{board.statuses()[column]} (#{board.tasks(column).length()})", width)
  end.join(" | "))
  visible = rows - 8
  start = if board.row() >= visible then board.row() - visible + 1 else 0 end
  (0...visible).each() do |offset|
    index = start + offset
    lines.push((0...3).map() do |column|
      tasks = board.tasks(column)
      task = if index < tasks.length() then tasks[index] else nil end
      text = ""
      if task != nil
        mark = if board.column() == column && board.row() == index then ">" else " " end
        text = "#{mark}##{task.id()} #{task.title()}"
      end
      board_cell(text, width)
    end.join(" | "))
  end
  task = board.selected()
  detail = if task == nil then "No task selected" else "##{task.id()} #{board.project_for(task)} / #{task.title()}" end
  lines.push(board_cell(detail, columns - 1))
  lines.push(board_cell("/: search  Enter: details  a: add  e: edit  H/L: move  q: quit", columns - 1))
  lines.push(board_cell(board.message(), columns - 1))
  prompt = if board.mode() == "board" then "" else board_editor_prompt(board, columns - 1, lines.length()) end
  lines.push(if prompt.empty?() then board_cell("", columns - 1) else prompt end)
  lines.join("\r\n")
end
