# Host-wide nginx configuration for the droplet: the port-80 ACME/redirect
# server and a TLS default that refuses unknown names. Installed as
# /etc/nginx/conf.d/00-common.conf; the registry block is nginx.conf.example
# (diamond-registry.conf).

# Shared settings for every site on this host. TLS certificates come from
# certbot (webroot /var/www/letsencrypt); renewal is certbot.timer plus
# /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

# Port 80: ACME HTTP-01 challenges for renewal, everything else to HTTPS.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# Unknown hostnames on 443 are refused rather than served another site.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    ssl_reject_handshake on;
}

# The marketing site (rolld6.codes, with the former site domains
# redirecting to it) is /etc/nginx/conf.d/rolld6.conf, kept in the marketing
# repository as deploy/nginx.conf.
