# Include inside nginx's http {} context. Replace hostname and certificate paths.
# This example serves REGISTRY_BASE="" on a dedicated hostname.
map $request_method $registry_write_key {
    default $binary_remote_addr;
    GET "";
    HEAD "";
}
limit_req_zone $binary_remote_addr zone=registry_reads:10m rate=20r/s;
limit_req_zone $registry_write_key zone=registry_writes:10m rate=6r/m;
# Deliberately omit URI, query, client identity, headers and body.
log_format registry_json escape=json
    '{"status":$status,"duration_seconds":$request_time,'
    '"response_bytes":$body_bytes_sent,"limit":"$limit_req_status",'
    '"request_id":"$upstream_http_x_request_id"}';

server {
    listen 443 ssl;
    server_name cuts.example.com;
    ssl_certificate /etc/ssl/registry/fullchain.pem;
    ssl_certificate_key /etc/ssl/registry/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/registry-access.log registry_json;
    # nginx error logs can contain request URLs: restrict access and retention.
    error_log /var/log/nginx/registry-error.log warn;

    client_max_body_size 25m;
    client_header_timeout 10s;
    client_body_timeout 30s;
    send_timeout 30s;
    keepalive_timeout 15s;
    limit_req_status 429;

    location / {
        limit_req zone=registry_reads burst=40 nodelay;
        limit_req zone=registry_writes burst=3 nodelay;
        # No URI suffix: preserve any REGISTRY_BASE prefix when forwarding.
        proxy_pass http://127.0.0.1:18120;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection close;
        proxy_set_header Expect "";
        proxy_request_buffering on;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        proxy_next_upstream off;
        proxy_cache off;
    }
}
