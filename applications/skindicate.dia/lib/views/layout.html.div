<%# locals: title, content, current_user, csrf_token %>
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= title %> - Skindicate</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <nav>
    <a href="/">Skindicate</a>
    <% if current_user == nil %>
      | <a href="/login">Sign in</a> | <a href="/signup">Sign up</a>
    <% else %>
      | <a href="/skins/new">Submit a skin</a>
      | Signed in as <%= current_user.username() %>
      <form method="POST" action="/logout" style="display:inline"><input type="hidden" name="csrf_token" value="<%= csrf_token %>"><button>Sign out</button></form>
    <% end %>
  </nav>
  <h1><%= title %></h1>
  <%== content %>
</body>
</html>
