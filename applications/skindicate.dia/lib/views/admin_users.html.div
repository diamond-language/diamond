<%# locals: users, current_user, csrf_token %>
<div class="form-page">
<table class="admin-users-table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Username</th>
      <th>Email</th>
      <th>Role</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  <% users.each() do |user| %>
    <tr>
      <td><%= user.id() %></td>
      <td><a href="/users/<%= user.username() %>">@<%= user.username() %></a></td>
      <td><%= user.email() %></td>
      <td><span class="tag"><%= user.role() %></span></td>
      <td>
        <% if user.id() == current_user.id() %>
        <span class="admin-self-note">(you)</span>
        <% elsif user.admin?() %>
        <form method="POST" action="/admin/users/<%= user.id() %>/role">
          <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
          <input type="hidden" name="role" value="user">
          <button type="submit" class="btn btn-ghost btn-sm">Make user</button>
        </form>
        <% else %>
        <form method="POST" action="/admin/users/<%= user.id() %>/role">
          <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
          <input type="hidden" name="role" value="admin">
          <button type="submit" class="btn btn-ghost btn-sm">Make admin</button>
        </form>
        <% end %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
