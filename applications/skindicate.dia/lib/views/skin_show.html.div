<%# locals: skin, uploader, tags, is_owner, current_user, discussion, comments, db, csrf_token %>
<div class="skin-show">
  <div class="skin-preview-area">
    <% if skin.preview_image_path() != nil %>
    <img src="/<%= skin.preview_image_path() %>" alt="<%= skin.title() %>">
    <% else %>
    <div class="skin-preview-placeholder"><%= skin.platform() %></div>
    <% end %>
  </div>

  <div class="skin-info">
    <span class="skin-platform-badge"><%= skin.platform() %></span>
    <p class="skin-description"><%= skin.description() %></p>

    <% if tags.length() > 0 %>
    <div class="skin-tags">
    <% tags.each() do |tag| %><a href="/tags/<%= tag.name() %>" class="tag">#<%= tag.name() %></a><% end %>
    </div>
    <% end %>

    <a href="/<%= skin.file_path() %>" class="skin-download-link btn btn-primary">&#8595; <%= skin.original_filename() %></a>

    <% if is_owner %>
    <div class="skin-actions">
      <a href="/skins/<%= skin.id() %>/edit" class="btn btn-ghost">Edit</a>
      <form method="POST" action="/skins/<%= skin.id() %>/delete" style="display:inline" onsubmit="return confirm('Delete this skin?')">
        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <button type="submit" class="btn btn-danger">Delete</button>
      </form>
    </div>
    <% end %>

    <div class="skin-author-card">
      <a href="/users/<%= uploader.username() %>">@<%= uploader.username() %></a>
    </div>
  </div>
</div>

<section class="skin-comments">
  <div class="comments-header">
    <h2 class="comments-title"><%= discussion.comment_count(db) %> <% if discussion.comment_count(db) == 1 %>Comment<% else %>Comments<% end %></h2>
    <% if is_owner %>
    <div class="discussion-mod-controls">
      <% if discussion.locked?() %>
      <form method="POST" action="/skins/<%= skin.id() %>/unlock" style="display:inline">
        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <button type="submit" class="btn btn-ghost btn-sm">Unlock discussion</button>
      </form>
      <% elsif discussion.cooling_down?() %>
      <form method="POST" action="/skins/<%= skin.id() %>/unlock" style="display:inline">
        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <button type="submit" class="btn btn-ghost btn-sm">Clear cooldown</button>
      </form>
      <% else %>
      <form method="POST" action="/skins/<%= skin.id() %>/lock" style="display:inline">
        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <button type="submit" class="btn btn-ghost btn-sm">Lock discussion</button>
      </form>
      <% end %>
    </div>
    <% end %>
  </div>

  <% if discussion.locked?() %>
  <div class="discussion-notice discussion-notice-locked">
    <strong>Discussion locked.</strong> <%= discussion.locked_reason() %>
  </div>
  <% elsif discussion.cooling_down?() %>
  <div class="discussion-notice discussion-notice-cooldown">
    <strong>Cooling down.</strong> New comments are paused for a while after a flood of reports.
  </div>
  <% end %>

  <% if comments.length() == 0 %>
  <div class="empty-state"><p>No comments yet.</p></div>
  <% end %>

  <% comments.each() do |comment| %>
  <div class="comment" id="comment-<%= comment.id() %>">
    <div class="comment-meta">
      <a href="/users/<%= comment.persona_handle() %>" class="comment-author">@<%= comment.persona_handle() %></a>
      <time class="comment-time"><%= Time.at(comment.created_at()).strftime("%Y-%m-%d %H:%M") %></time>
      <% if comment.edited?() %>
      <span class="comment-edited">(edited)</span>
      <% end %>
      <span class="comment-actions">
        <% if current_user != nil && current_user.username() != comment.persona_handle() %>
        <form method="POST" action="/comments/<%= comment.id() %>/report" class="comment-report-form" title="Report comment">
          <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
          <button type="submit" class="comment-action-btn">&#9873; Report</button>
        </form>
        <% end %>
        <% if current_user != nil && (current_user.username() == comment.persona_handle() || is_owner) %>
        <form method="POST" action="/comments/<%= comment.id() %>/delete" class="comment-delete-form" onsubmit="return confirm('Delete this comment?')">
          <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
          <button type="submit" class="comment-delete" title="Delete comment">&#10005;</button>
        </form>
        <% end %>
      </span>
    </div>
    <p class="comment-text"><%= comment.body() %></p>

    <% replies = comment.replies(db) %>
    <% if replies.length() > 0 %>
    <div class="comment-replies">
      <% replies.each() do |reply| %>
      <div class="comment comment-reply" id="comment-<%= reply.id() %>">
        <div class="comment-meta">
          <a href="/users/<%= reply.persona_handle() %>" class="comment-author">@<%= reply.persona_handle() %></a>
          <time class="comment-time"><%= Time.at(reply.created_at()).strftime("%Y-%m-%d %H:%M") %></time>
          <% if reply.edited?() %>
          <span class="comment-edited">(edited)</span>
          <% end %>
          <span class="comment-actions">
            <% if current_user != nil && current_user.username() != reply.persona_handle() %>
            <form method="POST" action="/comments/<%= reply.id() %>/report" class="comment-report-form" title="Report comment">
              <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
              <button type="submit" class="comment-action-btn">&#9873; Report</button>
            </form>
            <% end %>
            <% if current_user != nil && (current_user.username() == reply.persona_handle() || is_owner) %>
            <form method="POST" action="/comments/<%= reply.id() %>/delete" class="comment-delete-form" onsubmit="return confirm('Delete this comment?')">
              <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
              <button type="submit" class="comment-delete" title="Delete comment">&#10005;</button>
            </form>
            <% end %>
          </span>
        </div>
        <p class="comment-text"><%= reply.body() %></p>
      </div>
      <% end %>
    </div>
    <% end %>

    <% if current_user != nil && discussion.open?() %>
    <form method="POST" action="/skins/<%= skin.id() %>/comments" class="reply-form">
      <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
      <input type="hidden" name="parent_id" value="<%= comment.id() %>">
      <textarea class="comment-input" name="body" rows="2" placeholder="Reply to @<%= comment.persona_handle() %>&hellip;" required></textarea>
      <div class="comment-form-actions">
        <button type="submit" class="btn btn-ghost btn-sm">Reply</button>
      </div>
    </form>
    <% end %>
  </div>
  <% end %>

  <% if discussion.open?() %>
  <% if current_user != nil %>
  <form method="POST" action="/skins/<%= skin.id() %>/comments" class="comment-form">
    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <div class="comment-form-input">
      <textarea class="comment-input" name="body" placeholder="Add a comment&hellip;" required></textarea>
      <div class="comment-form-actions">
        <button type="submit" class="btn btn-primary btn-sm">Post</button>
      </div>
    </div>
  </form>
  <% else %>
  <p class="comments-sign-in"><a href="/login">Sign in</a> to leave a comment.</p>
  <% end %>
  <% end %>
</section>
