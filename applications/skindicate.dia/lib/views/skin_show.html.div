<%# locals: skin, uploader, tags, is_owner, current_user, skin_entry, comment_entries, db, csrf_token %>
<div class="skin-show">
  <div class="skin-preview-area">
    <% if skin.preview_image_path() != nil %>
    <img src="/<%= skin.preview_image_path() %>" alt="<%= skin.title() %>">
    <% else %>
    <div class="skin-preview-placeholder"><%= skin.platform() %></div>
    <% end %>
  </div>

  <div class="skin-info">
    <span class="skin-platform-badge"><%= skin.platform() %></span>
    <p class="skin-description"><%= skin.description() %></p>

    <% if tags.length() > 0 %>
    <div class="skin-tags">
    <% tags.each() do |tag| %><a href="/tags/<%= tag.name() %>" class="tag">#<%= tag.name() %></a><% end %>
    </div>
    <% end %>

    <a href="/<%= skin.file_path() %>" class="skin-download-link btn btn-primary">&#8595; <%= skin.original_filename() %></a>

    <% if is_owner %>
    <div class="skin-actions">
      <a href="/skins/<%= skin.id() %>/edit" class="btn btn-ghost">Edit</a>
      <form method="POST" action="/skins/<%= skin.id() %>/delete" style="display:inline" onsubmit="return confirm('Delete this skin?')">
        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <button type="submit" class="btn btn-danger">Delete</button>
      </form>
    </div>
    <% end %>

    <div class="skin-author-card">
      <a href="/users/<%= uploader.username() %>">@<%= uploader.username() %></a>
    </div>
  </div>
</div>

<section class="skin-comments">
  <h2 class="comments-title"><%= comment_entries.length() %> <% if comment_entries.length() == 1 %>Comment<% else %>Comments<% end %></h2>

  <% if comment_entries.length() == 0 %>
  <div class="empty-state"><p>No comments yet.</p></div>
  <% end %>

  <% comment_entries.each() do |comment_entry| %>
  <% comment = comment_entry.entryable(db) %>
  <% comment_author = User.find(db, comment_entry.user_id()) %>
  <div class="comment" id="comment-<%= comment_entry.id() %>">
    <div class="comment-meta">
      <a href="/users/<%= comment_author.username() %>" class="comment-author">@<%= comment_author.username() %></a>
      <time class="comment-time"><%= Time.at(comment_entry.created_at()).strftime("%Y-%m-%d %H:%M") %></time>
      <span class="comment-actions">
        <% if current_user != nil && (current_user.id() == comment_entry.user_id() || is_owner) %>
        <form method="POST" action="/comments/<%= comment.id() %>/delete" class="comment-delete-form" onsubmit="return confirm('Delete this comment?')">
          <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
          <button type="submit" class="comment-delete" title="Delete comment">&#10005;</button>
        </form>
        <% end %>
      </span>
    </div>
    <p class="comment-text"><%= comment.body() %></p>

    <% replies = comment_entry.children(db) %>
    <% if replies.length() > 0 %>
    <div class="comment-replies">
      <% replies.each() do |reply_entry| %>
      <% reply = reply_entry.entryable(db) %>
      <% reply_author = User.find(db, reply_entry.user_id()) %>
      <div class="comment comment-reply" id="comment-<%= reply_entry.id() %>">
        <div class="comment-meta">
          <a href="/users/<%= reply_author.username() %>" class="comment-author">@<%= reply_author.username() %></a>
          <time class="comment-time"><%= Time.at(reply_entry.created_at()).strftime("%Y-%m-%d %H:%M") %></time>
          <span class="comment-actions">
            <% if current_user != nil && (current_user.id() == reply_entry.user_id() || is_owner) %>
            <form method="POST" action="/comments/<%= reply.id() %>/delete" class="comment-delete-form" onsubmit="return confirm('Delete this comment?')">
              <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
              <button type="submit" class="comment-delete" title="Delete comment">&#10005;</button>
            </form>
            <% end %>
          </span>
        </div>
        <p class="comment-text"><%= reply.body() %></p>
      </div>
      <% end %>
    </div>
    <% end %>

    <% if current_user != nil %>
    <form method="POST" action="/skins/<%= skin.id() %>/comments" class="reply-form">
      <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
      <input type="hidden" name="parent_id" value="<%= comment_entry.id() %>">
      <textarea class="comment-input" name="body" rows="2" placeholder="Reply to @<%= comment_author.username() %>&hellip;" required></textarea>
      <div class="comment-form-actions">
        <button type="submit" class="btn btn-ghost btn-sm">Reply</button>
      </div>
    </form>
    <% end %>
  </div>
  <% end %>

  <% if current_user != nil %>
  <form method="POST" action="/skins/<%= skin.id() %>/comments" class="comment-form">
    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <div class="comment-form-input">
      <textarea class="comment-input" name="body" placeholder="Add a comment&hellip;" required></textarea>
      <div class="comment-form-actions">
        <button type="submit" class="btn btn-primary btn-sm">Post</button>
      </div>
    </div>
  </form>
  <% else %>
  <p class="comments-sign-in"><a href="/login">Sign in</a> to leave a comment.</p>
  <% end %>
</section>
