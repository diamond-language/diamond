<%# locals: skins, db %>
<% if skins.length() == 0 %>
<div class="empty-state"><p>No skins here yet.</p></div>
<% end %>
<div class="skins-grid">
<% skins.each() do |skin| %>
  <article class="skin-card">
    <a href="/skins/<%= skin.id() %>" class="skin-card-preview">
      <% if skin.preview_image_path() != nil %>
      <img src="/<%= skin.preview_image_path() %>" alt="<%= skin.title() %>" loading="lazy">
      <% else %>
      <div class="skin-card-placeholder"><%= skin.platform() %></div>
      <% end %>
    </a>
    <div class="skin-card-meta">
      <a href="/skins/<%= skin.id() %>" class="skin-card-title"><%= skin.title() %></a>
      <span class="skin-card-platform"><%= skin.platform() %></span>
      <a href="/users/<%= skin.user(db).username() %>" class="skin-card-author">@<%= skin.user(db).username() %></a>
    </div>
  </article>
<% end %>
</div>
