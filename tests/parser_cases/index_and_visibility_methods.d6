class Store
  def initialize()
    @data = {"a" => 1}
  end
  def [](key) = @data[key]
  def []=(key, value)
    @data[key] = value
  end
  protected
  def hidden() = 42
  public
  def peek(other: Store) -> Int = other.hidden()
end
class Wrap
  def initialize(target: Store)
    @target = target
  end
  delegate peek(other), to: @target
  delegate fetch(*keys), to: @target
end
class Store
  def fetch(*keys) = keys.map() do |key| self[key] end
end
store = Store.new()
store["b"] = 2
hidden = begin
  store.hidden()
rescue error: StandardError
  "protected"
end
[store["a"] + store["b"], Wrap.new(store).peek(store), Wrap.new(store).fetch("a", "b"), hidden]
