# Int and Float fields the compiler can prove: the results must match an
# unproven run exactly, including Int overflow into big integers.
class Point
  def initialize(x: Int, y: Int)
    @x = x
    @y = y
  end

  # Calls x() and y() before they are defined, on purpose.
  def dot(other: Point) -> Int = @x * other.x() + @y * other.y()
  def x() -> Int = @x
  def y() -> Int = @y
  def scale(factor: Int) -> Int = @x * factor
end

class Body
  attr_accessor vx: Float
  attr_reader mass: Float

  # A default argument jumps over its own assignment; the fields after it
  # are still assigned on every path.
  def initialize(vx: Float, mass: Float = 2.0)
    @vx = vx
    @mass = mass
  end

  def momentum() -> Float = @vx * @mass
end

struct Pair(left: Int, right: Float)
  def total() -> Float = @left + @right
end

puts(Point.new(1, 2).dot(Point.new(3, 4)))
puts(Point.new(4611686018427387904, 1).scale(4))
puts(Point.new(-7, 0).x() / 2)
body = Body.new(1.5)
puts(body.momentum())
body.vx = 3.0
puts(body.vx() + body.mass())
puts(Pair.new(2, 0.5).total())
