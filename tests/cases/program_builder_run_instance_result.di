b = ProgramBuilder.new()
class_index = b.declare_class("Box", -1)

fn = b.declare_function("get", 1, 1)
k = b.add_constant(fn, 42)
b.emit_byte(fn, 0)
b.emit_byte(fn, 1)
b.emit_byte(fn, k)
b.emit_byte(fn, 57)
b.emit_byte(fn, 1)
b.set_register_count(fn, 2)
b.declare_method(class_index, "get", fn, 0, 0, false)

b.emit_byte(-1, 39)
b.emit_byte(-1, 0)
b.emit_byte(-1, class_index)
b.emit_byte(-1, 1)
b.emit_byte(-1, 0)
b.emit_byte(-1, 57)
b.emit_byte(-1, 0)
b.set_register_count(-1, 2)

result = b.run()
result.get()
