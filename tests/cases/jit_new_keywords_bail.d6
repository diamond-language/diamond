# Keyword construction compiles to DIAMOND_OP_NEW_KEYWORDS (synthetic-chunk
# re-entry into run_chunk), which compile_body has no case for, so run_once
# still bails whole. The 1 compiled function is describe, whose
# interpolation compiles; initialize only stores its arguments and runs
# without a call.
class Box
  def initialize(left, right)
    @left = left
    @right = right
  end
  def describe() -> String = "#{@left}-#{@right}"
end

def run_once() -> String
  box = Box.new(right: "r", left: "l")
  box.describe()
end

puts(run_once())
