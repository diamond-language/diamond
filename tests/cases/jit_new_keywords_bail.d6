# Keyword construction compiles to DIAMOND_OP_NEW_KEYWORDS (a synthetic-chunk
# re-entry into run_chunk). Compiled code runs it through the interpreter's own
# body (diamond_jit_outlined), so run_once compiles alongside describe, whose
# interpolation compiles; initialize only stores its arguments and runs
# without a call.
class Box
  def initialize(left, right)
    @left = left
    @right = right
  end
  def describe() -> String = "#{@left}-#{@right}"
end

def run_once() -> String
  box = Box.new(right: "r", left: "l")
  box.describe()
end

puts(run_once())
