# An ivar-loaded local reassigned anywhere in the body (even to another
# read of the exact same ivar) fails register_new_class_if_sole_writer's
# whole-body "exactly one write" rule, same shape as jit_new_local_
# reassigned.d6's NEW-based test. `run` used to bail for an unrelated
# reason, its `i == 3`; since the JIT compiles Int == (ba6a8827) it
# compiles anyway, through the general dispatch path rather than the
# single-class proof, and the total stays right. `double` and `run`
# compile (2); both `initialize`s only store their argument, written
# without a call.
class Box
  def initialize(value)
    @value = value
  end
  def double() -> Int = @value * 2
end

class Holder
  def initialize(box: Box)
    @box = box
  end
  def run(n) -> Int
    x = @box
    total = 0
    i = 0
    while i < n
      total = total + x.double()
      if i == 3
        x = @box
      end
      i = i + 1
    end
    total
  end
end

puts(Holder.new(Box.new(21)).run(6))
