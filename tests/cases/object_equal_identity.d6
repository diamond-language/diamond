# equal? asks whether two values are the same object, even when a class's
# own == says two different objects are equal.
class Point
  def initialize(x: Int, y: Int)
    @x = x
    @y = y
  end
  def x() = @x
  def y() = @y
  def ==(other) = other is Point && @x == other.x() && @y == other.y()
end

a = Point.new(1, 2)
b = Point.new(1, 2)
text = "hi"
list = [1]
[a == b, a.equal?(b), a.equal?(a), text.equal?(text), text.equal?("hi"), list.equal?(list),
  list.equal?([1]), 3.equal?(3), 3.equal?(3.0), nil.equal?(nil), :x.equal?(:x), :x.equal?(:y)]
