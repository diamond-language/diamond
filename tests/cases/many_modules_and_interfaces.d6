class Square
  include Greets
  def initialize(side: Int)
    @side = side
  end
  def area() -> Int = @side * @side
end

def check(shape) = shape is Shape39

puts(M0.id() + M299.id())
puts(Square.new(3).greet())
puts(Square.new(4) is Shape39)
puts(Thread.new(check, Square.new(2)).join())
