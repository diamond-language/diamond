# __dir__ and __FILE__ are the absolute directory and path of the file they are written in,
# including through a require and inside string interpolation.
require "dir_constants_helper"
# A comment mentioning __dir__ is left alone.

mentions = "the text __dir__ in a string is not substituted"
my__dir__ = 7

[File.basename(__FILE__, ".d6"),
 File.absolute?(__FILE__),
 File.exist?("#{__dir__}/dir_constants.d6"),
 File.dirname(__FILE__) == __dir__,
 File.basename(helper_file(), ".d6"),
 helper_dir() == __dir__,
 mentions,
 my__dir__]
