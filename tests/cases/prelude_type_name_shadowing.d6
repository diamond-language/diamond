# A program that declares another kind of type under a prelude class's name
# gets the name (docs/compatibility.md): the prelude's class keeps working for
# the prelude, under "MatchData (core)".
struct MatchData(a: Int)
end
p(MatchData.new(5).a())

module StringBuilder
  def self.hi() = "own module"
end
p(StringBuilder.hi())

found = "ab".match_data(/(?<w>b)/)
p(found["w"])
p(found.class())
