# Floored `%` on arbitrary-precision Ints: the result takes the divisor's sign,
# matching Int `%`. Expected values come from Python's own floored %.
# Values past 64 bits are built by arithmetic, since literals cap at 64 bits.
def m(a, b) = a % b

puts(m(((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0), (7)))
puts(m((-((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0)), (7)))
puts(m(((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0), (-7)))
puts(m((-((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0)), (-7)))
puts(m(((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 12345), (((0 * 1000000000 + 100) * 1000000000 + 0) * 1000000000 + 0)))
puts(m((-((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 12345)), (((0 * 1000000000 + 100) * 1000000000 + 0) * 1000000000 + 0)))
puts(m(((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 12345), (-(((0 * 1000000000 + 100) * 1000000000 + 0) * 1000000000 + 0))))
puts(m((-((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 12345)), (-(((0 * 1000000000 + 100) * 1000000000 + 0) * 1000000000 + 0))))
puts(m((7), ((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0)))
puts(m((-7), ((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0)))
puts(m((7), (-((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0))))
puts(m((-7), (-((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0))))
puts(m((((((((0 * 1000000000 + 1000000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 5), ((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0)))
puts(m((-(((((((0 * 1000000000 + 1000000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 5)), ((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0)))
puts(m(((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0), ((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0)))
puts(m((-((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0)), ((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0)))
puts(m(((((0 * 1000000000 + 3000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0), ((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0)))
puts(m((((0 * 1000000000 + 10) * 1000000000 + 0) * 1000000000 + 5), (((0 * 1000000000 + 10) * 1000000000 + 0) * 1000000000 + 0)))
puts(m((((0 * 1000000000 + 18) * 1000000000 + 446744073) * 1000000000 + 709551616), (3)))
puts(m((-(((0 * 1000000000 + 18) * 1000000000 + 446744073) * 1000000000 + 709551616)), (3)))
puts(m((((0 * 1000000000 + 18) * 1000000000 + 446744073) * 1000000000 + 709551616), (-3)))
puts(m((3), (((0 * 1000000000 + 18) * 1000000000 + 446744073) * 1000000000 + 709551616)))
puts(m((-3), (((0 * 1000000000 + 18) * 1000000000 + 446744073) * 1000000000 + 709551616)))
puts(m((((0 * 1000000000 + 9) * 1000000000 + 223372036) * 1000000000 + 854775808), (((0 * 1000000000 + 9) * 1000000000 + 223372036) * 1000000000 + 854775808)))
puts(m((-(((0 * 1000000000 + 9) * 1000000000 + 223372036) * 1000000000 + 854775809)), (4611686018427387904)))
begin
  m(((((0 * 1000000000 + 1000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0), 0)
rescue error: ZeroDivisionError
  puts("zero")
end
# identity check: (a - a % b) is an exact multiple of b
x = (((((((0 * 1000000000 + 1000000) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 0) * 1000000000 + 12345)
y = (100000000000000003)
puts((x - x % y) / y * y == x - x % y)
nil
