b = ProgramBuilder.new()
i = 0
while i < 1024
  index = b.declare_module("M#{i}")
  raise "wrong index" unless index == i
  i += 1
end
class_index = b.declare_class("Box", -1)
b.include_module(class_index, 1023)
b.include_module_in_module(1022, 1023)
b.declare_module_field(1023, "value")
begin
  b.declare_module("Overflow")
  false
rescue error: TypeError
  error.message().include?("too many modules: a program holds at most 1024")
end
