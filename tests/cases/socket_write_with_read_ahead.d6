# Writing works while unread bytes sit in the socket's read-ahead, and they survive it.
server = TCPServer.listen(0, host: "127.0.0.1")
client = TCPSocket.connect("127.0.0.1", server.port())
peer = server.accept()
peer.write("first\nsecond\n")
peer.flush()
first = client.gets()
client.write("reply\n")
client.flush()
reply = peer.gets()
second = client.gets()
client.write("from the client\n")
peer.write("third\n")
peer.flush()
third = client.gets()
client.shutdown_write()
last = peer.gets()
ended = peer.gets()
client.close()
peer.close()
server.close()
[first, reply, second, third, last, ended]
