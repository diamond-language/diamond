# A class that overrides `dup` itself: compiled code dispatches the call
# through the interpreter's own method lookup (diamond_jit_invoke_any), so the
# override runs, with no bailout to the interpreter. (`n()` is a plain getter,
# read without a call, and `initialize` only stores its argument, written
# without a call, so neither is compiled.)
class Widget
  def initialize(n)
    @n = n
  end
  def dup() = Widget.new(999)
  def n() = @n
end

def dup_it(x) = x.dup()

w = Widget.new(42)
d = dup_it(w)
puts(d.n())
