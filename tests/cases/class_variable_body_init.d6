# A class or module body can set a class variable, and a Thread starts with a
# copy of the class variables already set (it keeps its own from then on).
class Counter
  @@count = 10
  @@seen = {}
  def self.bump()
    @@count += 1
    @@seen["last"] = @@count
    @@count
  end
  def self.seen() = @@seen
end

class Other
  @@count = 100
  def self.count() = @@count
end

module Registry
  @@names = ["core"]
  def self.add(name) = @@names.push(name)
  def self.names() = @@names
end

def in_thread()
  Registry.add("thread")
  [Counter.bump(), Registry.names()]
end

Counter.bump()
Counter.bump()
from_thread = Thread.new(in_thread).join()
[Counter.seen(), Other.count(), Registry.names(), from_thread]
