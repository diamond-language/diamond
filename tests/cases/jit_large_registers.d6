# Functions with more registers than the JIT's stack register file (256)
# compile too (threshold 1, stress GC): their register file comes from the
# heap and the compiled code frees it on every exit, and their calls to
# themselves go through the trampoline rather than the native self-call,
# which would reserve the registers on the stack. A hash literal holds each
# key and value in its own register, so 150 pairs take 300.

def wide(base: Int) -> Int
  values = {"k0" => base + 0, "k1" => base + 1, "k2" => base + 2, "k3" => base + 3, "k4" => base + 4, "k5" => base + 5,
    "k6" => base + 6, "k7" => base + 7, "k8" => base + 8, "k9" => base + 9, "k10" => base + 10, "k11" => base + 11,
    "k12" => base + 12, "k13" => base + 13, "k14" => base + 14, "k15" => base + 15, "k16" => base + 16, "k17" => base + 17,
    "k18" => base + 18, "k19" => base + 19, "k20" => base + 20, "k21" => base + 21, "k22" => base + 22, "k23" => base + 23,
    "k24" => base + 24, "k25" => base + 25, "k26" => base + 26, "k27" => base + 27, "k28" => base + 28, "k29" => base + 29,
    "k30" => base + 30, "k31" => base + 31, "k32" => base + 32, "k33" => base + 33, "k34" => base + 34, "k35" => base + 35,
    "k36" => base + 36, "k37" => base + 37, "k38" => base + 38, "k39" => base + 39, "k40" => base + 40, "k41" => base + 41,
    "k42" => base + 42, "k43" => base + 43, "k44" => base + 44, "k45" => base + 45, "k46" => base + 46, "k47" => base + 47,
    "k48" => base + 48, "k49" => base + 49, "k50" => base + 50, "k51" => base + 51, "k52" => base + 52, "k53" => base + 53,
    "k54" => base + 54, "k55" => base + 55, "k56" => base + 56, "k57" => base + 57, "k58" => base + 58, "k59" => base + 59,
    "k60" => base + 60, "k61" => base + 61, "k62" => base + 62, "k63" => base + 63, "k64" => base + 64, "k65" => base + 65,
    "k66" => base + 66, "k67" => base + 67, "k68" => base + 68, "k69" => base + 69, "k70" => base + 70, "k71" => base + 71,
    "k72" => base + 72, "k73" => base + 73, "k74" => base + 74, "k75" => base + 75, "k76" => base + 76, "k77" => base + 77,
    "k78" => base + 78, "k79" => base + 79, "k80" => base + 80, "k81" => base + 81, "k82" => base + 82, "k83" => base + 83,
    "k84" => base + 84, "k85" => base + 85, "k86" => base + 86, "k87" => base + 87, "k88" => base + 88, "k89" => base + 89,
    "k90" => base + 90, "k91" => base + 91, "k92" => base + 92, "k93" => base + 93, "k94" => base + 94, "k95" => base + 95,
    "k96" => base + 96, "k97" => base + 97, "k98" => base + 98, "k99" => base + 99, "k100" => base + 100, "k101" => base + 101,
    "k102" => base + 102, "k103" => base + 103, "k104" => base + 104, "k105" => base + 105, "k106" => base + 106, "k107" => base + 107,
    "k108" => base + 108, "k109" => base + 109, "k110" => base + 110, "k111" => base + 111, "k112" => base + 112, "k113" => base + 113,
    "k114" => base + 114, "k115" => base + 115, "k116" => base + 116, "k117" => base + 117, "k118" => base + 118, "k119" => base + 119,
    "k120" => base + 120, "k121" => base + 121, "k122" => base + 122, "k123" => base + 123, "k124" => base + 124, "k125" => base + 125,
    "k126" => base + 126, "k127" => base + 127, "k128" => base + 128, "k129" => base + 129, "k130" => base + 130, "k131" => base + 131,
    "k132" => base + 132, "k133" => base + 133, "k134" => base + 134, "k135" => base + 135, "k136" => base + 136, "k137" => base + 137,
    "k138" => base + 138, "k139" => base + 139, "k140" => base + 140, "k141" => base + 141, "k142" => base + 142, "k143" => base + 143,
    "k144" => base + 144, "k145" => base + 145, "k146" => base + 146, "k147" => base + 147, "k148" => base + 148, "k149" => base + 149}
  values.values().sum()
end

# Recursion through a wide function, allocating strings (so the stress
# collector runs) while the heap register file holds the only references.
def wide_strings(depth: Int) -> Array[String]
  if depth == 0
    return []
  end
  words = {"k0" => "w#{depth}-0", "k1" => "w#{depth}-1", "k2" => "w#{depth}-2", "k3" => "w#{depth}-3",
    "k4" => "w#{depth}-4", "k5" => "w#{depth}-5", "k6" => "w#{depth}-6", "k7" => "w#{depth}-7",
