total = 0
index = 0
while index < 5
  total = total + wide(index)
  index = index + 1
end
puts(total)
puts(wide_strings(3))
puts(wide_checked(7, true))
puts(wide_checked(7, false))
begin
  wide_checked("seven", true)
rescue error: TypeError
  puts("checked: #{error.message()}")
end
begin
  wide_raise("raised ")
rescue error: ArgumentError
  puts(error.message())
end
puts(wide_rescue("here"))
