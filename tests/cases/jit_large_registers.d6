    "k140" => "w#{depth}-140", "k141" => "w#{depth}-141", "k142" => "w#{depth}-142", "k143" => "w#{depth}-143",
    "k144" => "w#{depth}-144", "k145" => "w#{depth}-145", "k146" => "w#{depth}-146", "k147" => "w#{depth}-147",
    "k148" => "w#{depth}-148", "k149" => "w#{depth}-149"}
  rest = wide_strings(depth - 1)
