end

# The other exits: a retry (a failed return check in a function that makes
# no calls bails to the interpreter, which raises), an exception propagated
# from a call, and one rescued inside the function.
def wide_checked(value, early: Bool) -> Int
  if early
    return value
  end
  values = {"k0" => 0, "k1" => 1, "k2" => 2, "k3" => 3, "k4" => 4, "k5" => 5,
