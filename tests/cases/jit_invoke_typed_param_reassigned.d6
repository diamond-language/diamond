# A typed parameter reassigned anywhere in the body (even to another
# in-scope instance of the exact same class, via a plain MOVE -- not a
# DIAMOND_OP_NEW, which the JIT doesn't support at all and would bail the
# function for an unrelated reason) fails parameter_never_reassigned's
# whole-body scan. `run_loop` used to bail for an unrelated reason, its
# `i == 3`; since the JIT compiles Int == (ba6a8827) it compiles anyway,
# through the general dispatch path rather than the single-class proof,
# and the total stays right (a reassignment to another class gives the
# right answer too). `double` and `run_loop` compile (2); `initialize` only stores its argument, written without a call.
class Box
  def initialize(value)
    @value = value
  end
  def double() -> Int = @value * 2
end

def run_loop(box: Box, other_box: Box, n) -> Int
  total = 0
  i = 0
  while i < n
    total = total + box.double()
    if i == 3
      box = other_box
    end
    i = i + 1
  end
  total
end

b = Box.new(21)
other = Box.new(99)
puts(run_loop(b, other, 6))
