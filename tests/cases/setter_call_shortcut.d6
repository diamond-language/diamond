# A method whose whole body stores its argument in an instance variable is
# answered by writing the field, without a call. Everything a real call would
# do differently must still happen: these are the edges.
class Point
  attr_accessor x: Int
  attr_accessor label

  def initialize(x, label)
    @x = x
    @label = label
  end
end

class Shifted < Point
  def x=(value: Int)
    @x = value + 100
  end
end

class Box[T]
  attr_accessor value: T

  def initialize(value: T)
    @value = value
  end
end

point = Point.new(3, "p")
point.x = 4
puts(point.x())
point.label = nil
puts(point.label())
puts(point.x = 9)

shifted = Shifted.new(1, "s")
shifted.x = 5
puts(shifted.x())

box = Box[Int].new(1)
box.value = 41
puts(box.value() + 1)

# The declared parameter type still rejects a wrong value, with the usual message.
begin
  point.x = "nine"
rescue error: TypeError
  puts(error.message())
end
puts(point.x())

# A frozen object still refuses the write.
point.freeze()
begin
  point.x = 10
rescue error: FrozenError
  puts("frozen: #{error.message()}")
end
puts(point.x())

# Class-typed fields: an exact instance and nil are settled without a call,
# a subclass instance goes through the full type check, and a wrong class or
# a primitive is still rejected with the usual message.
class Link
  attr_accessor next_link: Link | Nil

  def initialize(next_link: Link | Nil)
    @next_link = next_link
  end
end

class SpecialLink < Link
end

head = Link.new(nil)
puts(head.next_link())
head.next_link = Link.new(nil)
puts(head.next_link().next_link())
head.next_link = SpecialLink.new(nil)
puts(head.next_link() is SpecialLink)
head.next_link = nil
puts(head.next_link())
begin
  head.next_link = point
rescue error: TypeError
  puts(error.message())
end
begin
  head.next_link = 5
rescue error: TypeError
  puts(error.message())
end

# Float arithmetic answered inline still matches the general path.
a = 1.5
b = 0.25
puts(a + b)
puts(a - b)
puts(a * b)
puts(a / b)
puts(a / 0.0)
puts(2 * b)
puts(a - 1)
