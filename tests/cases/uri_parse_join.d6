# URI.parse splits a URI into its parts, and resolve/URI.join resolve a
# reference against a base exactly as RFC 3986 section 5.4 lists.
base = URI.parse("http://a/b/c/d;p?q")
examples = [
  ["g:h", "g:h"], ["g", "http://a/b/c/g"], ["./g", "http://a/b/c/g"], ["g/", "http://a/b/c/g/"],
  ["/g", "http://a/g"], ["//g", "http://g"], ["?y", "http://a/b/c/d;p?y"], ["g?y", "http://a/b/c/g?y"],
  ["#s", "http://a/b/c/d;p?q#s"], ["g#s", "http://a/b/c/g#s"], ["g?y#s", "http://a/b/c/g?y#s"],
  [";x", "http://a/b/c/;x"], ["g;x", "http://a/b/c/g;x"], ["g;x?y#s", "http://a/b/c/g;x?y#s"],
  ["", "http://a/b/c/d;p?q"], [".", "http://a/b/c/"], ["./", "http://a/b/c/"], ["..", "http://a/b/"],
  ["../", "http://a/b/"], ["../g", "http://a/b/g"], ["../..", "http://a/"], ["../../", "http://a/"],
  ["../../g", "http://a/g"],
  # The abnormal examples (section 5.4.2).
  ["../../../g", "http://a/g"], ["../../../../g", "http://a/g"], ["/./g", "http://a/g"],
  ["/../g", "http://a/g"], ["g.", "http://a/b/c/g."], [".g", "http://a/b/c/.g"], ["g..", "http://a/b/c/g.."],
  ["..g", "http://a/b/c/..g"], ["./../g", "http://a/b/g"], ["./g/.", "http://a/b/c/g/"],
  ["g/./h", "http://a/b/c/g/h"], ["g/../h", "http://a/b/c/h"], ["g;x=1/./y", "http://a/b/c/g;x=1/y"],
  ["g;x=1/../y", "http://a/b/c/y"], ["g?y/./x", "http://a/b/c/g?y/./x"], ["g#s/../x", "http://a/b/c/g#s/../x"]
]
failures = examples.select() do |pair| base.resolve(pair[0]).to_s() != pair[1] end
puts("#{examples.length() - failures.length()} of #{examples.length()} references resolve as RFC 3986 says")
failures.each() do |pair| puts("  #{pair[0]} -> #{base.resolve(pair[0])}, expected #{pair[1]}") end

uri = URI.parse("HTTPS://ada:secret@Example.COM:443/docs/./guide/../api?lang=d6#top")
puts([uri.scheme(), uri.userinfo(), uri.host(), uri.port(), uri.path(), uri.query(), uri.fragment()].inspect())
puts(uri.normalize())
puts([uri.origin(), uri.default_port(), uri.request_target(), uri.absolute?()].inspect())
puts(uri.with_fragment(nil))

relative = URI.parse("../img/logo.png?v=2")
puts([relative.scheme(), relative.host(), relative.path(), relative.query(), relative.absolute?()].inspect())
puts(URI.parse("http://[::1]:8080/").host())
puts(URI.parse("mailto:ada@example.com").path())
puts(URI.parse("x") == URI.parse("x"))
puts(URI.join("https://rolld6.codes/docs/guide/basics.html", "../api/uri.html#parse"))
puts("#{URI.parse("/a b")}")
begin
  URI.parse("http://example.com:http/")
rescue e: ArgumentError
  puts(e.message())
end
