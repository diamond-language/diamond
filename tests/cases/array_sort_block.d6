# A block orders by its result, and the receiver is left alone.
values = [3, 1, 2]
puts(values.sort() do |a, b| b - a end.inspect())
puts(values.inspect())

# Equal elements keep their order, across more than one merge pass.
words = ["bb", "a", "dd", "c", "ee", "f", "gg", "h", "ii"]
puts(words.sort() do |a, b| a.length() - b.length() end.inspect())

# Plain sort still works, and the empty and single-element cases return new arrays.
puts([2, 1].sort().inspect())
empty = []
puts(empty.sort() do |a, b| 0 end.inspect())
one = [1]
copy = one.sort() do |a, b| 0 end
copy.push(2)
puts(one.inspect())

# The block is a real comparison: it isn't limited to what plain sort can order.
class Item
  attr_reader rank
  def initialize(rank: Int)
    @rank = rank
  end
end
items = [Item.new(2), Item.new(3), Item.new(1)]
puts(items.sort() do |a, b| a.rank() - b.rank() end.map() do |item| item.rank() end.inspect())

# A named function works too, and Enumerable classes get the same method.
def descending(a, b) = b - a
puts([1, 2, 3].sort(descending).inspect())

class Numbers
  include Enumerable
  def each(callback: Callable[1])
    [1, 3, 2].each() do |value| callback(value) end
  end
end
puts(Numbers.new().sort() do |a, b| b - a end.inspect())

begin
  [1, 2].sort() do |a, b| "no" end
rescue error: TypeError
  puts(error.message())
end
