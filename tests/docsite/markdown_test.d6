# Tests for tools/docsite/markdown.d6.
#
#   build/diamond tests/docsite/markdown_test.d6

require "../../tools/docsite/markdown"

STATS = {"checks" => 0, "failures" => 0}

def check(name: String, source: String, expected: String)
  STATS["checks"] += 1
  actual = Markdown.new({"other.md" => "/docs/other.html"}).render(source).html()
  return if actual == expected
  STATS["failures"] += 1
  puts("FAIL #{name}")
  puts("  expected: #{expected.inspect()}")
  puts("  actual:   #{actual.inspect()}")
end

check("paragraph", "Hello\nworld.", "<p>Hello\nworld.</p>")
check("two paragraphs", "One.\n\nTwo.", "<p>One.</p>\n<p>Two.</p>")
check("escaping", "a < b && c > \"d\"", "<p>a &lt; b &amp;&amp; c &gt; &quot;d&quot;</p>")
check("heading", "# Title", "<h1 id=\"title\"><a class=\"anchor\" href=\"#title\">Title</a></h1>")
check("heading slug", "## `File.open` and `.read`!",
  "<h2 id=\"fileopen-and-read\"><a class=\"anchor\" href=\"#fileopen-and-read\"><code>File.open</code> and <code>.read</code>!</a></h2>")
check("duplicate ids", "## A\n\n## A",
  "<h2 id=\"a\"><a class=\"anchor\" href=\"#a\">A</a></h2>\n<h2 id=\"a-1\"><a class=\"anchor\" href=\"#a-1\">A</a></h2>")
check("code span", "Use `a < b` here.", "<p>Use <code>a &lt; b</code> here.</p>")
check("double backtick span", "``a ` b``", "<p><code>a ` b</code></p>")
check("unclosed backtick", "a ` b", "<p>a ` b</p>")
check("strong and em", "**bold** and *em* and _under_", "<p><strong>bold</strong> and <em>em</em> and <em>under</em></p>")
check("strong across lines", "**a\nb** c", "<p><strong>a\nb</strong> c</p>")
check("snake_case is not emphasis", "call do_this_now please", "<p>call do_this_now please</p>")
check("star in code is literal", "`a * b * c`", "<p><code>a * b * c</code></p>")
check("multiplication", "2 * 3 * 4", "<p>2 * 3 * 4</p>")
check("backslash escape", "\\*not em\\*", "<p>*not em*</p>")
check("link", "See [the docs](https://x.org/a?b=1&c=2).",
  "<p>See <a href=\"https://x.org/a?b=1&amp;c=2\">the docs</a>.</p>")
check("mapped link with fragment", "[Other](other.md#part)", "<p><a href=\"/docs/other.html#part\">Other</a></p>")
check("code in link text", "[`x`](other.md)", "<p><a href=\"/docs/other.html\"><code>x</code></a></p>")
check("autolink", "<https://example.com>", "<p><a href=\"https://example.com\">https://example.com</a></p>")
check("fence", "```ruby\nputs(1 < 2)\n```", "<pre><code class=\"language-d6\">puts(1 &lt; 2)</code></pre>")
check("fence keeps blank lines", "```sh\na\n\nb\n```", "<pre><code class=\"language-sh\">a\n\nb</code></pre>")
check("plain fence", "```\nx\n```", "<pre><code>x</code></pre>")
check("tight list", "- one\n- two", "<ul>\n<li>one</li>\n<li>two</li>\n</ul>")
check("loose list", "- one\n\n- two", "<ul>\n<li><p>one</p></li>\n<li><p>two</p></li>\n</ul>")
check("ordered list", "1. a\n2. b", "<ol>\n<li>a</li>\n<li>b</li>\n</ol>")
check("ordered start", "3. a\n4. b", "<ol start=\"3\">\n<li>a</li>\n<li>b</li>\n</ol>")
check("nested list", "- a\n  - b\n  - c\n- d",
  "<ul>\n<li>a\n<ul>\n<li>b</li>\n<li>c</li>\n</ul></li>\n<li>d</li>\n</ul>")
check("lazy continuation", "- a long\nitem", "<ul>\n<li>a long\nitem</li>\n</ul>")
check("fence in list", "1. Run:\n\n   ```sh\n   make\n   ```\n2. Done",
  "<ol>\n<li>Run:\n<pre><code class=\"language-sh\">make</code></pre></li>\n<li>Done</li>\n</ol>")
check("list after paragraph", "Intro:\n- a", "<p>Intro:</p>\n<ul>\n<li>a</li>\n</ul>")
check("table", "| a | b |\n|---|--:|\n| `x|y` | 2 |",
  "<div class=\"table-wrap\"><table>\n<thead><tr><th>a</th><th style=\"text-align: right\">b</th></tr></thead>\n" +
  "<tbody>\n<tr><td><code>x|y</code></td><td style=\"text-align: right\">2</td></tr>\n</tbody>\n</table></div>")
check("rule", "a\n\n---\n\nb", "<p>a</p>\n<hr>\n<p>b</p>")
check("html comment dropped", "<!-- doc-check: skip -->\n\ntext", "<p>text</p>")
check("comment right above a fence", "<!-- doc-check: skip -->\n```ruby\nx\n```\n\n**b**", "<pre><code class=\"language-d6\" data-run=\"no\">x</code></pre>\n<p><strong>b</strong></p>")
check("no-run marker", "<!-- docsite: no-run -->\n```ruby\nx\n```\n\n```ruby\ny\n```", "<pre><code class=\"language-d6\" data-run=\"no\">x</code></pre>\n<pre><code class=\"language-d6\">y</code></pre>")
check("marker only reaches the next block", "<!-- docsite: no-run -->\n\ntext\n\n```ruby\nx\n```", "<p>text</p>\n<pre><code class=\"language-d6\">x</code></pre>")
STATS["checks"] += 1
fallback = Markdown.new({"a.md" => "/a.html"}, "https://gh/blob/main/docs/").render("[x](../README.md#top) [y](a.md) [z](#here) [w](https://x.org/) [v](/root)").html()
unless fallback == "<p><a href=\"https://gh/blob/main/docs/../README.md#top\">x</a> <a href=\"/a.html\">y</a> <a href=\"#here\">z</a> <a href=\"https://x.org/\">w</a> <a href=\"/root\">v</a></p>"
  STATS["failures"] += 1
  puts("FAIL fallback links: #{fallback.inspect()}")
end
check("html anchor kept", "<a id=\"x\"></a>", "<a id=\"x\"></a>")
check("quote", "> quoted *text*", "<blockquote>\n<p>quoted <em>text</em></p>\n</blockquote>")
check("em dash", "a — b", "<p>a — b</p>")

page = Markdown.new({}).render("# Guide\n\n## First\n\n### Sub\n\n## Second")
STATS["checks"] += 1
headings = page.headings().map() do |h| h.id() end
unless page.title() == "Guide" && headings == ["first", "sub", "second"]
  STATS["failures"] += 1
  puts("FAIL title and headings: #{page.title().inspect()} #{headings.inspect()}")
end

puts("markdown: #{STATS["checks"]} checks, #{STATS["failures"]} failures")
exit(STATS["failures"] == 0 ? 0 : 1)
