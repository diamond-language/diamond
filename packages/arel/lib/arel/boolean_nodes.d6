module Arel

  ## `NOT expression`; made with `not_()` on a predicate.
  class Not
    def initialize(expression)
      @expression = expression
    end
    def expression() = @expression
  end

  ## `left AND right` or `left OR right`; made with `and_also` and `or_else`.
  class Logical
    def initialize(left, operator: String, right)
      @left = left
      @operator = operator
      @right = right
    end
    def left() = @left
    def operator() -> String = @operator
    def right() = @right
    ## This condition `AND other`.
    def and_also(other) -> Logical = Logical.new(self, "AND", other)
    ## This condition `OR other`.
    def or_else(other) -> Logical = Logical.new(self, "OR", other)
    ## `NOT` this condition.
    def not_() -> Not = Not.new(self)
  end

  ## A comparison such as `column = ?`, from `Attribute#eq`, `#lt` and the rest. The
  ## right side is bound as a parameter unless it is a column or `Arel.literal`;
  ## `eq(nil)` and `not_eq(nil)` render `IS NULL` and `IS NOT NULL`. Combine with
  ## `and_also`, `or_else` and `not_`.
  class Predicate
    def initialize(left, operator: String, right)
      @left = left
      @operator = operator
      @right = right
    end
    def left() = @left
    def operator() -> String = @operator
    def right() = @right
    def and_also(other) -> Logical = Logical.new(self, "AND", other)
    def or_else(other) -> Logical = Logical.new(self, "OR", other)
    def not_() -> Not = Not.new(self)
  end

  ## `IN (...)` or `NOT IN (...)` over a list of values or a subquery.
  class Membership
    def initialize(left, values, negated: Bool)
      @left = left
      @values = values
      @negated = negated
    end
    def left() = @left
    def values() = @values
    def negated?() -> Bool = @negated
    def and_also(other) -> Logical = Logical.new(self, "AND", other)
    def or_else(other) -> Logical = Logical.new(self, "OR", other)
    def not_() -> Not = Not.new(self)
  end

  ## `BETWEEN lower AND upper`, or its negation.
  class Between
    def initialize(left, lower, upper, negated: Bool)
      @left = left
      @lower = lower
      @upper = upper
      @negated = negated
    end
    def left() = @left
    def lower() = @lower
    def upper() = @upper
    def negated?() -> Bool = @negated
    def and_also(other) -> Logical = Logical.new(self, "AND", other)
    def or_else(other) -> Logical = Logical.new(self, "OR", other)
    def not_() -> Not = Not.new(self)
  end

end

