## Plans `active_record` loads from a GraphQL query: selects only the requested columns
## and preloads requested associations in one query each.
module GraphSQL

  ## Raised when one query selects the same association under two field names.
  class AliasedAssociationError < StandardError
    def self.for_duplicate(type_name, association, fields)
      joined_fields = fields.join(", ")
      AliasedAssociationError.new(
        "#{type_name} maps association '#{association}' under multiple requested GraphQL fields " +
        "(#{joined_fields})")
    end
  end

end

