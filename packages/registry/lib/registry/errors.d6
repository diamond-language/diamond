module Registry
  # What a request can be refused for. The message is the protocol's error code,
  # and API#failure_status has to cover every class here or it doesn't compile.
  ## Why a request was refused. The message is the protocol's error code, and the HTTP
  ## adapter maps each subclass to a status.
  sealed class Failure < StandardError
  end

  ## No valid credential.
  class Unauthorized < Failure
    def initialize()
      super("unauthorized")
    end
  end

  ## The credential lacks the needed scope or ownership.
  class Forbidden < Failure
    def initialize()
      super("forbidden")
    end
  end

  ## No such cut, release or credential.
  class NotFound < Failure
    def initialize()
      super("not_found")
    end
  end

  ## A malformed request.
  class InvalidRequest < Failure
    def initialize()
      super("invalid_request")
    end
  end

  ## The archive failed `facet verify`.
  class InvalidArchive < Failure
    def initialize()
      super("invalid_archive")
    end
  end

  ## The archive is over the size limit.
  class PayloadTooLarge < Failure
    def initialize()
      super("payload_too_large")
    end
  end

  ## That version is already published with different contents, or was taken down.
  class ReleaseExists < Failure
    def initialize()
      super("release_exists")
    end
  end

  ## An idempotency key was reused for a different upload.
  class IdempotencyConflict < Failure
    def initialize()
      super("idempotency_conflict")
    end
  end

  ## The change would leave a cut with no owner.
  class LastOwner < Failure
    def initialize()
      super("last_owner")
    end
  end
end

