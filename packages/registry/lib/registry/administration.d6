module Registry
  class Administration
    def initialize(db)
      @db = db
      @records = Records.new(db)
      @db.execute("PRAGMA foreign_keys = ON")
      @db.execute("PRAGMA synchronous = FULL")
      @db.execute("PRAGMA busy_timeout = 5000")
    end

    def reason!(reason: String)
      if reason.strip().length() == 0 || reason.length() > 1024 then raise InvalidRequest.new() end
    end

    def authenticate(token: String, scope: String) -> Credential
      credential = @records.active_credential(token)
      if credential == nil then raise Unauthorized.new() end
      if scope != "" && !credential.allows?(scope) then raise Forbidden.new() end
      credential
    end

    def authorize_owners(name: String, token: String) -> Credential
      credential = self.authenticate(token, "")
      unless credential.allows?("admin")
        unless credential.allows?("manage:#{name}") then raise Forbidden.new() end
        cut = @records.cut(name)
        if cut == nil || !@records.owner?(cut.id(), credential.subject()) then raise Forbidden.new() end
      end
      credential
    end

    def owner_rows(cut: Cut) -> Array = @records.owners(cut.id()).map() do |owner| owner.as_json() end

    def owners(name: String, token: String)
      self.authorize_owners(name, token)
      {"protocol": 1, "name": name, "owners": self.owner_rows(@records.cut!(name))}
    end

    def change_owner(name: String, owner: String, action: String, reason: String, token: String)
      self.reason!(reason)
      if owner.strip().length() == 0 || owner.length() > 256 || !["add", "remove"].include?(action)
        raise InvalidRequest.new()
      end
      @records.transaction() do |repo|
        credential = self.authorize_owners(name, token)
        cut = @records.cut!(name)
        present = @records.owner?(cut.id(), owner)
        changed = false
        if action == "add" && !present
          @db.execute("INSERT INTO owners (cut_id, owner, created_at) VALUES (?, ?, ?)", [cut.id(), owner, Time.now().to_i()])
          changed = true
        elsif action == "remove" && present
          if @records.owners(cut.id()).length() == 1 then raise LastOwner.new() end
          @db.execute("DELETE FROM owners WHERE cut_id = ? AND owner = ?", [cut.id(), owner])
          changed = true
        end
        if changed
          @records.audit({"subject": credential.subject(), "action": "owner_#{action}", "cut_name": name, "target_owner": owner,
            "reason": reason, "created_at": Time.now().to_i()}.merge(@records.credential_fields(credential)))
        end
        {"protocol": 1, "name": name, "owners": self.owner_rows(cut)}
      end
    end

    def audit(token: String, after: Int = 0, limit: Int = 50)
      if after < 0 || limit < 1 || limit > 100 then raise InvalidRequest.new() end
      self.authenticate(token, "admin")
      events = @records.audit_page(after, limit + 1)
      next_after = nil
      if events.length() > limit
        events.pop()
        next_after = events[events.length() - 1].id()
      end
      {"protocol": 1, "events": events.map() do |event| event.as_json() end, "next_after": next_after}
    end

    def change(name: String, version: String, action: String, reason: String, token: String)
      self.reason!(reason)
      unless ["yank", "unyank", "takedown"].include?(action) then raise InvalidRequest.new() end
      @records.transaction() do |repo|
        scope = if action == "takedown" then "admin" else "manage:#{name}" end
        credential = self.authenticate(token, scope)
        cut = @records.cut(name)
        if action != "takedown" && (cut == nil || !@records.owner?(cut.id(), credential.subject()))
          raise Forbidden.new()
        end
        release = cut == nil ? nil : @records.release(cut.id(), version)
        if release == nil then raise NotFound.new() end
        changed = false
        if action == "takedown"
          unless release.taken_down?()
            @records.take_down(release, reason)
            changed = true
          end
        else
          if release.taken_down?() then raise NotFound.new() end
          yanked = action == "yank"
          if release.yanked?() != yanked
            @records.set_yanked(release, yanked)
            changed = true
          end
        end
        if changed
          @records.audit({"subject": credential.subject(), "action": action, "cut_name": name, "version": version,
            "sha256": release.sha256(), "reason": reason, "created_at": Time.now().to_i()}.merge(@records.credential_fields(credential)))
        end
        {"protocol": 1, "name": name, "version": version, "taken_down": action == "takedown"}
      end
    end

    def validate_credential(subject: String, scopes: Array, expires: Int, reason: String, operator: String)
      self.reason!(reason)
      if subject.strip().length() == 0 || subject.length() > 256 || operator.strip().length() == 0 || operator.length() > 256 || scopes.length() == 0 || expires <= Time.now().to_i()
        raise InvalidRequest.new()
      end
      scopes.each() do |scope|
        unless scope is String then raise InvalidRequest.new() end
        if scope != "admin"
          parts = scope.split(":")
          if parts.length() != 2 || !["publish", "manage"].include?(parts[0]) then raise InvalidRequest.new() end
          name = parts[1]
          if name.length() == 0 || name.length() > 63 then raise InvalidRequest.new() end
          chars = name.chars()
          index = 0
          while index < chars.length()
            code = chars[index].ord()
            letter = code >= 97 && code <= 122
            if !letter && (index == 0 || !((code >= 48 && code <= 57) || code == 95)) then raise InvalidRequest.new() end
            index += 1
          end
        end
      end
    end

    def revoke_row(credential: Credential, reason: String, operator: String)
      @db.execute("UPDATE credentials SET revoked_at = ? WHERE id = ?", [Time.now().to_i(), credential.id()])
      @records.audit({"subject": operator, "action": "credential_revoke", "reason": reason, "created_at": Time.now().to_i()}
        .merge(@records.credential_fields(credential)))
    end

    # Called only by the local operator CLI, under filesystem access control.
    def issue(subject: String, scopes: Array, expires: Int, reason: String, operator: String, previous: Int = 0)
      self.validate_credential(subject, scopes, expires, reason, operator)
      token = SecureRandom.hex(32)
      @records.transaction() do |repo|
        if previous != 0
          replaced = @records.credential(previous)
          if replaced == nil || replaced.revoked_at() != nil then raise NotFound.new() end
          if replaced.subject() != subject || replaced.scopes() != JSON.stringify(scopes) then raise InvalidRequest.new() end
          self.revoke_row(replaced, reason, operator)
        end
        @db.execute("INSERT INTO credentials (token_digest, subject, scopes, expires_at, created_at) VALUES (?, ?, ?, ?, ?)", [Digest.sha256(token), subject, JSON.stringify(scopes), expires, Time.now().to_i()])
        id = @db.last_insert_row_id()
        @records.audit({"subject": operator, "action": "credential_issue", "reason": reason, "created_at": Time.now().to_i(),
          "credential_id": id, "credential_scopes": JSON.stringify(scopes), "credential_expires_at": expires})
        {"id": id, "token": token, "subject": subject, "scopes": scopes, "expires_at": expires}
      end
    end

    def revoke(id: Int, reason: String, operator: String)
      self.reason!(reason)
      self.reason!(operator)
      if operator.length() > 256 then raise InvalidRequest.new() end
      @records.transaction() do |repo|
        credential = @records.credential(id)
        if credential == nil then raise NotFound.new() end
        if credential.revoked_at() == nil then self.revoke_row(credential, reason, operator) end
        {"id": id, "revoked": true}
      end
    end
  end
end
