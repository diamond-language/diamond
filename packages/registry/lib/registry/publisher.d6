module Registry
  # One connection per worker. Call Schema.apply before constructing this service.
  # Roots and verifier executable are trusted operator configuration.
  class Publisher
    def initialize(db, store, staging: String, verifier: String)
      unless File.directory?(staging) then raise ArgumentError.new("staging directory must exist") end
      @db = db
      @store = store
      @staging = staging
      @verifier = verifier
      @records = Records.new(db)
      @db.execute("PRAGMA foreign_keys = ON")
      @db.execute("PRAGMA synchronous = FULL")
      @db.execute("PRAGMA busy_timeout = 5000")
    end

    # The credential that may publish `name`, refusing a reused key on a different body.
    def authorize(name: String, token: String, key: String, digest: String) -> Credential
      credential = @records.active_credential(token)
      if credential == nil then raise Unauthorized.new() end
      unless credential.allows?("publish:#{name}") then raise Forbidden.new() end
      cut = @records.cut(name)
      if cut != nil && !@records.owner?(cut.id(), credential.subject()) then raise Forbidden.new() end
      if key != ""
        existing = @records.idempotency_key(credential.id(), key)
        if existing != nil && existing.body_sha256() != digest then raise IdempotencyConflict.new() end
      end
      credential
    end

    def verify(name: String, bytes: String, digest: String) -> Archive
      candidate = File.join(@staging, "upload-#{SecureRandom.hex(32)}")
      File.publish(candidate, bytes)
      begin
        Archive.new(@verifier, candidate, name, digest, bytes.length())
      ensure
        File.delete(candidate)
      end
    end

    def publish(name: String, bytes: String, token: String, key: String = "")
      if bytes.length() == 0 || bytes.length() > 58720256 then raise PayloadTooLarge.new() end
      if key.length() > 128 then raise InvalidRequest.new() end
      characters = token.chars()
      index = 0
      while index < characters.length()
        code = characters[index].ord()
        if code <= 32 || code == 127 then raise Unauthorized.new() end
        index += 1
      end
      digest = Digest.sha256(bytes)
      # Refuse early, so a bad credential can't spend a verifier process. Verification holds
      # no lock, so everything it could have changed is checked again under the lock.
      self.authorize(name, token, key, digest)
      archive = self.verify(name, bytes, digest)
      @records.transaction() do |repo|
        credential = self.authorize(name, token, key, digest)
        self.store(name, bytes, digest, key, credential, archive)
      end
    end

    # Runs inside the transaction.
    def store(name: String, bytes: String, digest: String, key: String, credential: Credential, archive: Archive)
      now = Time.now().to_i()
      cut = @records.cut(name)
      if cut == nil
        @db.execute("INSERT INTO cuts (name, created_at) VALUES (?, ?)", [name, now])
        cut = @records.cut(name)
        @db.execute("INSERT INTO owners (cut_id, owner, created_at) VALUES (?, ?, ?)", [cut.id(), credential.subject(), now])
        @records.audit({"subject": credential.subject(), "action": "claim", "cut_name": name, "created_at": now}
          .merge(@records.credential_fields(credential)))
      end
      version = archive.version()
      existing = @records.release(cut.id(), version)
      created = existing == nil
      # New releases must name maintainers; an identical retry of a release
      # published before the requirement remains idempotent.
      if created && !archive.maintainers_listed?() then raise InvalidArchive.new() end
      yanked = false
      if !created
        if existing.sha256() != digest || existing.size() != bytes.length() || existing.taken_down?()
          raise ReleaseExists.new()
        end
        yanked = existing.yanked?()
      end
      # Existing complete blobs can be left by a previous rolled-back attempt.
      # Verify and synchronize them before creating any database reference.
      if @store.contains?(digest)
        unless @store.read(digest) == bytes then raise IOError.new("blob conflict") end
        File.sync(@store.path(digest))
      else
        @store.put(digest, bytes)
      end
      if created
        @db.execute("INSERT INTO releases (cut_id, version, dependencies, maintainers, sha256, size, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)",
          [cut.id(), version, JSON.stringify(archive.dependencies()), JSON.stringify(archive.maintainers()), digest, bytes.length(), now])
        @records.record_details(@db.last_insert_row_id(), archive)
        @records.audit({"subject": credential.subject(), "action": "publish", "cut_name": name, "version": version,
          "sha256": digest, "created_at": now}.merge(@records.credential_fields(credential)))
      end
      if key != ""
        @db.execute("INSERT OR IGNORE INTO idempotency_keys (credential_id, key, body_sha256, created_at) VALUES (?, ?, ?, ?)",
          [credential.id(), key, digest, now])
      end
      {"protocol": 1, "name": name, "version": version, "sha256": digest, "size": bytes.length(), "yanked": yanked, "created": created}
    end

    # Reads display details for releases published before they were recorded. A release whose
    # blob is missing or fails verification is left for the next run and counted as skipped.
    def record_missing_details() -> Hash
      rows = @db.query("SELECT releases.id, cuts.name, releases.sha256, releases.size FROM releases JOIN cuts ON cuts.id = releases.cut_id LEFT JOIN release_details ON release_details.release_id = releases.id WHERE release_details.release_id IS NULL AND releases.takedown_reason IS NULL")
      recorded = 0
      skipped = 0
      rows.each() do |row|
        begin
          @records.record_details(row["id"], Archive.new(@verifier, @store.path(row["sha256"]), row["name"], row["sha256"], row["size"]))
          recorded += 1
        rescue error: StandardError
          skipped += 1
        end
      end
      {"recorded": recorded, "skipped": skipped}
    end
  end
end
