module GraphQL

  # `resolve`, when present, is a Callable[3] -- `(object, args, context)`.
  # A nil resolver asks the executor to call the field's own name as a public,
  # zero-argument method on the runtime object. Fields that need arguments,
  # context, name translation, or Hash lookup still provide an explicit
  # resolver.
  class Field
    attr_reader name
    attr_reader type
    attr_reader resolve
    attr_reader arguments
    attr_reader description
    # AppliedDirective values from SDL (`@auth(as: PLAYER)`), in source order.
    attr_reader directives

    def initialize(name, type, resolve = nil, arguments = [], description = nil, directives = [])
      @name = name
      @type = type
      @resolve = resolve
      @arguments = arguments
      @description = description
      @directives = directives
    end

    # Replaces the resolver (GraphQL::App installs one on every field it builds) and returns the field.
    def bind(resolve)
      @resolve = resolve
      self
    end

    # The applied directive called `directive_name`, or nil.
    def directive(directive_name)
      @directives.find() do |candidate|
        candidate.name() == directive_name
      end
    end

    # nil if this field has no argument by that name.
    def argument(arg_name)
      @arguments.find() do |candidate|
        candidate.name() == arg_name
      end
    end
  end

end
