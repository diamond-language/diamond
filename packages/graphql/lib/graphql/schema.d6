module GraphQL

  # `GraphQL::Schema.new().query(query_type).mutation(mutation_type)` --
  # this phase is just the builder shell (query/mutation registration +
  # the type-registry walk needed later for introspection); `.execute`
  # lives in a later phase once the language/execution layers exist.
  ## A schema: `GraphQL::Schema.new().query(QueryType).mutation(MutationType)`.
  class Schema
    def initialize()
      @query_type = nil
      @mutation_type = nil
      @mask_errors = true
      @max_query_depth = 20
      @max_query_nodes = 10000
      @directives = []
    end

    ## Builds a schema from GraphQL SDL text: object, interface, union, enum, input
    ## and scalar types, directive definitions, descriptions, and directives applied
    ## to field definitions. Fields have no resolvers, so each resolves to the
    ## parent object's method of the same name. A custom scalar passes values
    ## through unchanged. Raises `SchemaError` naming the problem and its line.
    def self.from_sdl(source: String) = GraphQL::SchemaParser.build(source)

    ## Registers a `DirectiveDefinition` and returns the schema.
    def directive(definition)
      @directives << definition
      self
    end

    ## The registered `DirectiveDefinition` values, in the order they were added.
    def directives() = @directives

    ## The directive definition called `name`, or `nil`.
    def directive_named(name)
      @directives.find() do |definition|
        definition.name() == name
      end
    end

    ## Sets the query root type and returns the schema.
    def query(type)
      @query_type = type
      self
    end

    ## Sets the mutation root type (optional) and returns the schema.
    def mutation(type)
      @mutation_type = type
      self
    end

    # An exception a resolver raises other than GraphQL::ExecutionError reaches the client as "Internal server error" (its real message can
    # hold SQL, file paths or other internals) and is written to stderr; `schema.mask_errors(false)` sends the message instead, for development.
    ## By default (`true`) an exception from a resolver other than `ExecutionError`
    ## reaches the client as `"Internal server error"`, with the real message written
    ## to stderr. `mask_errors(false)` sends the real message, for development.
    ## Returns the schema.
    def mask_errors(flag)
      @mask_errors = flag
      self
    end

    def mask_errors?() = @mask_errors

    # Limits on a query once its fragments are expanded: the deepest field nesting and the number of fields. A document is rejected before it is
    # validated or executed when it exceeds either.
    ## With a limit, sets the deepest field nesting a query may reach once fragments
    ## are expanded (default 20) and returns the schema; without one, returns the
    ## current limit. A deeper document is rejected before it runs.
    def max_query_depth(limit = nil)
      @max_query_depth = limit unless limit == nil
      if limit == nil then @max_query_depth else self end
    end

    ## With a limit, sets how many fields a query may select once fragments are
    ## expanded (default 10,000) and returns the schema; without one, returns the
    ## current limit.
    def max_query_nodes(limit = nil)
      @max_query_nodes = limit unless limit == nil
      if limit == nil then @max_query_nodes else self end
    end

    def query_type() = @query_type
    def mutation_type() = @mutation_type

    # The named type a List/NonNull wrapper ultimately refers to --
    # unwraps any number of wrapper layers.
    def self.unwrap(type)
      if type.kind() == "LIST" || type.kind() == "NON_NULL"
        self.unwrap(type.of_type())
      else
        type
      end
    end

    def self.visit_arguments(arguments, visited)
      arguments.each() do |argument|
        self.visit(argument.type(), visited)
      end
      nil
    end

    def self.visit_fields(fields, visited)
      fields.each() do |field|
        self.visit(field.type(), visited)
        self.visit_arguments(field.arguments(), visited)
      end
      nil
    end

    # Registers `type` (unwrapped to its named form) into `visited` and
    # recurses into everything it references -- field return types, field
    # argument types, interface implementations, union member types,
    # input object field types. `visited` (keyed by type name) doubles as
    # the cycle guard: a type already registered is never re-walked, so a
    # cyclic graph (Author -> books -> Book -> author -> Author) still
    # terminates.
    def self.visit(type, visited)
      named = self.unwrap(type)
      name = named.name()
      if visited[name] != nil
        return nil
      end
      visited[name] = named
      kind = named.kind()
      if kind == "OBJECT"
        self.visit_fields(named.fields(), visited)
        named.interfaces().each() do |iface|
          self.visit(iface, visited)
        end
      elsif kind == "INTERFACE"
        self.visit_fields(named.fields(), visited)
        named.implementors().each() do |implementor|
          self.visit(implementor, visited)
        end
      elsif kind == "UNION"
        named.possible_types().each() do |possible_type|
          self.visit(possible_type, visited)
        end
      elsif kind == "INPUT_OBJECT"
        self.visit_arguments(named.arguments(), visited)
      end
      nil
    end

    # Every type reachable from the query/mutation roots or a directive definition's arguments, keyed by name.
    ## Every type reachable from the root types or a directive's arguments, keyed by name.
    def type_map()
      visited = {}
      unless @query_type == nil
        Schema.visit(@query_type, visited)
      end
      unless @mutation_type == nil
        Schema.visit(@mutation_type, visited)
      end
      @directives.each() do |definition|
        Schema.visit_arguments(definition.arguments(), visited)
      end
      visited
    end

    def types() = self.type_map()

    # The schema as SDL text (see GraphQL::SchemaPrinter).
    ## The schema as GraphQL SDL text: types in name order, built-in scalars left out,
    ## descriptions as block strings.
    def to_sdl() = GraphQL::SchemaPrinter.print(self)

    # `Schema.new().query(query_type).execute(query_string)` -- a fresh
    # `GraphQL::Execution::Executor` per call (see executor.d6's own
    # header comment for why: no state to reset between requests, no
    # shared mutable state to worry about). Returns `{"data": ...}`, or
    # `{"data": ..., "errors": [...]}` when at least one field errored,
    # or just `{"errors": [...]}` (no `"data"` key at all) for a
    # request-level failure -- an unparseable document, an unknown
    # operation, a variable/argument that doesn't coerce -- per spec.
    ## Runs `query_string` and returns a Hash: `{"data": ...}`, `{"data": ...,
    ## "errors": [...]}` when some fields failed, or `{"errors": [...]}` with no
    ## `"data"` for a request-level failure (a parse error, unknown operation, or a
    ## variable or argument that doesn't coerce). `context` is passed to every
    ## resolver; the executor adds `"dataloader"` and `"lookahead"` to it.
    def execute(query_string, raw_variables = {}, context = {}, root_value = nil, operation_name = nil)
      GraphQL::Execution::Executor.new(self).execute(query_string, raw_variables, context, root_value, operation_name)
    end
  end

end

