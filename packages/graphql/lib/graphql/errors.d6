module GraphQL

  # Raised by a resolver to produce a specific, client-visible field
  # error message (rather than a generic "internal error" for whatever
  # StandardError the resolver happened to raise) -- the one error class
  # this package expects application code to reach for directly. Caught
  # by the executor at the same point any other resolver exception is
  # caught; distinguished only so a resolver can choose its own message
  # with intent instead of it being an implementation-detail leak.
  # `extensions` is an optional Hash returned to the client under the
  # error's "extensions" key (the spec's place for things like a code).
  ## Raise from a resolver to return this message to the client for that field.
  ## `extensions` is returned under the error's `"extensions"` key (omitted when
  ## empty):
  ## `raise GraphQL::ExecutionError.new("invalid password", {"code": "UNAUTHENTICATED"})`.
  class ExecutionError < StandardError
    attr_reader message: String
    attr_reader extensions: Hash
    def initialize(message: String, extensions: Hash = {})
      @message = message
      @extensions = extensions
    end
  end

  # Raised for a request-level problem the executor can't attribute to
  # one field -- an unparseable document, an unknown operation name, a
  # missing required variable, a variable/argument that doesn't coerce
  # against its declared type. Schema#execute catches this at the top
  # and turns it into the request-level `{"errors": [...]}` shape (no
  # `"data"` key at all, per spec -- distinct from a field-level error,
  # which still returns partial `"data"` alongside its own error entry).
  ## A request-level failure that `Schema#execute` turns into `{"errors": [...]}`.
  ## Errors with a machine-readable code, so a client branches on the code and never on
  ## the message: `GraphQL::Fail.signal("NOT_FOUND", "no such board")` reaches the client
  ## as `{"message": "no such board", "extensions": {"code": "NOT_FOUND"}}`.
  module Fail
    ## Raises an `ExecutionError` carrying `code` in its extensions.
    def self.signal(code, message)
      raise GraphQL::ExecutionError.new(message, {"code": code})
    end

    ## The code an `ExecutionError` carries, or `"INTERNAL"` when it has none.
    def self.code(error) = error.extensions()["code"] || "INTERNAL"

    ## Gives every error in an `execute` result a code and returns the result: errors
    ## raised through `signal` keep theirs, others get `"INTERNAL"`, or `"BAD_REQUEST"`
    ## when the whole request was rejected (the result has no `"data"`).
    def self.annotate(result)
      errors = result["errors"]
      if errors == nil then return result end
      request_level = !result.key?("data")
      result["errors"] = errors.map() do |error|
        if error.key?("extensions")
          error
        else
          error.merge({"extensions": {"code": if request_level then "BAD_REQUEST" else "INTERNAL" end}})
        end
      end
      result
    end
  end

  class RequestError < StandardError
    attr_reader message: String
    def initialize(message: String)
      @message = message
    end
  end

end

