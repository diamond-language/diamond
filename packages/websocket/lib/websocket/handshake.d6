# Server-side RFC 6455 handshake: recognizing a genuine WebSocket
# upgrade request (already parsed the ordinary way, by packages/http's
# own http_parse_request -- an upgrade request is a perfectly normal GET
# with a few extra headers, nothing about parsing it is special) and
# answering it with the raw 101 response bytes, written directly to the
# connection rather than through http_write_response -- see
# packages/gremlin/lib/gremlin.d6's own "Escape hatch: taking over the
# raw connection" doc comment for why a handler needs to do that at all.

# RFC 6455 section 1.3's fixed GUID, concatenated onto the client's own
# Sec-WebSocket-Key before hashing. Not a secret -- a fixed magic value
# the spec uses so the computed Sec-WebSocket-Accept could only have
# come from a server that actually understands the WebSocket protocol,
# not a cache or proxy blindly echoing the request back.
def websocket_guid() = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

# Digest.sha1 returns a 40-character lowercase hex string (docs/
# collections.md), not the 20 raw bytes the handshake's own
# Base64.encode step needs -- and String#to_i is base-10 only, so
# there's no native radix parse to lean on. Small enough to hand-roll
# rather than pull in a general base-N parser for one call site --
# packages/http/lib/http/client.d6's http_parse_hex hand-rolls the same
# underlying hex-digit-value gap for chunked-encoding sizes.
def websocket_hex_digit_value(ch)
  code = ch.ord()
  if code >= 48 && code <= 57
    code - 48
  elsif code >= 97 && code <= 102
    code - 97 + 10
  elsif code >= 65 && code <= 70
    code - 65 + 10
  else
    raise IOError.new("invalid hex digit in WebSocket handshake key")
  end
end

def websocket_hex_to_bytes(hex)
  sb = StringBuilder.new()
  index = 0
  while index < hex.length()
    high = websocket_hex_digit_value(hex[index])
    low = websocket_hex_digit_value(hex[index + 1])
    sb.append(chr(high * 16 + low))
    index = index + 2
  end
  sb.to_s()
end

# RFC 6455 section 4.2.2, step 5.2: Base64(SHA1(key + GUID)).
def websocket_accept_key(client_key)
  digest_hex = Digest.sha1(client_key + websocket_guid())
  Base64.encode(websocket_hex_to_bytes(digest_hex))
end

# The header check every real client sends (RFC 6455 sections 4.1/4.2.1):
# `Upgrade: websocket` and a `Connection` header naming "upgrade" as one
# of (possibly several, comma-separated) tokens, both matched case-
# insensitively, plus a present Sec-WebSocket-Key -- its actual random
# bytes don't need validating here, only that the client sent one at
# all, since websocket_accept_key below fails loudly (a raised error,
# not a wrong-but-silent Accept value) on anything that isn't a real
# hex-digest-shaped key. Deliberately does not require
# Sec-WebSocket-Version == "13": a version mismatch is a real client
# bug worth surfacing, but rejecting on a missing/malformed Upgrade or
# Connection header (indicating this isn't a WebSocket request at all)
# is the check that actually matters for routing -- a handler decides
# whether to even attempt the handshake based on this function alone.
## Whether a request Hash asks to upgrade to WebSocket: `Upgrade: websocket`, a
## `Connection` header containing `upgrade`, and a `Sec-WebSocket-Key`.
def websocket_upgrade_request?(request)
  headers = request["headers"]
  upgrade = headers["upgrade"]
  connection = headers["connection"]
  key = headers["sec-websocket-key"]
  if upgrade == nil || connection == nil || key == nil
    return false
  end
  if upgrade.downcase() != "websocket"
    return false
  end
  if connection.downcase().index_of("upgrade") == nil
    return false
  end
  true
end

def websocket_handshake_response_bytes(request)
  accept_key = websocket_accept_key(request["headers"]["sec-websocket-key"])
  "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: #{accept_key}\r\n\r\n"
end

# The one call an application handler needs: given
# request["gremlin_connection"] and the already-parsed request, writes
# the 101 response directly to `conn` and returns a fresh
# WebSocketConnection wrapping it for the framed read/write lifetime of
# this connection from here on.
#
# Raises ArgumentError if `request` isn't really a WebSocket upgrade --
# a programmer error, not a client's fault: a real caller is expected to
# have already checked websocket_upgrade_request?(request) before ever
# reaching this point (matching e.g. packages/multipart's own
# multipart_save_file "caller already checked" contracts), and route on
# the result the same way an ordinary [status, headers, body] response
# would be chosen instead.
## Answers the upgrade on `conn` (with gremlin, `request["gremlin_connection"]`) and
## returns a `WebSocketConnection`. The handler then returns `nil` instead of a response.
def websocket_accept(conn, request)
  unless websocket_upgrade_request?(request)
    raise ArgumentError.new("websocket_accept called on a request that is not a WebSocket upgrade")
  end
  conn.write(websocket_handshake_response_bytes(request))
  # A WebSocket outlives the request deadline gremlin_serve(limits: ...) sets; connections without that method (a test double) have none.
  begin
    conn.clear_deadline()
  rescue error: StandardError
    nil
  end
  WebSocketConnection.new(conn)
end


## Whether a browser may open this WebSocket: the request's `Origin` must be one of
## `allowed` (origins such as `"https://example.com"`) or, without `allowed`, name the same
## host as its `Host` header over `http://` or `https://`. A WebSocket upgrade carries
## cookies but no CSRF token, so check this before `websocket_accept`. A request with no
## `Origin` (not from a browser) is allowed.
def websocket_origin_allowed?(request, allowed = nil)
  origin = request["headers"]["origin"]
  return true if origin == nil
  return allowed.include?(origin) if allowed != nil
  host = request["headers"]["host"]
  host != nil && (origin == "http://#{host}" || origin == "https://#{host}")
end

# Splits a ws:// or wss:// URL into [tls, host, port, authority, path]. The
# authority (host, and port when given) is what the Host header carries.
def websocket_split_url(url)
  tls = false
  rest = nil
  if url.start_with?("ws://")
    rest = url.slice(5, url.length() - 5)
  elsif url.start_with?("wss://")
    tls = true
    rest = url.slice(6, url.length() - 6)
  else
    raise ArgumentError.new("WebSocket URL must start with ws:// or wss://: #{url}")
  end
  slash = rest.index_of("/")
  authority = if slash == nil then rest else rest.slice(0, slash) end
  path = if slash == nil then "/" else rest.slice(slash, rest.length() - slash) end
  host = authority
  port_text = nil
  if authority.start_with?("[")
    close = authority.index_of("]")
    raise ArgumentError.new("WebSocket URL has an unterminated IPv6 address: #{url}") if close == nil
    host = authority.slice(1, close - 1)
    after = authority.slice(close + 1, authority.length() - close - 1)
    port_text = after.slice(1, after.length() - 1) if after.start_with?(":")
  else
    colon = authority.index_of(":")
    if colon != nil
      host = authority.slice(0, colon)
      port_text = authority.slice(colon + 1, authority.length() - colon - 1)
    end
  end
  raise ArgumentError.new("WebSocket URL has no host: #{url}") if host.empty?()
  port = if tls then 443 else 80 end
  if port_text != nil
    port = port_text.to_i()
    raise ArgumentError.new("WebSocket URL has a bad port: #{url}") if port < 1 || port > 65535 || port.to_s() != port_text
  end
  [tls, host, port, authority, path]
end

## Connects to a `ws://` or `wss://` URL and returns a client `WebSocketConnection`
## (`send_text`, `receive`, `close` as on the server side). `headers` adds request
## headers, such as `{"Origin": "https://example.com"}` or a `Cookie`; `options` goes to
## `TCPSocket.connect` or `TLSSocket.connect` (timeouts, CA files). Raises `IOError` if the
## server does not accept the upgrade.
def websocket_connect(url, headers = {}, options = nil)
  [tls, host, port, authority, path] = websocket_split_url(url)
  socket = if tls then TLSSocket.connect(host, port, options) else TCPSocket.connect(host, port, options) end
  key = Base64.encode(SecureRandom.bytes(16))
  request = StringBuilder.new()
  request.append("GET #{path} HTTP/1.1\r\nHost: #{authority}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n")
  request.append("Sec-WebSocket-Key: #{key}\r\nSec-WebSocket-Version: 13\r\n")
  headers.each() do |name, value|
    request.append("#{name}: #{value}\r\n")
  end
  request.append("\r\n")
  begin
    socket.write(request.to_s())
    socket.flush() if socket is File
    # The response head, a byte at a time so no frame bytes after it are taken.
    head = StringBuilder.new()
    length = 0
    tail = ""
    while tail != "\r\n\r\n"
      byte = socket.read(1)
      raise IOError.new("WebSocket server closed the connection during the handshake") if byte == nil || byte.empty?()
      length += 1
      raise IOError.new("WebSocket handshake response head is over 16384 bytes") if length > 16384
      head.append(byte)
      tail = (tail + byte)
      tail = tail.slice(tail.length() - 4, 4) if tail.length() > 4
    end
    lines = head.to_s().split("\r\n")
    status = lines[0]
    unless status.start_with?("HTTP/1.1 101")
      raise IOError.new("WebSocket server refused the upgrade: #{status}")
    end
    accept = nil
    lines.each() do |line|
      colon = line.index_of(":")
      if colon != nil && line.slice(0, colon).strip().downcase() == "sec-websocket-accept"
        accept = line.slice(colon + 1, line.length() - colon - 1).strip()
      end
    end
    unless accept == websocket_accept_key(key)
      raise IOError.new("WebSocket server answered with a wrong Sec-WebSocket-Accept")
    end
  rescue error: IOError
    socket.close()
    raise error
  end
  WebSocketConnection.new(socket, websocket_max_message_size(), client: true)
end
