# Drives tls_test.d6: hermetic TLS handshake success, identity checks and cancellation cleanup.
#
#   diamond tls_driver.d6 PROGRAM...
require "../../../tests/harness"

command = ARGV

# Whatever the peer has sent so far (non-blocking sockets raise when there is nothing yet, so
# this polls first); "" or nil when the peer closed, and nil on timeout.
def read_available(socket, timeout_ms)
  ready = IO.poll([socket], [], timeout_ms)
  return nil unless ready["readable"][0]
  chunk = socket.read(65536)
  chunk == nil ? "" : chunk
end

# Reads until the peer closes, within `timeout_ms`.
def drain(socket, timeout_ms)
  deadline = Time.monotonic() + timeout_ms / 1000.0
  loop do
    return nil if Time.monotonic() > deadline
    chunk = read_available(socket, 100)
    return nil if chunk == ""
  end
end

def accept_within(listener, timeout_ms)
  ready = IO.poll([listener], [], timeout_ms)
  raise "no client connected within #{timeout_ms}ms" unless ready["readable"][0]
  listener.accept()
end

work = Process.run(["mktemp", "-d"]).stdout().strip()
begin
  [["good", "DNS:localhost,IP:127.0.0.1"], ["wrong", "DNS:wrong.test"]].each() do |pair|
    made = Process.run(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "1",
      "-subj", "/CN=TLS test", "-addext", "subjectAltName=#{pair[1]}",
      "-keyout", "#{work}/#{pair[0]}.key", "-out", "#{work}/#{pair[0]}.pem"])
    raise "cannot make a test certificate: #{made.stderr()}" unless made.success?()
  end

  modes = ["success", "ip", "raw", "pending", "untrusted", "wronghost", "deadline", "cancel",
           "signal", "signal_error", "pre", "leaks", "validation", "setup_error"]
  shim = "#{work}/resolver.so"
  built = Process.run([ENV["CC"] == nil || ENV["CC"] == "" ? "cc" : ENV["CC"], "-shared", "-fPIC",
    "-o", shim, "test/resolver_shim.c", "-ldl"])
  if built.success?()
    modes.push("budget")
  else
    puts("resolver shim unavailable; skipping budget: #{built.stderr()}")
  end

  modes.each() do |mode|
    cert = mode == "wronghost" ? "wrong" : "good"
    handshakes = ["success", "ip", "raw", "validation", "untrusted", "wronghost"]
    listener = nil
    if handshakes.include?(mode)
      listener = TLSServer.listen(0, "#{work}/#{cert}.pem", "#{work}/#{cert}.key",
        {"alpn": ["diamond-test"]})
    else
      listener = TCPServer.listen_nonblocking(0, host: "127.0.0.1")
    end
    env = {"DIAMOND_NO_CACHE": "1"}
    if mode == "budget"
      parts = []
      prefix = ENV["DNS_TEST_PRELOAD_PREFIX"]
      parts.push(prefix) if prefix != nil && prefix != ""
      parts.push(shim)
      existing = ENV["LD_PRELOAD"]
      parts.push(existing) if existing != nil && existing != ""
      env["LD_PRELOAD"] = parts.join(":")
    end
    child = Harness::Child.new(command + [listener.port().to_s(), "#{work}/#{cert}.pem", mode], env)
    begin
      if mode == "leaks"
        child.line("baseline", 10000)
        baseline = Harness.descriptor_count(child.pid())
        child.send("go\n")
        20.times() do |i|
          peer = accept_within(listener, 10000)
          drain(peer, 5000)
          peer.close()
        end
        child.line("no leaks", 10000)
        if baseline != nil && Harness.descriptor_count(child.pid()) != baseline
          raise "cancelled handshakes leaked descriptors"
        end
        child.send("go\n")
      elsif mode != "pre"
        if handshakes.include?(mode)
          ready = IO.poll([listener], [], 10000)
          raise "no client connected" unless ready["readable"][0]
          accepted = true
          tls = nil
          begin
            tls = listener.accept()
          rescue error: IOError
            # The client rejected the certificate and tore the handshake down.
            raise error unless mode == "untrusted" || mode == "wronghost"
            accepted = false
          end
          if accepted
            raise "an invalid certificate was accepted" unless ["success", "ip", "raw", "validation"].include?(mode)
            expected_name = mode == "ip" ? nil : "localhost"
            raise "unexpected SNI name #{tls.server_name().inspect()}" unless tls.server_name() == expected_name
            raise "client did not send hello" unless tls.read(5) == "hello"
            tls.write("world")
            tail = tls.read(1)
            raise "caller failed to close the TLS connection" unless tail == nil || tail == ""
            tls.close()
          end
        elsif mode == "setup_error"
          peer = accept_within(listener, 10000)
          closed = read_available(peer, 10000)
          raise "setup failure leaked the transferred descriptor" unless closed == ""
          peer.close()
        else
          peer = accept_within(listener, 10000)
          # The ClientHello is observed before signalling: the handler is installed and the
          # client is inside the pending handshake.
          first = read_available(peer, 10000)
          raise "no ClientHello" if first == nil || first == ""
          child.terminate() if mode == "signal" || mode == "signal_error"
          drain(peer, 10000)
          peer.close()
        end
      end
      expected = ["success", "ip", "raw", "validation"].include?(mode) ? "success" :
        ["untrusted", "wronghost", "setup_error"].include?(mode) ? "certificate rejected" :
        (mode == "deadline" || mode == "budget") ? "deadline" :
        mode == "signal_error" ? "signal error" :
        mode == "pending" ? "pending" : "cancelled"
      child.line(expected, 10000) unless mode == "leaks"
      child.line("cleaned", 10000)
      raise "#{mode}: unclean exit" unless child.wait() == 0
    rescue error
      puts("TLS scenario #{mode}: #{child.errors()}")
      raise error
    ensure
      child.finish()
      listener.close()
    end
  end
ensure
  Process.run(["rm", "-rf", work])
end
puts("cancellation TLS handshake tests passed")
exit(0)
