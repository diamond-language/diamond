# CSRF protection via the synchronizer-token pattern, built on
# CookieSession's own request["session"] -- must run *after*
# CookieSession in the middleware chain (rack_compose([CookieSession.call,
# Csrf.call], app_handler)), the same ordering requirement any session-
# dependent middleware has. `.token(request)` lazily mints one 256-bit
# token per session (SecureRandom.hex(32)) and stores it in the session, so
# it survives across requests the same way the session itself does -- call
# it from your own template/handler code to get the value to embed in a
# form (as a hidden `csrf_token` field, such as div's
# `Div.hidden_field_tag("csrf_token", token)`) or hand to client-side JS (to
# echo back as the X-CSRF-Token header).
#
# `.call` ensures a token exists on every request (so the very first GET
# that renders a form already has one to embed), skips the check for the
# three methods that must never carry a state-changing side effect
# (GET/HEAD/OPTIONS), and otherwise requires the token -- from the
# X-CSRF-Token header, or else a `csrf_token` field of a urlencoded or
# multipart form body -- to match the session's via constant_time_equal,
# rejecting with 403 if it's missing or doesn't match. The field is read
# here rather than through core URI so the cut keeps working on runtimes
# older than URI; the token is hex, so it needs no percent-decoding.
## CSRF protection for `CookieSession` apps.
class Csrf
  ## The session's CSRF token, created on first use. Put it in pages that submit forms.
  def self.token(request)
    token = request["session"]["csrf_token"]
    if token == nil
      token = SecureRandom.hex(32)
      request["session"]["csrf_token"] = token
    end
    token
  end

  ## Whether `submitted` matches the session's token.
  def self.valid?(request, submitted)
    token = request["session"]["csrf_token"]
    if token == nil || submitted == nil
      false
    else
      constant_time_equal(token, submitted)
    end
  end

  ## The token a request sent: its `x-csrf-token` header, or else the `csrf_token`
  ## field of an `application/x-www-form-urlencoded` or `multipart/form-data` body.
  def self.submitted(request)
    header = request["headers"]["x-csrf-token"]
    return header if header != nil
    body = request["body"]
    return nil if body == nil
    content_type = (request["headers"]["content-type"] || "").downcase()
    if content_type.start_with?("application/x-www-form-urlencoded")
      found = nil
      body.split("&").each() do |pair|
        found = pair.slice(11, pair.length() - 11) if found == nil && pair.start_with?("csrf_token=")
      end
      found
    elsif content_type.start_with?("multipart/form-data")
      # The part browsers send for <input type="hidden" name="csrf_token">.
      marker = "form-data; name=\"csrf_token\"\r\n\r\n"
      start = body.index_of(marker)
      return nil if start == nil
      rest = body.slice(start + marker.length(), body.length() - start - marker.length())
      stop = rest.index_of("\r\n")
      stop == nil ? nil : rest.slice(0, stop)
    else
      nil
    end
  end

  ## Middleware: lets `GET`, `HEAD` and `OPTIONS` through and answers 403 to any other
  ## request without the session's token, in an `x-csrf-token` header or a
  ## `csrf_token` form field.
  def self.call(request, context, forward)
    Csrf.token(request)
    if ["GET", "HEAD", "OPTIONS"].include?(request["method"])
      return forward(request, context)
    end
    if Csrf.valid?(request, Csrf.submitted(request))
      forward(request, context)
    else
      [403, {"Content-Type": "text/plain"}, "invalid or missing CSRF token"]
    end
  end
end
