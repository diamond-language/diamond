{
  "name": "diamond-language",
  "displayName": "d6",
  "description": "Syntax highlighting and language server diagnostics/hover/go-to-definition/outline for the d6 programming language",
  "version": "0.7.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:diamond", "onLanguage:diamond-template"],
  "contributes": {
    "languages": [
      {
        "id": "diamond",
        "aliases": ["d6", "diamond"],
        "extensions": [".d6"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "diamond-template",
        "aliases": ["d6 Template"],
        "extensions": [".div"]
      }
    ],
    "grammars": [
      {
        "language": "diamond",
        "scopeName": "source.diamond",
        "path": "./syntaxes/diamond.tmLanguage.json"
      },
      {
        "language": "diamond-template",
        "scopeName": "text.html.div",
        "path": "./syntaxes/diamond-template.tmLanguage.json",
        "embeddedLanguages": {
          "source.diamond": "diamond"
        }
      }
    ],
    "configuration": {
      "title": "d6",
      "properties": {
        "diamond.languageServerPath": {
          "type": "string",
          "default": "d6-lsp",
          "description": "Path to the d6-lsp binary (built via `make lsp`). Defaults to looking it up on PATH."
        },
        "diamond.debugAdapterPath": {
          "type": "string",
          "default": "d6-dap",
          "description": "Path to the d6-dap binary (built via `make dap`). Defaults to looking it up on PATH."
        }
      }
    },
    "commands": [
      {
        "command": "diamond.restartLanguageServer",
        "title": "d6: Restart Language Server"
      }
    ],
    "debuggers": [
      {
        "type": "diamond",
        "label": "d6",
        "languages": ["diamond"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the d6 (.d6) script to run.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "Command-line arguments passed to the program, available to it as ARGV.",
                "items": { "type": "string" },
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the launched program.",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "diamond",
            "request": "launch",
            "name": "Debug d6 File",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "d6: Launch",
            "description": "Launch and debug the currently open d6 file",
            "body": {
              "type": "diamond",
              "request": "launch",
              "name": "Debug d6 File",
              "program": "^\"${1:\\${file\\}}\""
            }
          }
        ]
      }
    ]
  }
}
