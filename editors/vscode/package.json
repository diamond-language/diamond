{
  "name": "diamond-language",
  "displayName": "Diamond",
  "description": "Syntax highlighting for the Diamond programming language",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "diamond",
        "aliases": ["Diamond", "diamond"],
        "extensions": [".di"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "diamond",
        "scopeName": "source.diamond",
        "path": "./syntaxes/diamond.tmLanguage.json"
      }
    ]
  }
}
