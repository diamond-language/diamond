require "lexer"

# Self-hosting Phase 3: a Diamond-language port of src/compiler.c's
# single-pass parser. Uses selfhost/lexer.d6 for tokenizing and the
# native ProgramBuilder bridge to emit and run real bytecode. Built incrementally, sub-phase by
# sub-phase:
#
#   Sub-phase 1 ("expression evaluator core"): literals, arithmetic/
#   comparison/logical expressions, local variables, if/while/loop/break.
#
#   Sub-phases 2-5 extend that core with named functions and closures,
#   classes and interfaces, typed and generic declarations, collection
#   literals and indexing, namespaces/modules and `require`, and exception
#   handling. The differential corpus in tests/parser_cases records the
#   exact supported surface and grows with each slice.
#
# Deliberately narrower than the eventual full port throughout:
#   - Unsupported constructs fail explicitly; the port must never silently
#     accept a construct it cannot lower with native-compiler semantics.
#   - No compile-time `_INT` opcode quickening (compiler.c's own
#     `known_types` optimization): every arithmetic/comparison opcode
#     emitted here is the generic form (ADD, not ADD_INT), which is
#     always correct and only foregoes a speed optimization the VM would
#     otherwise apply lazily at runtime via the interpreter's own
#     quickening (`DIAMOND_QUICKEN`) instead.
#   - Remaining grammar and semantic gaps are added as independently
#     differential-tested slices.
#
# The opcode constants below must exactly match src/vm.h's DiamondOpCode
# enum ordinals -- this file and the VM only ever need to agree the same
# way compiler.c and vm.c already implicitly do. Verified against a
# real `sizeof`/enum-dump each time this file is touched, not hand-counted.
# Opcode constants are grouped in a namespace and read as `Opcode::NAME`.
module Opcode
  CONSTANT = 0
  STRING = 1
  SYMBOL = 2
  NIL = 3
  BOOL = 4
  MOVE = 5
  ADD = 6
  SUBTRACT = 8
  MULTIPLY = 9
  DIVIDE = 10
  LESS = 14
  LESS_EQUAL = 15
  GREATER = 16
  GREATER_EQUAL = 17
  NEGATE = 18
  EQUAL = 19
  NOT_EQUAL = 20
  JUMP = 27
  CALL = 29
  CALL_TYPED = 30
  JUMP_IF_FALSE = 28
  CLOSURE = 31
  CALL_CLOSURE = 32
  # DIAMOND_OP_CALL_CLOSURE_KEYWORDS: a direct call that skips a defaulted parameter; keep in step with src/vm.h.
  CALL_CLOSURE_KEYWORDS = 152
  INVOKE_KEYWORDS = 150
  NEW_KEYWORDS = 153
  NEW_TYPED = 187
  TAIL_CALL = 171
  ARGV = 103
  ENV = 104
  CALL_TYPED_SPREAD = 145
  INVOKE_TYPED_KEYWORDS = 151
  GET_CAPTURE = 33
  GET_CAPTURE_CELL = 34
  BOX_LOCAL = 36
  GET_CELL = 37
  SET_CELL = 38
  NEW = 39
  INVOKE = 40
  INVOKE_TYPED = 42
  SUPER = 43
  GET_IVAR = 44
  SET_IVAR = 45
  CHECK_TYPE = 50
  ARRAY = 51
  INDEX_GET = 52
  INDEX_SET = 53
  CHECK_DESTRUCTURE_COUNT = 95
  COLLECT_VARIADIC = 129
  CALL_SPREAD = 130
  INVOKE_SPREAD = 140
  INVOKE_TYPED_SPREAD = 146
  CALL_CLOSURE_SPREAD = 141
  NEW_SPREAD = 142
  BUILD_SPREAD_ARGS = 144
  LOAD_CLASS = 110
  HASH_REST = 136
  ARRAY_MIDDLE = 137
  ARRAY_SUFFIX = 138
  CHECK_HASH_KEY = 139
  HASH = 54
  NOT = 55
  JUMP_IF_TRUE = 56
  RETURN = 57
  RAISE = 58
  PUSH_RESCUE = 59
  POP_RESCUE = 60
  PUSH_ENSURE = 61
  RUN_ENSURE = 62
  END_ENSURE = 63
  IS_TYPE = 64
  ARGUMENT_PROVIDED = 65
  TO_STRING = 66
  YIELD = 67
  REDEFINE_METHOD = 68
  FIBER_NEW = 69
  PRINT = 70
  GETS = 71
  FILE_OPEN = 72
  # DIAMOND_OP_FILE_DELETE (File.delete's own native addition, landed
  # 2026-08-31) was inserted directly after FILE_OPEN in the real enum --
  # not a construct this self-hosted parser emits, so it gets no entry
  # of its own here, but it silently shifted every single opcode number
  # below by 1, TCP_CONNECT through COMPARE, on the very same day the
  # MODULO/COMPARE fix above landed (and after it, so that fix's own
  # verification never saw this). Exactly the class of bug both that fix
  # and the "Widened function indices" self-hosting slice already warn
  # about -- caught here by bisecting a real CI
  # regression (a firsthand Ubuntu 26.04 + Clang portability pass
  # restored CI far enough to actually run test-self-host-smoke for the
  # first time in 13+ days) down to this commit, then re-verifying every
  # single value below with the same throwaway C probe technique against
  # src/vm.h rather than adjusting the stale ones by hand.
  TCP_CONNECT = 74
  TCP_LISTEN = 75
  # 76-82 are UDP_BIND, UDP_OPEN, SIGNAL_TRAP, TLS_CONNECT, and TLS_LISTEN
  # in src/vm.h's DiamondOpCode enum -- none of them are constructs this
  # self-hosted parser emits (UDPSocket/Signal/TLSSocket/TLSServer aren't
  # part of its supported grammar), so they have no entry of their own
  # here, but every opcode number below had to shift by 7 to match once
  # those 7 were inserted before REGEXP_NEW in the real enum. This is
  # exactly the class of bug the "Widened function indices" self-hosting
  # slice already flagged -- any native opcode insertion
  # ahead of an entry here silently desyncs it, and nothing catches that
  # except actually running a program through the self-hosted path.
  REGEXP_NEW = 83
  CHR = 84
  TO_FLOAT = 85
  TO_INT = 86
  TO_SYMBOL = 87
  # DIAMOND_OP_JSON_STRINGIFY (native JSON.stringify): keep in step with src/vm.h.
  JSON_STRINGIFY = 178
  # DIAMOND_OP_JSON_STRINGIFY_OPTIONS: JSON.stringify(value, options); same operands plus the options register.
  JSON_STRINGIFY_OPTIONS = 186
  UNWIND_JUMP = 185
  INVOKE_SELF_METHOD = 111
  BLOCK_RETURN = 173
  BLOCK_BREAK = 174
  # DIAMOND_OP_CASE_MATCH: `when` tests (Range, Regexp, class and == patterns); keep in step with src/vm.h.
  CASE_MATCH = 131
  CASE_ARRAY_SHAPE = 132
  CASE_HASH_SHAPE = 134
  CASE_HASH_HAS = 135
  MATH_UNARY = 88
  MATH_BINARY = 89
  PROGRAM_BUILDER_NEW = 90
  # 91 (THREAD_NEW), 94 (SQLITE3_OPEN) and 96-98 (TIME_MONOTONIC,
  # TIME_NOW, TIME_AT) in src/vm.h's DiamondOpCode enum have no entry of
  # their own here -- none of them are constructs this self-hosted
  # parser emits (Thread, SQLite3, and Time literals aren't part of its
  # supported grammar). 92-93 (GET_CVAR/SET_CVAR) *are* named below:
  # class variables; 95 (CHECK_DESTRUCTURE_COUNT) is named above.
  # SHIFT_LEFT below still has to account for the full original 8-opcode
  # gap (91-98) to match the real enum value -- same class of bug the
  # comment above (REGEXP_NEW's own gap) already flags. Confirmed
  # against the real value with a throwaway C probe (printf("%d",
  # (int)DIAMOND_OP_SHIFT_LEFT)) rather than counted by hand a second
  # time, after counting by hand got it wrong once already (missed
  # SQLITE3_OPEN, landed on 97 instead of 98).
  GET_CVAR = 92
  SET_CVAR = 93
  SHIFT_LEFT = 99
  # 100-104 are PROCESS_RUN, PROCESS_SPAWN, DEBUGGER, ARGV, and ENV in
  # src/vm.h's DiamondOpCode enum -- same story again: none are
  # constructs this self-hosted parser emits (Process.run/.spawn,
  # debugger()/breakpoint(), and the ARGV/ENV globals aren't part of
  # its supported grammar), so MODULO below has to account for that
  # 5-opcode gap on top of SHIFT_LEFT's own 8-opcode one. This gap grew
  # from 4 to 5 when DIAMOND_OP_PROCESS_SPAWN was inserted between
  # PROCESS_RUN and DEBUGGER (Process.spawn's own native addition) --
  # exactly the silent-desync failure mode this mirror's own comments
  # warn about, caught 2026-08-31 by re-verifying with the same
  # throwaway C probe technique instead of trusting the old hardcoded
  # value, not by a differential-corpus failure (MODULO/COMPARE happen
  # to have no dedicated positive-corpus case exercising their exact
  # opcode byte). Confirmed with the same throwaway C probe technique
  # as SHIFT_LEFT, not counted by hand.
  MODULO = 105
  # Appended immediately after MODULO. Later native-only tail opcodes,
  # including CASE_MATCH/CASE_ARRAY_SHAPE/ARRAY_REST and the case Hash
  # predicates, rest/suffix extraction, and object-pattern support, do not
  # shift this
  # value. Still confirmed with the same throwaway C probe technique as
  # SHIFT_LEFT/MODULO above rather than trusting the arithmetic alone.
  COMPARE = 106
  # `>>` (DIAMOND_OP_SHIFT_RIGHT) was added natively well after this list
  # was last verified -- 55 opcodes past COMPARE, not adjacent to
  # SHIFT_LEFT the way the token pair's own lexing is. This lexer/parser
  # mirror had no `>>` support at all until this entry (lexer.d6's own
  # `>` branch never checked for a second `>`, so `1 >> 2` silently
  # lexed as two `greater` tokens) -- found by tests/lexer_diff.sh
  # failing on tests/cases/bitwise_operators.d6, not by hand-auditing.
  # Confirmed with the same throwaway C probe technique as SHIFT_LEFT
  # above, not counted by hand.
  SHIFT_RIGHT = 161
  # Int-only `&`, `|`, `^` follow SHIFT_RIGHT directly in src/vm.h (checked with the same probe).
  BITWISE_AND = 162
  BITWISE_OR = 163
  BITWISE_XOR = 164
  # `.class()` (DIAMOND_OP_CLASS_NAME), probed from src/vm.h the same way.
  CLASS_NAME = 165
end

module Precedence
  NONE = 0
  RANGE = 1
  OR = 2
  AND = 3
  EQUALITY = 4
  COMPARISON = 5
  SHIFT = 6
  TERM = 7
  FACTOR = 8
  PREFIX = 9
  POWER = 10
end

# Phase 3 sub-phase 4 (gradual typing): scalar and union type annotations
# (`Int`/`Float`/`String`/`Bool`/`Nil`/a declared class name, separated by
# `|`) plus recursively typed `Array[T]` and `Hash[K, V]` contracts on
# parameters and return types, plus `Callable[n]`, `Callable[n, Return]`,
# and `Callable[[Parameters], Return]`, plus top-level structural interface
# declarations. Deliberately no interface inheritance, generics, or
# narrowing yet --
# each is a natural, separate extension of the same
# ProgramBuilder#declare_type_set bridge method this round adds, not
# something this round itself needs. Values must exactly match
# src/vm.h's DiamondTypeId enum ordinals, the same way Opcode above
# does for DiamondOpCode.
module Type
  INT = 0
  FLOAT = 1
  STRING = 2
  BOOL = 3
  NIL = 4
  ARRAY = 5
  HASH = 6
  CALLABLE = 7
  SIZED = 8
  SYMBOL = 9
  CLASS_BASE = 10
  # No type has this id: an annotation's name not declared yet.
  UNDECLARED = 65534
  # Keep the non-overlapping partitions in sync with DiamondTypeId in vm.h.
  VARIABLE_BASE = 61696
  INTERFACE_BASE = 61952
end

# Helpers that need no parser state, kept outside Parser: a class holds at
# most 256 methods (DIAMOND_MAX_METHODS).

# The `Callable[[params], R]` annotation member a do block passed as
# argument `slot` of a top-level function takes its types from, or nil:
# the parameter must be typed with exactly that one member, as in
# compiler_calls.c's compile_contextual_typed_block.
def contextual_block_member(function_entry, slot)
  return nil if function_entry.length() < 8
  types = function_entry[7]
  return nil if types == nil || slot < 0 || slot >= types.length()
  annotation = types[slot]
  return nil if annotation == nil || annotation.length() != 1
  member = annotation[0]
  return nil if member[0] != "Callable" || member[5] == nil
  member
end

# A class entry's type parameters. Builtin entries (below) have none.
def class_type_parameters(entry)
  if entry.length() > 4 then entry[4] else [] end
end

# The native VM's built-in exception hierarchy (DiamondBuiltinClass,
# src/vm.h) is constructed directly by diamond_program_init -- called
# by both diamond_compile and the ProgramBuilder native bridge -- and
# never goes through any .d6 source at all, so it's otherwise invisible
# to a parser whose class bookkeeping only ever sees what it compiles
# from `class ... end` syntax. These twelve indices are fixed and
# already occupied before this parser (or any target program) declares
# its own first class, so they're safe to hardcode rather than query.
# Fourth element is the class's singleton-method descriptor list
# (see compile_class's own @classes.push), empty here since none of
# the built-ins declare any -- kept for a uniform four-element shape
# across every class_entry source (find_class doesn't otherwise care
# which of the two returned it).
def find_builtin_class(name)
  return ["Exception", 0, nil, []] if name == "Exception"
  return ["StandardError", 1, 0, []] if name == "StandardError"
  return ["RuntimeError", 2, 1, []] if name == "RuntimeError"
  return ["TypeError", 3, 1, []] if name == "TypeError"
  return ["ArgumentError", 4, 1, []] if name == "ArgumentError"
  return ["IndexError", 5, 1, []] if name == "IndexError"
  return ["ZeroDivisionError", 6, 1, []] if name == "ZeroDivisionError"
  return ["RangeError", 7, 1, []] if name == "RangeError"
  return ["SystemStackError", 8, 0, []] if name == "SystemStackError"
  return ["FiberError", 9, 1, []] if name == "FiberError"
  return ["IOError", 10, 1, []] if name == "IOError"
  return ["RegexpError", 11, 1, []] if name == "RegexpError"
  # 12-18 (WouldBlockError..JSONError) are the same kind of silent
  # mirror desync the Opcode module's own comments already warn
  # about (see MODULO/COMPARE's fix) -- this list stopped at
  # RegexpError while src/vm.h's DiamondBuiltinClass enum grew seven
  # more entries. JSONError specifically became a builtin (previously
  # a lib/core/json_codec.d6 class declaration this parser could
  # already see) when JSON.parse went native, which is what actually
  # surfaced this: lib/core/json_codec.d6's own `raise JSONError.new(...)`
  # started failing to self-parse with "undefined local variable" --
  # find_class (line ~692) falls through to find_builtin_class for any
  # bare capitalized name it can't resolve as a user-declared class,
  # and this returning nil for JSONError sent that fallthrough to
  # local-variable lookup instead, which is what actually raised the
  # error. Verified against src/vm.h's DiamondBuiltinClass enum
  # directly (plain sequential enum, no gaps), not counted by hand.
  return ["WouldBlockError", 12, 1, []] if name == "WouldBlockError"
  return ["ThreadError", 13, 1, []] if name == "ThreadError"
  return ["SQLite3Error", 14, 1, []] if name == "SQLite3Error"
  return ["PostgreSQLError", 15, 1, []] if name == "PostgreSQLError"
  return ["MySQLError", 16, 1, []] if name == "MySQLError"
  return ["NoMethodError", 17, 1, []] if name == "NoMethodError"
  return ["JSONError", 18, 1, []] if name == "JSONError"
  return ["SupervisorError", 19, 1, []] if name == "SupervisorError"
  return ["SandboxError", 20, 1, []] if name == "SandboxError"
  return ["ResourceLimitError", 21, 1, []] if name == "ResourceLimitError"
  return ["FrozenError", 22, 1, []] if name == "FrozenError"
  nil
end

# The entry in `classes` (Parser's @classes) for a class index, or nil.
def class_entry_by_index(classes, class_index)
  index = 0
  result = nil
  while index < classes.length()
    result = classes[index] if classes[index][1] == class_index
    index = index + 1
  end
  result
end

# The context a trailing block passed to a singleton takes its types from:
# the singleton's last parameter (descriptor[4] is its signature), or nil.
def singleton_block_context(descriptor)
  return nil if descriptor.length() < 5 || descriptor[2] == 0 || descriptor[4][2].length() > 0
  contextual_block_member([nil, nil, nil, nil, nil, nil, nil, descriptor[4][0]], descriptor[2] - 1)
end

# The registers base, base + 1, ... base + count - 1.
def contiguous_registers(base, count)
  registers = []
  index = 0
  while index < count
    registers.push(base + index)
    index = index + 1
  end
  registers
end

# Does a token of this kind end a statement, so a break/return before it
# carries no value? The modifier keywords count: `break if x`.
def statement_end_kind?(kind)
  kind == :newline || kind == :end || kind == :else || kind == :if ||
    kind == :unless || kind == :eof
end

# parse_parameter_names already rejects a required parameter following
# a default one, so the first non-nil entry (if any) marks where
# optional parameters begin -- everything before it is required.
# Parameters before the first default, variadic or block parameter.
def required_parameter_count(parsed_parameters)
  defaults = parsed_parameters[2]
  last = defaults.length() - 1
  index = 0
  while index < defaults.length()
    return index if defaults[index] != nil || index == parsed_parameters[4]
    return index if index == last && parsed_parameters[3]
    index = index + 1
  end
  index
end

def type_fact_in(facts, reg)
  index = facts.length() - 1
  while index >= 0
    return facts[index][1] if facts[index][0] == reg
    index = index - 1
  end
  nil
end

def struct_field_index(fields, field_name)
  index = 0
  while index < fields.length()
    return index if fields[index][0] == field_name
    index = index + 1
  end
  nil
end

# An instance method: register 0 is always `self` (allocated before
# any user-declared parameter, exactly mirroring compile_definition.c's
# own class/module branch), and the compiled function is registered
# into the class via declare_method rather than @functions -- resolved
# later at INVOKE time by the VM against the receiver's runtime class,
# not by this parser at compile time the way a direct top-level call
# is. One level of nested `def` is supported inside a method body (see
# compile_method_body's own function_nesting_depth increment and
# compile_definition's self_offset handling) -- the nested closure gets
# its own independent `self`, not a captured one, so it can be handed
# to redefine_method and later invoked normally against any receiver.
# Operator overloading: a method literally named "+"/"=="/etc. is
# already legal at the VM level (lookup_method dispatches purely by
# name-string + arity, no charset restriction) -- the only barrier is
# the parser accepting the token as a method name. Unary minus is
# deliberately NOT included: it's named "negate", an ordinary
# identifier, mirroring compiler.c's own operator_name list exactly
# (compile_definition's identical check).
# A statement starting with one of these runs to its own `end`.
def block_expression_start?(kind)
  kind == :if || kind == :unless || kind == :while || kind == :until || kind == :case || kind == :begin
end

def undefined_name_message(name)
  return "undefined namespaced class" if name.include?("::")
  "undefined constant '" + name + "'"
end

def operator_method_token?(kind)
  return true if kind == :plus
  return true if kind == :minus
  return true if kind == :star
  return true if kind == :slash
  return true if kind == :percent
  return true if kind == :equal_equal
  return true if kind == :less
  return true if kind == :less_equal
  return true if kind == :greater
  return true if kind == :greater_equal
  return true if kind == :spaceship
  false
end

def attribute_keyword?(kind)
  return true if kind == :attr
  return true if kind == :attr_reader
  return true if kind == :attr_writer
  return true if kind == :attr_accessor
  kind == :attr_predicate
end

def find_parameter_slot(parameter_names, name)
  index = 0
  result = -1
  while index < parameter_names.length() && result == -1
    result = index if parameter_names[index] == name
    index = index + 1
  end
  result
end

def compound_assignment_token?(kind)
  kind == :plus_equal || kind == :minus_equal || kind == :star_equal ||
    kind == :slash_equal || kind == :percent_equal ||
    kind == :or_or_equal || kind == :and_and_equal
end

# Destructuring assignment -- a port of compiler_assignment.c's
# multi_assignment_ahead/compile_multi_assignment. The lookahead
# recognizes the comma-root form (`a, b =`) and bracketed/braced
# recursive patterns (`[a, [b, c]] =`, `{"k": v, **rest} =`) without
# stealing an ordinary Array or Hash literal from expression parsing.
def destructuring_target_kind?(kind)
  kind == :identifier || kind == :instance_variable || kind == :class_variable
end

# Skips `.member` and `[index]` suffixes after a target name; returns
# the first token past them.
def scan_destructuring_target_suffix(lexer, token)
  while true
    if token.kind() == :dot
      token = lexer.next_token()
      return token if token.kind() != :identifier
      token = lexer.next_token()
    elsif token.kind() == :left_bracket
      depth = 1
      while depth > 0
        token = lexer.next_token()
        return token if token.kind() == :eof || token.kind() == :error
        depth = depth + 1 if token.kind() == :left_bracket
        depth = depth - 1 if token.kind() == :right_bracket
      end
      token = lexer.next_token()
    else
      return token
    end
  end
end

# A pattern node: [kind (:leaf/:array/:hash), children, rest,
# hash_rest, name token, instance_variable, class_variable,
# key register, target (:plain/:indexed/:member), target receiver,
# target index register or member name, value register].
def destructure_node(kind) = [kind, [], false, false, nil, false, false, 0, :plain, 0, nil, 0]

def copy_type_facts_from(facts)
  copy = []
  index = 0
  while index < facts.length()
    copy.push(facts[index])
    index = index + 1
  end
  copy
end

# --- Array/Hash/object patterns in `when`, as compiler_case.c ---
# A node: [kind, name token, reader name, value register, key register,
# subject register (set while matching), children, class index]. Kinds:
# :array, :hash, :object (groups), :bind, :wildcard, :rest_bind,
# :rest_wildcard, :hash_rest_bind, :hash_rest_wildcard, :pin, :value.
def case_pattern_node(kind) = [kind, nil, nil, 0, 0, 0, [], nil]

def lowercase_name?(text)
  first = text.slice(0, 1)
  first >= "a" && first <= "z"
end

def rest_kind?(node) = node[0] == :rest_bind || node[0] == :rest_wildcard

def hash_rest_kind?(node) = node[0] == :hash_rest_bind || node[0] == :hash_rest_wildcard

# The binding nodes of a pattern, in source order.
def collect_case_bindings(node, found)
  found.push(node) if node[0] == :bind || node[0] == :rest_bind || node[0] == :hash_rest_bind
  index = 0
  while index < node[6].length()
    collect_case_bindings(node[6][index], found)
    index = index + 1
  end
  found
end

def token_precedence(kind)
  return Precedence::RANGE if kind == :dot_dot || kind == :dot_dot_dot
  return Precedence::OR if kind == :or_or || kind == :or
  return Precedence::AND if kind == :and_and || kind == :and
  return Precedence::EQUALITY if kind == :equal_equal || kind == :bang_equal ||
    kind == :is || kind == :spaceship
  return Precedence::COMPARISON if kind == :less || kind == :less_equal || kind == :greater || kind == :greater_equal
  return Precedence::SHIFT if kind == :less_less || kind == :greater_greater ||
    kind == :ampersand || kind == :pipe || kind == :caret
  return Precedence::TERM if kind == :plus || kind == :minus
  return Precedence::FACTOR if kind == :star || kind == :slash || kind == :percent
  Precedence::NONE
end

def binary_opcode(kind)
  return Opcode::ADD if kind == :plus
  return Opcode::SUBTRACT if kind == :minus
  return Opcode::MULTIPLY if kind == :star
  return Opcode::DIVIDE if kind == :slash
  return Opcode::MODULO if kind == :percent
  return Opcode::EQUAL if kind == :equal_equal
  return Opcode::NOT_EQUAL if kind == :bang_equal
  return Opcode::LESS if kind == :less
  return Opcode::LESS_EQUAL if kind == :less_equal
  return Opcode::GREATER if kind == :greater
  return Opcode::GREATER_EQUAL if kind == :greater_equal
  return Opcode::COMPARE if kind == :spaceship
  return Opcode::SHIFT_RIGHT if kind == :greater_greater
  return Opcode::BITWISE_AND if kind == :ampersand
  return Opcode::BITWISE_OR if kind == :pipe
  return Opcode::BITWISE_XOR if kind == :caret
  Opcode::SHIFT_LEFT
end

def find_descriptor(descriptors, name)
  index = 0
  result = nil
  while index < descriptors.length()
    result = descriptors[index] if descriptors[index][0] == name
    index = index + 1
  end
  result
end

def math_unary_id(name)
  return 0 if name == "sqrt"
  return 1 if name == "sin"
  return 2 if name == "cos"
  return 5 if name == "exp"
  return 6 if name == "log"
  return 7 if name == "tanh"
  3
end

class Parser
  def initialize(source, builder)
    @source = source
    @builder = builder
    @lexer = Lexer.new(source)
    @current = @lexer.next_token()
    @previous = @current
    @code_count = 0
    @next_register = 0
    # Bytes prepended to `source` by a caller before it reached this
    # constructor (e.g. parse_and_run_with_core splicing lib/core.d6 in
    # front so target programs can call its functions) -- subtracted from
    # @current.start() in fail() before it's handed to
    # ProgramBuilder#source_location, whose segment offsets (recorded by
    # expand_source, called *before* any such prepending) are relative to
    # the unprefixed string. Zero by default: only a caller that actually
    # prepends something needs to call set_offset_correction.
    @offset_correction = 0
    # Each entry is [name, register, captured] -- captured marks a local
    # whose register holds a Cell (either a nested closure captured it,
    # or this local itself is a captured-from-outside binding inside a
    # nested function's own body), needing GET_CELL/SET_CELL rather than
    # a direct register read/MOVE. See compile_definition/BOX_LOCAL.
    @locals = []
    # Inside a loop whose body may capture (loop_body_may_capture?): new
    # locals start captured. Mirrors compiler.c's loop_captures_pending.
    @loop_captures_pending = false
    # The name of the enclosing method's `&block` parameter, which `yield`
    # calls; nil outside one, where `yield` is Fiber.yield. Mirrors
    # compiler.c's has_current_block/current_block_register.
    @current_block_name = nil
    @current_block_type = nil
    # Inside a do block (not a def nested in one): `next` returns from it.
    @in_block = false
    # A do block whose `break` lands in the call it is passed to: that
    # call's offset is recorded by the next call opcode emitted.
    @block_has_break = false
    @pending_block_call = nil
    # The enclosing def a block's `return` returns from (-1 outside one)
    # and its declared return type.
    @method_function_index = -1
    @method_return_type = nil
    # The `Callable[[params], R]` member a do block about to be compiled
    # fills, from the callee's parameter: its parameter and result types.
    @block_context = nil
    # Whether the block being compiled returns early (`next value`), so its
    # result type can't be read off the body alone.
    @block_returns_early = false
    @loops = []
    @begin_depth = 0
    @functions = []
    @namespace_constants = []
    # Forward references, patched at the end of compile(): constant reads
    # [function index, operand offset, name, scope, token] and direct calls
    # [function index, operand offset, name, argument count, token].
    @forward_constants = []
    @forward_calls = []
    # Classes named before their declaration: `X.new(...)` sites
    # [function index, operand offset, name, module, token] and
    # `X.method(...)` sites [function index, operand offset, name, module,
    # token, method name, argument count, method name token].
    @forward_news = []
    @forward_type_names = []
    @self_capture_index = nil
    @forward_is_types = []
    @type_name_tokens = {}
    # The tail call bookkeeping: see maybe_rewrite_tail_call.
    @last_plain_call = nil
    @last_move = nil
    @tail_call_candidates = []
    @nonlocal_landing_functions = []
    @forward_singleton_calls = []
    # Function indices declared with a `*name` parameter: calls to them may
    # pass more arguments than the declared arity.
    @variadic_functions = []
    # [variadic index or nil, has block parameter] for the def whose
    # parameters bind_parameters binds next; see compile_definition.
    @parameter_shape = nil
    # True while compiling a body whose register 0 holds self: an instance
    # method, a def nested in one, and blocks inside either.
    @in_method = false
    # Inside a class's `def self.x` (not a module's): `self.name(...)` and a
    # bare call to one of the class's singleton methods dispatch on self's
    # actual class, as compiler.c's in_singleton_method does.
    @in_singleton_method = false
    # Class indices declared `sealed class`; `.new` on one is a compile error.
    @sealed_classes = []
    # The class a `when` value named, for exhaustiveness (see
    # parse_case_class_pattern).
    @case_pattern_class_index = nil
    # [class_index, [[field, type source text, token], ...]] for each struct,
    # inherited fields first.
    @struct_fields = []
    # [class_index, method name, private, required arity] for each instance
    # method, and the classes that include a module (whose methods aren't
    # listed): what a `when Class{reader: ...}` pattern checks its readers
    # against.
    @instance_methods = []
    @classes_with_includes = []
    # -1 targets the ProgramBuilder entry function; a real function's own
    # index once compile_definition switches into its body. Every
    # emit_byte/add_constant/add_string/patch_byte call routes through
    # this so the same emission helpers work unmodified regardless of
    # which function is currently being compiled.
    @current_function_index = -1
    # The enclosing function's own @locals snapshot, taken the moment a
    # nested `def` is entered -- every entry becomes a capture candidate
    # (see compile_definition). Empty outside a nested function's body.
    @enclosing_locals = []
    # 0 while compiling the top-level script -- a `def` encountered here
    # is a plain top-level function (compile_definition's own
    # at_top_level check reads this *before* incrementing). Entering any
    # function body increments it; a `def` encountered at any depth
    # becomes a nested closure. Used to be capped at depth 1 (arity/self-
    # register budget concerns from before compile_function_body/
    # parse_parameter_names/emit_closure were split out) -- that cap
    # turned out stale by the time it was actually tested against real
    # nested-closure fixtures and was removed; arbitrary depth works
    # exactly like compiler.c's own general enclosing_locals-walk.
    @function_nesting_depth = 0
    # Array of [name, class_index] entries, mirroring @functions --
    # `ClassName.new(...)` resolves against this via find_class.
    @classes = []
    @interfaces = []
    @modules = []
    @current_module_index = nil
    @current_module_name = nil
    @current_module_entry = nil
    @current_type_variables = []
    @type_facts = []
    @declared_types = []
    @pending_nil_narrowing = nil
    @pending_type_narrowing = nil
    @current_exception = nil
    @current_retry_target = nil
    # The class_index currently being compiled (compile_class), or nil
    # outside any class body -- gates `self`/`@ivar` (both require being
    # inside a method) and rejects a class or `def` nested inside a
    # class body beyond one plain method (see compile_class/compile_method).
    @current_class_index = nil
    # Names already declared as methods on the class currently being
    # compiled, checked before declare_method so a duplicate method
    # produces this Parser's own fail()/error_message() instead of
    # surfacing as an uncaught exception from declare_method's own
    # (separate, VM-level) duplicate check.
    @current_class_method_names = []
    # Same, for `def self.foo`-declared class singleton methods -- a
    # separate namespace from instance methods (native's own
    # class->singleton_methods[] is a distinct array from
    # class->methods[], so the same name can be both).
    @current_class_singleton_method_names = []
    # Index into @classes of the class currently being compiled's own
    # entry -- mirrors @current_module_entry's own indexing pattern.
    # register_compiled_method appends each `def self.foo` singleton's
    # descriptor to @classes[@current_class_entry][3] so a later,
    # unrelated call site (Klass.foo(...)) can look it up by class_entry
    # alone, the same way it already looks up class_index/superclass.
    @current_class_entry = nil
    # Default visibility for methods declared for the rest of the class
    # currently being compiled -- set by a bare `private`/`public` in the
    # class body (compile_class_visibility). Named visibility targets
    # (`private(name)`) aren't supported: unlike compile_module's own
    # bare-vs-named split, there's no bridge method to flip an
    # already-declared class method's visibility after the fact.
    @current_class_methods_private = false
    @current_class_methods_protected = false
    @current_class_included_method_names = []
    # The class_index of the class currently being compiled's
    # superclass, or nil if it has none -- gates `super`'s own "used in
    # a class without a superclass" check. Doesn't need the superclass's
    # full identity beyond "does one exist": SUPER's own opcode operand
    # is the *current* class's index, not the superclass's -- the VM
    # itself walks `owner->superclass` at runtime.
    @current_class_superclass_index = nil
    # The name of the method currently being compiled (compile_method),
    # needed by `super(...)`: it always calls the superclass's version
    # of *this same* method, never an explicitly named one.
    @current_method_name = nil
    @current_method_uses_state = false
    # The current function/method/closure's declared `-> Type` return
    # type name (a String), or nil if it has none -- needed by both the
    # implicit final-expression return path (compile_function_body/
    # compile_method_body) and every explicit `return` statement
    # (compile_return) anywhere in its body, mirroring compiler.c's own
    # current_return_type field exactly (checked on *every* return path,
    # not just the implicit one).
    @current_return_type = nil
    @failed = false
    @error_message = nil
    self.fail("unexpected character") if @current.kind() == :error
  end

  def error_message() = @error_message

  # Parses and emits the whole program into function -1 (the
  # ProgramBuilder's entry function), finishing with a RETURN of the top-level sequence's result.
  # Returns true on success; on failure, error_message() explains why and
  # no .run() should be attempted against a partially-emitted program.
  def compile()
    result = self.compile_sequence()
    if !@failed && @current.kind() != :eof
      self.fail("unexpected block terminator")
    end
    self.emit_instruction1(Opcode::RETURN, result)
    @builder.set_register_count(-1, @next_register)
    self.resolve_forward_references() unless @failed
    !@failed
  end

  def set_offset_correction(value)
    @offset_correction = value
  end

  private

  def fail(message) = self.fail_at(@current.start(), @current.line(), @current.column(), message)

  # Like fail, but reporting a previously-saved token's position instead
  # of wherever @current has since advanced to -- needed for the handful
  # of diagnostics compiler.c itself anchors to a token other than the
  # one currently being parsed (e.g. parse_call's keyword-argument
  # checks, anchored to the call's own function name rather than the
  # specific offending argument).
  def fail_at(start, line, column, message)
    if !@failed
      offset = if start >= @offset_correction
        start - @offset_correction
      else
        start
      end
      @error_message = @builder.source_location(offset, line, column) + ": " + message
    end
    @failed = true
  end

  def advance_token()
    @previous = @current
    @current = @lexer.next_token()
    self.fail("unexpected character") if @current.kind() == :error
  end

  def skip_newlines()
    while @current.kind() == :newline
      self.advance_token()
    end
  end

  def at_block_end?() =
    @current.kind() == :eof || @current.kind() == :else || @current.kind() == :elsif || @current.kind() == :when || @current.kind() == :rescue || @current.kind() == :ensure || @current.kind() == :end

  def token_text(token) = @source.slice(token.start(), token.length())

  # --- emission, mirroring compiler.c's emit_byte/emit_opcode/
  # emit_instruction/allocate_register/add_constant/add_string ---

  def emit_byte(byte)
    @builder.set_source_location(@previous.line(), @previous.column())
    @builder.emit_byte(@current_function_index, byte)
    @code_count = @code_count + 1
  end

  # Every operand emitted here is 16-bit, big-endian -- same split as
  # emit_function_index/patch_jump below -- mirroring compiler.c's own
  # emit_instruction, which widens *every* operand it takes uniformly
  # (register or not: a constant/string/type-set index, a bool flag) rather
  # than classifying each call site by hand. See that function's own
  # comment in compiler.c for why. Opcodes with a genuinely narrow operand
  # (a function id, an argument count, ...) that must stay one byte don't
  # route through here -- they hand-roll their emission with emit_byte
  # directly, same as compiler.c's own hand-rolled opcodes.
  def emit_register(register)
    self.emit_byte(register / 256)
    self.emit_byte(mod(register, 256))
  end

  def emit_instruction1(opcode, a)
    self.emit_byte(opcode)
    self.emit_register(a)
  end

  def emit_instruction2(opcode, a, b)
    @last_move = [@code_count, a, b] if opcode == Opcode::MOVE
    self.emit_byte(opcode)
    self.emit_register(a)
    self.emit_register(b)
  end

  def emit_instruction3(opcode, a, b, c)
    self.emit_byte(opcode)
    self.emit_register(a)
    self.emit_register(b)
    self.emit_register(c)
  end

  # CALL/CALL_TYPED/CLOSURE's function-index operand is 16-bit, big-endian
  # (same split as patch_jump's jump target below), mirroring compiler.c's
  # own emit_function_index -- the dynamically sized native function table
  # uses 16-bit indices, past what a single byte holds.
  def emit_function_index(function_index)
    self.emit_byte(function_index / 256)
    self.emit_byte(mod(function_index, 256))
  end

  # 4096, mirroring compiler.c's own DIAMOND_REGISTER_COUNT ceiling check
  # (Compiler.next_register >= DIAMOND_REGISTER_COUNT, "program needs too
  # many registers") -- not a wire-format limit (registers are 16-bit
  # operands now, see emit_register above) but a deliberate cap on the
  # native VM's per-call register array (a VLA sized to each function's
  # own register count, see run_chunk in vm.c).
  def allocate_register()
    if @next_register >= 4096
      self.fail("program needs too many registers")
      return @next_register
    end
    register = @next_register
    @next_register = @next_register + 1
    register
  end

  def add_constant(value) = @builder.add_constant(@current_function_index, value)

  def add_string(text) = @builder.add_string(@current_function_index, text)

  # JUMP: [opcode][hi][lo]. JUMP_IF_FALSE/JUMP_IF_TRUE:
  # [opcode][condition hi][condition lo][hi][lo]. `operand` is the offset
  # of the first placeholder byte, recorded before the target is known so
  # patch_jump can overwrite it later -- exactly compiler.c's own
  # emit_jump/patch_jump split, now via ProgramBuilder#patch_byte instead
  # of a direct C array write.
  def emit_jump(opcode, condition)
    conditional = opcode == Opcode::JUMP_IF_FALSE || opcode == Opcode::JUMP_IF_TRUE
    operand = @code_count + (if conditional
      3
    else
      1
    end)
    self.emit_byte(opcode)
    self.emit_register(condition) if conditional
    self.emit_byte(0)
    self.emit_byte(0)
    operand
  end

  # Emits a call opcode, first giving a pending breaking block this call's
  # offset -- compiler.c's emit_opcode does the same.
  def emit_call_opcode(opcode)
    if @pending_block_call != nil
      @builder.set_block_call_offset(@pending_block_call, @code_count)
      @pending_block_call = nil
    end
    self.emit_byte(opcode)
  end

  def patch_jump(operand, target)
    @last_plain_call[5] = true if @last_plain_call != nil && @last_plain_call[1] == target
    @builder.patch_byte(@current_function_index, operand, target / 256)
    @builder.patch_byte(@current_function_index, operand + 1, mod(target, 256))
  end

  # `position` is [start_offset, line, column] as recorded by
  # parse_parameter_names, already inside the callee's own reset
  # register scope by the time this runs. Mirrors compiler.c's own
  # ARGUMENT_PROVIDED/JUMP_IF_TRUE guard around the fallback expression,
  # re-lexing and compiling that expression for real via the same
  # embedded-Lexer save/restore trick parse_string's interpolation
  # already uses, since the first pass only skipped over its tokens.
  # Shared by compile_function_body (index_offset 0: no implicit self)
  # and compile_method_body (index_offset 1: register 0/parameter slot 0
  # is self), both of which were, on their own, already close enough to
  # the 256-register ceiling that inlining this same handful of lines
  # directly overflowed each of them -- the same register-budget wall
  # parse_name and compile_class already hit this session, worth a
  # shared helper here instead of duplicating the loop twice.
  def bind_parameters(function_index, parameter_names, parameter_types, parameter_defaults, index_offset)
    # Parameter registers must land in a single contiguous block,
    # reserved *before* any default expression is compiled -- mirroring
    # compiler.c's own parameter_base/allocate_register pre-pass exactly.
    # Interleaving define_local (one register) with compile_parameter_
    # default's own scratch registers (one for ARGUMENT_PROVIDED's result,
    # more for the fallback expression) used to push each later
    # parameter's register past where the VM's fixed calling convention
    # (registers[index] = arguments[index], see run_chunk) actually placed
    # its argument -- a real bug, not just a register-numbering quirk: any
    # function with two or more defaulted parameters silently read every
    # parameter after the first from the wrong register. Found via
    # legacy_0132.d6 once ProgramBuilder#run could finally return its
    # Array result to expose the wrong value at all.
    shape = @parameter_shape
    @parameter_shape = nil
    if shape != nil && shape[1]
      @current_block_name = parameter_names[parameter_names.length() - 1]
      # Its annotation, which `yield` checks the block against.
      @current_block_type = parameter_types[parameter_types.length() - 1]
    end
    parameter_base = @next_register
    index = 0
    while index < parameter_names.length()
      self.allocate_register()
      index = index + 1
    end
    index = 0
    while index < parameter_names.length()
      register = parameter_base + index
      @locals.push([parameter_names[index], register, false])
      # Keyword calls (CALL_CLOSURE_KEYWORDS) match these names. Indexed by
      # declared position, like parameter_type_sets below.
      @builder.set_parameter_name(function_index, index, parameter_names[index]) unless @failed
      # The default-value fallback must run *before* the type check: an
      # omitted argument's register holds whatever the VM's ordinary
      # zero-init leaves it as (Nil), not the type the annotation
      # promises, until the fallback MOVE actually runs. Checking first
      # would reject every omitted-and-defaulted call outright, which is
      # exactly backwards -- mirrors compiler.c's own parameter loop,
      # which parses the default (`= expr`) before ever calling
      # emit_type_check on this parameter.
      default_position = parameter_defaults[index]
      self.compile_parameter_default(register, index + index_offset, default_position) if default_position != nil
      type_name = parameter_types[index]
      # A `&block: Callable[...]` parameter is nil when no block is given,
      # so it gets no entry check or type fact, as in compiler.c; its type
      # is still recorded for callers.
      is_block = shape != nil && shape[1] && index == parameter_names.length() - 1
      if type_name != nil && is_block
        set_index = self.declare_annotation(type_name)
        @builder.set_parameter_type(function_index, index, set_index) unless @failed
      elsif type_name != nil
        @declared_types.push([register, type_name])
        set_index = self.emit_type_check(register, type_name)
        # Unlike ARGUMENT_PROVIDED above (a call-time argument index,
        # which does include the receiver), DiamondFunction.
        # parameter_type_sets is indexed purely by declared-parameter
        # position -- compiler.c's own equivalent loop never gives self
        # a slot there at all, self or no self, so index_offset must NOT
        # apply here. Adding it shifted every method parameter's type
        # into the next slot over, leaving slot 0 permanently UINT8_MAX
        # ("untyped") for any single-parameter method -- and an untyped
        # actual parameter is deliberately compatible with *any* required
        # interface type (see the interface-satisfies check in vm.c), so
        # this silently accepted parameter types that should have been
        # rejected. Found via legacy_0121.d6/legacy_0122.d6 once
        # ProgramBuilder#run could return their Array results to expose
        # the wrong Bool values at all.
        @builder.set_parameter_type(function_index, index, set_index) unless @failed
      end
      index = index + 1
    end
    self.finish_parameter_shape(function_index, shape, parameter_base, index_offset) if shape != nil
  end

  # A `*name` parameter collects every argument past the fixed ones (the
  # receiver slot included) into an Array, keeping a trailing block out of
  # it when a `&block` parameter follows.
  def finish_parameter_shape(function_index, shape, parameter_base, index_offset)
    variadic_index = shape[0]
    return if variadic_index == nil && !shape[1]
    @builder.set_parameter_flags(function_index, variadic_index != nil, shape[1]) unless @failed
    return if variadic_index == nil
    @variadic_functions.push(function_index)
    register = parameter_base + variadic_index
    self.emit_instruction3(Opcode::COLLECT_VARIADIC, register, variadic_index + index_offset,
      if shape[1] then 1 else 0 end)
    self.set_type_fact(register, Type::ARRAY)
  end

  def variadic_function?(function_index) = @variadic_functions.include?(function_index)

  # Whether `count` arguments overflow a callee declaring `arity` parameters.
  def too_many_arguments?(count, arity, function_index)
    count > arity && !self.variadic_function?(function_index)
  end

  def compile_parameter_default(register, parameter_index, position)
    provided = self.allocate_register()
    self.emit_instruction2(Opcode::ARGUMENT_PROVIDED, provided, parameter_index)
    skip = self.emit_jump(Opcode::JUMP_IF_TRUE, provided)
    outer_lexer = @lexer
    outer_current = @current
    outer_previous = @previous
    embedded = Lexer.new(@source)
    embedded.restore_state(position[0], position[0], position[1], position[2], position[1], position[2])
    @lexer = embedded
    @current = @lexer.next_token()
    fallback = self.parse_expression()
    @lexer = outer_lexer
    @current = outer_current
    @previous = outer_previous
    self.emit_instruction2(Opcode::MOVE, register, fallback)
    self.patch_jump(skip, @code_count)
  end

  def emit_rescue_handler(exception)
    self.emit_byte(Opcode::PUSH_RESCUE)
    self.emit_register(exception)
    self.emit_byte(128)
    index = 0
    while index < 8
      self.emit_byte(0)
      index = index + 1
    end
    operand = @code_count
    self.emit_byte(0)
    self.emit_byte(0)
    operand
  end

  def parse_rescue_types(exception)
    types = []
    annotation = []
    if @current.kind() == :colon
      self.advance_token()
      while !@failed
        if @current.kind() != :identifier
          self.fail("expected rescue type")
        elsif types.length() == 8
          self.fail("too many rescue types")
        else
          name_token = @current
          name = self.consume_qualified_module_name()
          # A class declared later: emit_rescue_type_test patches its id in.
          type_id = self.annotation_type_id(name)
          @type_name_tokens[name] = name_token unless @type_name_tokens.include_key?(name)
          duplicate = false
          index = 0
          while index < types.length()
            duplicate = true if annotation[index][0] == name
            index = index + 1
          end
          self.fail("duplicate rescue type") if duplicate
          types.push(type_id)
          annotation.push([name, nil, nil, -1, nil, nil])
          if @current.kind() == :pipe
            self.advance_token()
          else
            break
          end
        end
      end
    end
    self.set_type_fact(exception, types[0]) if types.length() == 1 && types[0] != Type::UNDECLARED
    @declared_types.push([exception, annotation]) if annotation.length() > 0
    @rescue_type_names = annotation
    types
  end

  # --- locals: an Array of [name, register, captured] entries, scanned
  # in reverse so the most recently declared match wins on shadowing
  # (mirroring compiler.c's find_local's own reverse scan over its
  # fixed-size array). find_local returns the entry itself (or nil), not
  # just a register, since callers need `captured` to decide between a
  # direct register read/MOVE and a GET_CELL/SET_CELL unwrap -- see
  # read_local/compile_assignment. ---

  def find_local(name)
    index = @locals.length() - 1
    result = nil
    while index >= 0 && result == nil
      entry = @locals[index]
      result = entry if entry[0] == name
      index = index - 1
    end
    result
  end

  def define_local(name)
    register = self.allocate_register()
    @locals.push([name, register, @loop_captures_pending])
    register
  end

  # A captured local's register holds a Cell (see compile_definition's
  # GET_CAPTURE_CELL loop), so reading its value needs an extra GET_CELL
  # unwrap; an ordinary local's register already holds the value directly.
  # A captured local's boxing site may sit in a branch that didn't run
  # (a block or nested def inside an `if`), so every Cell access re-emits
  # BOX_LOCAL first -- it does nothing once the register holds a Cell.
  def read_local(entry)
    return entry[1] unless entry[2]
    self.emit_instruction1(Opcode::BOX_LOCAL, entry[1])
    destination = self.allocate_register()
    self.emit_instruction2(Opcode::GET_CELL, destination, entry[1])
    # The copy is the local's value, so it keeps what is known about it.
    fact = self.type_fact(entry[1])
    self.set_type_fact(destination, fact) if fact != nil
    declaration = self.declared_type(entry[1])
    @declared_types.push([destination, declaration]) if declaration != nil
    destination
  end

  # --- functions: an Array of [name, function_index, arity] entries,
  # scanned the same reverse-shadowing way as locals (compiler.c's own
  # find_function scans its fixed-size program->functions array forward,
  # but since redeclaration is already rejected in compile_definition,
  # forward vs. reverse never actually differs in practice here). ---

  def find_function(name)
    index = @functions.length() - 1
    result = nil
    while index >= 0 && result == nil
      entry = @functions[index]
      result = entry if entry[0] == name
      index = index - 1
    end
    result
  end

  # --- classes: an Array of [name, class_index, superclass_index] entries. ---

  def find_class(name)
    index = @classes.length() - 1
    result = nil
    while index >= 0 && result == nil
      entry = @classes[index]
      result = entry if entry[0] == name
      index = index - 1
    end
    result = find_builtin_class(name) if result == nil
    result
  end

  def find_interface(name)
    index = @interfaces.length() - 1
    result = nil
    while index >= 0 && result == nil
      entry = @interfaces[index]
      result = entry if entry[0] == name
      index = index - 1
    end
    result
  end

  # --- statement sequencing ---

  def postfix_modifier_ahead()
    return nil if @current.kind() == :def || @current.kind() == :closure || @current.kind() == :class || @current.kind() == :interface || @current.kind() == :module
    lookahead = @lexer.clone()
    depth = if @current.kind() == :left_paren || @current.kind() == :left_bracket || @current.kind() == :left_brace
      1
    else
      0
    end
    depth = 1 if block_expression_start?(@current.kind())
    expression_expected = false
    while true
      kind = lookahead.next_token().kind()
      return nil if kind == :eof || kind == :error || kind == :newline
      # This closes something the statement sits in, as in `do |v| x += v end`.
      return nil if depth == 0 && (kind == :end || kind == :right_paren || kind == :right_bracket || kind == :right_brace)
      if depth == 0 && (kind == :if || kind == :unless || kind == :while || kind == :until)
        return nil if expression_expected
        return kind
      end
      depth = depth + 1 if kind == :do
      depth = depth - 1 if kind == :end && depth > 0
      if kind == :left_paren || kind == :left_bracket || kind == :left_brace
        depth = depth + 1
      elsif kind == :right_paren || kind == :right_bracket || kind == :right_brace
        depth = depth - 1 if depth > 0
      end
      expression_expected = depth == 0 && (kind == :equal || compound_assignment_token?(kind))
    end
    nil
  end

  # Does the statement starting at @current contain a `do` block or a def
  # before its first line ends (brackets let it span lines)? Mirrors
  # compiler.c's statement_may_capture. A block boxes every visible local
  # in place, so a value read earlier in the same statement (the receiver
  # of `items.map() do ... end`) would otherwise turn into the Cell.
  def statement_may_capture?()
    lookahead = @lexer.clone()
    kind = @current.kind()
    depth = 0
    while kind != :eof
      return true if kind == :do || kind == :def || kind == :closure
      if kind == :left_paren || kind == :left_bracket || kind == :left_brace
        depth = depth + 1
      elsif kind == :right_paren || kind == :right_bracket || kind == :right_brace
        return false if depth == 0
        depth = depth - 1
      elsif kind == :newline
        return false if depth == 0
      end
      kind = lookahead.next_token().kind()
    end
    false
  end

  # Marks every local captured, so the statement's reads copy the value
  # out of a Cell (read_local) instead of handing over the register a
  # block is about to box in place.
  def mark_locals_captured()
    index = 0
    while index < @locals.length()
      entry = @locals[index]
      entry[2] = true
      index = index + 1
    end
  end

  # Does the loop body starting at the current token contain a def or `do`
  # before its own `end`? A local read by the condition (or early in the
  # body) and captured later in the body must be box-aware from the start,
  # since the next iteration finds it boxed. Mirrors compiler_flow.c's
  # loop_body_may_capture, false positives included (they only cost some
  # boxing).
  def loop_body_may_capture?()
    lookahead = @lexer.clone()
    kind = @current.kind()
    depth = 0
    while kind != :eof
      return true if kind == :def || kind == :closure || kind == :do
      if kind == :if || kind == :unless || kind == :while || kind == :until ||
          kind == :loop || kind == :case || kind == :begin || kind == :class ||
          kind == :module || kind == :interface
        depth = depth + 1
      elsif kind == :end
        return false if depth == 0
        depth = depth - 1
      end
      kind = lookahead.next_token().kind()
    end
    false
  end

  # Enters a loop; returns the outer pending flag to restore on exit.
  def enter_capturing_loop()
    outer = @loop_captures_pending
    if !@loop_captures_pending && self.loop_body_may_capture?()
      @loop_captures_pending = true
      self.mark_locals_captured()
    end
    outer
  end

  def compile_sequence()
    self.skip_newlines()
    result = self.allocate_register()
    while !@failed && !self.at_block_end?()
      self.mark_locals_captured() if self.statement_may_capture?()
      postfix = self.postfix_modifier_ahead()
      postfix_loop = postfix == :while || postfix == :until
      has_postfix = postfix == :if || postfix == :unless || postfix_loop
      postfix_result = if has_postfix
        self.allocate_register()
      else
        result
      end
      condition_jump = if has_postfix
        self.emit_jump(Opcode::JUMP, 0)
      else
        0
      end
      body_start = @code_count
      declaration_statement = @current.kind() == :def || @current.kind() == :closure || @current.kind() == :class ||
        @current.kind() == :sealed || @current.kind() == :struct ||
        @current.kind() == :interface || @current.kind() == :module
      if @current.kind() == :def
        result = self.compile_definition()
      elsif @current.kind() == :closure
        result = self.compile_definition(true)
      elsif @current.kind() == :class || @current.kind() == :sealed
        result = self.compile_class()
      elsif @current.kind() == :struct
        result = self.compile_struct()
      elsif @current.kind() == :interface
        result = self.compile_interface()
      elsif @current.kind() == :module
        result = self.compile_module()
      elsif @current.kind() == :break || @current.kind() == :next || @current.kind() == :redo
        result = self.compile_break()
      elsif @current.kind() == :return
        result = self.compile_return()
      elsif @current.kind() == :raise
        result = self.compile_raise()
      elsif @current.kind() == :retry
        result = self.compile_retry()
      elsif self.index_assignment_ahead?()
        result = self.compile_index_assignment()
      elsif self.multi_assignment_ahead?()
        result = self.compile_multi_assignment()
      elsif self.compound_assignment_ahead?()
        result = self.compile_compound_assignment()
      elsif self.assignment_ahead?()
        result = self.compile_assignment()
      else
        result = self.parse_expression()
      end
      if has_postfix
        if @current.kind() != postfix
          self.fail("expected postfix condition")
          return result
        end
        self.advance_token()
        # `i += 1 while i < 5`: the condition runs first and the loop is nil.
        body_exit = if postfix_loop
          nil
        else
          self.emit_instruction2(Opcode::MOVE, postfix_result, result)
          self.emit_jump(Opcode::JUMP, 0)
        end
        condition_start = @code_count
        condition = self.parse_expression()
        body_jump = self.emit_jump(if postfix == :if || postfix == :while
          Opcode::JUMP_IF_TRUE
        else
          Opcode::JUMP_IF_FALSE
        end, condition)
        self.emit_instruction1(Opcode::NIL, postfix_result)
        self.patch_jump(condition_jump, condition_start)
        self.patch_jump(body_exit, @code_count) if body_exit != nil
        self.patch_jump(body_jump, body_start)
        result = postfix_result
      end
      if !has_postfix && declaration_statement && (@current.kind() == :if || @current.kind() == :unless)
        self.fail("postfix modifiers cannot follow declarations")
      elsif @current.kind() == :newline
        self.skip_newlines()
      elsif !self.at_block_end?()
        self.fail("expected newline after expression")
      end
    end
    result
  end

  # Top-level named functions and nested closures at any depth -- see
  # @function_nesting_depth's own comment for the full scope. A
  # top-level function is found later by name via
  # @functions/find_function and called with CALL; a nested `def`
  # instead becomes a local variable (named after the function) holding
  # a Closure value, called with CALL_CLOSURE like any other
  # closure-valued local -- compiler.c's own distinction, mirrored
  # exactly (`at_top_level`, computed from @function_nesting_depth
  # *before* it's incremented for this def's own body).
  # Split into several small methods (parse_parameter_names/
  # compile_function_body/emit_closure below), not just for readability:
  # every local variable anywhere in one method body counts toward that
  # method's own 256-register budget (register allocation is monotonic,
  # never recycled -- see Compiler.next_register in compiler.c), and the
  # first, single-method version of this exhausted it outright ("program
  # needs too many registers"), the exact same failure mode
  # selfhost/lexer.d6's own next_token/scan_punctuation split hit and
  # documented in Phase 2. Worth remembering for the rest of this port:
  # any method this size needs to be split from the start, not after
  # hitting the limit.
  # Anonymous `do |params| ... end` closure literal attached to a call's
  # argument list -- pure sugar over the same nested-closure machinery
  # compile_definition uses (declare_function, eager unconditional
  # capture, BOX_LOCAL+CLOSURE), minus every def-specific piece that
  # doesn't apply to a block: no name, no self_offset, no operator
  # methods, no return type, no `= expr` endless form. Deliberately NOT
  # built on top of compile_function_body/emit_closure: those emit
  # "expected 'end' after function body" and push a named local for the
  # result, and this needs "expected 'end' after block body" (to match
  # compiler.c's own compile_block exactly, for the differential error
  # tests) and must NOT bind a name in the outer scope (a block is only
  # ever the call's own trailing argument, never referenced afterward).
  # Mirrors compiler.c's compile_block exactly, including that neither
  # side requires a newline before the body: compile_sequence already
  # skips leading newlines itself.
  def compile_block()
    self.advance_token()
    parameter_names = []
    if @current.kind() == :pipe
      self.advance_token()
      self.skip_newlines()
      if @current.kind() != :pipe
        more = true
        while more
          if @current.kind() != :identifier
            self.fail("expected block parameter name")
            return 0
          end
          parameter_names.push(self.token_text(@current))
          self.advance_token()
          self.skip_newlines()
          if @current.kind() == :comma
            self.advance_token()
            self.skip_newlines()
            more = true
          else
            more = false
          end
        end
      end
      if @current.kind() != :pipe
        self.fail("expected '|' after block parameters")
        return 0
      end
      self.advance_token()
    end

    # Inside a method the block sees self as its register 0, as in
    # compiler.c's compile_block: a boxed copy of the enclosing self is
    # captured after the enclosing locals, and the CAPTURED_SELF owner
    # (65533) makes the VM pass the block's arguments from register 1.
    self_copy = nil
    if @in_method || @in_singleton_method
      self_copy = self.allocate_register()
      self.emit_instruction2(Opcode::MOVE, self_copy, 0)
      self.emit_instruction1(Opcode::BOX_LOCAL, self_copy)
    end
    function_index = @builder.declare_function("<block>", parameter_names.length(),
      parameter_names.length())
    @builder.set_function_owner_class(function_index, 65533) if self_copy != nil
    enclosing_locals = @locals

    outer_locals = @locals
    outer_loop_captures_pending = @loop_captures_pending
    outer_current_block_name = @current_block_name
    outer_current_block_type = @current_block_type
    outer_in_block = @in_block
    outer_block_has_break = @block_has_break
    outer_block_returns_early = @block_returns_early
    context = @block_context
    @block_context = nil
    outer_loops = @loops
    outer_begin_depth = @begin_depth
    outer_next_register = @next_register
    outer_code_count = @code_count
    outer_function_index = @current_function_index
    outer_enclosing_locals = @enclosing_locals
    outer_return_type = @current_return_type
    outer_type_facts = @type_facts
    outer_declared_types = @declared_types

    @locals = []
    @loop_captures_pending = false
    @in_block = true
    @block_has_break = false
    @block_returns_early = false
    @loops = []
    @begin_depth = 0
    @next_register = 0
    @code_count = 0
    @current_function_index = function_index
    @enclosing_locals = enclosing_locals
    # A `next value` is checked against the contextual result type.
    @current_return_type = if context == nil then nil else context[4] end
    @type_facts = []
    @declared_types = []
    @function_nesting_depth = @function_nesting_depth + 1

    if self_copy != nil
      self_register = self.allocate_register()
      self.emit_instruction2(Opcode::GET_CAPTURE, self_register, enclosing_locals.length())
    end
    index = 0
    while index < parameter_names.length()
      register = self.allocate_register()
      @locals.push([parameter_names[index], register, false])
      # The contextual parameter type is part of the block's Callable
      # signature, which typed Callable checks read, and a fact in its body.
      if context != nil && index < context[5].length()
        parameter_type = context[5][index]
        set_index = self.declare_annotation(parameter_type)
        @builder.set_parameter_type(function_index, index, set_index) unless @failed
        @declared_types.push([register, parameter_type])
        fact = self.annotation_single_type(parameter_type)
        self.set_type_fact(register, fact) if fact != nil
      end
      if parameter_names[index] == @current_block_name
        @current_block_name = nil
        @current_block_type = nil
      end
      index = index + 1
    end

    # Eager capture: every enclosing local not shadowed by a block
    # parameter of the same name becomes a directly-accessible local
    # right away -- same unconditional design compile_function_body's
    # own nested-def handling uses, not a selective "only if referenced"
    # scheme.
    index = 0
    while index < enclosing_locals.length()
      entry = enclosing_locals[index]
      if self.find_local(entry[0]) == nil
        cell = self.allocate_register()
        self.emit_instruction2(Opcode::GET_CAPTURE_CELL, cell, index)
        @locals.push([entry[0], cell, true])
      end
      index = index + 1
    end

    body_result = self.compile_body()
    # The result is checked against the contextual type, or else its known
    # type becomes the block's declared result, as compiler.c's
    # finish_block_return does (only without an early `next value`, whose
    # type the body alone doesn't show).
    if @current_return_type != nil
      set_index = self.emit_type_check(body_result, @current_return_type)
      @builder.set_return_type(function_index, set_index) unless @failed
    elsif !@block_returns_early && self.type_fact(body_result) != nil && !@failed
      set_index = @builder.declare_type_set(function_index,
        [[self.type_fact(body_result), -1, -1, -1, -1, []]])
      @builder.set_return_type(function_index, set_index)
    end
    self.emit_instruction1(Opcode::RETURN, body_result)
    if @current.kind() != :end
      self.fail("expected 'end' after block body")
    else
      self.advance_token()
    end
    @builder.set_register_count(function_index, @next_register)

    @locals = outer_locals
    @loop_captures_pending = outer_loop_captures_pending
    @current_block_name = outer_current_block_name
    @current_block_type = outer_current_block_type
    @in_block = outer_in_block
    @loops = outer_loops
    @begin_depth = outer_begin_depth
    @next_register = outer_next_register
    @code_count = outer_code_count
    @current_function_index = outer_function_index
    @enclosing_locals = outer_enclosing_locals
    @current_return_type = outer_return_type
    @type_facts = outer_type_facts
    @declared_types = outer_declared_types
    @function_nesting_depth = @function_nesting_depth - 1

    # BOX_LOCAL + CLOSURE, emitted into the *outer* (caller's) bytecode
    # now that @locals has been restored -- same shape emit_closure ends
    # with, minus its final `@locals.push` (a block binds no name).
    capture_registers = []
    index = 0
    while index < enclosing_locals.length()
      entry = enclosing_locals[index]
      self.emit_instruction1(Opcode::BOX_LOCAL, entry[1])
      entry[2] = true
      capture_registers.push(entry[1])
      index = index + 1
    end
    capture_registers.push(self_copy) if self_copy != nil
    result = self.allocate_register()
    self.emit_byte(Opcode::CLOSURE)
    self.emit_register(result)
    self.emit_function_index(function_index)
    self.emit_byte(capture_registers.length())
    index = 0
    while index < capture_registers.length()
      self.emit_register(capture_registers[index])
      index = index + 1
    end
    # The break lands in this frame, in the call the block is passed to.
    if @block_has_break
      @nonlocal_landing_functions.push(@current_function_index)
      @builder.set_nonlocal_landing(@current_function_index)
      @pending_block_call = function_index
    end
    @block_has_break = outer_block_has_break
    @block_returns_early = outer_block_returns_early
    result
  end

  # `closure name() ... end` is a nested def that also captures self: register
  # 0 holds it, as in a method, though the closure's arity doesn't count it.
  def compile_definition(captures_self = false)
    if captures_self && !@in_method && !@in_singleton_method
      self.fail("closure requires an enclosing method -- no 'self' is available here")
      return 0
    end
    self.advance_token()
    at_top_level = @function_nesting_depth == 0
    # A plain `def` (as opposed to a class body's own `def`, routed to
    # compile_method instead) never legitimately names an operator --
    # only recognized here to produce the same rejection compile_method
    # gives inside a class, matching compiler.c's own unified
    # compile_definition exactly rather than falling through to the
    # generic "expected function name" message.
    if operator_method_token?(@current.kind()) &&
       @current_class_index == nil && @current_module_index == nil
      self.fail("operator methods can only be defined inside a class or module")
      return 0
    end
    if @current.kind() != :identifier
      self.fail("expected function name after 'def'")
      return 0
    end
    name = self.token_text(@current)
    if at_top_level && self.find_function(name) != nil
      self.fail("function is already defined")
      return 0
    end
    self.advance_token()
    outer_type_variables = @current_type_variables
    @current_type_variables = self.parse_type_variables()
    return 0 if @failed
    if @current.kind() != :left_paren
      self.fail("expected '(' after function name")
      return 0
    end
    self.advance_token()
    parsed_parameters = self.parse_parameter_names()
    return 0 if @failed
    if @current.kind() != :right_paren
      self.fail("expected ')' after parameters")
      return 0
    end
    self.advance_token()
    parameter_names = parsed_parameters[0]
    parameter_types = parsed_parameters[1]
    parameter_defaults = parsed_parameters[2]
    has_block_parameter = parsed_parameters[3]
    return_type = nil
    if @current.kind() == :arrow
      self.advance_token()
      return_type = self.parse_type_annotation()
    end
    return 0 if @failed

    arity = parameter_names.length()
    # A `def` nested directly inside a method or module-method body
    # (never at_top_level, since a class/module body itself routes `def`
    # to compile_method instead -- see compile_method's own comment)
    # reserves register 0 for its OWN independent `self`, exactly like
    # an ordinary instance method, rather than capturing the enclosing
    # method's self as a lexical binding -- mirroring compiler.c's
    # compile_definition, which applies this reservation purely from
    # current_class/current_module context, unconditionally on nesting.
    # Confirmed directly against the real compiler's bytecode output for
    # tests/cases/legacy_0093.d6's `def self.square_area_patch` /
    # `def square_area` pattern: the nested closure's own body reads
    # `@width` via GET_IVAR on ITS OWN register 0, with zero captures.
    self_offset = if @current_class_index != nil || @current_module_index != nil
      1
    else
      0
    end
    required_arity = required_parameter_count(parsed_parameters)
    @parameter_shape = [parsed_parameters[4], has_block_parameter]
    function_index = if captures_self
      @builder.declare_function(name, arity, required_arity)
    else
      @builder.declare_function(name, arity + self_offset, required_arity + self_offset)
    end
    if captures_self
      self_offset = 1
      @builder.set_function_owner_class(function_index, 65533)
    elsif self_offset == 1
      # 65534 (UINT16_MAX-1, DIAMOND_OWNER_MODULE) is the same module-method
      # sentinel declare_module_method's bridge handler uses -- distinct from
      # 65535 ("not a method"), so REDEFINE_METHOD's owner_class check (and
      # the private-method parameter_offset bypass) both still treat
      # this function as belonging to its class/module.
      @builder.set_function_owner_class(function_index, if @current_class_index != nil
        @current_class_index
      else
        65534
      end)
    end
    @builder.set_type_variables(function_index, @current_type_variables)
    if at_top_level
      @functions.push([name, function_index, arity, parameter_names,
                       @current_type_variables.length(), return_type,
                       required_arity, parameter_types, has_block_parameter])
    end
    # Every entry currently in scope becomes a capture candidate,
    # unconditionally -- mirroring compiler.c's own eager design (not
    # just names the nested body actually goes on to reference). Empty
    # for a top-level def (nothing to capture from the top-level script
    # itself, and top-level functions don't capture anything anyway).
    enclosing_locals = if at_top_level
      []
    else
      @locals
    end

    @self_capture_index = if captures_self then enclosing_locals.length() else nil end
    self.compile_function_body(function_index, parameter_names, parameter_types,
                               parameter_defaults, return_type, enclosing_locals, self_offset)
    @current_type_variables = outer_type_variables

    if at_top_level
      # Evaluates to nil, a sole-writer fresh register in the
      # (now-restored) outer function -- matching compile_definition.c's
      # own at_top_level branch exactly (no opcode needed).
      return self.allocate_register()
    end
    self.emit_closure(function_index, enclosing_locals, name, captures_self)
  end

  def parse_type_variables()
    variables = []
    return variables unless @current.kind() == :left_bracket
    self.advance_token()
    self.skip_newlines()
    while !@failed && @current.kind() != :right_bracket
      if @current.kind() != :identifier || variables.length() == 8
        self.fail("expected generic type parameter")
      else
        name = self.token_text(@current)
        index = 0
        while index < variables.length()
          self.fail("duplicate generic type parameter") if variables[index] == name
          index = index + 1
        end
        variables.push(name) unless @failed
        self.advance_token() unless @failed
        self.skip_newlines()
        if @current.kind() == :comma
          self.advance_token()
          self.skip_newlines()
        else
          break
        end
      end
    end
    if !@failed && @current.kind() != :right_bracket
      self.fail("expected ']' after generic type parameters")
    else
      self.advance_token() unless @failed
    end
    variables
  end

  # Returns [names, types]: parallel arrays, `types[i]` is a recursive
  # annotation tree, or nil if it
  # had no `: Type` annotation. Resolving a type name to a type id and
  # declaring its type set happens later, inside the callee's own
  # switched-in context (see compile_function_body/emit_parameter_type_checks)
  # -- declare_type_set needs the *callee's* function_index, which isn't
  # known yet while still parsing the parameter list in the caller's
  # (outer) context.
  # Default-value expressions aren't parsed here -- this runs before
  # compile_method_body's own register-scope reset, and a default is a
  # real expression that needs to compile into the *function's* frame,
  # not the caller's. Each default's position (start offset, line,
  # column, right after its '=') is recorded instead and skipped over
  # with a nesting-aware scan (mirroring compiler.c's own parameter_count
  # lookahead), so compile_method_body can later re-lex and compile it
  # for real from that saved position -- the same embedded-Lexer
  # save/restore trick parse_string already uses for interpolation.
  def parse_parameter_names()
    self.skip_newlines()
    names = []
    types = []
    defaults = []
    has_block_parameter = false
    variadic_index = nil
    saw_default = false
    if @current.kind() != :right_paren
      more = true
      while more && !@failed
        block_parameter = @current.kind() == :ampersand
        has_block_parameter = true if block_parameter
        self.advance_token() if block_parameter
        variadic = !block_parameter && @current.kind() == :star
        if variadic
          if variadic_index != nil
            self.fail("a function can only declare one variadic parameter")
            return nil
          end
          self.advance_token()
        end
        if @current.kind() != :identifier
          self.fail("expected parameter name")
          more = false
        elsif variadic
          # `*name` collects the remaining arguments into an Array: no type,
          # no default, and only a `&block` may follow it.
          names.push(self.token_text(@current))
          types.push(nil)
          defaults.push(nil)
          variadic_index = names.length() - 1
          self.advance_token()
          if @current.kind() == :colon
            self.fail("a variadic parameter cannot have a type annotation")
            return nil
          end
          if @current.kind() == :equal
            self.fail("a variadic parameter cannot have a default value")
            return nil
          end
          self.skip_newlines()
          more = false
          if @current.kind() == :comma
            self.advance_token()
            self.skip_newlines()
            if @current.kind() != :ampersand
              self.fail("only a block parameter may follow a variadic parameter")
              return nil
            end
            more = true
          end
        else
          names.push(self.token_text(@current))
          self.advance_token()
          type_name = nil
          if @current.kind() == :colon
            self.advance_token()
            type_name = self.parse_type_annotation()
            more = false if @failed
          end
          types.push(type_name)
          default_position = nil
          if !@failed && @current.kind() == :equal
            self.advance_token()
            default_position = [@current.start(), @current.line(), @current.column()]
            self.skip_default_expression()
            saw_default = true
          elsif saw_default && !block_parameter
            self.fail("required parameter cannot follow a default parameter")
          end
          defaults.push(default_position)
          self.skip_newlines()
          if block_parameter && @current.kind() == :comma
            self.fail("a block parameter must be the last parameter")
          end
          if !@failed && @current.kind() == :comma
            self.advance_token()
            self.skip_newlines()
            more = @current.kind() != :right_paren
          else
            more = false
          end
        end
      end
    end
    [names, types, defaults, has_block_parameter, variadic_index]
  end

  def skip_default_expression()
    nesting = 0
    scanning = true
    while scanning && !@failed
      kind = @current.kind()
      if kind == :left_paren || kind == :left_bracket || kind == :left_brace
        nesting = nesting + 1
      elsif kind == :right_paren || kind == :right_bracket || kind == :right_brace
        if nesting == 0
          scanning = false
        else
          nesting = nesting - 1
        end
      elsif kind == :comma && nesting == 0
        scanning = false
      elsif kind == :eof
        self.fail("expected ')' after parameters")
        scanning = false
      end
      self.advance_token() if scanning
    end
  end

  def parse_type_annotation()
    members = []
    parsing = true
    while parsing && !@failed
      if @current.kind() != :identifier
        self.fail("expected type annotation")
      else
        name = self.token_text(@current)
        name_token = @current
        self.advance_token()
        while !@failed && @current.kind() == :double_colon
          self.advance_token()
          if @current.kind() != :identifier
            self.fail("type name is too long")
          else
            name = name + "::" + self.token_text(@current)
            self.advance_token()
          end
        end
        if members.length() == 8
          self.fail("too many types in union")
        else
          argument = nil
          second_argument = nil
          callable_arity = -1
          callable_return = nil
          callable_parameters = nil
          if !@failed && @current.kind() == :left_bracket
            if name == "Callable"
              callable = self.parse_callable_arguments()
              callable_arity = callable[0]
              callable_return = callable[1]
              callable_parameters = callable[2]
            elsif name != "Array" && name != "Hash"
              # A generic class: its declaration may still be ahead (a struct
              # field naming its own struct), so declare_annotation checks it.
              self.advance_token()
              self.skip_newlines()
              argument = self.parse_type_annotation()
              self.skip_newlines()
              if @current.kind() == :comma
                self.advance_token()
                self.skip_newlines()
                second_argument = self.parse_type_annotation()
                self.skip_newlines()
              end
              if !@failed && @current.kind() != :right_bracket
                self.fail("expected ']' after class type arguments")
              else
                self.advance_token() unless @failed
              end
            else
              self.advance_token()
              self.skip_newlines()
              argument = self.parse_type_annotation()
              self.skip_newlines()
              if name == "Hash"
                if @current.kind() != :comma
                  self.fail("expected ',' between Hash key and value types")
                else
                  self.advance_token()
                  self.skip_newlines()
                  second_argument = self.parse_type_annotation()
                  self.skip_newlines()
                end
              end
              if !@failed && @current.kind() != :right_bracket
                self.fail("expected ']' after collection type arguments")
              else
                self.advance_token() unless @failed
              end
            end
          elsif name == "Array" || name == "Hash"
            # Unparameterized collections remain valid dynamic contracts.
          end
          if !@failed
            member = [name, argument, second_argument, callable_arity,
                      callable_return, callable_parameters]
            self.fail("duplicate type in union") if members.include?(member)
            @type_name_tokens[name] = name_token unless @type_name_tokens.include_key?(name)
            members.push(member)
          end
        end
        if !@failed && @current.kind() == :pipe
          self.advance_token()
        else
          parsing = false
        end
      end
    end
    members
  end

  def parse_callable_arguments()
    self.advance_token()
    self.skip_newlines()
    arity = -1
    return_type = nil
    parameter_types = nil
    if @current.kind() == :integer
      text = self.token_text(@current)
      arity = text.to_i()
      if arity > 16
        self.fail("Callable arity cannot exceed 16")
      end
      self.advance_token() unless @failed
    elsif @current.kind() == :left_bracket
      self.advance_token()
      self.skip_newlines()
      parameter_types = []
      while !@failed && @current.kind() != :right_bracket
        if parameter_types.length() == 16
          self.fail("Callable cannot exceed 16 parameters")
        else
          parameter_types.push(self.parse_type_annotation())
          self.skip_newlines()
          if @current.kind() == :comma
            self.advance_token()
            self.skip_newlines()
          else
            break
          end
        end
      end
      if !@failed && @current.kind() != :right_bracket
        self.fail("expected ']' after Callable parameters")
      else
        self.advance_token() unless @failed
      end
      arity = parameter_types.length() unless @failed
    else
      self.fail("expected Callable arity or parameter list")
    end
    if !@failed && @current.kind() == :comma
      self.advance_token()
      self.skip_newlines()
      return_type = self.parse_type_annotation()
    end
    self.skip_newlines()
    if !@failed && @current.kind() != :right_bracket
      self.fail("expected ']' after collection type arguments")
    else
      self.advance_token() unless @failed
    end
    [arity, return_type, parameter_types]
  end

  def resolve_type_name(name)
    type_id = self.find_type_name(name)
    self.fail("unknown type annotation") if type_id == nil
    type_id || 0
  end

  # An annotation may name a type declared later, which matches no known type.
  def annotation_type_id(name) = self.find_type_name(name) || Type::UNDECLARED

  def find_type_name(name)
    return Type::INT if name == "Int"
    return Type::FLOAT if name == "Float"
    return Type::STRING if name == "String"
    return Type::BOOL if name == "Bool"
    return Type::SIZED if name == "Sized"
    return Type::SYMBOL if name == "Symbol"
    return Type::NIL if name == "Nil"
    return Type::ARRAY if name == "Array"
    return Type::HASH if name == "Hash"
    return Type::CALLABLE if name == "Callable"
    variable = 0
    while variable < @current_type_variables.length()
      return Type::VARIABLE_BASE + variable if @current_type_variables[variable] == name
      variable = variable + 1
    end
    interface_entry = self.find_interface(name)
    if interface_entry != nil
      return Type::INTERFACE_BASE + interface_entry[1]
    end
    class_entry = self.find_forward_class(name, @current_module_name)
    if class_entry != nil
      return Type::CLASS_BASE + class_entry[1]
    end
    # Native types come after classes, so a program's own Channel still wins.
    native = @builder.native_type_id(name)
    native
  end

  # A type set can name a class or interface declared later, as compiler.c's
  # discovery pass allows: a placeholder class stands in until every
  # declaration is known. A name still unknown then is the error it looks like.
  def resolve_forward_type_names()
    index = 0
    while index < @forward_type_names.length() && !@failed
      entry = @forward_type_names[index]
      name = entry[3]
      interface_entry = self.find_interface(name)
      class_entry = self.find_forward_class(name, entry[5])
      type_id = if interface_entry != nil
        Type::INTERFACE_BASE + interface_entry[1]
      elsif class_entry != nil
        Type::CLASS_BASE + class_entry[1]
      else
        nil
      end
      if type_id == nil
        token = @type_name_tokens[name]
        self.fail_at(token.start(), token.line(), token.column(), "unknown type annotation")
      else
        self.check_class_type_arguments(entry[4]) if entry[4][1] != nil
        @builder.patch_type_set_member(entry[0], entry[1], entry[2], type_id) unless @failed
      end
      index = index + 1
    end
  end

  def compile_interface()
    self.advance_token()
    if @function_nesting_depth != 0 || @current_class_index != nil
      self.fail("interfaces must be declared at top level")
      return 0
    end
    if @current.kind() != :identifier
      self.fail("expected valid interface name")
      return 0
    end
    name = self.token_text(@current)
    if @current_module_name != nil
      name = @current_module_name + "::" + name
    end
    if self.find_interface(name) != nil || self.find_class(name) != nil
      self.fail("type name is already defined")
      return 0
    end
    index = 0
    while index < @modules.length()
      self.fail("type name is already defined") if @modules[index][0] == name
      index = index + 1
    end
    return 0 if @failed
    interface_index = @builder.declare_interface(name)
    @interfaces.push([name, interface_index])
    self.advance_token()
    if @current.kind() == :less
      self.advance_token()
      self.skip_newlines()
      parsing_bases = true
      while parsing_bases && !@failed
        if @current.kind() != :identifier
          self.fail("expected base interface name after '<'")
        else
          base_name = self.token_text(@current)
          base = self.find_interface(base_name)
          if base == nil && @current_module_name != nil
            base = self.find_interface(@current_module_name + "::" + base_name)
          end
          if base == nil
            self.fail("undefined base interface")
          else
            @builder.inherit_interface(interface_index, base[1])
            self.advance_token()
            if @current.kind() == :comma
              self.advance_token()
              self.skip_newlines()
            else
              parsing_bases = false
            end
          end
        end
      end
    end
    return 0 unless self.consume_block_start()
    while !@failed && @current.kind() != :end
      self.compile_interface_method(interface_index)
      self.skip_newlines()
    end
    if @current.kind() == :end
      self.advance_token()
    else
      self.fail("expected 'end' after interface")
    end
    self.allocate_register()
  end

  def compile_interface_method(interface_index)
    if @current.kind() != :def
      self.fail("expected method signature in interface")
      return
    end
    self.advance_token()
    if @current.kind() != :identifier && !operator_method_token?(@current.kind())
      self.fail("expected interface method name")
      return
    end
    name = self.token_text(@current)
    self.advance_token()
    if @current.kind() != :left_paren
      self.fail("expected '(' after interface method")
      return
    end
    self.advance_token()
    parsed = self.parse_parameter_names()
    return if @failed
    if @current.kind() != :right_paren
      self.fail("expected ')' after interface parameters")
      return
    end
    self.advance_token()
    return_type = nil
    if @current.kind() == :arrow
      self.advance_token()
      return_type = self.parse_type_annotation()
    end
    parameter_sets = []
    index = 0
    while index < parsed[1].length() && !@failed
      annotation = parsed[1][index]
      if annotation == nil
        parameter_sets.push(-1)
      else
        parameter_sets.push(self.declare_annotation(annotation))
      end
      index = index + 1
    end
    return_set = if return_type == nil
      -1
    else
      self.declare_annotation(return_type)
    end
    if !@failed
      @builder.declare_interface_method(interface_index, name,
        parsed[0].length(), parameter_sets, return_set)
    end
  end

  # `Box[Int]`: Box must take exactly that many type arguments.
  def check_class_type_arguments(member)
    return if member[0] == "Array" || member[0] == "Hash"
    entry = self.find_class(member[0])
    count = if member[2] == nil then 1 else 2 end
    if entry == nil || class_type_parameters(entry).length() != count || entry[5]
      self.fail("this type does not accept arguments")
    end
  end

  def declare_annotation(type_annotation)
    descriptors = []
    forward_members = []
    index = 0
    while index < type_annotation.length() && !@failed
      member = type_annotation[index]
      type_id = self.find_type_name(member[0])
      if type_id == nil
        forward_members.push([index, member])
        type_id = Type::CLASS_BASE
      elsif member[1] != nil
        self.check_class_type_arguments(member)
      end
      argument_set = if member[1] == nil
        -1
      else
        self.declare_annotation(member[1])
      end
      second_argument_set = if member[2] == nil
        -1
      else
        self.declare_annotation(member[2])
      end
      callable_return_set = if member[4] == nil
        -1
      else
        self.declare_annotation(member[4])
      end
      callable_parameter_sets = []
      if member[5] != nil
        parameter = 0
        while parameter < member[5].length()
          callable_parameter_sets.push(self.declare_annotation(member[5][parameter]))
          parameter = parameter + 1
        end
      end
      descriptors.push([type_id, argument_set, second_argument_set, member[3],
                        callable_return_set, callable_parameter_sets])
      index = index + 1
    end
    return 0 if @failed
    set_index = @builder.declare_type_set(@current_function_index, descriptors)
    index = 0
    while index < forward_members.length()
      entry = forward_members[index]
      @forward_type_names.push([@current_function_index, set_index, entry[0], entry[1][0], entry[1], @current_module_name])
      index = index + 1
    end
    set_index
  end

  def emit_type_check(reg, type_annotation)
    fact = self.type_fact(reg)
    if fact != nil && self.annotation_accepts_type?(type_annotation, fact)
      return self.declare_annotation(type_annotation)
    end
    set_index = self.declare_annotation(type_annotation)
    return if @failed
    self.emit_instruction2(Opcode::CHECK_TYPE, reg, set_index)
    set_index
  end

  def type_fact(reg)
    index = @type_facts.length() - 1
    while index >= 0
      return @type_facts[index][1] if @type_facts[index][0] == reg
      index = index - 1
    end
    nil
  end

  def set_type_fact(reg, type_id) = @type_facts.push([reg, type_id])

  def copy_type_facts()
    copy = []
    index = 0
    while index < @type_facts.length()
      copy.push(@type_facts[index])
      index = index + 1
    end
    copy
  end

  def merge_local_type_facts(original, then_facts, else_facts)
    @type_facts = original
    index = 0
    while index < @locals.length()
      local = @locals[index]
      unless local[2]
        then_fact = type_fact_in(then_facts, local[1])
        else_fact = type_fact_in(else_facts, local[1])
        if then_fact != nil && then_fact == else_fact
          self.set_type_fact(local[1], then_fact)
        end
      end
      index = index + 1
    end
  end

  # A bare type-fact match alone isn't enough to skip the runtime
  # CHECK_TYPE: a fact only ever records the bare container kind (e.g.
  # Type::HASH for any hash literal), never its element constraint, so
  # "Hash" trivially matching a `-> Hash[K, V]` annotation would
  # silently skip enforcing K/V entirely. Mirrors compiler.c's own
  # emit_type_check, which forces the check whenever the matched set
  # member has an argument_set, precisely to keep collection element
  # constraints (concrete or type-variable) from ever being skipped this
  # way -- confirmed missing by tracing why a self-hosted-compiled
  # `pair[K, V](...) -> Hash[K, V]` never attached the runtime
  # constraint a later `result[wrong_key] = ...` needs.
  def annotation_accepts_type?(annotation, type_id)
    index = 0
    while index < annotation.length()
      member = annotation[index]
      if self.annotation_type_id(member[0]) == type_id
        return member[1] == nil
      end
      index = index + 1
    end
    false
  end

  def declared_type(reg)
    index = @declared_types.length() - 1
    while index >= 0
      return @declared_types[index][1] if @declared_types[index][0] == reg
      index = index - 1
    end
    nil
  end

  def non_nil_single_type(annotation)
    found = nil
    index = 0
    while index < annotation.length()
      type_id = self.annotation_type_id(annotation[index][0])
      if type_id != Type::NIL
        return nil if found != nil
        found = type_id
      end
      index = index + 1
    end
    found
  end

  def remaining_single_type(annotation, excluded)
    found = nil
    index = 0
    while index < annotation.length()
      type_id = self.annotation_type_id(annotation[index][0])
      if type_id != excluded
        return nil if found != nil
        found = type_id
      end
      index = index + 1
    end
    found
  end

  def annotation_single_type(annotation)
    return nil if annotation == nil || annotation.length() != 1
    self.annotation_type_id(annotation[0][0])
  end

  def binary_result_fact(operator, left, right)
    left_fact = self.type_fact(left)
    right_fact = self.type_fact(right)
    return Type::INT if left_fact == Type::INT && right_fact == Type::INT
    left_numeric = left_fact == Type::INT || left_fact == Type::FLOAT
    right_numeric = right_fact == Type::INT || right_fact == Type::FLOAT
    # Excludes spaceship explicitly: unlike the arithmetic operators, its
    # own result is always Int-or-Nil, never Float, regardless of operand
    # types -- the Type::INT return just above stays correct for
    # spaceship unmodified, since two known Ints really do always
    # produce an Int result under this design. Mirrors compiler.c's own
    # fix exactly (same bug shape, same reasoning -- see its comment).
    if operator != :spaceship && left_numeric && right_numeric &&
       (left_fact == Type::FLOAT || right_fact == Type::FLOAT)
      return Type::FLOAT
    end
    if operator == :plus && left_fact == Type::STRING && right_fact == Type::STRING
      return Type::STRING
    end
    nil
  end

  def apply_result_join(destination, left, right)
    left_fact = self.type_fact(left)
    right_fact = self.type_fact(right)
    self.set_type_fact(destination, left_fact) if left_fact != nil && left_fact == right_fact
    left_declaration = self.declared_type(left)
    right_declaration = self.declared_type(right)
    if left_declaration != nil && left_declaration == right_declaration
      @declared_types.push([destination, left_declaration])
    end
  end

  def annotation_with_nil(annotation)
    result = []
    has_nil = false
    index = 0
    while index < annotation.length()
      result.push(annotation[index])
      has_nil = true if self.annotation_type_id(annotation[index][0]) == Type::NIL
      index = index + 1
    end
    result.push(["Nil", nil, nil, -1, nil, nil]) unless has_nil
    result
  end

  def homogeneous_element_annotation(elements)
    return nil if elements.length() == 0
    fact = self.type_fact(elements[0])
    return nil if fact == nil
    index = 1
    while index < elements.length()
      return nil if self.type_fact(elements[index]) != fact
      index = index + 1
    end
    name = if fact == Type::INT
      "Int"
    elsif fact == Type::FLOAT
      "Float"
    elsif fact == Type::STRING
      "String"
    elsif fact == Type::BOOL
      "Bool"
    elsif fact == Type::NIL
      "Nil"
    else
      nil
    end
    return nil if name == nil
    [[name, nil, nil, -1, nil, nil]]
  end

  # Switches compiler state into the new function, compiles its body,
  # and restores the outer state afterward -- the part of
  # compile_definition that's identical for a top-level function and a
  # nested closure alike (the only difference between the two is what
  # happens with the result *after* this returns, handled by
  # compile_definition/emit_closure).
  def compile_function_body(function_index, parameter_names, parameter_types,
                            parameter_defaults, return_type, enclosing_locals, self_offset)
    outer_locals = @locals
    outer_loop_captures_pending = @loop_captures_pending
    outer_current_block_name = @current_block_name
    outer_current_block_type = @current_block_type
    outer_in_block = @in_block
    outer_loops = @loops
    outer_begin_depth = @begin_depth
    outer_next_register = @next_register
    outer_code_count = @code_count
    outer_function_index = @current_function_index
    outer_enclosing_locals = @enclosing_locals
    outer_return_type = @current_return_type
    outer_type_facts = @type_facts
    outer_declared_types = @declared_types
    outer_in_method = @in_method
    outer_in_singleton_method = @in_singleton_method
    # A closure in a singleton method keeps calling self's singleton methods.
    closure_in_singleton = @self_capture_index != nil && @in_singleton_method
    @in_method = self_offset == 1 && !closure_in_singleton
    @in_singleton_method = closure_in_singleton

    @locals = []
    @loop_captures_pending = false
    @current_block_name = nil
    @current_block_type = nil
    @in_block = false
    @loops = []
    @begin_depth = 0
    @next_register = 0
    @code_count = 0
    @current_function_index = function_index
    @enclosing_locals = enclosing_locals
    outer_method_function_index = @method_function_index
    outer_method_return_type = @method_return_type
    @current_return_type = return_type
    @method_function_index = function_index
    @method_return_type = return_type
    @type_facts = []
    @declared_types = []
    @function_nesting_depth = @function_nesting_depth + 1

    self.allocate_register() if self_offset == 1
    if @self_capture_index != nil
      self.emit_instruction2(Opcode::GET_CAPTURE, 0, @self_capture_index)
      @self_capture_index = nil
    end
    self.bind_parameters(function_index, parameter_names, parameter_types, parameter_defaults, self_offset)

    # GET_CAPTURE_CELL for every enclosing local not shadowed by one of
    # this function's own parameters -- from here on, referencing that
    # name inside the body reads/writes this cell (via the ordinary
    # find_local/read_local/compile_assignment paths, no special-casing
    # needed) rather than any register in the outer function directly.
    index = 0
    while index < enclosing_locals.length()
      entry = enclosing_locals[index]
      if self.find_local(entry[0]) == nil
        cell = self.allocate_register()
        self.emit_instruction2(Opcode::GET_CAPTURE_CELL, cell, index)
        @locals.push([entry[0], cell, true])
      end
      index = index + 1
    end

    endless = @current.kind() == :equal
    if endless
      self.advance_token()
      self.skip_newlines()
      self.mark_locals_captured() if self.statement_may_capture?()
      postfix = self.postfix_modifier_ahead()
      has_postfix = postfix == :if || postfix == :unless
      postfix_result = self.allocate_register() if has_postfix
      condition_jump = self.emit_jump(Opcode::JUMP, 0) if has_postfix
      body_start = @code_count
      # `raise` is a statement, not an expression, but `def f() = raise E`
      # is the natural way to write a method that only raises; without a
      # postfix condition the body never returns, so the declared return
      # type isn't checked against the raised value.
      raises = @current.kind() == :raise
      body_result = if raises
        self.compile_raise()
      else
        self.parse_expression()
      end
      if has_postfix
        if @current.kind() != postfix
          self.fail("expected postfix condition")
        else
          self.advance_token()
          self.emit_instruction2(Opcode::MOVE, postfix_result, body_result)
          body_exit = self.emit_jump(Opcode::JUMP, 0)
          condition_start = @code_count
          condition = self.parse_expression()
          body_jump = self.emit_jump(if postfix == :if
            Opcode::JUMP_IF_TRUE
          else
            Opcode::JUMP_IF_FALSE
          end, condition)
          self.emit_instruction1(Opcode::NIL, postfix_result)
          self.patch_jump(condition_jump, condition_start)
          self.patch_jump(body_exit, @code_count)
          self.patch_jump(body_jump, body_start)
          body_result = postfix_result
        end
      end
      before_check = @code_count
      if return_type != nil
        set_index = self.emit_type_check(body_result, return_type)
        @builder.set_return_type(function_index, set_index) unless @failed
      end
      self.maybe_rewrite_tail_call(body_result, before_check, return_type)
      self.emit_instruction1(Opcode::RETURN, body_result)
    elsif self.consume_block_start()
      body_result = self.compile_body()
      before_check = @code_count
      if return_type != nil
        set_index = self.emit_type_check(body_result, return_type)
        @builder.set_return_type(function_index, set_index) unless @failed
      end
      self.maybe_rewrite_tail_call(body_result, before_check, return_type)
      self.emit_instruction1(Opcode::RETURN, body_result)
      if @current.kind() != :end
        self.fail("expected 'end' after function body")
      else
        self.advance_token()
      end
    end
    @builder.set_register_count(function_index, @next_register)

    @locals = outer_locals
    @loop_captures_pending = outer_loop_captures_pending
    @current_block_name = outer_current_block_name
    @current_block_type = outer_current_block_type
    @in_block = outer_in_block
    @loops = outer_loops
    @begin_depth = outer_begin_depth
    @next_register = outer_next_register
    @code_count = outer_code_count
    @current_function_index = outer_function_index
    @enclosing_locals = outer_enclosing_locals
    @current_return_type = outer_return_type
    @method_function_index = outer_method_function_index
    @method_return_type = outer_method_return_type
    @type_facts = outer_type_facts
    @declared_types = outer_declared_types
    @in_method = outer_in_method
    @in_singleton_method = outer_in_singleton_method
    @function_nesting_depth = @function_nesting_depth - 1
  end

  # BOX_LOCAL runs back in the OUTER scope, after the nested body is
  # fully compiled: converts each captured outer register from a plain
  # value into a Cell in place (idempotent -- a no-op if it's already
  # one, e.g. this same local was captured by an earlier nested def
  # too), and marks the outer entry `captured` so every subsequent
  # read/write of that name in the outer function also goes through
  # GET_CELL/SET_CELL from here on, matching compiler.c's own
  # once-boxed-always-boxed semantics exactly.
  def emit_closure(function_index, enclosing_locals, name, captures_self = false)
    capture_registers = []
    index = 0
    while index < enclosing_locals.length()
      entry = enclosing_locals[index]
      self.emit_instruction1(Opcode::BOX_LOCAL, entry[1])
      entry[2] = true
      capture_registers.push(entry[1])
      index = index + 1
    end
    if captures_self
      self_copy = self.allocate_register()
      self.emit_instruction2(Opcode::MOVE, self_copy, 0)
      self.emit_instruction1(Opcode::BOX_LOCAL, self_copy)
      capture_registers.push(self_copy)
    end
    result = self.allocate_register()
    self.emit_byte(Opcode::CLOSURE)
    self.emit_register(result)
    self.emit_function_index(function_index)
    self.emit_byte(capture_registers.length())
    index = 0
    while index < capture_registers.length()
      self.emit_register(capture_registers[index])
      index = index + 1
    end
    @locals.push([name, result, false])
    result
  end

  # `class Name ... end` or `class Name < Superclass ... end` --
  # top-level only (no nested classes, no class declared inside a
  # function/method body: a much narrower scope cut than compiler.c's
  # own class declarations, which have no such restriction -- confirmed
  # by testing directly against the real compiler, not assumed).
  # `sealed class X` makes X itself impossible to instantiate (its
  # subclasses still can); the lexer only produces :sealed right before
  # `class`.
  def compile_class()
    sealed = @current.kind() == :sealed
    self.advance_token() if sealed
    self.advance_token()
    if @function_nesting_depth != 0 || @current_class_index != nil
      self.fail("classes must be declared at the top level")
      return 0
    end
    if @current.kind() != :identifier
      self.fail("expected valid class name")
      return 0
    end
    name = self.token_text(@current)
    if @current_module_name != nil
      name = @current_module_name + "::" + name
    end
    # A class can be reopened: the later body adds to the same entry.
    existing = self.find_class(name)
    reopened = nil
    if existing != nil
      index = 0
      while index < @classes.length()
        reopened = index if @classes[index][1] == existing[1]
        index = index + 1
      end
      if reopened == nil
        self.fail("class is already defined")
        return 0
      end
    end
    if self.find_interface(name) != nil
      self.fail("type name is already defined")
      return 0
    end
    index = 0
    while index < @modules.length()
      self.fail("type name is already defined") if @modules[index][0] == name
      index = index + 1
    end
    return 0 if @failed
    self.advance_token()
    if reopened != nil && (@current.kind() == :left_bracket || existing[4].length() > 0)
      self.fail("generic classes cannot be reopened")
      return 0
    end
    type_parameters = self.parse_class_type_parameters()
    return 0 if @failed
    superclass_index = self.parse_optional_superclass()
    return 0 if @failed
    parent_arguments = self.parse_parent_type_arguments(type_parameters)
    return 0 if @failed
    if reopened == nil
      class_index = @builder.declare_class(name, if superclass_index == nil
        -1
      else
        superclass_index
      end)
      @classes.push([name, class_index, superclass_index, [], type_parameters, false])
      reopened = @classes.length() - 1
      self.apply_class_type_parameters(@classes[reopened], parent_arguments[0])
      return 0 if @failed
    else
      if superclass_index != nil && superclass_index != existing[2]
        self.fail("reopened class has a different superclass")
        return 0
      end
      class_index = existing[1]
      superclass_index = existing[2]
    end
    if sealed
      @builder.seal_class(class_index)
      @sealed_classes.push(class_index)
    end
    @current_class_entry = reopened
    @current_class_index = class_index
    @current_class_superclass_index = superclass_index
    @current_class_method_names = []
    @current_class_singleton_method_names = []
    @current_class_methods_private = false
    @current_class_methods_protected = false
    @current_class_included_method_names = []

    if !self.consume_block_start()
      @current_class_index = nil
      @current_class_superclass_index = nil
      @current_class_methods_private = false
      return 0
    end
    self.compile_class_members(name)
    if @current.kind() != :end
      self.fail("expected method definition or include in class") unless @failed
      @current_class_index = nil
      @current_class_superclass_index = nil
      @current_class_methods_private = false
      return 0
    end
    self.advance_token()
    @current_class_index = nil
    @current_class_superclass_index = nil
    @current_class_methods_private = false
    # Sole-writer fresh register; run_chunk's zero-init already covers
    # nil, matching compile_class.c's own return value exactly.
    self.allocate_register()
  end

  # `[T]` or `[K, V]` after a class or struct name.
  def parse_class_type_parameters()
    names = self.parse_type_variables()
    self.fail("generic classes require one or two type parameters") if names.length() > 2
    names
  end

  # The `[Int]` of `class IntBox < Box[Int]`, resolved against the subclass's
  # own parameters: [annotations, each one's source text], empty if unwritten.
  def parse_parent_type_arguments(type_parameters)
    annotations = []
    texts = []
    return [annotations, texts] unless @current.kind() == :left_bracket
    self.advance_token()
    self.skip_newlines()
    while !@failed && @current.kind() != :right_bracket
      start = @current.start()
      annotations.push(self.parse_type_annotation())
      texts.push(@source.slice(start, @previous.start() + @previous.length() - start)) unless @failed
      self.skip_newlines()
      break if @current.kind() != :comma
      self.advance_token()
      self.skip_newlines()
    end
    if !@failed && @current.kind() != :right_bracket
      self.fail("expected ']' after superclass type arguments")
    else
      self.advance_token() unless @failed
    end
    [annotations, texts]
  end

  # Records a declared class's parameters and how they map onto its parent's.
  # A subclass that fixes a generic parent's arguments still has that parent's
  # parameter slots, under names no program can write.
  def apply_class_type_parameters(entry, parent_annotations)
    if entry[4].length() > 0
      @builder.set_class_type_parameters(entry[1], entry[4])
    end
    return if entry[2] == nil
    # Only the subclass's parameters are in scope here, and the top-level
    # function holding these sets declares them just while they are built.
    outer_type_variables = @current_type_variables
    @current_type_variables = entry[4]
    @builder.set_type_variables(@current_function_index, entry[4])
    sets = self.declare_annotations(parent_annotations)
    @builder.set_type_variables(@current_function_index, outer_type_variables)
    @current_type_variables = outer_type_variables
    return if @failed
    @builder.set_parent_type_arguments(entry[1], @current_function_index, sets)
    parent = self.find_class_by_index(entry[2])
    if entry[4].length() == 0 && parent != nil && parent[4].length() > 0
      entry[5] = true
      entry[4] = if parent[4].length() == 1 then ["$parent0"] else ["$parent0", "$parent1"] end
    end
  end

  # A declared class, or nil for a builtin one.
  def find_class_by_index(class_index)
    index = 0
    while index < @classes.length()
      return @classes[index] if @classes[index][1] == class_index
      index = index + 1
    end
    nil
  end

  # The class type parameters an instance member of the current class sees.
  def current_class_type_parameters()
    return [] if @current_class_index == nil
    @classes[@current_class_entry][4]
  end

  # `delegate name(a, *rest, &block), to: @target` is the method forwarding
  # those same arguments.
  def compile_delegate()
    self.advance_token()
    if @current.kind() != :identifier
      self.fail("expected method name after 'delegate'")
      return
    end
    name = self.token_text(@current)
    self.advance_token()
    if @current.kind() != :left_paren
      self.fail("expected '(' after delegated method name")
      return
    end
    start = @current.start()
    depth = 0
    while !@failed
      depth = depth + 1 if @current.kind() == :left_paren
      depth = depth - 1 if @current.kind() == :right_paren
      if @current.kind() == :eof
        self.fail("expected ')' after delegated parameters")
        return
      end
      self.advance_token()
      break if depth == 0
    end
    parameters = @source.slice(start, @previous.start() + @previous.length() - start)
    if @current.kind() != :comma
      self.fail("expected ', to:' after delegated parameters")
      return
    end
    self.advance_token()
    if @current.kind() != :identifier || self.token_text(@current) != "to"
      self.fail("expected ', to:' after delegated parameters")
      return
    end
    self.advance_token()
    if @current.kind() != :colon
      self.fail("expected ':' after 'to'")
      return
    end
    self.advance_token()
    if @current.kind() != :instance_variable
      self.fail("delegate target must be an instance variable")
      return
    end
    target = self.token_text(@current)
    self.compile_generated_source("def " + name + parameters + " = " + target + "." + name + parameters + "\n")
    self.advance_token() unless @failed
  end

  # The members of a class (or struct) body, up to its `end`.
  def compile_class_members(name)
    while !@failed && @current.kind() != :end
      if @current.kind() == :def
        self.compile_method()
      elsif @current.kind() == :identifier && self.assignment_ahead?()
        self.compile_module_constant(name)
      elsif attribute_keyword?(@current.kind())
        self.compile_attribute()
      elsif @current.kind() == :private || @current.kind() == :public || @current.kind() == :protected
        self.compile_class_visibility()
      elsif @current.kind() == :delegate
        self.compile_delegate()
      elsif @current.kind() == :include
        self.compile_class_include()
      elsif @current.kind() == :alias_method
        self.compile_alias_method()
      else
        self.fail("expected method definition or include in class")
      end
      self.skip_newlines() if @current.kind() == :newline
    end
  end

  # `struct Name(field: Type, ...) [< Parent] ... end` -- a class whose
  # typed initialize, readers, == and to_s are generated, as in
  # compiler.c's compile_struct. The fields take the first slots (a parent
  # struct's first), then the hand-written body compiles, then the
  # generated methods are compiled from Diamond source text; a body that
  # defines == or to_s replaces that generated one.
  def compile_struct()
    self.advance_token()
    if @function_nesting_depth != 0 || @current_class_index != nil
      self.fail("classes must be declared at the top level")
      return 0
    end
    if @current.kind() != :identifier
      self.fail("expected valid struct name")
      return 0
    end
    name = self.token_text(@current)
    name = @current_module_name + "::" + name if @current_module_name != nil
    if self.find_class(name) != nil
      self.fail("struct is already defined")
      return 0
    end
    if self.find_interface(name) != nil
      self.fail("type name is already defined")
      return 0
    end
    index = 0
    while index < @modules.length()
      self.fail("type name is already defined") if @modules[index][0] == name
      index = index + 1
    end
    return 0 if @failed
    self.advance_token()
    type_parameters = self.parse_class_type_parameters()
    return 0 if @failed
    fields = self.parse_struct_fields()
    return 0 if fields == nil
    parent_entry = nil
    inherited = []
    parent_arguments = [[], []]
    if @current.kind() == :less
      self.advance_token()
      if @current.kind() != :identifier
        self.fail("expected superclass name after '<'")
        return 0
      end
      parent_token = @current
      parent_entry = self.find_forward_class(self.token_text(@current), @current_module_name)
      if parent_entry == nil
        self.fail("undefined superclass")
        return 0
      end
      inherited = self.struct_fields_of(parent_entry[1])
      if inherited == nil
        self.fail("a struct's superclass must be a struct declared earlier")
        return 0
      end
      index = 0
      while index < fields.length()
        if struct_field_index(inherited, fields[index][0]) != nil
          token = fields[index][2]
          self.fail_at(token.start(), token.line(), token.column(),
            "struct field is already defined by its superclass")
          return 0
        end
        index = index + 1
      end
      self.advance_token()
      parent_arguments = self.parse_parent_type_arguments(type_parameters)
      return 0 if @failed
      inherited = self.specialized_struct_fields(inherited, parent_entry, parent_arguments[1])
    end
    superclass_index = if parent_entry == nil then nil else parent_entry[1] end
    class_index = @builder.declare_class(name, if superclass_index == nil then -1 else superclass_index end)
    all_fields = inherited + fields
    @classes.push([name, class_index, superclass_index, [], type_parameters, false])
    self.apply_class_type_parameters(@classes[@classes.length() - 1], parent_arguments[0])
    return 0 if @failed
    @struct_fields.push([class_index, all_fields])
    index = 0
    while index < fields.length()
      @builder.declare_field(class_index, fields[index][0])
      index = index + 1
    end
    @current_class_entry = @classes.length() - 1
    @current_class_index = class_index
    @current_class_superclass_index = superclass_index
    @current_class_method_names = []
    @current_class_singleton_method_names = []
    @current_class_methods_private = false
    @current_class_methods_protected = false
    @current_class_included_method_names = []
    if self.consume_block_start()
      self.compile_generated_source(self.struct_constructor_source(all_fields, fields))
      self.compile_class_members(name) unless @failed
      if @current.kind() != :end
        self.fail("expected method definition or include in class") unless @failed
      else
        self.compile_generated_source(self.struct_comparison_source(name, all_fields))
        self.advance_token() unless @failed
      end
    end
    @current_class_index = nil
    @current_class_superclass_index = nil
    @current_class_methods_private = false
    self.allocate_register()
  end

  # `(field: Type, ...)`: [[name, type source text, name token], ...], or nil.
  def parse_struct_fields()
    if @current.kind() != :left_paren
      self.fail("expected '(' after struct name")
      return nil
    end
    self.advance_token()
    self.skip_newlines()
    fields = []
    while @current.kind() != :right_paren && !@failed
      if @current.kind() != :identifier
        self.fail("expected field name")
        return nil
      end
      if fields.length() == 32
        self.fail("too many struct fields")
        return nil
      end
      field_token = @current
      field_name = self.token_text(@current)
      if field_name == "initialize" || field_name == "to_s"
        self.fail("field name collides with a generated struct method")
        return nil
      end
      if struct_field_index(fields, field_name) != nil
        self.fail("duplicate struct field name")
        return nil
      end
      self.advance_token()
      if @current.kind() != :colon
        self.fail("expected ':' and a type after field name")
        return nil
      end
      self.advance_token()
      type_start = @current.start()
      self.parse_type_annotation()
      return nil if @failed
      type_end = @previous.start() + @previous.length()
      fields.push([field_name, @source.slice(type_start, type_end - type_start), field_token])
      self.skip_newlines()
      break if @current.kind() != :comma
      self.advance_token()
      self.skip_newlines()
    end
    if @current.kind() != :right_paren
      self.fail("expected ')' after struct fields")
      return nil
    end
    self.advance_token()
    fields
  end

  # A generic parent's fields, with its parameters replaced in each type's
  # source text by what the child wrote for them. A parent that already fixed
  # its own parent's arguments, or takes none, has nothing to replace.
  def specialized_struct_fields(fields, parent_entry, argument_texts)
    return fields if argument_texts.length() == 0 || class_type_parameters(parent_entry).length() == 0 || parent_entry[5]
    result = []
    index = 0
    while index < fields.length()
      field = fields[index]
      result.push([field[0], self.substitute_type_names(field[1], parent_entry[4], argument_texts), field[2]])
      index = index + 1
    end
    result
  end

  def substitute_type_names(text, names, replacements)
    lexer = Lexer.new(text)
    result = ""
    position = 0
    token = lexer.next_token()
    while token.kind() != :eof
      if token.kind() == :identifier
        at = names.index(text.slice(token.start(), token.length()))
        if at != nil
          result = result + text.slice(position, token.start() - position) + replacements[at]
          position = token.start() + token.length()
        end
      end
      token = lexer.next_token()
    end
    result + text.slice(position, text.length() - position)
  end

  def struct_fields_of(class_index)
    index = 0
    while index < @struct_fields.length()
      return @struct_fields[index][1] if @struct_fields[index][0] == class_index
      index = index + 1
    end
    nil
  end

  def struct_method_defined?(method_name)
    index = 0
    while index < @current_class_method_names.length()
      return true if @current_class_method_names[index] == method_name
      index = index + 1
    end
    @current_class_included_method_names.include?(method_name)
  end

  # initialize and the readers, compiled before the hand-written body so a
  # body redefining one fails at its own def.
  def struct_constructor_source(all_fields, own_fields)
    text = "def initialize("
    index = 0
    while index < all_fields.length()
      text = text + ", " if index > 0
      text = text + all_fields[index][0] + ": " + all_fields[index][1]
      index = index + 1
    end
    text = text + ")\n"
    index = 0
    while index < all_fields.length()
      text = text + "@" + all_fields[index][0] + " = " + all_fields[index][0] + "\n"
      index = index + 1
    end
    text = text + "end\n"
    index = 0
    while index < own_fields.length()
      text = text + "def " + own_fields[index][0] + "() -> " + own_fields[index][1] +
        " = @" + own_fields[index][0] + "\n"
      index = index + 1
    end
    text
  end

  # == and to_s, after the body, which may define its own.
  def struct_comparison_source(name, all_fields)
    text = ""
    if !self.struct_method_defined?("==")
      text = text + "def ==(other)\nreturn false unless self.class() == other.class()\n"
      index = 0
      while index < all_fields.length()
        text = text + "return false unless @" + all_fields[index][0] + " == other." +
          all_fields[index][0] + "()\n"
        index = index + 1
      end
      text = text + "true\nend\n"
    end
    if !self.struct_method_defined?("to_s")
      text = text + "def to_s() = \"" + name + "("
      index = 0
      while index < all_fields.length()
        text = text + ", " if index > 0
        text = text + all_fields[index][0] + ": #" + "{@" + all_fields[index][0] + "}"
        index = index + 1
      end
      text = text + ")\"\n"
    end
    text
  end

  # Compiles generated members from source text, swapped in for the file
  # being compiled.
  def compile_generated_source(text)
    outer_source = @source
    outer_lexer = @lexer
    outer_current = @current
    outer_previous = @previous
    @source = text
    @lexer = Lexer.new(text)
    @current = @lexer.next_token()
    self.skip_newlines()
    while !@failed && @current.kind() != :eof
      self.compile_method()
      self.skip_newlines()
    end
    @source = outer_source
    @lexer = outer_lexer
    @current = outer_current
    @previous = outer_previous
  end

  def compile_class_include()
    self.advance_token()
    if @current.kind() != :identifier
      self.fail("expected module name after 'include'")
      return
    end
    module_name = self.consume_qualified_module_name()
    module_index = nil
    index = 0
    while index < @modules.length()
      module_index = @modules[index][1] if @modules[index][0] == module_name
      index = index + 1
    end
    if module_index == nil && @current_module_name != nil
      qualified_name = @current_module_name + "::" + module_name
      index = 0
      while index < @modules.length()
        module_index = @modules[index][1] if @modules[index][0] == qualified_name
        index = index + 1
      end
    end
    if module_index == nil
      self.fail("undefined module")
    else
      @builder.include_module(@current_class_index, module_index)
      @classes_with_includes.push(@current_class_index)
      index = 0
      while index < @modules.length()
        @current_class_included_method_names = @current_class_included_method_names + @modules[index][3] if @modules[index][1] == module_index
        index = index + 1
      end
    end
  end

  # `alias_method new_name, existing_name` inside a class or module body
  # -- copies an already-declared method's implementation under a second
  # name, mirroring compiler.c's own compile_alias_method exactly.
  # Existence/duplicate checks happen here rather than being left to
  # alias_class_method/alias_module_method's own failure paths: unlike
  # compile()'s ordinary self.fail() outcomes, a bridge call failure has
  # no rescue anywhere in this parser and would crash the whole compile
  # attempt instead of a clean error_message() -- the same reason
  # duplicate_method_name? is checked before every declare_method call.
  def compile_alias_method()
    self.advance_token()
    parenthesized = @current.kind() == :left_paren
    self.advance_token() if parenthesized
    if @current.kind() != :identifier
      self.fail("expected new alias name")
      return
    end
    alias_token = @current
    alias_name = self.token_text(@current)
    self.advance_token()
    if @current.kind() == :equal
      alias_name = alias_name + "="
      self.advance_token()
    end
    if @current.kind() != :comma
      self.fail("expected ',' in alias_method")
      return
    end
    self.advance_token()
    self.skip_newlines() if parenthesized
    if @current.kind() != :identifier
      self.fail("expected existing method name")
      return
    end
    original_token = @current
    original_name = self.token_text(@current)
    self.advance_token()
    if @current.kind() == :equal
      original_name = original_name + "="
      self.advance_token()
    end
    class_context = @current_module_index == nil || @current_class_index != nil
    names = if class_context
      @current_class_method_names
    else
      @modules[@current_module_entry][3]
    end
    found_source = false
    index = 0
    while index < names.length()
      found_source = true if names[index] == original_name
      index = index + 1
    end
    if !found_source
      self.fail_at(original_token.start(), original_token.line(), original_token.column(),
        "alias source is not defined here")
      return
    end
    index = 0
    while index < names.length()
      if names[index] == alias_name
        self.fail_at(alias_token.start(), alias_token.line(), alias_token.column(),
          "alias name is already defined")
      end
      index = index + 1
    end
    return if @failed
    if class_context
      @builder.alias_class_method(@current_class_index, alias_name, original_name)
      @current_class_method_names.push(alias_name)
    else
      @builder.alias_module_method(@current_module_index, alias_name, original_name)
      @modules[@current_module_entry][3].push(alias_name)
    end
    if parenthesized
      if @current.kind() != :right_paren
        self.fail("expected ')' after alias_method names")
        return
      end
      self.advance_token()
    end
  end

  # Bare `private`/`public` sets the default visibility for methods
  # declared for the remainder of the current class body; a parenthesized
  # or bare comma-separated name list instead retroactively flips
  # already-declared methods' visibility (compiler.c's
  # compile_visibility), mirroring compile_module_include's own
  # named-list handling exactly, just against set_class_method_visibility
  # and @current_class_method_names instead.
  def compile_class_visibility()
    private_mode = @current.kind() == :private
    protected_mode = @current.kind() == :protected
    self.advance_token()
    if @current.kind() == :identifier || @current.kind() == :left_paren
      parenthesized = @current.kind() == :left_paren
      self.advance_token() if parenthesized
      if @current.kind() == :identifier
        more = true
        while more && !@failed
          # A writer target (`private value=`) is registered under
          # "value=" -- peek one token ahead to see whether this name is
          # immediately followed by '=', mirroring compiler.c's own
          # compile_visibility exactly (writer_name lookahead).
          name = self.token_text(@current)
          lookahead = @lexer.clone()
          writer_name = lookahead.next_token().kind() == :equal
          name = name + "=" if writer_name
          found = false
          index = 0
          while index < @current_class_method_names.length()
            found = true if @current_class_method_names[index] == name
            index = index + 1
          end
          if found
            @builder.set_class_method_visibility(@current_class_index, name, private_mode, protected_mode)
          else
            self.fail("visibility target is not defined here")
          end
          self.advance_token()
          self.advance_token() if writer_name && @current.kind() == :equal
          if @current.kind() == :comma
            self.advance_token()
          else
            more = false
          end
        end
        if parenthesized
          if @current.kind() == :right_paren
            self.advance_token()
          else
            self.fail("expected ')' after visibility targets")
          end
        end
      elsif parenthesized
        self.fail("expected method name in visibility list")
      end
      return
    end
    @current_class_methods_private = private_mode
    @current_class_methods_protected = protected_mode
  end

  # Returns the superclass's class_index, or nil if there's no `<
  # Superclass` clause at all. Doesn't itself call declare_class --
  # compile_class still needs the -1-vs-index translation for that call,
  # so it stays the caller's job.
  def parse_optional_superclass()
    return nil unless @current.kind() == :less
    self.advance_token()
    if @current.kind() != :identifier
      self.fail("expected superclass name after '<'")
      return nil
    end
    superclass_token = @current
    superclass_name = self.consume_qualified_module_name()
    entry = self.find_forward_class(superclass_name, @current_module_name)
    if entry == nil
      self.fail_at(superclass_token.start(), superclass_token.line(), superclass_token.column(), "undefined superclass")
      return nil
    end
    entry[1]
  end

  def compile_module()
    self.advance_token()
    if @function_nesting_depth != 0 || @current_class_index != nil
      self.fail("modules must be declared at top level")
      return 0
    end
    if @current.kind() != :identifier
      self.fail("expected valid module name")
      return 0
    end
    local_name = self.token_text(@current)
    name = if @current_module_name == nil
      local_name
    else
      @current_module_name + "::" + local_name
    end
    # A module can be reopened: the later body adds to the same entry.
    module_entry = nil
    index = 0
    while index < @modules.length()
      module_entry = index if @modules[index][0] == name
      index = index + 1
    end
    self.fail("module name is already defined") if self.find_class(name) != nil || self.find_interface(name) != nil
    return 0 if @failed
    module_index = if module_entry == nil then @builder.declare_module(name) else @modules[module_entry][1] end
    if module_entry == nil
      module_entry = @modules.length()
      @modules.push([name, module_index, [], [], [false], [false], [], [], @current_module_name, []])
    end
    outer_module_index = @current_module_index
    outer_module_name = @current_module_name
    outer_module_entry = @current_module_entry
    @current_module_index = module_index
    @current_module_name = name
    @current_module_entry = module_entry
    self.advance_token()
    if self.consume_block_start()
      while !@failed && @current.kind() != :end
        if @current.kind() == :def
          self.compile_method()
        elsif attribute_keyword?(@current.kind())
          self.compile_attribute()
        elsif @current.kind() == :delegate
          self.compile_delegate()
        elsif @current.kind() == :interface
          self.compile_interface()
        elsif @current.kind() == :class || @current.kind() == :sealed
          self.compile_class()
        elsif @current.kind() == :struct
          self.compile_struct()
        elsif @current.kind() == :module
          self.compile_module()
        elsif @current.kind() == :module_function
          self.compile_module_function()
        elsif @current.kind() == :include || @current.kind() == :private || @current.kind() == :public
          self.compile_module_include()
        elsif @current.kind() == :alias_method
          self.compile_alias_method()
        elsif self.assignment_ahead?()
          self.compile_module_constant(name)
        else
          self.fail("expected module constant or method definition")
        end
        self.skip_newlines() if @current.kind() == :newline
      end
      self.advance_token() if @current.kind() == :end
    end
    @current_module_index = outer_module_index
    @current_module_name = outer_module_name
    @current_module_entry = outer_module_entry
    self.allocate_register()
  end

  def compile_module_function()
    self.advance_token()
    parenthesized = @current.kind() == :left_paren
    self.advance_token() if parenthesized
    if @current.kind() == :identifier
      more = true
      while more && !@failed
        method_name = self.token_text(@current)
        self.advance_token()
        if @current.kind() == :equal
          method_name = method_name + "="
          self.advance_token()
        end
        found = false
        descriptor = nil
        index = 0
        while index < @modules[@current_module_entry][3].length()
          if @modules[@current_module_entry][3][index] == method_name
            found = true
            descriptor = @modules[@current_module_entry][6][index]
          end
          index = index + 1
        end
        if found
          if descriptor[3]
            self.fail("stateful module method cannot become a module_function")
          else
            @builder.export_module_method(@current_module_index, method_name)
            @modules[@current_module_entry][7].push(descriptor)
          end
        else
          self.fail("module_function target is not defined here")
        end
        if @current.kind() == :comma
          self.advance_token()
        else
          more = false
        end
      end
      if parenthesized
        if @current.kind() == :right_paren
          self.advance_token()
        else
          self.fail("expected ')' after module_function targets")
        end
      end
    elsif parenthesized
      self.fail("expected method in module_function list")
    else
      mode = @modules[@current_module_entry][5]
      mode[0] = true
    end
  end

  def find_namespace_constant(name)
    index = 0
    while index < @namespace_constants.length()
      return @namespace_constants[index][1] if @namespace_constants[index][0] == name
      index = index + 1
    end
    nil
  end

  def constant_scope()
    return @classes[@current_class_entry][0] if @current_class_index != nil
    return @current_module_name if @current_module_name != nil
    ""
  end

  def find_lexical_constant(name) = self.find_constant_from(self.constant_scope(), name)

  # Resolves name the way a reference inside `scope` does: innermost
  # enclosing class or module first, then outward to the top level.
  def find_constant_from(scope, name)
    innermost = scope
    while scope != ""
      found = self.find_namespace_constant(scope + "::" + name)
      return found if found != nil
      parts = scope.split("::")
      parts.pop()
      scope = parts.join("::")
    end
    # Then the ancestors of the class this reference is in.
    entry = if innermost == "" then nil else self.find_class(innermost) end
    while entry != nil && entry[2] != nil
      parent = self.find_class_by_index(entry[2])
      break if parent == nil
      found = self.find_namespace_constant(parent[0] + "::" + name)
      return found if found != nil
      entry = parent
    end
    self.find_namespace_constant(name)
  end

  # A single-pass compiler sees a constant read or a call before a later
  # declaration of it; compiler.c learns every declaration up front from its
  # discovery pass instead. Each such reference was emitted with a
  # placeholder index and is patched here, once every declaration is known.
  def resolve_forward_references()
    self.resolve_forward_type_names()
    index = 0
    while index < @forward_is_types.length() && !@failed
      entry = @forward_is_types[index]
      interface_entry = self.find_interface(entry[2])
      class_entry = self.find_forward_class(entry[2], entry[4])
      if interface_entry != nil
        self.patch_index(entry[0], entry[1], Type::INTERFACE_BASE + interface_entry[1])
      elsif class_entry != nil
        self.patch_index(entry[0], entry[1], Type::CLASS_BASE + class_entry[1])
      else
        token = entry[3]
        self.fail_at(token.start(), token.line(), token.column(), "unknown type annotation")
      end
      index = index + 1
    end
    index = 0
    while index < @forward_constants.length() && !@failed
      entry = @forward_constants[index]
      # A `when` pattern (entry[5]) names a class before a constant, and
      # loads it with LOAD_CLASS -- the same size as the constant read.
      class_entry = if entry[5] then self.find_forward_class(entry[2], entry[6]) else nil end
      constant_index = self.find_constant_from(entry[3], entry[2])
      if class_entry != nil
        @builder.patch_byte(entry[0], entry[1] - 3, Opcode::LOAD_CLASS)
        self.patch_index(entry[0], entry[1], class_entry[1])
      elsif constant_index == nil
        token = entry[4]
        self.fail_at(token.start(), token.line(), token.column(),
          undefined_name_message(entry[2]))
      else
        self.patch_index(entry[0], entry[1], constant_index)
      end
      index = index + 1
    end
    index = 0
    while index < @forward_calls.length() && !@failed
      entry = @forward_calls[index]
      token = entry[4]
      function_entry = self.find_function(entry[2])
      paths = entry[5]
      if paths != nil
        # An implicit self call: the function if one exists, else self's method.
        target = if function_entry == nil
          paths[2]
        else
          paths[1]
        end
        self.patch_index(entry[0], paths[0], target)
        @builder.set_block_call_offset(paths[3], target) if paths[3] != nil
      end
      if function_entry == nil && paths != nil
        # Dispatched on self at run time.
      elsif function_entry == nil
        self.fail_at(token.start(), token.line(), token.column(), "undefined function")
      elsif entry[3] >= 0 && (entry[3] < function_entry[6] ||
                              self.too_many_arguments?(entry[3], function_entry[2], function_entry[1]))
        self.fail_at(token.start(), token.line(), token.column(), "wrong number of arguments")
      else
        self.patch_index(entry[0], entry[1], function_entry[1])
      end
      index = index + 1
    end
    self.resolve_forward_class_references()
    self.rewrite_cyclic_tail_calls()
  end

  def resolve_forward_class_references()
    index = 0
    while index < @forward_news.length() && !@failed
      entry = @forward_news[index]
      class_entry = self.find_forward_class(entry[2], entry[3])
      if class_entry == nil
        token = entry[4]
        self.fail_at(token.start(), token.line(), token.column(),
          undefined_name_message(entry[2]))
      elsif !self.fail_if_sealed(class_entry[1], entry[5])
        self.patch_index(entry[0], entry[1], class_entry[1])
      end
      index = index + 1
    end
    index = 0
    while index < @forward_singleton_calls.length() && !@failed
      entry = @forward_singleton_calls[index]
      token = entry[4]
      class_entry = self.find_forward_class(entry[2], entry[3])
      descriptor = if class_entry == nil
        nil
      else
        self.find_class_singleton_descriptor(class_entry, entry[5])
      end
      if class_entry == nil
        self.fail_at(token.start(), token.line(), token.column(),
          undefined_name_message(entry[2]))
      elsif descriptor == nil
        method_token = entry[7]
        self.fail_at(method_token.start(), method_token.line(), method_token.column(),
          "undefined class singleton method")
      elsif entry[6] >= 0 && (entry[6] < descriptor[3] ||
                              self.too_many_arguments?(entry[6], descriptor[2], descriptor[1]))
        self.fail_at(token.start(), token.line(), token.column(), "wrong number of arguments")
      else
        self.patch_index(entry[0], entry[1], descriptor[1])
        self.patch_index(entry[0], entry[8], class_entry[1])
      end
      index = index + 1
    end
  end

  # Overwrites a 16-bit operand, big-endian like emit_register.
  def patch_index(function_index, offset, value)
    @builder.patch_byte(function_index, offset, value / 256)
    @builder.patch_byte(function_index, offset + 1, mod(value, 256))
  end

  # A capitalized name with nothing declared under it yet: a constant
  # assigned later in the file. Read with a placeholder index.
  def compile_forward_constant(name)
    self.emit_forward_name(name, false)
  end

  def emit_forward_name(name, class_pattern)
    destination = self.allocate_register()
    self.emit_byte(48)
    self.emit_register(destination)
    @forward_constants.push([@current_function_index, @code_count, name,
                             self.constant_scope(), @previous, class_pattern,
                             @current_module_name])
    self.emit_register(0)
    destination
  end

  # `when Circle`: a class name is matched as a class (LOAD_CLASS, which
  # CASE_MATCH tests with is_a?). A name nothing is declared under yet may
  # be a class or a constant declared later; resolve_forward_references
  # decides. nil when the pattern is an ordinary expression.
  def parse_case_class_pattern()
    return nil if @current.kind() != :identifier
    name = self.token_text(@current)
    first = name.slice(0, 1)
    return nil if first < "A" || first > "Z"
    return nil if self.find_local(name) != nil || self.find_function(name) != nil
    after = @lexer.clone().next_token().kind()
    return nil if after == :dot || after == :left_paren || after == :left_brace ||
      after == :double_colon || after == :left_bracket
    class_entry = self.find_forward_class(name, @current_module_name)
    if class_entry != nil
      self.advance_token()
      destination = self.allocate_register()
      self.emit_instruction2(Opcode::LOAD_CLASS, destination, class_entry[1])
      @case_pattern_class_index = class_entry[1]
      return destination
    end
    return nil if self.find_lexical_constant(name) != nil
    self.advance_token()
    self.emit_forward_name(name, true)
  end

  # A call to a top-level function defined later in the file. Its
  # parameters aren't known yet, so arguments are positional only; the
  # count is checked against the arity once the definition is reached.
  # Records a plain CALL just emitted; its target is a function index, or a
  # name when the function is declared later.
  def note_plain_call(opcode_offset, destination, target)
    @last_plain_call = [@current_function_index, @code_count, opcode_offset, destination, target, false]
  end

  # About to RETURN `value`: if that returns a plain CALL just made, it can be
  # a tail call, as in compiler_assignment.c's maybe_rewrite_self_tail_call.
  # Either the call wrote `value` as the last instruction, or only a MOVE into
  # it follows with no jump landing between them (an if/else or case join).
  # Not in a begin (its handler's offsets stay live) or a function a block's
  # break lands in. A call to another function waits for
  # rewrite_cyclic_tail_calls, which needs every function known.
  # A return check emitted since `before_check` is skipped by the tail call, so
  # the callee must declare the same return type, free of type variables:
  # compiler.c, which knows the callee's type up front, emits no check then.
  def maybe_rewrite_tail_call(value, before_check, return_type)
    call = @last_plain_call
    return if @begin_depth > 0 || call == nil || call[0] != @current_function_index
    return if @nonlocal_landing_functions.include?(@current_function_index)
    if call[1] == before_check
      return if call[3] != value
    else
      move = @last_move
      return if call[5] || move == nil || move[0] != call[1] || move[0] + 5 != before_check
      return if move[1] != value || move[2] != call[3]
    end
    required = nil
    if before_check != @code_count
      return if self.annotation_uses_type_variable?(return_type)
      required = return_type
    end
    if call[4] == @current_function_index
      @builder.patch_byte(@current_function_index, call[2], Opcode::TAIL_CALL)
    else
      @tail_call_candidates.push([@current_function_index, call[2], call[4], required])
    end
  end

  # A tail call to another function becomes TAIL_CALL only on a cycle of such
  # calls. Off a cycle it cannot recurse without bound, and an ordinary CALL
  # keeps a delegating wrapper compilable by the JIT.
  def rewrite_cyclic_tail_calls()
    edges = []
    index = 0
    while index < @tail_call_candidates.length()
      candidate = @tail_call_candidates[index]
      entry = self.find_tail_call_target(candidate[2])
      target = if entry == nil || (candidate[3] != nil && entry[5] != candidate[3]) then nil else entry[1] end
      edges.push([candidate[0], candidate[1], target])
      index = index + 1
    end
    index = 0
    while index < edges.length()
      edge = edges[index]
      if edge[2] != nil && self.tail_call_reaches?(edges, edge[2], edge[0])
        @builder.patch_byte(edge[0], edge[1], Opcode::TAIL_CALL)
      end
      index = index + 1
    end
  end

  def find_tail_call_target(target)
    return self.find_function(target) if target.is_a?(String)
    index = 0
    while index < @functions.length()
      return @functions[index] if @functions[index][1] == target
      index = index + 1
    end
    nil
  end

  def tail_call_reaches?(edges, from, goal)
    seen = [from]
    pending = [from]
    while pending.length() > 0
      current = pending.pop()
      return true if current == goal
      index = 0
      while index < edges.length()
        following = edges[index][2]
        if edges[index][0] == current && following != nil && !seen.include?(following)
          seen.push(following)
          pending.push(following)
        end
        index = index + 1
      end
    end
    false
  end

  def compile_forward_call(name_token)
    if @current.kind() != :left_paren
      self.fail("undefined function")
      return 0
    end
    return self.compile_implicit_self_call(name_token) if @in_method && @current_class_index != nil
    if @in_singleton_method && !self.call_arguments_have_spread_after_paren?()
      return self.compile_implicit_self_call(name_token)
    end
    site = self.emit_forward_call_site()
    return 0 if site == nil
    @forward_calls.push([@current_function_index, site[1], self.token_text(name_token),
                         site[2], name_token, nil])
    self.note_plain_call(site[1] - 3, site[0], self.token_text(name_token)) if site[2] >= 0
    site[0]
  end

  # Parses `(args)` plus an optional trailing do block (the current token is
  # the '(') and emits a CALL whose function index is a placeholder.
  # Returns [destination, function index operand offset, argument count].
  def emit_forward_call_site()
    self.advance_token()
    self.skip_newlines()
    if self.call_arguments_have_spread?()
      # The argument count is only known at run time: -1 skips the arity
      # check when the call is resolved.
      spread_arguments = self.parse_spread_call_arguments()
      return nil if spread_arguments == nil
      destination = self.allocate_register()
      self.emit_call_opcode(Opcode::CALL_SPREAD)
      self.emit_register(destination)
      offset = @code_count
      self.emit_function_index(0)
      self.emit_register(spread_arguments)
      return [destination, offset, -1]
    end
    parsed = self.parse_forward_call_arguments()
    return nil if parsed == nil
    destination = self.allocate_register()
    self.emit_call_opcode(Opcode::CALL)
    self.emit_register(destination)
    offset = @code_count
    self.emit_function_index(0)
    self.emit_register(parsed[0])
    self.emit_byte(parsed[1])
    [destination, offset, parsed[1]]
  end

  # Positional arguments through ')' plus an optional trailing do block,
  # moved into contiguous registers: [base, count], or nil. Keyword
  # arguments need the callee's parameter names, so they are rejected.
  def parse_forward_call_arguments()
    arguments = []
    if @current.kind() != :right_paren
      more = true
      while more && !@failed
        if self.keyword_argument_ahead?()
          self.fail("keyword arguments need the function defined before the call")
          return nil
        end
        arguments.push(self.parse_expression())
        self.skip_newlines()
        if @current.kind() == :comma
          self.advance_token()
          self.skip_newlines()
          more = @current.kind() != :right_paren
        else
          more = false
        end
      end
    end
    if @current.kind() != :right_paren
      self.fail("expected ')' after arguments")
      return nil
    end
    self.advance_token()
    arguments.push(self.compile_block()) if @current.kind() == :do
    [self.move_contiguous(arguments), arguments.length()]
  end

  # Does the argument list after the current '(' contain a splat?
  def call_arguments_have_spread_after_paren?()
    lookahead = @lexer.clone()
    depth = 1
    kind = lookahead.next_token().kind()
    while depth > 0 && kind != :eof
      return true if kind == :star && depth == 1
      depth = depth + 1 if kind == :left_paren || kind == :left_bracket || kind == :left_brace
      depth = depth - 1 if kind == :right_paren || kind == :right_bracket || kind == :right_brace
      kind = lookahead.next_token().kind() if depth > 0
    end
    false
  end

  # `name(...)` inside an instance method (or, through INVOKE_SELF_METHOD,
  # a class singleton method) with no function `name` declared
  # yet: a top-level function declared later in the file wins, as in
  # compiler.c, and otherwise it calls self's method. Which one is only
  # known once the whole file is compiled, so both are emitted behind a
  # jump that resolve_forward_references points at one of them.
  def compile_implicit_self_call(name_token)
    self.advance_token()
    self.skip_newlines()
    spread = self.call_arguments_have_spread?()
    parsed = if spread
      arguments = self.parse_spread_call_arguments()
      if arguments == nil
        nil
      else
        [arguments, -1]
      end
    else
      self.parse_forward_call_arguments()
    end
    return 0 if parsed == nil
    # Which of the two calls a breaking block lands in is known only once
    # resolve_forward_references picks one.
    block = @pending_block_call
    @pending_block_call = nil
    selector = self.emit_jump(Opcode::JUMP, 0)
    call_start = @code_count
    destination = self.allocate_register()
    self.emit_byte(if spread then Opcode::CALL_SPREAD else Opcode::CALL end)
    self.emit_register(destination)
    offset = @code_count
    self.emit_function_index(0)
    self.emit_register(parsed[0])
    self.emit_byte(parsed[1]) unless spread
    skip = self.emit_jump(Opcode::JUMP, 0)
    invoke_start = @code_count
    if @in_singleton_method
      # On self's class: INVOKE_SELF_METHOD, as compile_self_class_call.
      self.emit_byte(Opcode::INVOKE_SELF_METHOD)
      self.emit_register(destination)
      self.emit_register(self.add_string(self.token_text(name_token)))
    else
      self.emit_byte(if spread then Opcode::INVOKE_SPREAD else Opcode::INVOKE end)
      self.emit_register(destination)
      self.emit_register(0)
      self.emit_register(self.add_string(self.token_text(name_token)))
    end
    self.emit_register(parsed[0])
    self.emit_byte(parsed[1]) unless spread
    self.patch_jump(skip, @code_count)
    @forward_calls.push([@current_function_index, offset, self.token_text(name_token),
                         parsed[1], name_token, [selector, call_start, invoke_start, block]])
    destination
  end

  # `X.new(...)` or `X.method(...)` where class X, or the singleton method,
  # is declared later. The current token is the '.'.
  def compile_forward_class_call(name_token, class_name = self.token_text(name_token))
    self.advance_token()
    if @current.kind() != :identifier
      self.fail("expected method name after '.'")
      return 0
    end
    method_name = self.token_text(@current)
    method_token = @current
    self.advance_token()
    if @current.kind() != :left_paren
      self.fail("expected '(' after singleton function")
      return 0
    end
    if method_name == "new"
      self.advance_token()
      parsed = self.parse_call_arguments()
      return 0 if parsed == nil
      destination = self.allocate_register()
      self.emit_call_opcode(Opcode::NEW)
      self.emit_register(destination)
      @forward_news.push([@current_function_index, @code_count, class_name,
                          @current_module_name, name_token, method_token])
      self.emit_register(0)
      self.emit_register(parsed[0])
      self.emit_byte(parsed[1])
      return destination
    end
    site = self.emit_forward_singleton_site()
    return 0 if site == nil
    @forward_singleton_calls.push([@current_function_index, site[1], class_name,
                                   @current_module_name, name_token, method_name, site[2],
                                   method_token, site[3]])
    site[0]
  end

  # emit_forward_call_site for a class singleton declared later: the
  # receiver slot gets a LOAD_CLASS whose class index is patched in at
  # resolution, too. Returns [destination, function index operand offset,
  # argument count (-1 for a spread), class index operand offset].
  def emit_forward_singleton_site()
    self.advance_token()
    self.skip_newlines()
    receiver = self.allocate_register()
    class_operand = @code_count + 3
    self.emit_instruction2(Opcode::LOAD_CLASS, receiver, 0)
    if self.call_arguments_have_spread?()
      spread_arguments = self.parse_spread_call_arguments()
      return nil if spread_arguments == nil
      arguments = self.emit_build_spread_arguments([receiver], spread_arguments, [], false)
      destination = self.allocate_register()
      self.emit_call_opcode(Opcode::CALL_SPREAD)
      self.emit_register(destination)
      offset = @code_count
      self.emit_function_index(0)
      self.emit_register(arguments)
      return [destination, offset, -1, class_operand]
    end
    parsed = self.parse_forward_call_arguments()
    return nil if parsed == nil
    base = self.move_contiguous([receiver] + contiguous_registers(parsed[0], parsed[1]))
    destination = self.allocate_register()
    self.emit_call_opcode(Opcode::CALL)
    self.emit_register(destination)
    offset = @code_count
    self.emit_function_index(0)
    self.emit_register(base)
    self.emit_byte(parsed[1] + 1)
    [destination, offset, parsed[1], class_operand]
  end

  # The class a forward reference names, looked up the way parse_name
  # does: the bare name, then qualified by the module it appeared in.
  def find_forward_class(name, module_name)
    # The innermost enclosing module first, as compiler.c's
    # find_class_qualified_or_scoped.
    scope = module_name
    while scope != nil && scope != ""
      entry = self.find_class(scope + "::" + name)
      return entry if entry != nil
      parts = scope.split("::")
      parts.pop()
      scope = parts.join("::")
    end
    self.find_class(name)
  end

  def store_namespace_constant(name, value)
    if @function_nesting_depth != 0
      self.fail("constants cannot be defined inside functions")
      return value
    end
    scope = self.constant_scope()
    qualified = if scope == "" then name else scope + "::" + name end
    if self.find_namespace_constant(qualified) != nil
      self.fail("constant is already defined")
      return value
    end
    constant_index = @builder.declare_namespace_constant(qualified)
    @namespace_constants.push([qualified, constant_index])
    if @current_module_index != nil && @current_class_index == nil
      @modules[@current_module_entry][2].push([name, constant_index])
    end
    self.emit_instruction2(49, constant_index, value)
    value
  end

  def compile_module_constant(module_name)
    constant_name = self.token_text(@current)
    first = constant_name.slice(0, 1)
    if first < "A" || first > "Z"
      self.fail(if @current_class_index == nil
        "module constants must begin with an uppercase letter"
      else
        "class constants must begin with an uppercase letter"
      end)
      return
    end
    self.compile_assignment()
    if @current.kind() == :if || @current.kind() == :unless
      self.fail("expected definition or include in module")
    end
  end

  def compile_module_include()
    if @current.kind() == :private || @current.kind() == :public
      private_mode = @current.kind() == :private
      self.advance_token()
      parenthesized = @current.kind() == :left_paren
      self.advance_token() if parenthesized
      if @current.kind() == :identifier
        more = true
        while more && !@failed
          # A writer target (`private value=`) is registered under
          # "value=" -- peek one token ahead to see whether this name is
          # immediately followed by '=', mirroring compiler.c's own
          # compile_visibility exactly (writer_name lookahead).
          name = self.token_text(@current)
          lookahead = @lexer.clone()
          writer_name = lookahead.next_token().kind() == :equal
          name = name + "=" if writer_name
          found = false
          index = 0
          while index < @modules[@current_module_entry][3].length()
            found = true if @modules[@current_module_entry][3][index] == name
            index = index + 1
          end
          if found
            @builder.set_module_method_visibility(@current_module_index, name, private_mode)
          else
            self.fail("visibility target is not defined here")
          end
          self.advance_token()
          self.advance_token() if writer_name && @current.kind() == :equal
          if @current.kind() == :comma
            self.advance_token()
          else
            more = false
          end
        end
        if parenthesized
          if @current.kind() == :right_paren
            self.advance_token()
          else
            self.fail("expected ')' after visibility targets")
          end
        end
      elsif parenthesized
        self.fail("expected method name in visibility list")
      else
        mode = @modules[@current_module_entry][4]
        mode[0] = private_mode
      end
      return
    end
    self.advance_token()
    if @current.kind() != :identifier
      self.fail("expected module name after 'include'")
      return
    end
    name = self.consume_qualified_module_name()
    included = nil
    index = 0
    while index < @modules.length()
      included = @modules[index][1] if @modules[index][0] == name
      index = index + 1
    end
    if included == nil && @modules[@current_module_entry][8] != nil
      name = @modules[@current_module_entry][8] + "::" + name
      index = 0
      while index < @modules.length()
        included = @modules[index][1] if @modules[index][0] == name
        index = index + 1
      end
    end
    if included == nil
      self.fail("undefined module")
    elsif included == @current_module_index
      self.fail("module cannot include itself")
    else
      @builder.include_module_in_module(@current_module_index, included)
    end
  end

  def consume_qualified_module_name()
    name = self.token_text(@current)
    self.advance_token()
    while !@failed && @current.kind() == :double_colon
      self.advance_token()
      if @current.kind() != :identifier
        self.fail("invalid qualified module name")
      else
        name = name + "::" + self.token_text(@current)
        self.advance_token()
      end
    end
    name
  end

  def compile_method()
    self.advance_token()
    module_singleton = false
    if @current.kind() == :self && (@current_class_index != nil || @current_module_index != nil)
      module_singleton = true
      self.advance_token()
      if @current.kind() != :dot
        self.fail("expected '.' after 'self'")
        return
      end
      self.advance_token()
    end
    operator_name = operator_method_token?(@current.kind()) || @current.kind() == :left_bracket
    # A module's own operator method is inert until some class `include`s
    # it -- copied into the including class's own method table exactly
    # like any other module method, at which point dispatch works the
    # same as if the class had defined it directly. Mirrors compiler.c's
    # own relaxation exactly (see its comment): this is what lets
    # `module Comparable` derive `<`/`<=`/`>`/`>=` from a `<=>` an
    # including class defines.
    if operator_name &&
       (module_singleton || (@current_class_index == nil && @current_module_index == nil))
      self.fail("operator methods can only be defined inside a class or module")
      return
    end
    if @current.kind() != :identifier && !operator_name
      self.fail("expected function name after 'def'")
      return
    end
    name_token = @current
    name = self.token_text(@current)
    self.advance_token()
    if name == "["
      if @current.kind() != :right_bracket
        self.fail("expected ']' after '[' in method name")
        return
      end
      name = "[]"
      self.advance_token()
    end
    if @current.kind() == :equal
      name = name + "="
      self.advance_token()
    end
    if self.duplicate_method_name?(name, module_singleton)
      self.fail_at(name_token.start(), name_token.line(), name_token.column(),
        "duplicate or excessive method definition")
      return
    end
    outer_type_variables = @current_type_variables
    @current_type_variables = self.parse_type_variables()
    return if @failed
    class_type_parameters = if module_singleton then [] else self.current_class_type_parameters() end
    @current_type_variables = class_type_parameters + @current_type_variables
    if @current.kind() != :left_paren
      self.fail("expected '(' after function name")
      return
    end
    self.advance_token()
    parsed_parameters = self.parse_parameter_names()
    return if @failed
    if @current.kind() != :right_paren
      self.fail("expected ')' after parameters")
      return
    end
    self.advance_token()
    parameter_names = parsed_parameters[0]
    parameter_types = parsed_parameters[1]
    parameter_defaults = parsed_parameters[2]
    has_block_parameter = parsed_parameters[3]
    return_type = nil
    if @current.kind() == :arrow
      self.advance_token()
      return_type = self.parse_type_annotation()
    end
    return if @failed

    arity = parameter_names.length()
    required_arity = required_parameter_count(parsed_parameters)
    @parameter_shape = [parsed_parameters[4], has_block_parameter]
    # A class's `def self.x` reserves register 0 for the class it was called
    # on, as compiler.c does; a module's does not.
    self_offset = if module_singleton && @current_class_index == nil
      0
    else
      1
    end
    function_index = @builder.declare_function(name, arity + self_offset, required_arity + self_offset)
    @builder.set_type_variables(function_index, @current_type_variables, class_type_parameters.length())
    outer_method_name = @current_method_name
    @current_method_name = name
    @current_method_uses_state = false
    self.compile_method_body(function_index, parameter_names, parameter_types, parameter_defaults, return_type, module_singleton)
    @current_method_name = outer_method_name
    signature = [parameter_types, return_type, @current_type_variables, parameter_names]
    self.register_compiled_method(name, function_index, arity, required_arity, module_singleton, signature)
    @current_method_uses_state = false
    @current_type_variables = outer_type_variables
  end

  # Whether `name` is already declared in whichever of the four method
  # lists (class instance/singleton, module instance/singleton) `def
  # self.`-ness and the current class/module context select.
  def duplicate_method_name?(name, module_singleton)
    names = self.existing_method_names(module_singleton)
    index = 0
    found = false
    while index < names.length()
      found = true if names[index] == name
      index = index + 1
    end
    found
  end

  def existing_method_names(module_singleton)
    class_context = @current_module_index == nil || @current_class_index != nil
    if module_singleton
      return @current_class_singleton_method_names if class_context
      descriptors = @modules[@current_module_entry][9]
      names = []
      index = 0
      while index < descriptors.length()
        names.push(descriptors[index][0])
        index = index + 1
      end
      names
    else
      return @current_class_method_names if class_context
      @modules[@current_module_entry][3]
    end
  end

  # Registers a just-compiled method into whichever of the four targets
  # (class instance/singleton, module instance/singleton) it belongs to.
  # A directly-declared singleton (`def self.foo`) goes through the new
  # declare_class_singleton_method/declare_module_singleton_method bridge
  # calls -- distinct from module_function's export_module_method, which
  # instead re-exports an already-declared regular method.
  # `signature` ([parameter types, return type, type variables, parameter
  # names]) rides on singleton descriptors and instance method entries for
  # compile_reference_wrapper.
  def mark_protected_method(name)
    @builder.set_class_method_visibility(@current_class_index, name, false, true) if @current_class_methods_protected
  end

  def register_compiled_method(name, function_index, arity, required_arity, module_singleton, signature)
    class_context = @current_module_index == nil || @current_class_index != nil
    if module_singleton
      if class_context
        @current_class_singleton_method_names.push(name)
        @classes[@current_class_entry][3].push([name, function_index, arity, required_arity, signature])
        @builder.declare_class_singleton_method(@current_class_index, name, function_index, arity, required_arity)
      else
        @modules[@current_module_entry][9].push([name, function_index, arity, required_arity, signature])
        @builder.declare_module_singleton_method(@current_module_index, name, function_index, arity, required_arity)
      end
    else
      if class_context
        @current_class_method_names.push(name)
        @instance_methods.push([@current_class_index, name, @current_class_methods_private, required_arity, function_index, arity, signature])
        @builder.declare_method(@current_class_index, name, function_index, arity, required_arity, @current_class_methods_private)
        self.mark_protected_method(name)
      else
        self.register_module_method(name, function_index, arity, required_arity)
      end
    end
  end

  def register_module_method(name, function_index, arity, required_arity)
    @modules[@current_module_entry][3].push(name)
    descriptor = [name, function_index, arity, @current_method_uses_state, required_arity]
    @modules[@current_module_entry][6].push(descriptor)
    @builder.declare_module_method(@current_module_index, name, function_index,
      arity, required_arity, @modules[@current_module_entry][4][0])
    if @modules[@current_module_entry][5][0]
      if descriptor[3]
        self.fail("stateful method cannot use module_function mode")
      else
        @builder.export_module_method(@current_module_index, name)
        @modules[@current_module_entry][7].push(descriptor)
      end
    end
  end

  def compile_method_body(function_index, parameter_names, parameter_types, parameter_defaults, return_type, module_singleton)
    outer_locals = @locals
    outer_loop_captures_pending = @loop_captures_pending
    outer_current_block_name = @current_block_name
    outer_current_block_type = @current_block_type
    outer_in_block = @in_block
    outer_loops = @loops
    outer_begin_depth = @begin_depth
    outer_next_register = @next_register
    outer_code_count = @code_count
    outer_function_index = @current_function_index
    outer_return_type = @current_return_type
    outer_type_facts = @type_facts
    outer_declared_types = @declared_types
    outer_in_method = @in_method
    outer_in_singleton_method = @in_singleton_method
    @in_method = !module_singleton
    @in_singleton_method = module_singleton && @current_class_index != nil

    @locals = []
    @loop_captures_pending = false
    @current_block_name = nil
    @current_block_type = nil
    @in_block = false
    @loops = []
    @begin_depth = 0
    @next_register = 0
    @code_count = 0
    @current_function_index = function_index
    outer_method_function_index = @method_function_index
    outer_method_return_type = @method_return_type
    @current_return_type = return_type
    @method_function_index = function_index
    @method_return_type = return_type
    @type_facts = []
    @declared_types = []
    index_offset = if module_singleton && @current_class_index == nil
      0
    else
      self.allocate_register()
      1
    end
    # One level of nested `def` is supported inside a method body too
    # (see compile_definition's self_offset handling) -- counted the
    # same way a nested def inside a plain function body is, so the
    # existing function_nesting_depth>=2 cap in compile_definition
    # rejects a second level consistently either way.
    @function_nesting_depth = @function_nesting_depth + 1

    self.bind_parameters(function_index, parameter_names, parameter_types, parameter_defaults, index_offset)

    endless = @current.kind() == :equal
    if endless
      self.advance_token()
      self.skip_newlines()
      self.mark_locals_captured() if self.statement_may_capture?()
      postfix = self.postfix_modifier_ahead()
      has_postfix = postfix == :if || postfix == :unless
      postfix_result = self.allocate_register() if has_postfix
      condition_jump = self.emit_jump(Opcode::JUMP, 0) if has_postfix
      body_start = @code_count
      # `raise` is a statement, not an expression, but `def f() = raise E`
      # is the natural way to write a method that only raises; without a
      # postfix condition the body never returns, so the declared return
      # type isn't checked against the raised value.
      raises = @current.kind() == :raise
      body_result = if raises
        self.compile_raise()
      else
        self.parse_expression()
      end
      if has_postfix
        if @current.kind() != postfix
          self.fail("expected postfix condition")
        else
          self.advance_token()
          self.emit_instruction2(Opcode::MOVE, postfix_result, body_result)
          body_exit = self.emit_jump(Opcode::JUMP, 0)
          condition_start = @code_count
          condition = self.parse_expression()
          body_jump = self.emit_jump(if postfix == :if
            Opcode::JUMP_IF_TRUE
          else
            Opcode::JUMP_IF_FALSE
          end, condition)
          self.emit_instruction1(Opcode::NIL, postfix_result)
          self.patch_jump(condition_jump, condition_start)
          self.patch_jump(body_exit, @code_count)
          self.patch_jump(body_jump, body_start)
          body_result = postfix_result
        end
      end
      before_check = @code_count
      if return_type != nil
        set_index = self.emit_type_check(body_result, return_type)
        @builder.set_return_type(function_index, set_index) unless @failed
      end
      self.maybe_rewrite_tail_call(body_result, before_check, return_type)
      self.emit_instruction1(Opcode::RETURN, body_result)
    elsif self.consume_block_start()
      body_result = self.compile_body()
      before_check = @code_count
      if return_type != nil
        set_index = self.emit_type_check(body_result, return_type)
        @builder.set_return_type(function_index, set_index) unless @failed
      end
      self.maybe_rewrite_tail_call(body_result, before_check, return_type)
      self.emit_instruction1(Opcode::RETURN, body_result)
      if @current.kind() != :end
        self.fail("expected 'end' after function body")
      else
        self.advance_token()
      end
    end
    @builder.set_register_count(function_index, @next_register)

    @locals = outer_locals
    @loop_captures_pending = outer_loop_captures_pending
    @current_block_name = outer_current_block_name
    @current_block_type = outer_current_block_type
    @in_block = outer_in_block
    @loops = outer_loops
    @begin_depth = outer_begin_depth
    @next_register = outer_next_register
    @code_count = outer_code_count
    @current_function_index = outer_function_index
    @current_return_type = outer_return_type
    @method_function_index = outer_method_function_index
    @method_return_type = outer_method_return_type
    @type_facts = outer_type_facts
    @declared_types = outer_declared_types
    @in_method = outer_in_method
    @in_singleton_method = outer_in_singleton_method
    @function_nesting_depth = @function_nesting_depth - 1
  end

  # `attr`/`attr_reader`/`attr_writer`/`attr_accessor`/`attr_predicate`,
  # parenthesized or not, one or more comma-separated names -- mirrors
  # compiler.c's compile_attribute. `attr_predicate` is a reader whose
  # method name gets a `?` suffix instead of a plain field name (field
  # type itself is unaffected -- confirmed against compile_attribute_named,
  # which only ever changes the method_name suffix, never adds any
  # Bool-specific behavior), never a writer.
  def compile_attribute()
    predicate = @current.kind() == :attr_predicate
    reader = @current.kind() != :attr_writer
    writer = @current.kind() == :attr_writer || @current.kind() == :attr_accessor
    self.advance_token()
    parenthesized = @current.kind() == :left_paren
    if parenthesized
      self.advance_token()
      self.skip_newlines()
    end
    while !@failed
      if @current.kind() != :identifier
        if @current.kind() == :symbol
          self.fail("expected attribute name (write `attr_reader name: Type`, not `attr_reader :name`)")
        else
          self.fail("expected attribute name")
        end
        return
      end
      field_name = self.token_text(@current)
      self.advance_token()
      type_annotation = nil
      if @current.kind() == :colon
        self.advance_token()
        type_annotation = self.parse_type_annotation()
      end
      return if @failed
      self.compile_attribute_method(field_name, false, type_annotation, predicate) if reader
      self.compile_attribute_method(field_name, true, type_annotation, false) if writer && !@failed
      return if @failed
      self.skip_newlines() if parenthesized
      break if @current.kind() != :comma
      self.advance_token()
      self.skip_newlines() if parenthesized
    end
    return if @failed
    if parenthesized
      if @current.kind() != :right_paren
        self.fail("expected ')' after attribute names")
        return
      end
      self.advance_token()
    end
  end

  def compile_attribute_method(field_name, writer, type_annotation, predicate)
    method_name = if writer
      field_name + "="
    elsif predicate
      field_name + "?"
    else
      field_name
    end
    existing_names = if @current_module_index != nil && @current_class_index == nil
      @modules[@current_module_entry][3]
    else
      @current_class_method_names
    end
    index = 0
    while index < existing_names.length()
      self.fail("attribute method is already defined") if existing_names[index] == method_name
      index = index + 1
    end
    return if @failed

    arity = if writer
      1
    else
      0
    end
    function_index = @builder.declare_function(method_name, arity + 1, arity + 1)

    outer_locals = @locals
    outer_loop_captures_pending = @loop_captures_pending
    outer_current_block_name = @current_block_name
    outer_current_block_type = @current_block_type
    outer_in_block = @in_block
    outer_loops = @loops
    outer_begin_depth = @begin_depth
    outer_next_register = @next_register
    outer_code_count = @code_count
    outer_function_index = @current_function_index
    outer_return_type = @current_return_type
    outer_type_facts = @type_facts
    outer_declared_types = @declared_types

    @locals = []
    @loop_captures_pending = false
    @current_block_name = nil
    @current_block_type = nil
    @in_block = false
    @loops = []
    @begin_depth = 0
    @next_register = 0
    @code_count = 0
    @current_function_index = function_index
    @current_return_type = nil
    @type_facts = []
    @declared_types = []
    self.allocate_register()
    module_only = @current_module_index != nil && @current_class_index == nil
    field_index = if module_only
      @current_method_uses_state = true
      @builder.declare_module_field(@current_module_index, field_name)
      self.add_string(field_name)
    else
      @builder.declare_field(@current_class_index, field_name)
    end
    if writer
      value = self.allocate_register()
      if type_annotation != nil
        set_index = self.declare_annotation(type_annotation)
        @builder.set_parameter_type(function_index, 0, set_index) unless @failed
        self.emit_instruction2(Opcode::CHECK_TYPE, value, set_index) unless @failed
      end
      self.emit_instruction3(if module_only
        47
      else
        Opcode::SET_IVAR
      end, 0, field_index, value)
      self.emit_instruction1(Opcode::RETURN, value)
    else
      destination = self.allocate_register()
      self.emit_instruction3(if module_only
        46
      else
        Opcode::GET_IVAR
      end, destination, 0, field_index)
      if type_annotation != nil
        set_index = self.declare_annotation(type_annotation)
        @builder.set_return_type(function_index, set_index) unless @failed
        self.emit_instruction2(Opcode::CHECK_TYPE, destination, set_index) unless @failed
      end
      self.emit_instruction1(Opcode::RETURN, destination)
    end
    @builder.set_register_count(function_index, @next_register)

    @locals = outer_locals
    @loop_captures_pending = outer_loop_captures_pending
    @current_block_name = outer_current_block_name
    @current_block_type = outer_current_block_type
    @in_block = outer_in_block
    @loops = outer_loops
    @begin_depth = outer_begin_depth
    @next_register = outer_next_register
    @code_count = outer_code_count
    @current_function_index = outer_function_index
    @current_return_type = outer_return_type
    @type_facts = outer_type_facts
    @declared_types = outer_declared_types

    if module_only
      self.register_module_method(method_name, function_index, arity, arity)
    else
      @current_class_method_names.push(method_name)
      @instance_methods.push([@current_class_index, method_name, @current_class_methods_private, arity])
      @builder.declare_method(@current_class_index, method_name, function_index, arity, arity, @current_class_methods_private)
      self.mark_protected_method(method_name)
    end
  end

  # Shared by compile_call/compile_closure_call: parses `(arg, arg, ...)`
  # (the opening '(' already consumed by the caller) and moves each
  # argument's value register into a fresh, contiguous block starting at
  # a newly allocated base register -- the layout every call-family
  # opcode (CALL/CALL_CLOSURE) expects. Returns [argument_base, count],
  # or nil on a parse failure (caller should return 0 in that case).
  # --- call-site spread (`f(a, *rest, &block)`): the arguments become one
  # Array, passed through the *_SPREAD call opcodes. Mirrors compiler.c's
  # call_arguments_have_spread/parse_spread_argument_array. ---

  # Whether the argument list starting at the current token (just past the
  # '(') has a top-level `*expression` argument.
  def call_arguments_have_spread?()
    lookahead = @lexer.clone()
    kind = @current.kind()
    nesting = 0
    argument_start = true
    while kind != :eof
      return false if nesting == 0 && kind == :right_paren
      return true if nesting == 0 && argument_start && kind == :star
      if kind == :left_paren || kind == :left_bracket || kind == :left_brace
        nesting = nesting + 1
      elsif kind == :right_paren || kind == :right_bracket || kind == :right_brace
        nesting = nesting - 1 if nesting > 0
      end
      if kind == :comma
        argument_start = nesting == 0
      elsif kind != :newline
        argument_start = false
      end
      kind = lookahead.next_token().kind()
    end
    false
  end

  # Whether a top-level argument of the call is `name: value`; the current
  # token is the first argument.
  def call_arguments_have_keyword?()
    lookahead = @lexer.clone()
    kind = @current.kind()
    nesting = 0
    argument_start = true
    previous_was_argument_name = false
    while kind != :eof
      return false if nesting == 0 && kind == :right_paren
      return true if previous_was_argument_name && kind == :colon
      previous_was_argument_name = nesting == 0 && argument_start && kind == :identifier
      if kind == :left_paren || kind == :left_bracket || kind == :left_brace
        nesting = nesting + 1
      elsif kind == :right_paren || kind == :right_bracket || kind == :right_brace
        nesting = nesting - 1 if nesting > 0
      end
      if kind == :comma
        argument_start = nesting == 0
      elsif kind != :newline
        argument_start = false
      end
      kind = lookahead.next_token().kind()
    end
    false
  end

  # Arguments matched to parameters by name at run time (NEW_KEYWORDS,
  # INVOKE_KEYWORDS): [positional Array register, [[name string index,
  # value register], ...], block register or nil], or nil; a trailing block
  # takes its types from `block_context`. Mirrors compiler_calls.c's
  # parse_dynamic_keyword_arguments.
  def parse_dynamic_keyword_arguments(block_context = nil)
    positional = []
    keywords = []
    names = []
    seen_keyword = false
    spread = nil
    spread_at = 0
    while @current.kind() != :right_paren && !@failed
      if self.keyword_argument_ahead?()
        seen_keyword = true
        if keywords.length() == 32
          self.fail("too many keyword arguments")
          return nil
        end
        keyword_name = self.token_text(@current)
        if names.include?(keyword_name)
          self.fail("multiple values for the same argument")
          return nil
        end
        names.push(keyword_name)
        name_index = self.add_string(keyword_name)
        self.advance_token()
        self.advance_token()
        self.skip_newlines()
        keywords.push([name_index, self.parse_expression()])
      else
        if seen_keyword
          self.fail("positional argument cannot follow a keyword argument")
          return nil
        end
        if @current.kind() == :star
          if spread != nil
            self.fail("a call can contain only one spread argument")
            return nil
          end
          self.advance_token()
          self.skip_newlines()
          spread = self.parse_expression()
          spread_at = positional.length()
        elsif positional.length() == 32
          self.fail("too many fixed call arguments")
          return nil
        else
          positional.push(self.parse_expression())
        end
      end
      self.skip_newlines()
      break if @current.kind() != :comma
      self.advance_token()
      self.skip_newlines()
    end
    return nil if @failed
    if @current.kind() != :right_paren
      self.fail("expected ')' after arguments")
      return nil
    end
    self.advance_token()
    # A `*spread` among the positional arguments builds the Array around it.
    if spread != nil
      array = self.emit_build_spread_arguments(positional.slice(0, spread_at), spread,
        positional.slice(spread_at, positional.length() - spread_at), false)
    else
      base = if positional.length() == 0 then self.allocate_register() else self.move_contiguous(positional) end
      array = self.allocate_register()
      self.emit_instruction3(Opcode::ARRAY, array, base, positional.length())
      self.set_type_fact(array, Type::ARRAY)
    end
    block = nil
    if @current.kind() == :do
      # Snapshot the values so the block's own registers can't disturb them.
      index = 0
      while index < keywords.length()
        snapshot = self.allocate_register()
        self.emit_instruction2(Opcode::MOVE, snapshot, keywords[index][1])
        keywords[index] = [keywords[index][0], snapshot]
        index = index + 1
      end
      @block_context = block_context
      block = self.compile_block()
    end
    [array, keywords, block]
  end

  # The keyword trailer NEW_KEYWORDS and INVOKE_KEYWORDS share.
  def emit_keyword_trailer(arguments)
    keywords = arguments[1]
    self.emit_register(arguments[0])
    self.emit_byte(keywords.length() | if arguments[2] == nil then 0 else 128 end)
    index = 0
    while index < keywords.length()
      self.emit_register(keywords[index][0])
      self.emit_register(keywords[index][1])
      index = index + 1
    end
    self.emit_register(arguments[2]) if arguments[2] != nil
  end

  # MOVEs `values` into fresh contiguous registers; returns the first.
  def move_contiguous(values)
    base = self.allocate_register()
    index = 1
    while index < values.length()
      self.allocate_register()
      index = index + 1
    end
    index = 0
    while index < values.length()
      self.emit_instruction2(Opcode::MOVE, base + index, values[index])
      index = index + 1
    end
    base
  end

  # prefix + spread + suffix as one Array. With optional_block the last
  # suffix value is a forwarded `&block`, dropped when it is nil.
  def emit_build_spread_arguments(prefix, spread, suffix, optional_block)
    prefix_base = if prefix.length() > 0
      self.move_contiguous(prefix)
    else
      spread
    end
    suffix_base = if suffix.length() > 0
      self.move_contiguous(suffix)
    else
      spread
    end
    destination = self.allocate_register()
    self.emit_byte(Opcode::BUILD_SPREAD_ARGS)
    self.emit_register(destination)
    self.emit_register(prefix_base)
    self.emit_byte(prefix.length())
    self.emit_register(spread)
    self.emit_register(suffix_base)
    self.emit_byte(suffix.length() + (if optional_block then 128 else 0 end))
    self.set_type_fact(destination, Type::ARRAY)
    destination
  end

  # Parses the arguments through ')' (the current token is the first one)
  # plus an optional trailing do block; returns the argument Array, or nil.
  # `keywords`, when given, is [parameter names, []]: keyword arguments are
  # then allowed, and land in the second element as [slot, register]. With
  # nil names, keywords stay rejected and a trailing block lands there as
  # [-1, register] instead of joining the Array; a third element is that
  # block's context (see contextual_block_member).
  def parse_spread_call_arguments(keywords = nil)
    prefix = []
    suffix = []
    spread = nil
    optional_block = false
    while @current.kind() != :right_paren && !@failed
      if self.keyword_argument_ahead?()
        if keywords == nil || keywords[0] == nil
          self.fail("keyword arguments cannot be combined with a spread argument")
          return nil
        end
        keyword_token = @current
        slot = find_parameter_slot(keywords[0], self.token_text(@current))
        if slot == -1
          self.fail("no parameter with this name")
          return nil
        end
        index = 0
        while index < keywords[1].length()
          if keywords[1][index][0] == slot
            self.fail_at(keyword_token.start(), keyword_token.line(), keyword_token.column(),
              "multiple values for the same argument")
            return nil
          end
          index = index + 1
        end
        self.advance_token()
        self.advance_token()
        keywords[1].push([slot, self.parse_expression()])
      elsif keywords != nil && keywords[1].length() > 0
        self.fail("positional argument cannot follow a keyword argument")
        return nil
      elsif @current.kind() == :star
        if spread != nil
          self.fail("a call can contain only one spread argument")
          return nil
        end
        self.advance_token()
        self.skip_newlines()
        spread = self.parse_expression()
      else
        forwarded_block = @current.kind() == :ampersand
        value = self.parse_expression()
        if spread == nil
          prefix.push(value)
        else
          suffix.push(value)
        end
        if forwarded_block
          if @current.kind() != :right_paren || spread == nil
            self.fail("a forwarded block argument must be last")
            return nil
          end
          optional_block = true
        end
      end
      self.skip_newlines()
      break if @current.kind() != :comma
      self.advance_token()
      self.skip_newlines()
    end
    return nil if @failed
    if @current.kind() != :right_paren
      self.fail("expected ')' after arguments")
      return nil
    end
    self.advance_token()
    arguments = if prefix.length() == 0 && suffix.length() == 0
      spread
    else
      self.emit_build_spread_arguments(prefix, spread, suffix, optional_block)
    end
    if @current.kind() == :do
      @block_context = keywords[2] if keywords != nil && keywords.length() > 2
      block = self.compile_block()
      # With keywords the block fills the last parameter by slot, as in
      # compiler.c's parse_spread_function_call.
      if keywords != nil && keywords[0] == nil
        keywords[1].push([-1, block])
      elsif keywords != nil && keywords[1].length() > 0
        keywords[1].push([keywords[0].length() - 1, block])
      else
        arguments = self.emit_build_spread_arguments([], arguments, [block], false)
      end
    end
    arguments
  end

  def emit_type_argument_trailer(type_arguments)
    return if type_arguments.length() == 0
    self.emit_byte(type_arguments.length())
    index = 0
    while index < type_arguments.length()
      self.emit_register(type_arguments[index])
      index = index + 1
    end
  end

  def emit_call_spread(function_index, arguments, type_arguments = [])
    destination = self.allocate_register()
    self.emit_call_opcode(if type_arguments.length() == 0 then Opcode::CALL_SPREAD else Opcode::CALL_TYPED_SPREAD end)
    self.emit_register(destination)
    self.emit_function_index(function_index)
    self.emit_register(arguments)
    self.emit_type_argument_trailer(type_arguments)
    destination
  end

  # A module_function export reserves register 0 for an implicit receiver,
  # so its argument Array gets a leading nil there.
  # A trailing block goes by CALL_SINGLETON_KEYWORDS' block flag with the
  # spread Array as the positional arguments, as in compiler_calls.c;
  # `block_context` types it.
  def emit_singleton_spread_call(function_index, needs_receiver, type_arguments, block_context = nil)
    collected = [nil, [], block_context]
    arguments = self.parse_spread_call_arguments(collected)
    return 0 if arguments == nil
    if collected[1].length() > 0
      return self.compile_singleton_keyword_call(function_index, needs_receiver, type_arguments,
        [arguments, [], collected[1][0][1]])
    end
    if needs_receiver != false
      receiver = self.allocate_register()
      if needs_receiver == true
        self.emit_instruction1(Opcode::NIL, receiver)
      else
        self.emit_instruction2(Opcode::LOAD_CLASS, receiver, needs_receiver)
      end
      arguments = self.emit_build_spread_arguments([receiver], arguments, [], false)
    end
    self.emit_call_spread(function_index, arguments, type_arguments)
  end

  def parse_call_arguments()
    self.skip_newlines()
    arguments = []
    if @current.kind() != :right_paren
      more = true
      while more
        arguments.push(self.parse_expression())
        self.skip_newlines()
        if @current.kind() == :comma
          self.advance_token()
          self.skip_newlines()
          more = @current.kind() != :right_paren
        else
          more = false
        end
      end
    end
    if @current.kind() != :right_paren
      self.fail("expected ')' after arguments")
      return nil
    end
    self.advance_token()
    argument_base = self.allocate_register()
    i = 1
    while i < arguments.length()
      self.allocate_register()
      i = i + 1
    end
    i = 0
    while i < arguments.length()
      self.emit_instruction2(Opcode::MOVE, argument_base + i, arguments[i])
      i = i + 1
    end
    [argument_base, arguments.length()]
  end

  # Direct calls to a top-level function support keyword arguments
  # (`f(y: 2, x: 1)`), unlike closure calls/NEW/INVOKE (which stay
  # positional-only, via parse_call_arguments) -- compiler.c scopes
  # keyword arguments the same way, since only a direct call has
  # compile-time, non-polymorphic access to the target's exact
  # parameter names. A keyword may skip a defaulted parameter; see
  # emit_sparse_keyword_call. A function defined later in the file goes
  # through compile_forward_call.
  def compile_call(name)
    name_token = @previous
    function_entry = self.find_function(name)
    if function_entry == nil && @current.kind() == :left_bracket && @in_method && @current_class_index != nil
      # `echo[U](value)`: only self's method can take type arguments here.
      return self.compile_invoke_arguments(0, name)
    end
    return self.compile_forward_call(name_token) if function_entry == nil
    type_arguments = []
    if @current.kind() == :left_bracket
      type_annotations = self.parse_explicit_type_annotations()
      return 0 if type_annotations == nil
      if type_annotations.length() != function_entry[4]
        self.fail("wrong number of generic arguments")
        return 0
      end
      # `identity[Int]` with no call: a callable with those arguments applied.
      if @current.kind() != :left_paren
        descriptor = [function_entry[0], function_entry[1], function_entry[2], function_entry[6]]
        return self.compile_reference_wrapper(nil, [descriptor, false], type_annotations)
      end
      type_arguments = self.declare_annotations(type_annotations)
    elsif function_entry[4] > 0
      # Omitted arguments use the VM's ordinary runtime inference.
    end
    return 0 if @failed
    self.advance_token()
    self.skip_newlines()
    if self.call_arguments_have_spread?()
      # Keywords alongside a spread fill their slots by index
      # (CALL_KEYWORD_SPREAD), as in compiler.c's parse_spread_function_call.
      collected = [function_entry[3], []]
      arguments = self.parse_spread_call_arguments(collected)
      keywords = collected[1]
      return 0 if arguments == nil
      return self.publish_call_return(function_entry, self.emit_call_spread(function_entry[1], arguments, type_arguments)) if keywords.length() == 0
      destination = self.allocate_register()
      self.emit_call_opcode(148) # CALL_KEYWORD_SPREAD; Opcode is at its constant limit
      self.emit_register(destination)
      self.emit_function_index(function_entry[1])
      self.emit_register(arguments)
      self.emit_byte(keywords.length())
      index = 0
      while index < keywords.length()
        self.emit_byte(keywords[index][0])
        self.emit_register(keywords[index][1])
        index = index + 1
      end
      return self.publish_call_return(function_entry, destination)
    end
    parsed_arguments = self.parse_keyword_call_arguments(function_entry, name_token)
    return 0 if parsed_arguments == nil
    slot_values = parsed_arguments[0]
    argument_count = parsed_arguments[1]
    if parsed_arguments[2] != nil
      if type_arguments.length() > 0
        # CALL_CLOSURE_KEYWORDS can't carry explicit type arguments.
        self.fail_at(name_token.start(), name_token.line(), name_token.column(),
          "missing argument")
        return 0
      end
      destination = self.emit_sparse_keyword_call(function_entry, slot_values,
        parsed_arguments[2], argument_count)
      return self.publish_call_return(function_entry, destination)
    end
    argument_base = self.allocate_register()
    i = 1
    while i < argument_count
      self.allocate_register()
      i = i + 1
    end
    i = 0
    while i < argument_count
      self.emit_instruction2(Opcode::MOVE, argument_base + i, slot_values[i])
      i = i + 1
    end
    destination = self.allocate_register()
    call_offset = @code_count
    if type_arguments.length() == 0
      self.emit_call_opcode(Opcode::CALL)
    else
      self.emit_call_opcode(Opcode::CALL_TYPED)
    end
    self.emit_register(destination)
    self.emit_function_index(function_entry[1])
    self.emit_register(argument_base)
    self.emit_byte(argument_count)
    self.note_plain_call(call_offset, destination, function_entry[1]) if type_arguments.length() == 0
    if type_arguments.length() > 0
      self.emit_byte(type_arguments.length())
      i = 0
      while i < type_arguments.length()
        self.emit_register(type_arguments[i])
        i = i + 1
      end
    end
    self.publish_call_return(function_entry, destination)
  end

  # Records a direct call's declared return type on its destination.
  def publish_call_return(function_entry, destination)
    return_fact = if function_entry[4] == 0
      self.annotation_single_type(function_entry[5])
    else
      nil
    end
    self.set_type_fact(destination, return_fact) if return_fact != nil
    if function_entry[4] == 0 && function_entry[5] != nil
      @declared_types.push([destination, function_entry[5]])
    end
    destination
  end

  # A direct call whose keyword arguments leave a defaulted parameter unfilled
  # (`f(1, c: 5)` against `def f(a, b = 2, c = 3)`). CALL's arguments are
  # contiguous, so this goes through CALL_CLOSURE_KEYWORDS instead: the slots
  # before the first gap are positional and every later filled slot is passed
  # by name. The VM leaves each gap undefined, so its default runs. Mirrors
  # compiler.c's emit_sparse_keyword_call; a trailing block here is just
  # another filled slot, passed by name.
  def emit_sparse_keyword_call(function_entry, slot_values, slot_filled, argument_count)
    parameter_names = function_entry[3]
    first_gap = 0
    while first_gap < argument_count && slot_filled[first_gap]
      first_gap = first_gap + 1
    end
    callable = self.allocate_register()
    self.emit_byte(Opcode::CLOSURE)
    self.emit_register(callable)
    self.emit_function_index(function_entry[1])
    self.emit_byte(0)
    positional = self.allocate_register()
    base = positional
    if first_gap > 0
      base = self.allocate_register()
      i = 1
      while i < first_gap
        self.allocate_register()
        i = i + 1
      end
      i = 0
      while i < first_gap
        self.emit_instruction2(Opcode::MOVE, base + i, slot_values[i])
        i = i + 1
      end
    end
    self.emit_instruction3(Opcode::ARRAY, positional, base, first_gap)
    names = []
    registers = []
    slot = first_gap
    while slot < argument_count
      if slot_filled[slot]
        names.push(self.add_string(parameter_names[slot]))
        registers.push(slot_values[slot])
      end
      slot = slot + 1
    end
    destination = self.allocate_register()
    self.emit_call_opcode(Opcode::CALL_CLOSURE_KEYWORDS)
    self.emit_register(destination)
    self.emit_register(callable)
    self.emit_register(positional)
    self.emit_byte(names.length())
    i = 0
    while i < names.length()
      self.emit_register(names[i])
      self.emit_register(registers[i])
      i = i + 1
    end
    destination
  end

  def keyword_argument_ahead?()
    return false if @current.kind() != :identifier
    lookahead = @lexer.clone()
    lookahead.next_token().kind() == :colon
  end

  # Returns an Array of `arity` value registers, one per declared
  # parameter slot (in declaration order, regardless of the order
  # arguments were written at the call site), or nil on a parse
  # failure. Mirrors compiler.c's own slot_registers/slot_filled
  # tracking: a keyword fills its named slot directly; a positional
  # argument fills the next not-yet-seen slot in order; a positional
  # argument can't follow a keyword one.
  def parse_keyword_call_arguments(function_entry, name_token)
    arity = if self.variadic_function?(function_entry[1])
      255
    else
      function_entry[2]
    end
    parameter_names = function_entry[3]
    slot_values = []
    slot_filled = []
    index = 0
    while index < arity
      slot_values.push(nil)
      slot_filled.push(false)
      index = index + 1
    end
    next_positional_slot = 0
    seen_keyword = false
    if @current.kind() != :right_paren
      more = true
      while more
        slot = -1
        if self.keyword_argument_ahead?()
          keyword_token = @current
          keyword_name = self.token_text(@current)
          self.advance_token()
          self.advance_token()
          slot = find_parameter_slot(parameter_names, keyword_name)
          if slot == -1
            self.fail_at(keyword_token.start(), keyword_token.line(), keyword_token.column(),
              "no parameter with this name")
            return nil
          end
          seen_keyword = true
        else
          if seen_keyword
            self.fail("positional argument cannot follow a keyword argument")
            return nil
          end
          if next_positional_slot >= arity
            self.fail("too many call arguments")
            return nil
          end
          slot = next_positional_slot
          next_positional_slot = next_positional_slot + 1
        end
        if slot_filled[slot]
          self.fail_at(name_token.start(), name_token.line(), name_token.column(),
            "multiple values for the same argument")
          return nil
        end
        slot_values[slot] = self.parse_expression()
        slot_filled[slot] = true
        self.skip_newlines()
        if @current.kind() == :comma
          self.advance_token()
          self.skip_newlines()
          more = @current.kind() != :right_paren
        else
          more = false
        end
      end
    end
    if @current.kind() != :right_paren
      self.fail("expected ')' after arguments")
      return nil
    end
    self.advance_token()
    # The call's own argument count is the highest filled slot's index
    # plus one, not the declared arity -- omitted *trailing* slots are
    # exactly what a default parameter relies on. A gap *below* the
    # highest filled slot (an earlier default relied on while a later
    # slot is explicitly supplied via keyword) isn't supported: defaults
    # compile inline into the callee's own bytecode, conditioned on a
    # contiguous argument count, not stored as independently
    # re-evaluable expressions a call site could reach around a gap --
    # mirrors compiler.c's own parse_call exactly.
    argument_count = 0
    index = 0
    while index < arity
      argument_count = index + 1 if slot_filled[index]
      index = index + 1
    end
    # A trailing block fills the next unfilled slot -- the callee's own
    # declared arity already accounts for it (a direct call takes a
    # block by having a Callable-typed trailing parameter, same as any
    # other argument), so this needs no register-contiguity workaround
    # unlike compile_invoke: slot_values isn't materialized into
    # registers until after this function returns. Mirrors compiler.c's
    # own parse_call fix exactly (block goes into the next slot right
    # after argument_count is computed, before the "every slot below the
    # highest filled one must be filled" check below).
    # With a `&block` parameter (entry[8]) the block fills that last slot,
    # leaving defaulted parameters before it to their defaults.
    if @current.kind() == :do
      block_slot = argument_count
      block_slot = arity - 1 if function_entry.length() > 8 && function_entry[8] &&
        !self.variadic_function?(function_entry[1]) && arity - 1 > argument_count
      if block_slot >= arity
        self.fail("too many call arguments")
        return nil
      end
      @block_context = contextual_block_member(function_entry, block_slot)
      slot_values[block_slot] = self.compile_block()
      slot_filled[block_slot] = true
      argument_count = block_slot + 1
    end
    # A slot below the highest filled one may stay empty only when its
    # parameter has a default (index >= required arity); compile_call then
    # passes the later slots by name. A required parameter left empty is an
    # error -- mirrors compiler.c's gaps_are_defaulted.
    has_gap = false
    index = 0
    while index < argument_count
      if !slot_filled[index]
        if index < function_entry[6]
          self.fail_at(name_token.start(), name_token.line(), name_token.column(),
            "missing argument")
          return nil
        end
        has_gap = true
      end
      index = index + 1
    end
    if (!has_gap && argument_count < function_entry[6]) || argument_count > arity
      self.fail_at(name_token.start(), name_token.line(), name_token.column(),
        "wrong number of arguments")
      return nil
    end
    gaps = if has_gap
      slot_filled
    else
      nil
    end
    [slot_values, argument_count, gaps]
  end

  # Calling a closure-valued local (see compile_definition's nested-`def`
  # branch) -- unlike compile_call, the target's arity isn't known at
  # compile time (only the runtime Closure value's own function_index
  # carries it), so there's no argument-count check here; the VM raises
  # an ordinary ArityError at CALL_CLOSURE time instead, matching
  # compiler.c's own parse_call CALL_CLOSURE branch exactly.
  def compile_closure_call(local)
    self.compile_callable_call(self.read_local(local))
  end

  # `callable(args)` on a value already in a register (a local, @ivar or
  # @@cvar), the current token being the '('.
  # A trailing do block is one more call argument, in the register right
  # after `parsed`'s contiguous [base, count] (see compile_invoke); returns
  # the arguments with it.
  def append_trailing_block(parsed)
    return parsed if @current.kind() != :do
    block_slot = parsed[0] + parsed[1]
    self.allocate_register() if block_slot == @next_register
    block_result = self.compile_block()
    self.emit_instruction2(Opcode::MOVE, block_slot, block_result)
    [parsed[0], parsed[1] + 1]
  end

  def compile_callable_call(callable)
    self.advance_token()
    self.skip_newlines()
    if self.call_arguments_have_keyword?()
      arguments = self.parse_dynamic_keyword_arguments()
      return 0 if arguments == nil
      destination = self.allocate_register()
      self.emit_call_opcode(Opcode::CALL_CLOSURE_KEYWORDS)
      self.emit_register(destination)
      self.emit_register(callable)
      self.emit_keyword_trailer(arguments)
      return destination
    end
    if self.call_arguments_have_spread?()
      arguments = self.parse_spread_call_arguments()
      return 0 if arguments == nil
      destination = self.allocate_register()
      self.emit_call_opcode(Opcode::CALL_CLOSURE_SPREAD)
      self.emit_register(destination)
      self.emit_register(callable)
      self.emit_register(arguments)
      return destination
    end
    parsed = self.parse_call_arguments()
    return 0 if parsed == nil
    # A declared `Callable[[params], R]` types a trailing block from its
    # last parameter, and fewer arguments than that leave the ones before it
    # to their defaults: the block then goes by CALL_CLOSURE_KEYWORDS' block
    # flag (compiler.c's compile_callable_value_block).
    declaration = self.declared_type(callable)
    if @current.kind() == :do && declaration != nil && declaration.length() == 1 &&
       declaration[0][0] == "Callable" && declaration[0][5] != nil && declaration[0][5].length() > 0
      slot = declaration[0][5].length() - 1
      @block_context = contextual_block_member([nil, nil, nil, nil, nil, nil, nil, declaration[0][5]], slot)
      if parsed[1] < slot
        positional = self.allocate_register()
        self.emit_instruction3(Opcode::ARRAY, positional, parsed[0], parsed[1])
        block_result = self.compile_block()
        destination = self.allocate_register()
        self.emit_call_opcode(Opcode::CALL_CLOSURE_KEYWORDS)
        self.emit_register(destination)
        self.emit_register(callable)
        self.emit_keyword_trailer([positional, [], block_result])
        return destination
      end
    end
    argument_count = self.append_trailing_block(parsed)[1]
    destination = self.allocate_register()
    self.emit_call_opcode(Opcode::CALL_CLOSURE)
    self.emit_register(destination)
    self.emit_register(callable)
    self.emit_register(parsed[0])
    self.emit_byte(argument_count)
    destination
  end

  # `name(args)` on self's class from inside a class singleton method,
  # dispatched on the class self actually is (a subclass inherits it); the
  # current token is the '('. Mirrors parse_self_class_method_arguments.
  def compile_self_class_call(name)
    if @current.kind() != :left_paren
      self.fail("member access requires a method call with '()'")
      return 0
    end
    self.advance_token()
    parsed = self.parse_call_arguments()
    return 0 if parsed == nil
    destination = self.allocate_register()
    self.emit_call_opcode(Opcode::INVOKE_SELF_METHOD)
    self.emit_register(destination)
    self.emit_register(self.add_string(name))
    self.emit_register(parsed[0])
    self.emit_byte(parsed[1])
    destination
  end

  # Whether the class being compiled has declared its own `p` method (or
  # singleton method) so far,
  # which a bare `p(...)` inside it calls instead.
  def class_defines_p?()
    return false if @current_class_index == nil
    @current_class_method_names.include?("p") || @current_class_singleton_method_names.include?("p")
  end

  # `p(value)`: prints value.inspect() and returns value, when nothing else
  # named p exists. Mirrors compiler_builtins.c's parse_p_call.
  def parse_p_call()
    self.advance_token()
    self.skip_newlines()
    value = self.parse_expression()
    self.skip_newlines()
    if @current.kind() != :right_paren
      self.fail("expected ')' after arguments (p takes one value)")
      return 0
    end
    self.advance_token()
    text = self.emit_destructure_invoke(value, "inspect", nil)
    printed = self.allocate_register()
    self.emit_byte(Opcode::PRINT)
    self.emit_register(printed)
    self.emit_register(text)
    self.emit_byte(1)
    value
  end

  def parse_print_call(newline)
    self.advance_token()
    source = self.parse_expression()
    if @current.kind() != :right_paren
      self.fail("expected ')' after arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    self.emit_byte(Opcode::PRINT)
    self.emit_register(destination)
    self.emit_register(source)
    self.emit_byte(if newline
      1
    else
      0
    end)
    destination
  end

  def assignment_ahead?()
    return false if @current.kind() != :identifier && @current.kind() != :instance_variable &&
      @current.kind() != :class_variable
    lookahead = @lexer.clone()
    lookahead.next_token().kind() == :equal
  end

  # Same shape as assignment_ahead? above (identifier/@ivar/@@cvar
  # targets; `arr[i] += 1` goes through index_assignment_ahead?).
  def compound_assignment_ahead?()
    return false if @current.kind() != :identifier && @current.kind() != :instance_variable &&
      @current.kind() != :class_variable
    lookahead = @lexer.clone()
    compound_assignment_token?(lookahead.next_token().kind())
  end

  # `name[i] = v`, or a chain `name[i][j] = v`?
  # Or `name[i] += v` (one index only, as in compiler.c's
  # index_compound_assignment_ahead). The target may be an @ivar or @@cvar.
  def index_assignment_ahead?()
    return false if @current.kind() != :identifier && @current.kind() != :instance_variable &&
      @current.kind() != :class_variable
    lookahead = @lexer.clone()
    kind = lookahead.next_token().kind()
    return false if kind != :left_bracket
    # Any other receiver takes the expression path, as parse_index stores too.
    if @current.kind() == :identifier
      name = self.token_text(@current)
      return false if self.find_local(name) == nil && self.find_lexical_constant(name) == nil
    end
    groups = 0
    while kind == :left_bracket
      depth = 1
      while depth > 0
        kind = lookahead.next_token().kind()
        return false if kind == :eof || kind == :newline
        depth = depth + 1 if kind == :left_bracket
        depth = depth - 1 if kind == :right_bracket
      end
      groups = groups + 1
      kind = lookahead.next_token().kind()
    end
    kind == :equal || (groups == 1 && compound_assignment_token?(kind))
  end

  def compile_index_assignment()
    name = self.token_text(@current)
    local = self.find_local(name)
    constant_index = self.find_lexical_constant(name)
    receiver = if @current.kind() == :instance_variable
      self.compile_ivar_read(@current)
    elsif @current.kind() == :class_variable
      self.compile_cvar_read(@current)
    elsif local != nil
      self.read_local(local)
    elsif constant_index != nil
      destination = self.allocate_register()
      self.emit_instruction2(48, destination, constant_index)
      destination
    else
      self.fail("undefined local variable")
      return 0
    end
    self.advance_token()
    self.advance_token()
    index = self.parse_expression()
    if @current.kind() != :right_bracket
      self.fail("expected ']' after assignment index")
      return 0
    end
    self.advance_token()
    # In a chain, every index but the last reads the next receiver.
    while @current.kind() == :left_bracket
      element = self.allocate_register()
      self.emit_instruction3(Opcode::INDEX_GET, element, receiver, index)
      receiver = element
      self.advance_token()
      index = self.parse_expression()
      if @current.kind() != :right_bracket
        self.fail("expected ']' after assignment index")
        return 0
      end
      self.advance_token()
    end
    return self.compile_index_compound_store(receiver, index) if compound_assignment_token?(@current.kind())
    if @current.kind() != :equal
      self.fail("expected '=' after indexed target")
      return 0
    end
    self.advance_token()
    value = self.parse_expression()
    self.emit_instruction3(Opcode::INDEX_SET, receiver, index, value)
    value
  end

  # `receiver[index] op= value`, the current token being the operator: the
  # index is evaluated once and its register reused for the read and the
  # write. Mirrors compiler_assignment.c's compile_index_compound_assignment.
  def compile_index_compound_store(receiver, index)
    left = self.allocate_register()
    self.emit_instruction3(Opcode::INDEX_GET, left, receiver, index)
    op_kind = @current.kind()
    self.advance_token()
    if op_kind == :or_or_equal || op_kind == :and_and_equal
      destination = self.allocate_register()
      self.emit_instruction2(Opcode::MOVE, destination, left)
      end_jump = self.emit_jump(if op_kind == :and_and_equal
        Opcode::JUMP_IF_FALSE
      else
        Opcode::JUMP_IF_TRUE
      end, left)
      right = self.parse_expression()
      self.emit_instruction2(Opcode::MOVE, destination, right)
      self.patch_jump(end_jump, @code_count)
    else
      plain_kind = if op_kind == :plus_equal
        :plus
      elsif op_kind == :minus_equal
        :minus
      elsif op_kind == :star_equal
        :star
      elsif op_kind == :slash_equal
        :slash
      else
        :percent
      end
      right = self.parse_expression()
      destination = self.allocate_register()
      self.emit_instruction3(binary_opcode(plain_kind), destination, left, right)
    end
    self.emit_instruction3(Opcode::INDEX_SET, receiver, index, destination)
    destination
  end

  def compile_assignment_store(token, instance_variable, class_variable, value)
    return self.compile_ivar_write(token, value) if instance_variable
    return self.compile_cvar_write(token, value) if class_variable
    name = self.token_text(token)
    first = name.slice(0, 1)
    return self.store_namespace_constant(name, value) if first >= "A" && first <= "Z"
    existing = self.find_local(name)
    if existing != nil && existing[2]
      self.emit_instruction1(Opcode::BOX_LOCAL, existing[1])
      self.emit_instruction2(Opcode::SET_CELL, existing[1], value)
      self.set_type_fact(existing[1], self.type_fact(value))
      return value
    end
    destination = if existing == nil
      self.define_local(name)
    else
      existing[1]
    end
    self.emit_instruction2(Opcode::MOVE, destination, value)
    self.set_type_fact(destination, self.type_fact(value))
    source_declaration = self.declared_type(value)
    if source_declaration != nil
      @declared_types.push([destination, source_declaration])
    end
    destination
  end

  def compile_assignment()
    instance_variable = @current.kind() == :instance_variable
    class_variable = @current.kind() == :class_variable
    token = @current
    self.advance_token()
    self.advance_token()
    value = self.parse_expression()
    self.compile_assignment_store(token, instance_variable, class_variable, value)
  end

  # Returns the token after one pattern starting at `token`, or nil when
  # the tokens don't form a pattern.
  def scan_destructuring_pattern(lexer, token, depth)
    return nil if depth > 8
    if token.kind() == :star
      token = lexer.next_token()
      return nil unless destructuring_target_kind?(token.kind())
      return scan_destructuring_target_suffix(lexer, lexer.next_token())
    end
    if destructuring_target_kind?(token.kind())
      return scan_destructuring_target_suffix(lexer, lexer.next_token())
    end
    if token.kind() == :left_brace
      token = lexer.next_token()
      return nil if token.kind() == :right_brace
      while true
        if token.kind() == :star
          token = lexer.next_token()
          return nil if token.kind() != :star
          token = lexer.next_token()
          return nil unless destructuring_target_kind?(token.kind())
          token = scan_destructuring_target_suffix(lexer, lexer.next_token())
        else
          # Skip the key expression up to its top-level ':'.
          nesting = 0
          scanning = true
          while scanning
            kind = token.kind()
            return nil if kind == :eof || kind == :error || kind == :newline
            if kind == :colon && nesting == 0
              scanning = false
            else
              nesting = nesting + 1 if kind == :left_paren || kind == :left_bracket || kind == :left_brace
              if kind == :right_paren || kind == :right_bracket || kind == :right_brace
                return nil if nesting == 0
                nesting = nesting - 1
              end
              token = lexer.next_token()
            end
          end
          token = self.scan_destructuring_pattern(lexer, lexer.next_token(), depth + 1)
          return nil if token == nil
        end
        return lexer.next_token() if token.kind() == :right_brace
        return nil if token.kind() != :comma
        token = lexer.next_token()
      end
    end
    return nil if token.kind() != :left_bracket
    token = lexer.next_token()
    return nil if token.kind() == :right_bracket
    while true
      token = self.scan_destructuring_pattern(lexer, token, depth + 1)
      return nil if token == nil
      return lexer.next_token() if token.kind() == :right_bracket
      return nil if token.kind() != :comma
      token = lexer.next_token()
    end
  end

  def multi_assignment_ahead?()
    lookahead = @lexer.clone()
    token = @current
    if token.kind() == :left_bracket || token.kind() == :left_brace
      after = self.scan_destructuring_pattern(lookahead, token, 0)
      return after != nil && after.kind() == :equal
    end
    return false unless destructuring_target_kind?(token.kind())
    token = scan_destructuring_target_suffix(lookahead, lookahead.next_token())
    return false if token.kind() != :comma
    while token != nil && token.kind() == :comma
      token = self.scan_destructuring_pattern(lookahead, lookahead.next_token(), 0)
    end
    token != nil && token.kind() == :equal
  end

  def emit_destructure_invoke(receiver, name, argument)
    base = if argument == nil
      self.allocate_register()
    else
      argument
    end
    destination = self.allocate_register()
    self.emit_call_opcode(Opcode::INVOKE)
    self.emit_register(destination)
    self.emit_register(receiver)
    self.emit_register(self.add_string(name))
    self.emit_register(base)
    self.emit_byte(if argument == nil
      0
    else
      1
    end)
    destination
  end

  def load_destructure_target(token, kind)
    return self.compile_ivar_read(token) if kind == :instance_variable
    return self.compile_cvar_read(token) if kind == :class_variable
    name = self.token_text(token)
    local = self.find_local(name)
    return self.read_local(local) if local != nil
    constant_index = self.find_lexical_constant(name)
    if constant_index != nil
      destination = self.allocate_register()
      self.emit_instruction2(48, destination, constant_index)
      return destination
    end
    self.fail_at(token.start(), token.line(), token.column(), "undefined local variable")
    0
  end

  def parse_destructure_target(node)
    kind = @current.kind()
    node[0] = :leaf
    node[4] = @current
    node[5] = kind == :instance_variable
    node[6] = kind == :class_variable
    self.advance_token()
    return node if @current.kind() != :left_bracket && @current.kind() != :dot
    receiver = self.load_destructure_target(node[4], kind)
    while !@failed && (@current.kind() == :left_bracket || @current.kind() == :dot)
      if @current.kind() == :left_bracket
        self.advance_token()
        index = self.parse_expression()
        if @current.kind() != :right_bracket
          self.fail("expected ']' after destructuring target index")
          return node
        end
        self.advance_token()
        if @current.kind() == :left_bracket || @current.kind() == :dot
          loaded = self.allocate_register()
          self.emit_instruction3(Opcode::INDEX_GET, loaded, receiver, index)
          receiver = loaded
        else
          node[8] = :indexed
          node[9] = receiver
          node[10] = index
        end
      else
        self.advance_token()
        if @current.kind() != :identifier
          self.fail("expected member after '.' in destructuring target")
          return node
        end
        member = self.token_text(@current)
        self.advance_token()
        if @current.kind() == :left_bracket || @current.kind() == :dot
          receiver = self.emit_destructure_invoke(receiver, member, nil)
        else
          node[8] = :member
          node[9] = receiver
          node[10] = member
        end
      end
    end
    node
  end

  def fail_at_node(node, message)
    token = node[4]
    if token == nil
      self.fail(message)
    else
      self.fail_at(token.start(), token.line(), token.column(), message)
    end
  end

  def parse_hash_destructure_node(node, depth)
    self.advance_token()
    self.skip_newlines()
    children = node[1]
    while @current.kind() != :right_brace && !@failed
      if children.length() == 16
        self.fail("too many Hash destructuring targets")
        return node
      end
      if @current.kind() == :star && @lexer.clone().next_token().kind() == :star
        self.advance_token()
        self.advance_token()
        child = self.parse_destructure_node(depth + 1)
        return node if @failed
        if child[0] != :leaf
          self.fail_at(@previous.start(), @previous.line(), @previous.column(),
            "Hash rest target must be a variable")
          return node
        end
        child[3] = true
        children.push(child)
        self.skip_newlines()
        if @current.kind() != :right_brace
          self.fail("Hash rest target must be last")
          return node
        end
        break
      end
      key = self.parse_expression()
      if @current.kind() != :colon
        self.fail("expected ':' after Hash destructuring key")
        return node
      end
      self.advance_token()
      child = self.parse_destructure_node(depth + 1)
      return node if @failed
      if child[2]
        self.fail_at_node(child, "rest target is not valid as a Hash entry target")
        return node
      end
      child[7] = key
      children.push(child)
      self.skip_newlines()
      break if @current.kind() == :right_brace
      if @current.kind() != :comma
        self.fail("expected ',' in Hash destructuring pattern")
        return node
      end
      self.advance_token()
      self.skip_newlines()
    end
    return node if @failed
    if children.length() == 0
      self.fail("Hash destructuring pattern cannot be empty")
      return node
    end
    self.advance_token()
    node
  end

  # Appends one pattern to an Array node, enforcing the 16-target and
  # single-rest limits; false once compilation has failed.
  def push_destructure_child(node, depth)
    children = node[1]
    if children.length() == 16
      self.fail("too many destructuring targets")
      return false
    end
    child = self.parse_destructure_node(depth)
    return false if @failed
    if child[2]
      index = 0
      while index < children.length()
        if children[index][2]
          self.fail_at_node(child, "destructuring pattern may contain only one rest target")
          return false
        end
        index = index + 1
      end
    end
    children.push(child)
    true
  end

  def parse_destructure_node(depth)
    if @destructure_node_count == 64 || depth > 8
      self.fail("destructuring pattern is too complex")
      return destructure_node(:leaf)
    end
    @destructure_node_count = @destructure_node_count + 1
    node = destructure_node(:array)
    if @current.kind() == :star
      node[2] = true
      self.advance_token()
      if !destructuring_target_kind?(@current.kind())
        self.fail("expected target after '*' in destructuring pattern")
        return node
      end
    end
    return self.parse_destructure_target(node) if destructuring_target_kind?(@current.kind())
    if @current.kind() == :left_brace
      node[0] = :hash
      return self.parse_hash_destructure_node(node, depth)
    end
    if @current.kind() != :left_bracket
      self.fail("expected destructuring target")
      return node
    end
    self.advance_token()
    while @current.kind() != :right_bracket && !@failed
      return node unless self.push_destructure_child(node, depth + 1)
      break if @current.kind() == :right_bracket
      if @current.kind() != :comma
        self.fail("expected ',' in destructuring pattern")
        return node
      end
      self.advance_token()
    end
    return node if @failed
    if node[1].length() == 0
      self.fail("destructuring pattern cannot be empty")
      return node
    end
    self.advance_token()
    node
  end

  def emit_destructure_hash_extract(node, value, array_set, hash_set)
    self.emit_instruction2(Opcode::CHECK_TYPE, value, hash_set)
    children = node[1]
    fixed_count = 0
    index = 0
    while index < children.length()
      fixed_count = fixed_count + 1 unless children[index][3]
      index = index + 1
    end
    index = 0
    while index < children.length()
      child = children[index]
      if child[3]
        # `**rest`: everything except the keys named before it.
        key_base = self.allocate_register()
        key = 1
        while key < fixed_count
          self.allocate_register()
          key = key + 1
        end
        key_index = 0
        fixed = 0
        while fixed < children.length()
          if !children[fixed][3]
            self.emit_instruction2(Opcode::MOVE, key_base + key_index, children[fixed][7])
            key_index = key_index + 1
          end
          fixed = fixed + 1
        end
        excluded = self.allocate_register()
        self.emit_instruction3(Opcode::ARRAY, excluded, key_base, fixed_count)
        self.set_type_fact(excluded, Type::ARRAY)
        rest = self.allocate_register()
        self.emit_instruction3(Opcode::HASH_REST, rest, value, excluded)
        self.set_type_fact(rest, Type::HASH)
        child[11] = rest
      else
        self.emit_instruction2(Opcode::CHECK_HASH_KEY, value, child[7])
        element = self.allocate_register()
        self.emit_instruction3(Opcode::INDEX_GET, element, value, child[7])
        self.emit_destructure_extract(child, element, array_set, hash_set)
      end
      index = index + 1
    end
  end

  # Checks each group's shape against the already-evaluated value and
  # loads every leaf's value into a register; stores happen afterwards
  # (emit_destructure_stores), so a shape error leaves all targets
  # unchanged.
  def emit_destructure_extract(node, value, array_set, hash_set)
    node[11] = value
    return if node[0] == :leaf
    return self.emit_destructure_hash_extract(node, value, array_set, hash_set) if node[0] == :hash
    self.emit_instruction2(Opcode::CHECK_TYPE, value, array_set)
    children = node[1]
    count = children.length()
    rest_index = -1
    index = 0
    while index < count
      rest_index = index if children[index][2]
      index = index + 1
    end
    has_rest = rest_index >= 0
    fixed_count = if has_rest
      count - 1
    else
      count
    end
    self.emit_instruction2(Opcode::CHECK_DESTRUCTURE_COUNT, value, if has_rest
      fixed_count + 32768
    else
      fixed_count
    end)
    index = 0
    while index < count
      child = children[index]
      element = self.allocate_register()
      if child[2]
        self.emit_instruction3(Opcode::ARRAY_MIDDLE, element, value,
          index * 256 + (count - index - 1))
        self.set_type_fact(element, Type::ARRAY)
      elsif has_rest && index > rest_index
        self.emit_instruction3(Opcode::ARRAY_SUFFIX, element, value, count - index)
      else
        index_register = self.allocate_register()
        self.emit_instruction2(Opcode::CONSTANT, index_register, self.add_constant(index))
        self.set_type_fact(index_register, Type::INT)
        self.emit_instruction3(Opcode::INDEX_GET, element, value, index_register)
      end
      self.emit_destructure_extract(child, element, array_set, hash_set)
      index = index + 1
    end
  end

  def emit_destructure_stores(node)
    value = node[11]
    if node[0] == :leaf
      if node[8] == :indexed
        self.emit_instruction3(Opcode::INDEX_SET, node[9], node[10], value)
        return value
      end
      if node[8] == :member
        self.emit_destructure_invoke(node[9], node[10] + "=", value)
        return value
      end
      return self.compile_assignment_store(node[4], node[5], node[6], value)
    end
    last = value
    index = 0
    while index < node[1].length()
      last = self.emit_destructure_stores(node[1][index])
      index = index + 1
    end
    last
  end

  # The right-hand side is evaluated once; several comma-separated values
  # become one Array first.
  def compile_multi_assignment()
    @destructure_node_count = 0
    root = if @current.kind() == :left_bracket || @current.kind() == :left_brace
      self.parse_destructure_node(0)
    else
      node = destructure_node(:array)
      @destructure_node_count = 1
      parsing = true
      while parsing && self.push_destructure_child(node, 0)
        if @current.kind() == :comma
          self.advance_token()
        else
          parsing = false
        end
      end
      node
    end
    return 0 if @failed
    if @current.kind() != :equal
      self.fail("expected '=' after destructuring pattern")
      return 0
    end
    self.advance_token()
    values = [self.parse_expression()]
    while @current.kind() == :comma && !@failed
      if values.length() == 16
        self.fail("too many destructuring right-hand values")
        return 0
      end
      self.advance_token()
      self.skip_newlines()
      values.push(self.parse_expression())
    end
    return 0 if @failed
    value = values[0]
    if values.length() > 1
      base = self.allocate_register()
      index = 1
      while index < values.length()
        self.allocate_register()
        index = index + 1
      end
      index = 0
      while index < values.length()
        self.emit_instruction2(Opcode::MOVE, base + index, values[index])
        index = index + 1
      end
      value = self.allocate_register()
      self.emit_instruction3(Opcode::ARRAY, value, base, values.length())
      self.set_type_fact(value, Type::ARRAY)
    end
    array_set = self.declare_annotation([["Array", nil, nil, -1, nil, nil]])
    hash_set = self.declare_annotation([["Hash", nil, nil, -1, nil, nil]])
    return 0 if @failed
    self.emit_destructure_extract(root, value, array_set, hash_set)
    self.emit_destructure_stores(root)
  end

  # `x += y`/.../`x ||= y`/`x &&= y` -- see compiler.c's compile_compound_
  # assignment for the full rationale; this mirrors it exactly, just
  # built from this parser's own read/write primitives (read_local/
  # compile_ivar_read/compile_cvar_read for the read side,
  # compile_assignment_store for the write side) instead of a shared
  # parse_prefix dispatch, since this parser doesn't have one function
  # playing that combined role.
  def compile_compound_assignment()
    instance_variable = @current.kind() == :instance_variable
    class_variable = @current.kind() == :class_variable
    token = @current
    name = self.token_text(token)
    self.advance_token()
    left = if instance_variable
      self.compile_ivar_read(token)
    elsif class_variable
      self.compile_cvar_read(token)
    else
      existing = self.find_local(name)
      if existing == nil
        self.fail_at(token.start(), token.line(), token.column(), "undefined local variable")
        0
      else
        self.read_local(existing)
      end
    end
    op_kind = @current.kind()
    self.advance_token()
    if op_kind == :or_or_equal || op_kind == :and_and_equal
      is_and = op_kind == :and_and_equal
      destination = self.allocate_register()
      self.emit_instruction2(Opcode::MOVE, destination, left)
      end_jump = self.emit_jump(if is_and
        Opcode::JUMP_IF_FALSE
      else
        Opcode::JUMP_IF_TRUE
      end, left)
      right = self.parse_expression()
      self.emit_instruction2(Opcode::MOVE, destination, right)
      self.patch_jump(end_jump, @code_count)
      return self.compile_assignment_store(token, instance_variable, class_variable, destination)
    end
    plain_kind = if op_kind == :plus_equal
      :plus
    elsif op_kind == :minus_equal
      :minus
    elsif op_kind == :star_equal
      :star
    elsif op_kind == :slash_equal
      :slash
    else
      :percent
    end
    right = self.parse_expression()
    destination = self.allocate_register()
    self.emit_instruction3(binary_opcode(plain_kind), destination, left, right)
    result_fact = self.binary_result_fact(plain_kind, left, right)
    self.set_type_fact(destination, result_fact) if result_fact != nil
    self.compile_assignment_store(token, instance_variable, class_variable, destination)
  end

  def compile_ivar_write(token, value)
    if @current_class_index == nil && @current_module_index == nil
      self.fail("instance variable used outside a method")
      return 0
    end
    field_text = self.token_text(token)
    field_name = field_text.slice(1, field_text.length() - 1)
    if @current_module_index != nil && @current_class_index == nil
      @current_method_uses_state = true
      @builder.declare_module_field(@current_module_index, field_name)
      field_index = self.add_string(field_name)
      self.emit_instruction3(47, 0, field_index, value)
    else
      field_index = @builder.declare_field(@current_class_index, field_name)
      self.emit_instruction3(Opcode::SET_IVAR, 0, field_index, value)
    end
    value
  end

  def compile_ivar_read(token)
    if @current_class_index == nil && @current_module_index == nil
      self.fail("instance variable used outside a method")
      return 0
    end
    field_text = self.token_text(token)
    field_name = field_text.slice(1, field_text.length() - 1)
    destination = self.allocate_register()
    if @current_module_index != nil && @current_class_index == nil
      @current_method_uses_state = true
      @builder.declare_module_field(@current_module_index, field_name)
      field_index = self.add_string(field_name)
      self.emit_instruction3(46, destination, 0, field_index)
    else
      field_index = @builder.declare_field(@current_class_index, field_name)
      self.emit_instruction3(Opcode::GET_IVAR, destination, 0, field_index)
    end
    destination
  end

  # Class variables are class-only, never module-level (confirmed
  # directly against the native compiler: `class_variable_index` fails
  # "class variable used outside a class" whenever current_class < 0,
  # with no module_field-style alternative the way instance variables
  # have) -- so unlike compile_ivar_read/compile_ivar_write above, no
  # module branch here. GET_CVAR/SET_CVAR take (dest_or_value,
  # current_class_index, slot), the slot coming from the new
  # ProgramBuilder#declare_class_variable bridge (mirrors #declare_field).
  def compile_cvar_write(token, value)
    if @current_class_index == nil
      self.fail("class variable used outside a class")
      return 0
    end
    variable_text = self.token_text(token)
    variable_name = variable_text.slice(2, variable_text.length() - 2)
    slot = @builder.declare_class_variable(@current_class_index, variable_name)
    self.emit_instruction3(Opcode::SET_CVAR, @current_class_index, slot, value)
    value
  end

  def compile_cvar_read(token)
    if @current_class_index == nil
      self.fail("class variable used outside a class")
      return 0
    end
    variable_text = self.token_text(token)
    variable_name = variable_text.slice(2, variable_text.length() - 2)
    slot = @builder.declare_class_variable(@current_class_index, variable_name)
    destination = self.allocate_register()
    self.emit_instruction3(Opcode::GET_CVAR, destination, @current_class_index, slot)
    destination
  end

  # Parses an optional `[Type, Type, ...]` explicit generic-argument
  # list right after a callable's name, before its own '(' argument
  # list -- shared by every call site that accepts one
  # (compile_invoke and the class/module singleton call paths;
  # compile_call keeps its own copy since it alone also validates the
  # count against a statically-known type_variable_count). Returns an
  # Array of declared type-set indices (empty if there's no '[' at
  # all), or nil on a parse failure.
  # The type sets of explicit generic arguments, or nil after a failure.
  def declare_annotations(annotations)
    return nil if annotations == nil
    sets = []
    index = 0
    while index < annotations.length() && !@failed
      sets.push(self.declare_annotation(annotations[index]))
      index = index + 1
    end
    sets
  end

  def parse_explicit_type_annotations()
    type_arguments = []
    return type_arguments unless @current.kind() == :left_bracket
    self.advance_token()
    self.skip_newlines()
    while !@failed && @current.kind() != :right_bracket
      if type_arguments.length() == 8
        self.fail("too many generic arguments")
      else
        type_arguments.push(self.parse_type_annotation())
        self.skip_newlines()
        if @current.kind() == :comma
          self.advance_token()
          self.skip_newlines()
        else
          break
        end
      end
    end
    if !@failed && @current.kind() != :right_bracket
      self.fail("expected ']' after generic arguments")
    else
      self.advance_token() unless @failed
    end
    return nil if @failed
    type_arguments
  end

  # A method named without an argument list, as a Callable value, built as
  # a wrapper function. `target` is a method name for `receiver.method`: the
  # wrapper captures the receiver and INVOKEs the method on it. When the
  # receiver's class is known, the wrapper has the method's own signature;
  # otherwise it collects any arguments and goes through INVOKE_SPREAD
  # (compiler.c's parse_bound_method_reference). For `Owner.method`, `target`
  # is [descriptor, needs_receiver] and the wrapper, typed like the
  # singleton, calls it directly (parse_singleton_reference). A typed wrapper
  # leaves out unprovided trailing arguments so their defaults run, and
  # declares a generic target's type variables itself; explicit generic
  # arguments are declared again in the wrapper, whose type sets they index.
  def annotations_use_type_variable?(annotations)
    index = 0
    while index < annotations.length()
      return true if self.annotation_uses_type_variable?(annotations[index])
      index = index + 1
    end
    false
  end

  def annotation_uses_type_variable?(annotation)
    return false if annotation == nil
    index = 0
    while index < annotation.length()
      member = annotation[index]
      return true if @current_type_variables.include?(member[0])
      return true if self.annotation_uses_type_variable?(member[1])
      return true if self.annotation_uses_type_variable?(member[2])
      return true if self.annotation_uses_type_variable?(member[4])
      return true if member[5] != nil && self.annotations_use_type_variable?(member[5])
      index = index + 1
    end
    false
  end

  def compile_reference_wrapper(receiver, target, type_annotations)
    bound = target.is_a?(String)
    callee = nil
    if bound
      fact = self.type_fact(receiver)
      fact = self.annotation_single_type(self.declared_type(receiver)) if fact == nil
      if fact != nil && fact >= Type::CLASS_BASE && fact < 57344
        entry = self.case_pattern_reader(fact - Type::CLASS_BASE, target)
        callee = entry if entry != nil && entry.length() > 6 && !@variadic_functions.include?(entry[4])
      end
      captured = self.allocate_register()
      self.emit_instruction2(Opcode::MOVE, captured, receiver)
      self.emit_instruction1(Opcode::BOX_LOCAL, captured)
    else
      if @variadic_functions.include?(target[0][1])
        self.fail("expected '(' after singleton function")
        return 0
      end
      # A singleton descriptor is [name, function_index, arity,
      # required_arity, signature?]; an instance method entry is [class,
      # name, private, required_arity, function_index, arity, signature].
      descriptor = target[0]
      callee = [nil, descriptor[0], false, descriptor[3], descriptor[1], descriptor[2],
                if descriptor.length() > 4 then descriptor[4] else nil end]
    end
    arity = if callee == nil then 1 else callee[5] end
    required_arity = if callee == nil then 0 else callee[3] end
    function_index = @builder.declare_function("<method reference>", arity, required_arity)
    @builder.set_parameter_flags(function_index, true, false) if callee == nil && !@failed

    outer_locals = @locals
    outer_loops = @loops
    outer_begin_depth = @begin_depth
    outer_next_register = @next_register
    outer_code_count = @code_count
    outer_function_index = @current_function_index
    outer_pending_block_call = @pending_block_call
    outer_type_facts = @type_facts
    outer_type_variables = @current_type_variables
    @locals = []
    @loops = []
    @begin_depth = 0
    @next_register = 0
    @code_count = 0
    @current_function_index = function_index
    @pending_block_call = nil
    @type_facts = []

    base = @next_register
    index = 0
    while index < arity
      self.allocate_register()
      index = index + 1
    end
    # Type arguments naming the enclosing function's variables stay bound to
    # what they were when the reference was taken.
    if outer_type_variables.length() > 0 && self.annotations_use_type_variable?(type_annotations)
      @builder.set_type_variables(function_index, outer_type_variables)
      @builder.set_captures_type_variables(function_index)
    end
    type_arguments = self.declare_annotations(type_annotations)
    # signature is [parameter types, return type, type variables,
    # parameter names]; with explicit bindings a generic one stays untyped.
    signature = if callee == nil then nil else callee[6] end
    if signature != nil && (signature[2].length() == 0 || type_arguments.length() == 0)
      @current_type_variables = signature[2]
      @builder.set_type_variables(function_index, signature[2]) if signature[2].length() > 0
      index = 0
      while index < arity && !@failed
        @builder.set_parameter_name(function_index, index, signature[3][index])
        if signature[0][index] != nil
          @builder.set_parameter_type(function_index, index, self.declare_annotation(signature[0][index]))
        end
        index = index + 1
      end
      @builder.set_return_type(function_index, self.declare_annotation(signature[1])) if signature[1] != nil && !@failed
    end
    @current_type_variables = outer_type_variables
    if callee == nil
      self.emit_instruction3(Opcode::COLLECT_VARIADIC, base, 0, 0)
      required_arity = arity
    end
    if bound
      bound_receiver = self.allocate_register()
      self.emit_instruction2(Opcode::GET_CAPTURE, bound_receiver, 0)
      method_name_index = self.add_string(target)
    end
    count = required_arity
    while count <= arity
      skip = nil
      if count < arity
        provided = self.allocate_register()
        self.emit_instruction2(Opcode::ARGUMENT_PROVIDED, provided, count)
        skip = self.emit_jump(Opcode::JUMP_IF_TRUE, provided)
      end
      if bound
        result = self.allocate_register()
        opcode = if callee == nil then Opcode::INVOKE_SPREAD else Opcode::INVOKE end
        if type_arguments.length() > 0
          opcode = if callee == nil then Opcode::INVOKE_TYPED_SPREAD else Opcode::INVOKE_TYPED end
        end
        self.emit_call_opcode(opcode)
        self.emit_register(result)
        self.emit_register(bound_receiver)
        self.emit_register(method_name_index)
        self.emit_register(base)
        self.emit_byte(count) if callee != nil
        if type_arguments.length() > 0
          self.emit_byte(type_arguments.length())
          index = 0
          while index < type_arguments.length()
            self.emit_register(type_arguments[index])
            index = index + 1
          end
        end
      else
        result = self.emit_singleton_call(callee[4], [base, count], target[1], type_arguments)
      end
      if skip != nil
        self.emit_instruction1(Opcode::RETURN, result)
        self.patch_jump(skip, @code_count)
      end
      count = count + 1
    end
    self.emit_instruction1(Opcode::RETURN, result)
    @builder.set_register_count(function_index, @next_register) unless @failed

    @locals = outer_locals
    @loops = outer_loops
    @begin_depth = outer_begin_depth
    @next_register = outer_next_register
    @code_count = outer_code_count
    @current_function_index = outer_function_index
    @pending_block_call = outer_pending_block_call
    @type_facts = outer_type_facts

    destination = self.allocate_register()
    self.emit_byte(Opcode::CLOSURE)
    self.emit_register(destination)
    self.emit_function_index(function_index)
    if bound
      self.emit_byte(1)
      self.emit_register(captured)
    else
      self.emit_byte(0)
    end
    destination
  end

  # `receiver.method(args)` -- reached from parse_precedence's own
  # postfix-dot loop, so `receiver` can be any already-compiled
  # expression (a local, `self`, a call result, ...), not just an
  # identifier. Unlike a direct top-level call, the method name is
  # resolved by the VM at INVOKE time against the receiver's *runtime*
  # class, so there's no arity check here -- an ordinary ArityError
  # surfaces from the VM instead, mirroring compiler.c's own parse_invoke.
  def compile_invoke(receiver)
    self.advance_token()
    if @current.kind() != :identifier && @current.kind() != :class
      self.fail("expected method name after '.'")
      return 0
    end
    name = self.token_text(@current)
    self.advance_token()
    if @current.kind() == :equal
      name = name + "="
      self.advance_token()
      # `recv.attr = value` is `recv.attr=(value)`.
      if @current.kind() != :left_paren
        value = self.parse_expression()
        return self.emit_destructure_invoke(receiver, name, value)
      end
    end
    if name == "class" && @current.kind() == :left_paren
      self.advance_token()
      self.skip_newlines()
      if @current.kind() != :right_paren
        self.fail("class() takes no arguments")
        return 0
      end
      self.advance_token()
      destination = self.allocate_register()
      self.emit_instruction2(Opcode::CLASS_NAME, destination, receiver)
      self.set_type_fact(destination, Type::STRING)
      return destination
    end
    if name == "is_a?" && @current.kind() == :left_paren
      self.advance_token()
      self.skip_newlines()
      if @current.kind() != :identifier
        self.fail("expected a type name")
        return 0
      end
      type_token = @current
      type_name = self.consume_qualified_module_name()
      type_id = self.find_type_name(type_name)
      self.skip_newlines()
      if @current.kind() != :right_paren
        self.fail("expected ')' after is_a? type")
        return 0
      end
      self.advance_token()
      destination = self.allocate_register()
      if type_id == nil
        type_id = Type::UNDECLARED
        @forward_is_types.push([@current_function_index, @code_count + 5, type_name, type_token, @current_module_name])
      end
      self.emit_instruction3(Opcode::IS_TYPE, destination, receiver, type_id)
      self.set_type_fact(destination, Type::BOOL)
      return destination
    end
    self.compile_invoke_arguments(receiver, name)
  end

  # The rest of a method call, from just after its name.
  def compile_invoke_arguments(receiver, name)
    # Explicit generic arguments (`obj.method[Type](...)`) -- unlike
    # compile_call's own handling, there's no arity check against a
    # known type_variable_count here either: the target method is only
    # resolved at INVOKE time against the receiver's runtime class, the
    # same reason there's no argument-count check above. Mirrors
    # compiler.c's own parse_invoke exactly.
    type_annotations = self.parse_explicit_type_annotations()
    return 0 if type_annotations == nil
    if @current.kind() != :left_paren
      return self.compile_reference_wrapper(receiver, name, type_annotations)
    end
    type_arguments = self.declare_annotations(type_annotations)
    self.advance_token()
    method_name_index = self.add_string(name)
    # The method, when the receiver's class is known statically: a trailing
    # block takes its types from the last parameter, as a top-level
    # function's does (contextual_block_member).
    fact = self.type_fact(receiver)
    fact = self.annotation_single_type(self.declared_type(receiver)) if fact == nil
    entry = nil
    entry = self.case_pattern_reader(fact - Type::CLASS_BASE, name) if fact != nil && fact >= Type::CLASS_BASE && fact < 57344
    entry = nil if entry != nil && entry.length() < 7
    block_context = nil
    if entry != nil && entry[6][2].length() == 0 && entry[5] > 0
      block_context = contextual_block_member([nil, nil, nil, nil, nil, nil, nil, entry[6][0]], entry[5] - 1)
    end
    self.skip_newlines()
    if self.call_arguments_have_keyword?()
      arguments = self.parse_dynamic_keyword_arguments()
      return 0 if arguments == nil
      destination = self.allocate_register()
      self.emit_call_opcode(if type_arguments.length() == 0 then Opcode::INVOKE_KEYWORDS else Opcode::INVOKE_TYPED_KEYWORDS end)
      self.emit_register(destination)
      self.emit_register(receiver)
      self.emit_register(method_name_index)
      self.emit_keyword_trailer(arguments)
      self.emit_type_argument_trailer(type_arguments)
      return destination
    end
    if self.call_arguments_have_spread?()
      collected = [nil, [], block_context]
      arguments = self.parse_spread_call_arguments(collected)
      return 0 if arguments == nil
      # A trailing block goes by INVOKE_KEYWORDS' block flag, with the spread
      # Array as the positional arguments, as in compiler.c.
      if collected[1].length() > 0
        destination = self.allocate_register()
        self.emit_call_opcode(Opcode::INVOKE_KEYWORDS)
        self.emit_register(destination)
        self.emit_register(receiver)
        self.emit_register(method_name_index)
        self.emit_keyword_trailer([arguments, [], collected[1][0][1]])
        return destination
      end
      destination = self.allocate_register()
      self.emit_call_opcode(if type_arguments.length() == 0 then Opcode::INVOKE_SPREAD else Opcode::INVOKE_TYPED_SPREAD end)
      self.emit_register(destination)
      self.emit_register(receiver)
      self.emit_register(method_name_index)
      self.emit_register(arguments)
      self.emit_type_argument_trailer(type_arguments)
      return destination
    end
    parsed = self.parse_call_arguments()
    return 0 if parsed == nil
    argument_base = parsed[0]
    argument_count = parsed[1]
    # parse_call_arguments already materialized its arguments into the
    # contiguous range [argument_base, argument_base + argument_count)
    # before returning -- deliberately not touched (shared with
    # compile_new_call; see this feature's own design doc on keeping
    # constructor blocks unsupported on both compilers). A trailing
    # block's own result register needs to land at exactly
    # argument_base + argument_count for INVOKE's contiguous-range
    # convention, so reserve that slot explicitly and MOVE the block's
    # actual result into it -- mirrors compiler.c's own parse_invoke fix
    # in effect, via a different mechanism since this helper (unlike
    # compiler.c's local `args[]` array) has already materialized by the
    # time control returns here. NOT simply `self.allocate_register()`:
    # parse_call_arguments always reserves one throwaway register even
    # for a zero-argument call (so INVOKE always has a valid base register
    # to encode), so when argument_count is 0 that slot already exists at
    # @next_register - 1, not @next_register -- allocating again would
    # leave a silent one-register gap between it and the block.
    if @current.kind() == :do
      # Fewer arguments than a statically known method's block slot leave
      # its defaulted parameters out: the block goes by INVOKE_KEYWORDS'
      # block flag instead, as in compiler.c's parse_invoke.
      @block_context = block_context
      if entry != nil && argument_count < entry[5] - 1 && type_arguments.length() == 0
        positional = self.allocate_register()
        self.emit_instruction3(Opcode::ARRAY, positional, argument_base, argument_count)
        block_result = self.compile_block()
        destination = self.allocate_register()
        self.emit_call_opcode(Opcode::INVOKE_KEYWORDS)
        self.emit_register(destination)
        self.emit_register(receiver)
        self.emit_register(method_name_index)
        self.emit_keyword_trailer([positional, [], block_result])
        return destination
      end
      block_slot = argument_base + argument_count
      self.allocate_register() if block_slot == @next_register
      block_result = self.compile_block()
      self.emit_instruction2(Opcode::MOVE, block_slot, block_result)
      argument_count = argument_count + 1
    end
    destination = self.allocate_register()
    if type_arguments.length() == 0
      self.emit_call_opcode(Opcode::INVOKE)
    else
      self.emit_call_opcode(Opcode::INVOKE_TYPED)
    end
    self.emit_register(destination)
    self.emit_register(receiver)
    self.emit_register(method_name_index)
    self.emit_register(argument_base)
    self.emit_byte(argument_count)
    if type_arguments.length() > 0
      self.emit_byte(type_arguments.length())
      i = 0
      while i < type_arguments.length()
        self.emit_register(type_arguments[i])
        i = i + 1
      end
    end
    destination
  end

  def parse_index(receiver)
    self.advance_token()
    index = self.parse_expression()
    # `value[start, length]` reads a run, as value.slice(start, length) does.
    if @current.kind() == :comma
      self.advance_token()
      self.skip_newlines()
      length = self.parse_expression()
      if @current.kind() != :right_bracket
        self.fail("expected ']' after index")
        return 0
      end
      self.advance_token()
      base = self.move_contiguous([index, length])
      destination = self.allocate_register()
      self.emit_call_opcode(Opcode::INVOKE)
      self.emit_register(destination)
      self.emit_register(receiver)
      self.emit_register(self.add_string("slice"))
      self.emit_register(base)
      self.emit_byte(2)
      return destination
    end
    if @current.kind() != :right_bracket
      self.fail("expected ']' after index")
      return 0
    end
    self.advance_token()
    # `expr[index] = value` (or `+=` and friends) on a receiver that isn't
    # a plain local/@ivar/@@cvar -- `table()[key] += 1`, `a[i][j] += 1`.
    if @current.kind() == :equal
      self.advance_token()
      value = self.parse_expression()
      self.emit_instruction3(Opcode::INDEX_SET, receiver, index, value)
      return value
    end
    return self.compile_index_compound_store(receiver, index) if compound_assignment_token?(@current.kind())
    destination = self.allocate_register()
    self.emit_instruction3(Opcode::INDEX_GET, destination, receiver, index)
    receiver_annotation = self.declared_type(receiver)
    element = nil
    if receiver_annotation != nil && receiver_annotation.length() == 1
      member = receiver_annotation[0]
      element = member[1] if self.annotation_type_id(member[0]) == Type::ARRAY
    end
    if element != nil
      @declared_types.push([destination, element])
      fact = self.annotation_single_type(element)
      self.set_type_fact(destination, fact) if fact != nil
    else
      value = nil
      if receiver_annotation != nil && receiver_annotation.length() == 1
        member = receiver_annotation[0]
        value = member[2] if self.annotation_type_id(member[0]) == Type::HASH
      end
      if value != nil
        @declared_types.push([destination, self.annotation_with_nil(value)])
      end
    end
    destination
  end

  def compile_break()
    kind = @current.kind()
    # `next` in a do block, outside any loop inside it, ends this call of
    # the block -- what `return` already does there.
    return self.compile_return() if @loops.length() == 0 && kind == :next && @in_block
    # `break` there ends the call the block was passed to, whose result
    # becomes the break value.
    if @loops.length() == 0 && kind == :break && @in_block
      self.advance_token()
      value = if statement_end_kind?(@current.kind())
        self.allocate_register()
      else
        self.parse_expression()
      end
      @block_has_break = true
      self.emit_instruction1(Opcode::BLOCK_BREAK, value)
      return value
    end
    if @loops.length() == 0
      if kind == :break
        self.fail("'break' used outside a loop")
      elsif kind == :next
        self.fail("'next' used outside a loop")
      else
        self.fail("'redo' used outside a loop")
      end
      return self.allocate_register()
    end
    self.advance_token()
    has_value = @current.kind() != :newline && @current.kind() != :end && @current.kind() != :else && @current.kind() != :if && @current.kind() != :unless && @current.kind() != :eof
    frame = @loops[@loops.length() - 1]
    if kind != :break && has_value
      self.fail("next and redo do not accept values")
      return self.allocate_register()
    elsif has_value
      value = self.parse_expression()
      self.emit_instruction2(Opcode::MOVE, frame[0], value)
    end
    if kind == :break
      frame[1].push(self.emit_loop_jump(frame, 0))
    elsif kind == :next
      self.emit_loop_jump(frame, frame[2])
    else
      self.emit_loop_jump(frame, frame[3])
    end
    self.allocate_register()
  end

  # The jump a break/next/redo ends in: from inside begin blocks within the
  # loop, an UNWIND_JUMP that leaves them (running their ensure bodies)
  # first, otherwise a plain JUMP. Returns the target operand's offset, for
  # a break to patch. Mirrors compiler_control.c's emit_loop_jump.
  def emit_loop_jump(frame, target)
    levels = @begin_depth - frame[4]
    if levels <= 0
      operand = self.emit_jump(Opcode::JUMP, 0)
      self.patch_jump(operand, target)
      return operand
    end
    if levels > 255
      self.fail("loop control is nested too deeply in begin blocks")
      return 0
    end
    self.emit_byte(Opcode::UNWIND_JUMP)
    self.emit_byte(levels)
    operand = @code_count
    self.emit_byte(0)
    self.emit_byte(0)
    self.patch_jump(operand, target)
    operand
  end

  # `return` in a do block returns from the enclosing def: BLOCK_RETURN
  # unwinds every frame in between, running their ensure bodies. The value
  # is checked against the def's return type here, since the def's own
  # RETURN is skipped. Mirrors compiler_control.c's compile_block_return.
  def compile_block_return()
    if @method_function_index == -1
      self.fail("'return' in a block outside any def; use 'next' to end the block")
      return 0
    end
    self.advance_token()
    value = if statement_end_kind?(@current.kind())
      self.allocate_register()
    else
      self.parse_expression()
    end
    self.emit_type_check(value, @method_return_type) if @method_return_type != nil
    @nonlocal_landing_functions.push(@method_function_index)
    @builder.set_nonlocal_landing(@method_function_index)
    self.emit_instruction1(Opcode::BLOCK_RETURN, value)
    value
  end

  # RETURN halts run_chunk unconditionally the instant it executes,
  # wherever it is in the bytecode. Postfix if/unless delimit a bare return;
  # compile_sequence's modifier layout makes the opcode itself conditional.
  def compile_return()
    if @current_function_index == -1
      self.fail("'return' used outside a function")
      return 0
    end
    return self.compile_block_return() if @in_block && @current.kind() == :return
    @block_returns_early = true if @in_block
    self.advance_token()
    has_value = @current.kind() != :newline && @current.kind() != :end && @current.kind() != :else && @current.kind() != :if && @current.kind() != :unless && @current.kind() != :eof
    value = if has_value
      self.parse_expression()
    else
      self.allocate_register()
    end
    before_check = @code_count
    self.emit_type_check(value, @current_return_type) if @current_return_type != nil
    self.maybe_rewrite_tail_call(value, before_check, @current_return_type)
    self.emit_instruction1(Opcode::RETURN, value)
    value
  end

  def compile_raise()
    self.advance_token()
    if @current.kind() == :newline || @current.kind() == :end || @current.kind() == :rescue || @current.kind() == :ensure || @current.kind() == :if || @current.kind() == :unless || @current.kind() == :eof
      if @current_exception == nil
        self.fail("bare 'raise' used outside rescue")
        return 0
      end
      self.emit_instruction1(Opcode::RAISE, @current_exception)
      return @current_exception
    end
    value = self.parse_expression()
    self.emit_instruction1(Opcode::RAISE, value)
    value
  end

  def compile_retry()
    self.advance_token()
    if @current_retry_target == nil
      self.fail("'retry' used outside rescue")
      return 0
    end
    self.emit_byte(Opcode::JUMP)
    self.emit_byte(@current_retry_target / 256)
    self.emit_byte(mod(@current_retry_target, 256))
    self.allocate_register()
  end

  def compile_rescue_clause(exception, retry_target, destination, seen_types)
    self.advance_token()
    rescue_local_count = @locals.length()
    if @current.kind() == :identifier
      @locals.push([self.token_text(@current), exception, false])
      self.advance_token()
    end
    types = self.parse_rescue_types(exception)
    type_index = 0
    while type_index < types.length() && !@failed
      seen_index = 0
      while seen_index < seen_types.length()
        if seen_types[seen_index] == types[type_index] && types[type_index] != Type::UNDECLARED
          self.fail("rescue type was already handled")
        elsif seen_types[seen_index] >= Type::CLASS_BASE &&
              seen_types[seen_index] < Type::VARIABLE_BASE &&
              types[type_index] >= Type::CLASS_BASE &&
              types[type_index] < Type::VARIABLE_BASE
          ancestor = seen_types[seen_index] - Type::CLASS_BASE
          child = types[type_index] - Type::CLASS_BASE
          while child != nil && child != ancestor
            entry = nil
            class_index = 0
            while class_index < @classes.length() && entry == nil
              entry = @classes[class_index] if @classes[class_index][1] == child
              class_index = class_index + 1
            end
            child = if entry == nil
              nil
            else
              entry[2]
            end
          end
          self.fail("rescue type is covered by an earlier clause") if child == ancestor
        end
        seen_index = seen_index + 1
      end
      seen_types.push(types[type_index]) unless @failed
      type_index = type_index + 1
    end
    return nil if @failed
    match_jumps = []
    type_index = 0
    while type_index < types.length()
      matched = self.allocate_register()
      if types[type_index] == Type::UNDECLARED
        name = @rescue_type_names[type_index][0]
        @forward_is_types.push([@current_function_index, @code_count + 5, name, @type_name_tokens[name], @current_module_name])
      end
      self.emit_instruction3(Opcode::IS_TYPE, matched, exception, types[type_index])
      match_jumps.push(self.emit_jump(Opcode::JUMP_IF_TRUE, matched))
      type_index = type_index + 1
    end
    mismatch_jump = if types.length() > 0
      self.emit_jump(Opcode::JUMP, 0)
    else
      nil
    end
    return nil unless self.consume_block_start()
    type_index = 0
    while type_index < match_jumps.length()
      self.patch_jump(match_jumps[type_index], @code_count)
      type_index = type_index + 1
    end
    outer_exception = @current_exception
    outer_retry_target = @current_retry_target
    @current_exception = exception
    @current_retry_target = retry_target
    rescued = self.compile_sequence()
    @current_exception = outer_exception
    @current_retry_target = outer_retry_target
    rescued_fact = self.type_fact(rescued)
    rescued_declaration = self.declared_type(rescued)
    self.emit_instruction2(Opcode::MOVE, destination, rescued)
    finished = self.emit_jump(Opcode::JUMP, 0)
    while @locals.length() > rescue_local_count
      @locals.pop()
    end
    self.patch_jump(mismatch_jump, @code_count) if mismatch_jump != nil
    [finished, rescued_fact, rescued_declaration, mismatch_jump == nil]
  end

  def compile_begin()
    return 0 unless self.consume_block_start()
    original_facts = self.copy_type_facts()
    frame = self.open_begin_frame()
    body = self.compile_sequence()
    destination = self.close_begin_frame(frame, body, original_facts, 0, 0)
    return destination if @failed
    if @current.kind() != :end
      self.fail("expected 'end' after begin body")
      return destination
    end
    self.advance_token()
    destination
  end

  # Opens a protected region: PUSH_ENSURE, then the rescue handler.
  # Returns [ensure_operand, exception, retry_target, handler].
  def open_begin_frame()
    @begin_depth = @begin_depth + 1
    ensure_operand = @code_count + 1
    self.emit_byte(Opcode::PUSH_ENSURE)
    self.emit_byte(0)
    self.emit_byte(0)
    exception = self.allocate_register()
    retry_target = @code_count
    handler = self.emit_rescue_handler(exception)
    [ensure_operand, exception, retry_target, handler]
  end

  # Compiles a def or block body that may end in rescue/else/ensure clauses
  # without a `begin`, stopping before its `end`. Whether clauses follow is
  # only known after the body, so the body starts with a jump: to the body
  # itself when there are none, or to the frame setup that close_begin_frame
  # emits after the body, which then jumps back to it. Handlers are pushed at
  # run time, so the setup's position doesn't matter. compiler.c gets the
  # same answer from its discovery pass instead.
  def compile_body()
    original_facts = self.copy_type_facts()
    skip = self.emit_jump(Opcode::JUMP, 0)
    body_start = @code_count
    body = self.compile_sequence()
    if @current.kind() != :rescue && @current.kind() != :ensure
      self.patch_jump(skip, body_start)
      return body
    end
    self.close_begin_frame(nil, body, original_facts, skip, body_start)
  end

  # Compiles the clauses after a protected body, up to but not past `end`,
  # and returns the region's result register. frame is open_begin_frame's
  # result, or nil for compile_body's deferred setup (patched in at skip,
  # jumping back to body_start).
  def close_begin_frame(frame, body, original_facts, skip, body_start)
    body_fact = self.type_fact(body)
    body_declaration = self.declared_type(body)
    destination = self.allocate_register()
    self.emit_instruction2(Opcode::MOVE, destination, body)
    self.emit_byte(Opcode::POP_RESCUE)
    finished = self.emit_jump(Opcode::JUMP, 0)
    if frame == nil
      self.patch_jump(skip, @code_count)
      frame = self.open_begin_frame()
      self.emit_byte(Opcode::JUMP)
      self.emit_byte(body_start / 256)
      self.emit_byte(mod(body_start, 256))
    end
    ensure_operand = frame[0]
    exception = frame[1]
    retry_target = frame[2]
    handler = frame[3]
    self.patch_jump(handler, @code_count)
    rescued_fact = body_fact
    rescued_declaration = body_declaration
    rescue_finished = []
    seen_rescue_types = []
    saw_rescue = false
    catch_all = false
    while @current.kind() == :rescue && !@failed
      if catch_all
        self.fail("rescue clause after catch-all is unreachable")
        break
      end
      saw_rescue = true
      clause = self.compile_rescue_clause(exception, retry_target, destination, seen_rescue_types)
      return destination if clause == nil
      rescue_finished.push(clause[0])
      rescued_fact = nil if rescued_fact != clause[1]
      rescued_declaration = nil if rescued_declaration != clause[2]
      catch_all = clause[3]
    end
    if saw_rescue && !catch_all
      self.emit_instruction1(Opcode::RAISE, exception)
    end
    if @current.kind() != :ensure && !saw_rescue
      self.fail("expected 'rescue' or 'ensure' after begin body")
      return destination
    end
    @builder.patch_byte(@current_function_index, handler - 9, 0) if saw_rescue
    self.patch_jump(finished, @code_count)
    if @current.kind() == :else
      self.advance_token()
      return destination unless self.consume_block_start()
      normal = self.compile_sequence()
      self.emit_instruction2(Opcode::MOVE, destination, normal)
      body_fact = self.type_fact(normal)
      body_declaration = self.declared_type(normal)
    end
    rescue_index = 0
    while rescue_index < rescue_finished.length()
      self.patch_jump(rescue_finished[rescue_index], @code_count)
      rescue_index = rescue_index + 1
    end
    self.emit_byte(Opcode::RUN_ENSURE)
    continuation_operand = @code_count
    self.emit_byte(0)
    self.emit_byte(0)
    self.patch_jump(ensure_operand, @code_count)
    if @current.kind() == :ensure
      self.advance_token()
      return destination unless self.consume_block_start()
      self.compile_sequence()
    end
    self.emit_byte(Opcode::END_ENSURE)
    self.patch_jump(continuation_operand, @code_count)
    @begin_depth = @begin_depth - 1
    @type_facts = original_facts
    if body_fact != nil && body_fact == rescued_fact
      self.set_type_fact(destination, body_fact)
    end
    if body_declaration != nil && body_declaration == rescued_declaration
      @declared_types.push([destination, body_declaration])
    end
    destination
  end

  # --- control flow ---

  def consume_block_start_or(delimiter)
    if @current.kind() == delimiter
      self.advance_token()
      self.skip_newlines()
      return true
    end
    self.consume_block_start()
  end

  def consume_block_start()
    if @current.kind() != :newline
      self.fail("expected newline before block body")
      return false
    end
    self.skip_newlines()
    true
  end

  def apply_condition_fact(condition, narrowing, type_narrowing, when_true)
    if narrowing != nil && narrowing[0] == condition
      if when_true == narrowing[2]
        self.set_type_fact(narrowing[1], Type::NIL)
      else
        remaining = self.non_nil_single_type(self.declared_type(narrowing[1]))
        self.set_type_fact(narrowing[1], remaining) if remaining != nil
      end
    elsif type_narrowing != nil && type_narrowing[0] == condition
      if when_true
        self.set_type_fact(type_narrowing[1], type_narrowing[2])
      else
        remaining = self.remaining_single_type(
          self.declared_type(type_narrowing[1]), type_narrowing[2])
        self.set_type_fact(type_narrowing[1], remaining) if remaining != nil
      end
    end
  end

  # Mirrors src/compiler.c's parse_case/parse_case_branches -- see that
  # function's own comment for the full design rationale (deliberate v1
  # scope cuts: plain `==` only, no subject-less boolean form, no cross-
  # branch type-fact merging). No fixed-size array bookkeeping needed
  # here the way the native compiler's own fix needed -- @type_facts is already a plain growable Array here,
  # not indexed by register, so copy_type_facts()/direct reassignment is
  # the self-hosted parser's own existing, unbounded equivalent.
  # exhaustiveness: nil, or [required type ids, covered flags, case token]
  # when the subject's type is closed (see case_exhaustiveness).
  def parse_case_branches(subject, entry_facts, destination, subjectless, exhaustiveness)
    @type_facts = copy_type_facts_from(entry_facts)
    if @current.kind() == :else
      self.advance_token()
      self.skip_newlines() if @current.kind() == :newline
      body_result = self.compile_sequence()
      self.emit_instruction2(Opcode::MOVE, destination, body_result)
      @type_facts = copy_type_facts_from(entry_facts)
      if @current.kind() != :end
        self.fail("expected 'end' after case expression")
        return destination
      end
      self.advance_token()
      return destination
    end
    if @current.kind() == :end
      return destination if self.fail_unless_exhaustive(exhaustiveness)
      self.emit_instruction1(Opcode::NIL, destination)
      self.advance_token()
      return destination
    end
    if @current.kind() != :when
      self.fail("expected 'when', 'else', or 'end' in case expression")
      return destination
    end
    self.advance_token()
    match_reg = self.allocate_register()
    bindings = []
    collection_pattern = !subjectless && (@current.kind() == :left_bracket ||
      @current.kind() == :left_brace || self.object_pattern_ahead?())
    return destination if @failed
    covered = []
    if collection_pattern
      bindings = self.compile_case_pattern_alternatives(subject, match_reg, covered)
      return destination if bindings == nil
    else
      self.compile_case_scalar_values(subject, subjectless, match_reg, covered)
    end
    # A guard can reject a matching value, so a guarded `when` covers nothing.
    self.mark_case_coverage(exhaustiveness, covered) if @current.kind() != :if
    if @current.kind() == :if
      # A guard sees the pattern's bindings without storing them yet.
      skip_guard = self.emit_jump(Opcode::JUMP_IF_FALSE, match_reg)
      self.advance_token()
      saved_local_count = @locals.length()
      index = 0
      while index < bindings.length()
        @locals.push([self.token_text(bindings[index][0]), bindings[index][1], false])
        index = index + 1
      end
      guard = self.parse_expression()
      while @locals.length() > saved_local_count
        @locals.pop()
      end
      self.emit_instruction2(Opcode::NOT, match_reg, guard)
      self.emit_instruction2(Opcode::NOT, match_reg, match_reg)
      self.patch_jump(skip_guard, @code_count)
    end
    return destination unless self.consume_block_start_or(:then)
    false_jump = self.emit_jump(Opcode::JUMP_IF_FALSE, match_reg)
    index = 0
    while index < bindings.length()
      self.compile_assignment_store(bindings[index][0], false, false, bindings[index][1])
      index = index + 1
    end
    body_result = self.compile_sequence()
    self.emit_instruction2(Opcode::MOVE, destination, body_result)
    end_jump = self.emit_jump(Opcode::JUMP, 0)
    self.patch_jump(false_jump, @code_count)
    result = self.parse_case_branches(subject, entry_facts, destination, subjectless, exhaustiveness)
    self.patch_jump(end_jump, @code_count)
    result
  end

  def parse_case()
    case_token = @previous
    # `case` alone on its line tests each `when` value for truthiness.
    subjectless = @current.kind() == :newline
    subject = if subjectless
      truth = self.allocate_register()
      self.emit_instruction2(Opcode::BOOL, truth, 1)
      truth
    else
      self.parse_expression()
    end
    self.skip_newlines()
    exhaustiveness = if subjectless then nil else self.case_exhaustiveness(subject, case_token) end
    destination = self.allocate_register()
    entry_facts = self.copy_type_facts()
    if @current.kind() != :when
      self.fail("expected 'when' after case expression")
      return destination
    end
    self.parse_case_branches(subject, entry_facts, destination, subjectless, exhaustiveness)
  end

  # A subject declared as a union of classes and Nil, or known to be a
  # sealed class (then its direct subclasses), must have every member
  # covered unless the case has an `else`. Mirrors compiler_case.c.
  def case_exhaustiveness(subject, case_token)
    annotation = self.declared_type(subject)
    if annotation != nil && annotation.length() > 1
      required = []
      index = 0
      while index < annotation.length()
        id = self.annotation_type_id(annotation[index][0])
        return nil if @failed
        return nil if id != Type::NIL && (id < Type::CLASS_BASE || id >= Type::VARIABLE_BASE)
        required.push(id)
        index = index + 1
      end
      return [required, required.map() do |_| false end, case_token]
    end
    fact = self.type_fact(subject)
    fact = self.annotation_type_id(annotation[0][0]) if fact == nil && annotation != nil
    return nil if fact == nil || fact < Type::CLASS_BASE || fact >= Type::VARIABLE_BASE
    return nil unless @sealed_classes.include?(fact - Type::CLASS_BASE)
    required = []
    index = 0
    while index < @classes.length()
      required.push(Type::CLASS_BASE + @classes[index][1]) if @classes[index][2] == fact - Type::CLASS_BASE
      index = index + 1
    end
    return nil if required.length() == 0 || required.length() > 8
    [required, required.map() do |_| false end, case_token]
  end

  # Marks each required member a `when` covers: the type itself, or for a
  # class, any of its superclasses (`when Shape` matches a Circle).
  def mark_case_coverage(exhaustiveness, covered)
    return if exhaustiveness == nil
    required = exhaustiveness[0]
    flags = exhaustiveness[1]
    member = 0
    while member < required.length()
      walk = required[member]
      while walk != nil && !flags[member]
        flags[member] = true if covered.include?(walk)
        walk = if walk >= Type::CLASS_BASE
          parent = self.superclass_of(walk - Type::CLASS_BASE)
          if parent == nil then nil else Type::CLASS_BASE + parent end
        else
          nil
        end
      end
      member = member + 1
    end
  end

  def fail_unless_exhaustive(exhaustiveness)
    return false if exhaustiveness == nil
    missing = []
    member = 0
    while member < exhaustiveness[0].length()
      missing.push(self.closed_type_name(exhaustiveness[0][member])) unless exhaustiveness[1][member]
      member = member + 1
    end
    return false if missing.length() == 0
    token = exhaustiveness[2]
    self.fail_at(token.start(), token.line(), token.column(),
      "case is not exhaustive over its subject's known closed type; missing: " +
      missing.join(", ") + "; add the missing branch or an 'else'")
    true
  end

  def closed_type_name(id)
    return "Nil" if id == Type::NIL
    index = 0
    while index < @classes.length()
      return @classes[index][0] if Type::CLASS_BASE + @classes[index][1] == id
      index = index + 1
    end
    "?"
  end

  # A `when` of plain values or class names: match_reg becomes whether any
  # of them matches the subject (or is truthy, for a subjectless case).
  def compile_case_scalar_values(subject, subjectless, match_reg, covered)
    first_value = true
    skip_jump = 0
    more_values = true
    while more_values
      skip_jump = self.emit_jump(Opcode::JUMP_IF_TRUE, match_reg) unless first_value
      @case_pattern_class_index = nil
      value_reg = self.parse_case_class_pattern()
      if value_reg != nil && @case_pattern_class_index != nil
        covered.push(Type::CLASS_BASE + @case_pattern_class_index)
      end
      if value_reg == nil
        value_reg = self.parse_expression()
        covered.push(Type::NIL) if self.type_fact(value_reg) == Type::NIL
      end
      eq_reg = self.allocate_register()
      if subjectless
        self.emit_instruction2(Opcode::NOT, eq_reg, value_reg)
        self.emit_instruction2(Opcode::NOT, eq_reg, eq_reg)
      else
        self.emit_instruction3(Opcode::CASE_MATCH, eq_reg, value_reg, subject)
      end
      self.set_type_fact(eq_reg, Type::BOOL)
      self.emit_instruction2(Opcode::MOVE, match_reg, eq_reg)
      self.patch_jump(skip_jump, @code_count) unless first_value
      first_value = false
      if @current.kind() == :comma
        self.advance_token()
        self.skip_newlines()
      else
        more_values = false
      end
    end
  end

  # `Name{` or `Mod::Name{` at the current token: [qualified name, the
  # number of tokens it spans], or nil.
  def object_pattern_name()
    return nil if @current.kind() != :identifier
    name = self.token_text(@current)
    return nil if lowercase_name?(name) || name == "_"
    lookahead = @lexer.clone()
    next_token = lookahead.next_token()
    tokens = 1
    while next_token.kind() == :double_colon
      part = lookahead.next_token()
      return nil if part.kind() != :identifier
      name = name + "::" + self.token_text(part)
      tokens = tokens + 2
      next_token = lookahead.next_token()
    end
    return nil if next_token.kind() != :left_brace
    [name, tokens]
  end

  def object_pattern_ahead?() = self.object_pattern_name() != nil

  def case_pattern_reader(class_index, reader)
    walk = class_index
    while walk != nil
      index = @instance_methods.length() - 1
      while index >= 0
        entry = @instance_methods[index]
        return entry if entry[0] == walk && entry[1] == reader
        index = index - 1
      end
      walk = self.superclass_of(walk)
    end
    nil
  end

  def superclass_of(class_index)
    index = 0
    while index < @classes.length()
      return @classes[index][2] if @classes[index][1] == class_index
      index = index + 1
    end
    nil
  end

  def includes_a_module?(class_index)
    walk = class_index
    while walk != nil
      return true if @classes_with_includes.include?(walk)
      walk = self.superclass_of(walk)
    end
    false
  end

  # counter is [nodes parsed so far] for the whole pattern.
  def parse_case_pattern_node(depth, counter)
    node = case_pattern_node(:wildcard)
    if counter[0] == 64 || depth > 8
      self.fail("case Array pattern is too complex")
      return node
    end
    counter[0] = counter[0] + 1
    return self.parse_case_array_group(node, depth, counter) if @current.kind() == :left_bracket
    return self.parse_case_hash_group(node, depth, counter) if @current.kind() == :left_brace
    object_name = self.object_pattern_name()
    return self.parse_case_object_group(node, object_name, depth, counter) if object_name != nil
    if @current.kind() == :star
      self.advance_token()
      if @current.kind() != :identifier
        self.fail("expected lowercase binding or '_' after '*' in case Array pattern")
        return node
      end
      node[1] = @current
      text = self.token_text(@current)
      if text == "_"
        node[0] = :rest_wildcard
      elsif !lowercase_name?(text)
        self.fail("rest binding in case Array pattern must be lowercase")
        return node
      else
        node[0] = :rest_bind
      end
      self.advance_token()
      return node
    end
    if @current.kind() == :caret
      self.advance_token()
      if @current.kind() != :identifier
        self.fail("expected lowercase local after '^' in case Array pattern")
        return node
      end
      node[1] = @current
      text = self.token_text(@current)
      if !lowercase_name?(text) || text == "_"
        self.fail("pin in case Array pattern must name a lowercase local")
        return node
      end
      entry = self.find_local(text)
      if entry == nil
        self.fail("pin references undefined local variable")
        return node
      end
      self.advance_token()
      node[0] = :pin
      node[3] = self.read_local(entry)
      return node
    end
    if @current.kind() == :identifier
      text = self.token_text(@current)
      if text == "_"
        self.advance_token()
        return node
      end
      if lowercase_name?(text)
        node[0] = :bind
        node[1] = @current
        self.advance_token()
        return node
      end
    end
    node[0] = :value
    value = self.parse_case_class_pattern()
    value = self.parse_expression() if value == nil
    node[3] = value
    node
  end

  # `[a, *rest, ...]`: the current token is the '['.
  def parse_case_array_group(node, depth, counter)
    node[0] = :array
    self.advance_token()
    rest_seen = false
    while @current.kind() != :right_bracket && !@failed
      if node[6].length() == 16
        self.fail("too many case Array elements")
        return node
      end
      child = self.parse_case_pattern_node(depth + 1, counter)
      node[6].push(child)
      if rest_kind?(child)
        if rest_seen
          token = child[1]
          self.fail_at(token.start(), token.line(), token.column(),
            "case Array pattern may contain only one rest binding")
          return node
        end
        rest_seen = true
      end
      break if @current.kind() == :right_bracket
      if @current.kind() != :comma
        self.fail("expected ',' in case Array pattern")
        return node
      end
      self.advance_token()
    end
    return node if @failed
    if node[6].length() == 0
      self.fail("case Array pattern cannot be empty")
      return node
    end
    self.advance_token()
    node
  end

  # `{key: pattern, ..., **rest}`: the current token is the '{'.
  def parse_case_hash_group(node, depth, counter)
    node[0] = :hash
    self.advance_token()
    self.skip_newlines()
    while @current.kind() != :right_brace && !@failed
      if node[6].length() == 16
        self.fail("too many case Hash entries")
        return node
      end
      if @current.kind() == :star && @lexer.clone().next_token().kind() == :star
        self.advance_token()
        self.advance_token()
        if @current.kind() != :identifier
          self.fail("expected lowercase binding or '_' after '**' in case Hash pattern")
          return node
        end
        if counter[0] == 64
          self.fail("case Hash pattern is too complex")
          return node
        end
        counter[0] = counter[0] + 1
        rest = case_pattern_node(:hash_rest_wildcard)
        rest[1] = @current
        text = self.token_text(@current)
        if text != "_"
          if !lowercase_name?(text)
            self.fail("rest binding in case Hash pattern must be lowercase")
            return node
          end
          rest[0] = :hash_rest_bind
        end
        node[6].push(rest)
        self.advance_token()
        self.skip_newlines()
        if @current.kind() != :right_brace
          self.fail("rest binding must be last in case Hash pattern")
          return node
        end
        break
      end
      key = self.parse_expression()
      if @current.kind() != :colon
        self.fail("expected ':' after case Hash pattern key")
        return node
      end
      self.advance_token()
      child = self.parse_case_pattern_node(depth + 1, counter)
      if rest_kind?(child) || hash_rest_kind?(child)
        token = child[1]
        self.fail_at(token.start(), token.line(), token.column(),
          "rest bindings are not supported in case Hash patterns")
        return node
      end
      child[4] = key
      node[6].push(child)
      self.skip_newlines()
      break if @current.kind() == :right_brace
      if @current.kind() != :comma
        self.fail("expected ',' in case Hash pattern")
        return node
      end
      self.advance_token()
      self.skip_newlines()
    end
    return node if @failed
    if @current.kind() != :right_brace
      self.fail("expected '}' after case Hash pattern")
      return node
    end
    self.advance_token()
    node
  end

  # `Class{reader: pattern, ...}`, matched through public zero-argument
  # readers: the current token is the class name.
  def parse_case_object_group(node, object_name, depth, counter)
    class_entry = self.find_forward_class(object_name[0], @current_module_name)
    if class_entry == nil
      self.fail("unknown class '" + object_name[0] + "' in object pattern")
      return node
    end
    node[0] = :object
    node[7] = class_entry[1]
    node[3] = self.allocate_register()
    self.emit_instruction2(Opcode::LOAD_CLASS, node[3], class_entry[1])
    index = 0
    while index < object_name[1]
      self.advance_token()
      index = index + 1
    end
    self.advance_token()
    self.skip_newlines()
    while @current.kind() != :right_brace && !@failed
      if node[6].length() == 16
        self.fail("too many case object fields")
        return node
      end
      if @current.kind() != :identifier || !lowercase_name?(self.token_text(@current))
        self.fail("expected lowercase reader in case object pattern")
        return node
      end
      reader_token = @current
      reader_name = self.token_text(@current)
      reader = self.case_pattern_reader(class_entry[1], reader_name)
      unknown = reader == nil && !self.includes_a_module?(class_entry[1])
      if unknown || (reader != nil && (reader[2] || reader[3] > 0))
        self.fail("case object pattern requires a public zero-argument reader")
        return node
      end
      self.advance_token()
      if @current.kind() != :colon
        self.fail("expected ':' after case object reader")
        return node
      end
      self.advance_token()
      child = self.parse_case_pattern_node(depth + 1, counter)
      if rest_kind?(child)
        token = child[1]
        self.fail_at(token.start(), token.line(), token.column(),
          "rest bindings are not supported in case object patterns")
        return node
      end
      child[2] = reader_name
      node[6].push(child)
      self.skip_newlines()
      break if @current.kind() == :right_brace
      if @current.kind() != :comma
        self.fail("expected ',' in case object pattern")
        return node
      end
      self.advance_token()
      self.skip_newlines()
    end
    return node if @failed
    if @current.kind() != :right_brace
      self.fail("expected '}' after case object pattern")
      return node
    end
    self.advance_token()
    node
  end

  # Emits the checks for node against subject: each failing check jumps
  # (recorded in failures) with match_reg false.
  def emit_case_pattern_match(node, subject, match_reg, failures)
    node[5] = subject
    kind = node[0]
    return if kind == :bind || kind == :wildcard || rest_kind?(node) || hash_rest_kind?(node)
    test = self.allocate_register()
    if kind == :value || kind == :pin || kind == :object
      self.emit_instruction3(Opcode::CASE_MATCH, test, node[3], subject)
    elsif kind == :array
      has_rest = false
      index = 0
      while index < node[6].length()
        has_rest = true if rest_kind?(node[6][index])
        index = index + 1
      end
      fixed_count = node[6].length() - (if has_rest then 1 else 0 end)
      self.emit_instruction3(Opcode::CASE_ARRAY_SHAPE, test, subject,
        fixed_count + (if has_rest then 32768 else 0 end))
    else
      self.emit_instruction2(Opcode::CASE_HASH_SHAPE, test, subject)
    end
    self.set_type_fact(test, Type::BOOL)
    self.emit_instruction2(Opcode::MOVE, match_reg, test)
    failures.push(self.emit_jump(Opcode::JUMP_IF_FALSE, match_reg))
    return if kind != :array && kind != :hash && kind != :object
    children = node[6]
    rest_index = nil
    if kind == :array
      index = 0
      while index < children.length()
        rest_index = index if rest_kind?(children[index])
        index = index + 1
      end
    end
    index = 0
    while index < children.length()
      child = children[index]
      if hash_rest_kind?(child)
        if child[0] == :hash_rest_bind
          keys = []
          key = 0
          while key < index
            keys.push(children[key][4])
            key = key + 1
          end
          key_base = self.move_contiguous(keys)
          excluded = self.allocate_register()
          self.emit_instruction3(Opcode::ARRAY, excluded, key_base, index)
          self.set_type_fact(excluded, Type::ARRAY)
          rest = self.allocate_register()
          self.emit_instruction3(Opcode::HASH_REST, rest, subject, excluded)
          self.set_type_fact(rest, Type::HASH)
          child[5] = rest
        end
      elsif rest_kind?(child)
        if child[0] == :rest_bind
          rest = self.allocate_register()
          suffix = children.length() - index - 1
          self.emit_instruction3(Opcode::ARRAY_MIDDLE, rest, subject, index * 256 + suffix)
          self.set_type_fact(rest, Type::ARRAY)
          child[5] = rest
        end
      elsif kind == :object
        element = self.emit_destructure_invoke(subject, child[2], nil)
        self.emit_case_pattern_match(child, element, match_reg, failures)
      elsif kind == :array && rest_index != nil && index > rest_index
        element = self.allocate_register()
        self.emit_instruction3(Opcode::ARRAY_SUFFIX, element, subject, children.length() - index)
        self.emit_case_pattern_match(child, element, match_reg, failures)
      else
        index_reg = child[4]
        if kind == :array
          index_reg = self.allocate_register()
          self.emit_instruction2(Opcode::CONSTANT, index_reg, self.add_constant(index))
        else
          present = self.allocate_register()
          self.emit_instruction3(Opcode::CASE_HASH_HAS, present, subject, index_reg)
          self.set_type_fact(present, Type::BOOL)
          self.emit_instruction2(Opcode::MOVE, match_reg, present)
          failures.push(self.emit_jump(Opcode::JUMP_IF_FALSE, match_reg))
        end
        element = self.allocate_register()
        self.emit_instruction3(Opcode::INDEX_GET, element, subject, index_reg)
        self.emit_case_pattern_match(child, element, match_reg, failures)
      end
      index = index + 1
    end
  end

  # The comma-joined patterns of one `when`: emits each matcher into
  # match_reg and returns the bindings ([name token, register] each, filled
  # from whichever alternative matched), or nil after a compile error.
  def compile_case_pattern_alternatives(subject, match_reg, covered)
    bindings = []
    success_jumps = []
    first_pattern = true
    loop do
      if success_jumps.length() == 16
        self.fail("too many case pattern alternatives")
        return nil
      end
      root = self.parse_case_pattern_node(0, [0])
      return nil if @failed
      # An object pattern whose readers only bind or ignore matches every
      # instance of its class, as a bare `when Class` does.
      if root[0] == :object
        unconstrained = true
        index = 0
        while index < root[6].length()
          kind = root[6][index][0]
          unconstrained = false if kind != :bind && kind != :wildcard
          index = index + 1
        end
        covered.push(Type::CLASS_BASE + root[7]) if unconstrained
      end
      found = collect_case_bindings(root, [])
      left = 0
      while left < found.length()
        right = left + 1
        while right < found.length()
          if self.token_text(found[left][1]) == self.token_text(found[right][1])
            token = found[right][1]
            self.fail_at(token.start(), token.line(), token.column(),
              "duplicate binding in case collection pattern")
            return nil
          end
          right = right + 1
        end
        left = left + 1
      end
      aligned = []
      if first_pattern
        index = 0
        while index < found.length()
          bindings.push([found[index][1], self.allocate_register()])
          aligned.push(found[index])
          index = index + 1
        end
      else
        if found.length() != bindings.length()
          self.fail_at(@previous.start(), @previous.line(), @previous.column(),
            "case pattern alternatives must bind the same names")
          return nil
        end
        index = 0
        while index < bindings.length()
          name = self.token_text(bindings[index][0])
          match = nil
          candidate = 0
          while candidate < found.length() && match == nil
            match = found[candidate] if self.token_text(found[candidate][1]) == name
            candidate = candidate + 1
          end
          if match == nil
            self.fail_at(@previous.start(), @previous.line(), @previous.column(),
              "case pattern alternatives must bind the same names")
            return nil
          end
          aligned.push(match)
          index = index + 1
        end
      end
      self.emit_instruction2(Opcode::BOOL, match_reg, 1)
      self.set_type_fact(match_reg, Type::BOOL)
      failures = []
      self.emit_case_pattern_match(root, subject, match_reg, failures)
      index = 0
      while index < bindings.length()
        self.emit_instruction2(Opcode::MOVE, bindings[index][1], aligned[index][5])
        index = index + 1
      end
      success_jumps.push(self.emit_jump(Opcode::JUMP, 0))
      index = 0
      while index < failures.length()
        self.patch_jump(failures[index], @code_count)
        index = index + 1
      end
      first_pattern = false
      break if @current.kind() != :comma
      self.advance_token()
      self.skip_newlines()
    end
    index = 0
    while index < success_jumps.length()
      self.patch_jump(success_jumps[index], @code_count)
      index = index + 1
    end
    bindings
  end

  def parse_if(inverted)
    condition = self.parse_expression()
    return 0 unless self.consume_block_start_or(:then)
    branch_condition = condition
    if inverted
      branch_condition = self.allocate_register()
      self.emit_instruction2(Opcode::NOT, branch_condition, condition)
    end
    false_jump = self.emit_jump(Opcode::JUMP_IF_FALSE, branch_condition)
    destination = self.allocate_register()
    original_facts = self.copy_type_facts()
    narrowing = @pending_nil_narrowing
    type_narrowing = @pending_type_narrowing
    @pending_nil_narrowing = nil
    @pending_type_narrowing = nil
    self.apply_condition_fact(condition, narrowing, type_narrowing, !inverted)
    then_result = self.compile_sequence()
    then_fact = self.type_fact(then_result)
    then_declaration = self.declared_type(then_result)
    then_branch_facts = self.copy_type_facts()
    self.emit_instruction2(Opcode::MOVE, destination, then_result)
    end_jump = self.emit_jump(Opcode::JUMP, 0)
    self.patch_jump(false_jump, @code_count)

    end_consumed = false
    if @current.kind() == :else
      @type_facts = original_facts
      self.apply_condition_fact(condition, narrowing, type_narrowing, inverted)
      self.advance_token()
      self.skip_newlines() if @current.kind() == :newline
      else_result = self.compile_sequence()
      else_fact = self.type_fact(else_result)
      else_declaration = self.declared_type(else_result)
      else_branch_facts = self.copy_type_facts()
      self.emit_instruction2(Opcode::MOVE, destination, else_result)
    elsif @current.kind() == :elsif
      @type_facts = original_facts
      self.advance_token()
      else_result = self.parse_if(false)
      else_fact = self.type_fact(else_result)
      else_declaration = self.declared_type(else_result)
      else_branch_facts = self.copy_type_facts()
      self.emit_instruction2(Opcode::MOVE, destination, else_result)
      end_consumed = true
    else
      @type_facts = original_facts
      self.emit_instruction1(Opcode::NIL, destination)
      else_fact = Type::NIL
      else_declaration = nil
      else_branch_facts = original_facts
    end

    if !end_consumed && @current.kind() != :end
      self.fail("expected 'end' after if expression")
      return destination
    end
    self.advance_token() unless end_consumed
    self.patch_jump(end_jump, @code_count)
    self.merge_local_type_facts(original_facts, then_branch_facts,
                                else_branch_facts)
    if then_fact != nil && then_fact == else_fact
      self.set_type_fact(destination, then_fact)
    end
    if then_declaration != nil && then_declaration == else_declaration
      @declared_types.push([destination, then_declaration])
    end
    destination
  end

  def patch_breaks(frame)
    breaks = frame[1]
    index = 0
    while index < breaks.length()
      self.patch_jump(breaks[index], @code_count)
      index = index + 1
    end
  end

  def parse_while(inverted)
    destination = self.allocate_register()
    self.emit_instruction1(Opcode::NIL, destination)
    loop_start = @code_count
    outer_loop_captures_pending = self.enter_capturing_loop()
    condition = self.parse_expression()
    unless self.consume_block_start_or(:do)
      @loop_captures_pending = outer_loop_captures_pending
      return 0
    end
    branch_condition = condition
    if inverted
      branch_condition = self.allocate_register()
      self.emit_instruction2(Opcode::NOT, branch_condition, condition)
    end
    exit_jump = self.emit_jump(Opcode::JUMP_IF_FALSE, branch_condition)
    frame = [destination, [], loop_start, @code_count, @begin_depth]
    entry_facts = self.copy_type_facts()
    @loops.push(frame)
    self.compile_sequence()
    @loops.pop()
    @loop_captures_pending = outer_loop_captures_pending
    self.emit_byte(Opcode::JUMP)
    self.emit_byte(loop_start / 256)
    self.emit_byte(mod(loop_start, 256))
    self.patch_jump(exit_jump, @code_count)
    self.patch_breaks(frame)
    if @current.kind() != :end
      self.fail("expected 'end' after while expression")
      return 0
    end
    self.advance_token()
    @type_facts = entry_facts
    destination
  end

  def parse_loop()
    destination = self.allocate_register()
    self.emit_instruction1(Opcode::NIL, destination)
    return destination unless self.consume_block_start_or(:do)
    outer_loop_captures_pending = self.enter_capturing_loop()
    body_start = @code_count
    frame = [destination, [], body_start, body_start, @begin_depth]
    @loops.push(frame)
    self.compile_sequence()
    @loops.pop()
    @loop_captures_pending = outer_loop_captures_pending
    self.emit_byte(Opcode::JUMP)
    self.emit_byte(body_start / 256)
    self.emit_byte(mod(body_start, 256))
    self.patch_breaks(frame)
    if @current.kind() != :end
      self.fail("expected 'end' after loop")
      return destination
    end
    self.advance_token()
    destination
  end

  # --- expressions (Pratt/precedence-climbing, mirroring
  # parse_precedence/parse_prefix/token_precedence/binary_opcode) ---

  # After `..` or `...`: does the next token close or separate rather than
  # start an end expression (`a[1..]`, `(1..)`, `when 5..`)? Mirrors
  # compiler_expressions.c's range_end_absent.
  def range_end_absent?()
    kind = @current.kind()
    kind == :right_bracket || kind == :right_paren || kind == :right_brace ||
      kind == :comma || kind == :newline || kind == :eof || kind == :then ||
      kind == :end || kind == :do
  end

  # Mirrors src/compiler.c's parse_ternary -- see that function's own
  # comment for the full design rationale. No register-snapshot handling
  # needed here for the same reason it wasn't needed natively: a
  # ternary's branches are expressions, not statement sequences, so
  # neither branch can reassign a local out from under the other.
  def parse_ternary()
    condition = self.parse_precedence(Precedence::RANGE)
    return condition unless @current.kind() == :question
    narrowing = @pending_nil_narrowing
    type_narrowing = @pending_type_narrowing
    @pending_nil_narrowing = nil
    @pending_type_narrowing = nil
    self.advance_token()
    self.skip_newlines()
    false_jump = self.emit_jump(Opcode::JUMP_IF_FALSE, condition)
    destination = self.allocate_register()
    self.apply_condition_fact(condition, narrowing, type_narrowing, true)
    true_result = self.parse_expression()
    true_fact = self.type_fact(true_result)
    self.emit_instruction2(Opcode::MOVE, destination, true_result)
    end_jump = self.emit_jump(Opcode::JUMP, 0)
    self.patch_jump(false_jump, @code_count)
    self.apply_condition_fact(condition, narrowing, type_narrowing, false)
    self.skip_newlines()
    if @current.kind() != :colon
      self.fail("expected ':' in ternary expression")
      return destination
    end
    self.advance_token()
    self.skip_newlines()
    false_result = self.parse_expression()
    false_fact = self.type_fact(false_result)
    self.emit_instruction2(Opcode::MOVE, destination, false_result)
    self.patch_jump(end_jump, @code_count)
    self.set_type_fact(destination, true_fact) if true_fact != nil && true_fact == false_fact
    destination
  end

  def parse_expression() = self.parse_ternary()

  # `**` lexes as two adjacent `*` tokens, since `{**rest}` needs them apart.
  def power_operator_ahead?()
    return false if @current.kind() != :star
    following = @lexer.clone().next_token()
    following.kind() == :star && following.start() == @current.start() + 1
  end

  def current_operator_precedence()
    return Precedence::POWER if self.power_operator_ahead?()
    token_precedence(@current.kind())
  end

  def parse_precedence(precedence)
    left = self.parse_prefix()
    # `expr(...)` right after a whole expression calls the Callable it made
    # (`make()(1)`, `table[0]()`), as compiler.c's parse_precedence does.
    while !@failed && (@current.kind() == :dot || @current.kind() == :left_bracket || @current.kind() == :left_paren)
      left = if @current.kind() == :dot
        self.compile_invoke(left)
      elsif @current.kind() == :left_paren
        self.compile_callable_call(left)
      else
        self.parse_index(left)
      end
    end
    while !@failed && self.current_operator_precedence() >= precedence
      # `base ** exponent`: a call of the `**` method. The right side parses
      # at the same precedence, making it right-associative.
      if self.power_operator_ahead?()
        self.advance_token()
        self.advance_token()
        self.skip_newlines()
        exponent = self.parse_precedence(Precedence::POWER)
        base = self.move_contiguous([exponent])
        destination = self.allocate_register()
        self.emit_call_opcode(Opcode::INVOKE)
        self.emit_register(destination)
        self.emit_register(left)
        self.emit_register(self.add_string("**"))
        self.emit_register(base)
        self.emit_byte(1)
        left = destination
        next
      end
      operator = @current.kind()
      operator_precedence = token_precedence(operator)
      self.advance_token()
      # A newline right after a binary operator can only mean "the right
      # operand continues on the next line" -- mirrors src/compiler.c's
      # own parse_precedence fix for the exact same "expected expression"
      # symptom (`x = 1 +\n 2`, `if a &&\n b`). This mirror never got the
      # matching fix when that one landed -- latent until now, since
      # nothing in this parser's own source or the parser_cases corpus
      # happened to use trailing-operator continuation before.
      self.skip_newlines()
      if operator == :is
        if @current.kind() != :identifier
          self.fail("expected type after 'is'")
        else
          type_token = @current
          type_name = self.consume_qualified_module_name()
          type_id = self.find_type_name(type_name)
          if type_id != nil && type_id >= Type::VARIABLE_BASE && type_id < Type::INTERFACE_BASE
            self.fail("generic type variables cannot be used with 'is' before binding")
          end
          destination = self.allocate_register()
          if type_id == nil
            # A type declared later: its id is patched in once it is known.
            type_id = Type::UNDECLARED
            @forward_is_types.push([@current_function_index, @code_count + 5, type_name, type_token, @current_module_name])
          end
          self.emit_instruction3(Opcode::IS_TYPE, destination, left, type_id)
          if self.declared_type(left) != nil
            @pending_type_narrowing = [destination, left, type_id]
          end
          left = destination
        end
      elsif operator == :dot_dot || operator == :dot_dot_dot
        exclusive = operator == :dot_dot_dot
        # `1..` with nothing after it is an endless range: the end is nil.
        right = if self.range_end_absent?()
          nil_end = self.allocate_register()
          self.emit_instruction1(Opcode::NIL, nil_end)
          nil_end
        else
          self.parse_precedence(operator_precedence + 1)
        end
        class_entry = self.find_class("Range")
        if class_entry == nil
          self.fail("'Range' is not defined -- is the prelude loaded?")
        else
          exclusive_register = self.allocate_register()
          self.emit_instruction2(Opcode::BOOL, exclusive_register, if exclusive
            1
          else
            0
          end)
          argument_base = self.allocate_register()
          self.allocate_register()
          self.allocate_register()
          self.emit_instruction2(Opcode::MOVE, argument_base, left)
          self.emit_instruction2(Opcode::MOVE, argument_base + 1, right)
          self.emit_instruction2(Opcode::MOVE, argument_base + 2, exclusive_register)
          destination = self.allocate_register()
          self.emit_call_opcode(Opcode::NEW)
          self.emit_register(destination)
          self.emit_register(class_entry[1])
          self.emit_register(argument_base)
          self.emit_byte(3)
          self.set_type_fact(destination, Type::CLASS_BASE + class_entry[1])
          left = destination
        end
      elsif operator == :and_and || operator == :and || operator == :or_or || operator == :or
        is_and = operator == :and_and || operator == :and
        destination = self.allocate_register()
        self.emit_instruction2(Opcode::MOVE, destination, left)
        end_jump = self.emit_jump(if is_and
          Opcode::JUMP_IF_FALSE
        else
          Opcode::JUMP_IF_TRUE
        end, left)
        right = self.parse_precedence(operator_precedence + 1)
        self.emit_instruction2(Opcode::MOVE, destination, right)
        self.patch_jump(end_jump, @code_count)
        self.apply_result_join(destination, left, right)
        left = destination
      elsif operator != :is
        right = self.parse_precedence(operator_precedence + 1)
        destination = self.allocate_register()
        self.emit_instruction3(binary_opcode(operator), destination, left, right)
        if operator == :equal_equal || operator == :bang_equal
          self.set_type_fact(destination, Type::BOOL)
          nil_when_true = operator == :equal_equal
          if self.type_fact(left) == Type::NIL && self.declared_type(right) != nil
            @pending_nil_narrowing = [destination, right, nil_when_true]
          elsif self.type_fact(right) == Type::NIL && self.declared_type(left) != nil
            @pending_nil_narrowing = [destination, left, nil_when_true]
          end
        elsif operator == :less || operator == :less_equal || operator == :greater || operator == :greater_equal
          self.set_type_fact(destination, Type::BOOL)
        else
          result_fact = self.binary_result_fact(operator, left, right)
          self.set_type_fact(destination, result_fact) if result_fact != nil
        end
        left = destination
      end
    end
    left
  end

  def parse_prefix()
    self.advance_token()
    kind = @previous.kind()
    return self.parse_integer() if kind == :integer
    return self.parse_float() if kind == :float
    return self.parse_string() if kind == :string
    return self.parse_regex_literal() if kind == :regex
    return self.parse_symbol() if kind == :symbol
    return self.parse_literal() if kind == :true || kind == :false || kind == :nil
    return self.parse_name() if kind == :identifier
    return self.parse_grouping() if kind == :left_paren
    return self.parse_array() if kind == :left_bracket
    return self.parse_hash() if kind == :left_brace
    if kind == :self
      if @current_class_index == nil && @current_module_index == nil
        self.fail("'self' used outside a method")
        return 0
      end
      if @in_singleton_method && @current.kind() == :dot
        self.advance_token()
        if @current.kind() != :identifier
          self.fail("expected method name after '.'")
          return 0
        end
        name = self.token_text(@current)
        self.advance_token()
        return self.compile_self_class_call(name)
      end
      return 0
    end
    if kind == :instance_variable || kind == :class_variable
      value = if kind == :instance_variable
        self.compile_ivar_read(@previous)
      else
        self.compile_cvar_read(@previous)
      end
      # `@callback(x)` calls the Callable the variable holds.
      return self.compile_callable_call(value) if @current.kind() == :left_paren
      return value
    end
    if kind == :minus
      operand = self.parse_precedence(Precedence::PREFIX)
      destination = self.allocate_register()
      self.emit_instruction2(Opcode::NEGATE, destination, operand)
      operand_fact = self.type_fact(operand)
      if operand_fact == Type::INT || operand_fact == Type::FLOAT
        self.set_type_fact(destination, operand_fact)
      end
      return destination
    end
    if kind == :bang || kind == :not
      operand = self.parse_precedence(Precedence::PREFIX)
      destination = self.allocate_register()
      self.emit_instruction2(Opcode::NOT, destination, operand)
      self.set_type_fact(destination, Type::BOOL)
      return destination
    end
    return self.parse_precedence(Precedence::PREFIX) if kind == :ampersand
    return self.parse_case() if kind == :case
    return self.parse_if(false) if kind == :if
    return self.parse_if(true) if kind == :unless
    return self.parse_while(false) if kind == :while
    return self.parse_while(true) if kind == :until
    return self.parse_loop() if kind == :loop
    return self.compile_begin() if kind == :begin
    return self.parse_super() if kind == :super
    return self.compile_yield() if kind == :yield
    self.fail("expected expression")
    0
  end

  # Inside a method with a `&block` parameter, `yield(args)` calls that
  # block (through its Cell inside a nested block); elsewhere it is
  # Fiber.yield. Mirrors compiler_control.c's compile_yield.
  # `block_given?()`, the current token being the '(': whether the
  # enclosing method's `&block` is non-nil; false in one without a `&block`.
  # Mirrors compiler_calls.c's parse_block_given_call.
  def compile_block_given()
    self.advance_token()
    self.skip_newlines()
    if @current.kind() != :right_paren
      self.fail("block_given? does not accept arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    block_entry = if @current_block_name == nil then nil else self.find_local(@current_block_name) end
    if block_entry == nil
      self.emit_instruction2(Opcode::BOOL, destination, 0)
    else
      block = self.read_local(block_entry)
      absent = self.allocate_register()
      self.emit_instruction1(Opcode::NIL, absent)
      missing = self.allocate_register()
      self.emit_instruction3(Opcode::EQUAL, missing, block, absent)
      self.emit_instruction2(Opcode::NOT, destination, missing)
    end
    self.set_type_fact(destination, Type::BOOL)
    destination
  end

  def compile_yield()
    block_entry = if @current_block_name == nil then nil else self.find_local(@current_block_name) end
    if block_entry != nil
      block = self.read_local(block_entry)
      callable_set = self.declare_annotation(if @current_block_type == nil
        [["Callable", nil, nil, -1, nil, nil]]
      else
        @current_block_type
      end)
      self.emit_instruction2(Opcode::CHECK_TYPE, block, callable_set)
      return self.compile_closure_call(block_entry) if @current.kind() == :left_paren
      base = self.allocate_register()
      destination = self.allocate_register()
      self.emit_call_opcode(Opcode::CALL_CLOSURE)
      self.emit_register(destination)
      self.emit_register(block)
      self.emit_register(base)
      self.emit_byte(0)
      return destination
    end
    source = if @current.kind() == :left_paren
      self.advance_token()
      self.skip_newlines()
      value = if @current.kind() == :right_paren
        nil_value = self.allocate_register()
        self.emit_instruction1(Opcode::NIL, nil_value)
        nil_value
      else
        self.parse_expression()
      end
      self.skip_newlines()
      if @current.kind() != :right_paren
        self.fail("expected ')' after yield value")
        return 0
      end
      self.advance_token()
      value
    else
      self.allocate_register()
    end
    destination = self.allocate_register()
    self.emit_instruction2(Opcode::YIELD, destination, source)
    destination
  end

  def parse_super()
    if @current_class_index == nil
      self.fail("'super' used outside a method")
      return 0
    end
    if @current_class_superclass_index == nil
      self.fail("'super' used in a class without a superclass")
      return 0
    end
    if @current.kind() != :left_paren
      self.fail("expected '(' after 'super'")
      return 0
    end
    self.advance_token()
    parsed = self.parse_call_arguments()
    return 0 if parsed == nil
    destination = self.allocate_register()
    method_name_index = self.add_string(@current_method_name)
    self.emit_call_opcode(Opcode::SUPER)
    self.emit_register(destination)
    self.emit_register(@current_class_index)
    self.emit_register(method_name_index)
    self.emit_register(parsed[0])
    self.emit_byte(parsed[1])
    destination
  end

  def parse_grouping()
    result = self.parse_expression()
    if @current.kind() != :right_paren
      self.fail("expected ')' after expression")
      return result
    end
    self.advance_token()
    result
  end

  def parse_array()
    elements = []
    # `[head, *rest, tail]`: at most one splat, whose Array's elements are
    # spliced in place; spread_at is its position among elements.
    spread_at = nil
    self.skip_newlines()
    while !@failed && @current.kind() != :right_bracket
      # DIAMOND_MAX_ARGUMENTS, as in compiler_expressions.c's parse_array.
      if elements.length() == 255
        self.fail("array literal has too many elements")
      elsif @current.kind() == :star
        if spread_at != nil
          self.fail("an array literal can splat only one array")
          return 0
        end
        self.advance_token()
        spread_at = elements.length()
        elements.push(self.parse_expression())
        self.skip_newlines()
        if @current.kind() == :comma
          self.advance_token()
          self.skip_newlines()
        else
          break
        end
      else
        elements.push(self.parse_expression())
        self.skip_newlines()
        if @current.kind() == :comma
          self.advance_token()
          self.skip_newlines()
        else
          break
        end
      end
    end
    if !@failed && @current.kind() != :right_bracket
      self.fail("expected ']' after array literal")
    else
      self.advance_token() unless @failed
    end
    if spread_at != nil
      # The builder a call's `f(a, *rest, z)` uses: TypeError unless the
      # splat is an Array.
      return 0 if @failed
      return self.emit_build_spread_arguments(elements.slice(0, spread_at), elements[spread_at],
        elements.slice(spread_at + 1, elements.length() - spread_at - 1), false)
    end
    base = self.allocate_register()
    index = 1
    while index < elements.length()
      self.allocate_register()
      index = index + 1
    end
    index = 0
    while index < elements.length()
      self.emit_instruction2(Opcode::MOVE, base + index, elements[index])
      index = index + 1
    end
    destination = self.allocate_register()
    self.emit_instruction3(Opcode::ARRAY, destination, base, elements.length())
    self.set_type_fact(destination, Type::ARRAY)
    element_annotation = self.homogeneous_element_annotation(elements)
    if element_annotation != nil
      @declared_types.push([destination,
        [["Array", element_annotation, nil, -1, nil, nil]]])
    end
    destination
  end

  def parse_hash()
    keys = []
    values = []
    self.skip_newlines()
    while !@failed && @current.kind() != :right_brace
      if keys.length() == 255
        self.fail("hash literal has too many entries")
      else
        keys.push(self.parse_expression())
        if @current.kind() != :colon && @current.kind() != :fat_arrow
          self.fail("expected ':' or '=>' after hash key")
        else
          self.advance_token()
          values.push(self.parse_expression())
          self.skip_newlines()
          if @current.kind() == :comma
            self.advance_token()
            self.skip_newlines()
          else
            break
          end
        end
      end
    end
    return self.allocate_register() if @failed
    if !@failed && @current.kind() != :right_brace
      self.fail("expected '}' after hash literal")
    else
      self.advance_token() unless @failed
    end
    base = self.allocate_register()
    index = 1
    while index < keys.length() * 2
      self.allocate_register()
      index = index + 1
    end
    index = 0
    while index < keys.length()
      self.emit_instruction2(Opcode::MOVE, base + index * 2, keys[index])
      self.emit_instruction2(Opcode::MOVE, base + index * 2 + 1, values[index])
      index = index + 1
    end
    destination = self.allocate_register()
    self.emit_instruction3(Opcode::HASH, destination, base, keys.length())
    self.set_type_fact(destination, Type::HASH)
    key_annotation = self.homogeneous_element_annotation(keys)
    value_annotation = self.homogeneous_element_annotation(values)
    if key_annotation != nil && value_annotation != nil
      @declared_types.push([destination,
        [["Hash", key_annotation, value_annotation, -1, nil, nil]]])
    end
    destination
  end

  # Dispatch precedence mirrors parse_name/parse_call in compiler.c: a
  # local variable holding a closure is called first (so a local named
  # `puts` shadows the print builtin, just like the real compiler's own
  # `callable_local>=0` check runs before any of parse_name's builtin
  # checks, all of which explicitly require `find_local(name)<0`),
  # builtins are checked before user functions, and a bare identifier
  # with no following `(` is always a local read.
  def parse_name()
    name = self.token_text(@previous)
    module_entry = nil
    index = 0
    while index < @modules.length()
      module_entry = @modules[index] if @modules[index][0] == name
      index = index + 1
    end
    if module_entry != nil && @current.kind() == :dot
      self.advance_token()
      return self.compile_module_singleton_call(module_entry)
    end
    if @current.kind() == :double_colon
      return self.parse_qualified_name(name, module_entry)
    end
    class_entry = self.find_class(name)
    if class_entry == nil && @current_module_name != nil
      class_entry = self.find_class(@current_module_name + "::" + name)
    end
    return self.compile_class_dot_call(class_entry) if class_entry != nil && @current.kind() == :dot
    return self.compile_specialized_new(class_entry) if self.specialized_new_ahead?(class_entry)
    local = self.find_local(name)
    return self.parse_file_open_call() if self.is_file_open_target(name, class_entry, local)
    dot_construct = self.dot_construct_id(name, class_entry, local)
    return self.parse_dot_construct_call(dot_construct) if dot_construct >= 0
    if local == nil
      constant_index = self.find_lexical_constant(name)
      if constant_index != nil
        destination = self.allocate_register()
        self.emit_instruction2(48, destination, constant_index)
        return destination
      end
      if (name == "ARGV" || name == "ENV") && class_entry == nil && self.find_function(name) == nil
        destination = self.allocate_register()
        self.emit_instruction1(if name == "ARGV" then Opcode::ARGV else Opcode::ENV end, destination)
        self.set_type_fact(destination, if name == "ARGV" then Type::ARRAY else Type::HASH end)
        return destination
      end
      first = name.slice(0, 1)
      if first >= "A" && first <= "Z" && class_entry == nil && module_entry == nil
        return self.compile_forward_class_call(@previous) if @current.kind() == :dot
        if @current.kind() != :left_paren && (@current.kind() != :left_bracket || !self.callable_name?(name))
          return self.compile_forward_constant(name)
        end
      end
    end
    return self.parse_name_call(name, local) if @current.kind() == :left_paren
    return self.compile_call(name) if @current.kind() == :left_bracket && local == nil && self.callable_name?(name)
    if local == nil
      function_entry = self.find_function(name)
      return self.compile_function_value(function_entry) if function_entry != nil
      self.fail_at(@previous.start(), @previous.line(), @previous.column(), "undefined local variable")
      return 0
    end
    self.read_local(local)
  end

  # A top-level function named without a call (`f = add`, `list.map(double)`)
  # is a Callable value: a closure over it with nothing captured, as in
  # compiler.c.
  def compile_function_value(function_entry)
    destination = self.allocate_register()
    self.emit_byte(Opcode::CLOSURE)
    self.emit_register(destination)
    self.emit_function_index(function_entry[1])
    self.emit_byte(0)
    destination
  end

  def parse_name_call(name, local)
    return self.compile_closure_call(local) if local != nil
    return self.compile_block_given() if name == "block_given?"
    if @in_singleton_method && self.find_function(name) == nil &&
       @current_class_singleton_method_names.include?(name)
      return self.compile_self_class_call(name)
    end
    return self.parse_p_call() if name == "p" && self.find_function(name) == nil && !self.class_defines_p?()
    return self.parse_print_call(true) if name == "puts" && self.find_function(name) == nil
    return self.parse_print_call(false) if name == "print" && self.find_function(name) == nil
    return self.parse_builtin_scalar_call(name) if self.is_builtin_scalar_target(name)
    return self.parse_math_unary_call(math_unary_id(name)) if self.is_math_unary_target(name)
    return self.parse_math_binary_call(4) if self.is_math_binary_target(name)
    self.compile_call(name)
  end

  def parse_qualified_name(name, module_entry)
    qualified_token = @previous
    qualified = name
    while @current.kind() == :double_colon
      self.advance_token()
      if @current.kind() != :identifier
        self.fail("expected name after '::'")
        return 0
      end
      qualified = qualified + "::" + self.token_text(@current)
      self.advance_token()
    end
    constant_index = self.find_lexical_constant(qualified)
    if constant_index != nil
      destination = self.allocate_register()
      self.emit_instruction2(48, destination, constant_index)
      return destination
    end
    index = 0
    while index < @modules.length()
      if @modules[index][0] == qualified && @current.kind() == :dot
        self.advance_token()
        return self.compile_module_singleton_call(@modules[index])
      end
      index = index + 1
    end
    class_entry = self.find_class(qualified)
    return self.compile_class_dot_call(class_entry) if class_entry != nil && @current.kind() == :dot
    return self.compile_specialized_new(class_entry) if self.specialized_new_ahead?(class_entry)
    # Declared later, as far as this single pass can tell.
    return self.compile_forward_class_call(qualified_token, qualified) if @current.kind() == :dot
    self.emit_forward_name(qualified, true)
  end

  # Shared by compile_module_singleton_call and compile_class_singleton_call.
  # needs_receiver mirrors native's own DiamondMethod field of the same
  # name: true only for a module_function-exported method (which wraps a
  # real instance method that already reserves register 0 for self), so
  # its call still needs a leading, unused receiver slot to keep argument
  # positions aligned with the wrapped function's real parameter layout.
  # A directly-declared singleton (`def self.foo`, class or module) never
  # reserves self in the first place, so its call has no such slot.
  # needs_receiver is false, true (a module_function export: a nil
  # receiver slot) or the index of the class whose singleton is called,
  # loaded into the receiver slot.
  def emit_singleton_call(function_index, parsed, needs_receiver, type_arguments)
    offset = if needs_receiver == false
      0
    else
      1
    end
    base = self.allocate_register()
    index = 1
    while index < offset + parsed[1]
      self.allocate_register()
      index = index + 1
    end
    self.emit_instruction2(Opcode::LOAD_CLASS, base, needs_receiver) if needs_receiver != true && needs_receiver != false
    index = 0
    while index < parsed[1]
      self.emit_instruction2(Opcode::MOVE, base + index + offset, parsed[0] + index)
      index = index + 1
    end
    destination = self.allocate_register()
    if type_arguments.length() == 0
      self.emit_call_opcode(Opcode::CALL)
    else
      self.emit_call_opcode(Opcode::CALL_TYPED)
    end
    self.emit_register(destination)
    self.emit_function_index(function_index)
    self.emit_register(base)
    self.emit_byte(parsed[1] + offset)
    if type_arguments.length() > 0
      self.emit_byte(type_arguments.length())
      index = 0
      while index < type_arguments.length()
        self.emit_register(type_arguments[index])
        index = index + 1
      end
    end
    destination
  end

  # A directly-declared class singleton method (`def self.foo`) is
  # resolved at compile time against the class's own descriptor list
  # only -- unlike instance methods, which the VM looks up dynamically
  # against the receiver's runtime class (walking superclass links
  # itself at INVOKE time). `Child.answer()` for an inherited
  # `Parent.answer` singleton needs this parser-side walk instead,
  # mirroring compiler.c's own singleton lookup loop exactly.
  def find_class_singleton_descriptor(class_entry, name)
    owner = class_entry
    while owner != nil
      descriptor = find_descriptor(owner[3], name)
      return descriptor if descriptor != nil
      owner = if owner[2] == nil
        nil
      else
        class_entry_by_index(@classes, owner[2])
      end
    end
    nil
  end

  # module_entry[7] holds module_function-exported descriptors
  # ([name, function_index, arity, uses_state]); module_entry[9] holds
  # def self.foo-declared ones ([name, function_index, arity,
  # required_arity]) -- see register_compiled_method. Both are searched
  # since either syntax can produce a callable `ModuleName.foo(...)`.
  def compile_module_singleton_call(module_entry)
    if @current.kind() != :identifier
      self.fail("undefined module singleton function")
      return 0
    end
    name = self.token_text(@current)
    self.advance_token()
    if @current.kind() == :equal
      name = name + "="
      self.advance_token()
    end
    exported = find_descriptor(module_entry[7], name)
    declared = find_descriptor(module_entry[9], name)
    if exported == nil && declared == nil
      self.fail("undefined module singleton function")
      return 0
    end
    type_annotations = self.parse_explicit_type_annotations()
    return 0 if type_annotations == nil
    if @current.kind() != :left_paren
      return self.compile_reference_wrapper(nil, [exported, true], type_annotations) if exported != nil
      return self.compile_reference_wrapper(nil, [declared, false], type_annotations)
    end
    type_arguments = self.declare_annotations(type_annotations)
    self.advance_token()
    self.skip_newlines()
    if self.call_arguments_have_keyword?()
      return self.compile_singleton_keyword_call(exported[1], true, type_arguments) if exported != nil
      return self.compile_singleton_keyword_call(declared[1], false, type_arguments, nil, singleton_block_context(declared))
    end
    if self.call_arguments_have_spread?()
      return self.emit_singleton_spread_call(exported[1], true, type_arguments) if exported != nil
      return self.emit_singleton_spread_call(declared[1], false, type_arguments, singleton_block_context(declared))
    end
    parsed = self.parse_call_arguments()
    return 0 if parsed == nil
    if exported == nil
      result = self.compile_singleton_block_call(declared, false, type_arguments, parsed)
      return result if result != nil
    end
    parsed = self.append_trailing_block(parsed)
    if exported != nil
      if parsed[1] < exported[4] || self.too_many_arguments?(parsed[1], exported[2], exported[1])
        self.fail("wrong number of arguments")
        return 0
      end
      return self.emit_singleton_call(exported[1], parsed, true, type_arguments)
    end
    if parsed[1] < declared[3] || self.too_many_arguments?(parsed[1], declared[2], declared[1])
      self.fail("wrong number of arguments")
      return 0
    end
    self.emit_singleton_call(declared[1], parsed, false, type_arguments)
  end

  # A singleton call's positional arguments `parsed` with a trailing do
  # block, if any. The block takes its types from the last parameter, and
  # fewer arguments than that slot leave the defaulted ones before it out:
  # the call then goes by CALL_SINGLETON_KEYWORDS' block flag, as in
  # compiler_calls.c. Returns the call's register, or nil to make an
  # ordinary call with the block appended to `parsed`.
  def compile_singleton_block_call(descriptor, needs_receiver, type_arguments, parsed)
    return nil if @current.kind() != :do || descriptor.length() < 5
    @block_context = singleton_block_context(descriptor)
    return nil if parsed[1] >= descriptor[2] - 1
    positional = self.allocate_register()
    self.emit_instruction3(Opcode::ARRAY, positional, parsed[0], parsed[1])
    block_result = self.compile_block()
    self.compile_singleton_keyword_call(descriptor[1], needs_receiver, type_arguments,
      [positional, [], block_result])
  end

  # `Owner.method(name: value)`: arguments matched to parameters by name at
  # run time (CALL_SINGLETON_KEYWORDS), which fills the receiver slot from
  # needs_receiver -- compiler_calls.c's parse_singleton_keyword_call.
  # needs_receiver is false, true (a module_function export) or the index
  # of the class whose singleton is called.
  def compile_singleton_keyword_call(function_index, needs_receiver, type_arguments, arguments = nil, block_context = nil)
    arguments = self.parse_dynamic_keyword_arguments(block_context) if arguments == nil
    return 0 if arguments == nil
    destination = self.allocate_register()
    # CALL_SINGLETON_KEYWORDS (154) / CALL_TYPED_SINGLETON_KEYWORDS (155):
    # the Opcode module is at its constant limit.
    self.emit_call_opcode(if type_arguments.length() == 0 then 154 else 155 end)
    self.emit_register(destination)
    self.emit_function_index(function_index)
    self.emit_register(arguments[0])
    if needs_receiver == true || needs_receiver == false
      self.emit_register(65535)
    else
      self.emit_register(needs_receiver)
    end
    self.emit_byte(if needs_receiver == false then 0 else 1 end)
    keywords = arguments[1]
    self.emit_byte(keywords.length() | if arguments[2] == nil then 0 else 128 end)
    index = 0
    while index < keywords.length()
      self.emit_register(keywords[index][0])
      self.emit_register(keywords[index][1])
      index = index + 1
    end
    self.emit_register(arguments[2]) if arguments[2] != nil
    if type_arguments.length() > 0
      self.emit_byte(type_arguments.length())
      index = 0
      while index < type_arguments.length()
        self.emit_register(type_arguments[index])
        index = index + 1
      end
    end
    destination
  end

  # class_entry[3] holds def self.foo-declared descriptors ([name,
  # function_index, arity, required_arity]) -- see register_compiled_method.
  # Unlike modules, a class has no module_function-style export path, so
  # there's only ever one list to search.
  def compile_class_singleton_call(class_entry)
    if @current.kind() != :identifier
      self.fail("undefined class singleton method")
      return 0
    end
    name = self.token_text(@current)
    self.advance_token()
    if @current.kind() == :equal
      name = name + "="
      self.advance_token()
    end
    descriptor = self.find_class_singleton_descriptor(class_entry, name)
    if descriptor == nil
      self.fail("undefined class singleton method")
      return 0
    end
    type_annotations = self.parse_explicit_type_annotations()
    return 0 if type_annotations == nil
    if @current.kind() != :left_paren
      return self.compile_reference_wrapper(nil, [descriptor, class_entry[1]], type_annotations)
    end
    type_arguments = self.declare_annotations(type_annotations)
    self.advance_token()
    self.skip_newlines()
    if self.call_arguments_have_keyword?()
      return self.compile_singleton_keyword_call(descriptor[1], class_entry[1], type_arguments, nil, singleton_block_context(descriptor))
    end
    if self.call_arguments_have_spread?()
      return self.emit_singleton_spread_call(descriptor[1], class_entry[1], type_arguments, singleton_block_context(descriptor))
    end
    parsed = self.parse_call_arguments()
    return 0 if parsed == nil
    result = self.compile_singleton_block_call(descriptor, class_entry[1], type_arguments, parsed)
    return result if result != nil
    parsed = self.append_trailing_block(parsed)
    if parsed[1] < descriptor[3] || self.too_many_arguments?(parsed[1], descriptor[2], descriptor[1])
      self.fail("wrong number of arguments")
      return 0
    end
    self.emit_singleton_call(descriptor[1], parsed, class_entry[1], type_arguments)
  end

  # `Klass.` at this point could mean `.new(...)`, `redefine_method(...)`,
  # or a `def self.foo` singleton call. A one-token lookahead (mirroring
  # keyword_argument_ahead?'s own cloned-lexer peek) decides which
  # without committing to any of them by consuming the dot first --
  # compile_new_call, compile_redefine_method_call, and
  # compile_class_singleton_call each expect to consume it themselves,
  # matching compile_module_singleton_call's own call site.
  # "redefine_method" is a plain identifier, not a dedicated keyword
  # token (mirroring compiler.c's own name_equals check here, not a
  # DIAMOND_TOKEN_* comparison), so it's matched by text like any other
  # singleton name would be -- checked first since it's never a real
  # declared singleton method name.
  def compile_class_dot_call(class_entry)
    lookahead = @lexer.clone()
    peeked = lookahead.next_token()
    if peeked.kind() == :identifier && self.token_text(peeked) == "redefine_method"
      self.advance_token()
      return self.compile_redefine_method_call(class_entry[1])
    end
    if peeked.kind() == :identifier
      # A writer singleton (`def self.name=(value)`) is registered under
      # "name=" -- peek one token further to see whether this call site
      # is immediately followed by '=' the same way, mirroring
      # compiler.c's own singleton_call_name_equals exactly.
      candidate_name = self.token_text(peeked)
      after = lookahead.next_token()
      writer_name = candidate_name + "="
      found = if after.kind() == :equal
        self.find_class_singleton_descriptor(class_entry, writer_name)
      else
        self.find_class_singleton_descriptor(class_entry, candidate_name)
      end
      if found != nil
        self.advance_token()
        return self.compile_class_singleton_call(class_entry)
      end
      if candidate_name != "new" && after.kind() == :left_paren
        return self.compile_forward_class_call(@previous)
      end
    end
    self.compile_new_call(class_entry[1])
  end

  def compile_redefine_method_call(class_index)
    self.advance_token()
    if @current.kind() != :left_paren
      self.fail("expected '(' after 'redefine_method'")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    name_register = self.parse_expression()
    self.skip_newlines()
    if @current.kind() != :comma
      self.fail("expected ',' after redefine_method name")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    callable_register = self.parse_expression()
    self.skip_newlines()
    if @current.kind() != :right_paren
      self.fail("expected ')' after redefine_method arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    self.emit_byte(Opcode::REDEFINE_METHOD)
    self.emit_register(destination)
    self.emit_register(class_index)
    self.emit_register(name_register)
    self.emit_register(callable_register)
    self.set_type_fact(destination, Type::NIL)
    destination
  end

  def fail_if_sealed(class_index, token)
    return false unless @sealed_classes.include?(class_index)
    self.fail_at(token.start(), token.line(), token.column(),
      "cannot instantiate a sealed class directly -- use one of its subclasses")
    true
  end

  # `Box[...]` where Box is a generic class constructed right after.
  def specialized_new_ahead?(class_entry)
    return false if class_entry == nil || @current.kind() != :left_bracket
    return false if class_type_parameters(class_entry).length() == 0
    return true if self.find_function(class_entry[0]) == nil
    # A function of the same name: `Factory[Int](42)` calls that instead.
    self.kind_after_type_arguments() == :dot
  end

  # `Box[Int].new(...)`: NEW_TYPED carries the type arguments. Two of them
  # travel as one Hash-shaped member, as in compiler.c.
  def compile_specialized_new(class_entry)
    annotations = self.parse_explicit_type_annotations()
    return 0 if annotations == nil
    if class_entry[5]
      self.fail("inherited type arguments are fixed by the superclass")
      return 0
    end
    if annotations.length() != class_entry[4].length()
      self.fail(if class_entry[4].length() == 2
        "class specialization requires exactly two declared type arguments"
      else
        "class specialization requires exactly one declared type argument"
      end)
      return 0
    end
    if @current.kind() != :dot
      self.fail("expected '.new(...)' after class type argument")
      return 0
    end
    self.advance_token()
    if @current.kind() != :identifier || self.token_text(@current) != "new"
      self.fail("expected constructor of an instantiable generic class")
      return 0
    end
    return 0 if self.fail_if_sealed(class_entry[1], @current)
    self.advance_token()
    if @current.kind() != :left_paren
      self.fail("expected '(' after 'new'")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    sets = self.declare_annotations(annotations)
    return 0 if @failed
    explicit_type = if sets.length() == 1
      sets[0]
    else
      @builder.declare_type_set(@current_function_index, [[Type::HASH, sets[0], sets[1], -1, -1, []]])
    end
    arguments = self.parse_dynamic_keyword_arguments()
    return 0 if arguments == nil
    destination = self.allocate_register()
    self.emit_call_opcode(Opcode::NEW_TYPED)
    self.emit_register(destination)
    self.emit_register(class_entry[1])
    self.emit_register(explicit_type)
    self.emit_keyword_trailer(arguments)
    self.set_type_fact(destination, Type::CLASS_BASE + class_entry[1])
    destination
  end

  def compile_new_call(class_index)
    self.advance_token()
    if @current.kind() != :identifier || self.token_text(@current) != "new"
      self.fail("expected 'new' after class name")
      return 0
    end
    return 0 if self.fail_if_sealed(class_index, @current)
    self.advance_token()
    if @current.kind() != :left_paren
      self.fail("expected '(' after 'new'")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    if self.call_arguments_have_keyword?()
      arguments = self.parse_dynamic_keyword_arguments()
      return 0 if arguments == nil
      destination = self.allocate_register()
      self.emit_call_opcode(Opcode::NEW_KEYWORDS)
      self.emit_register(destination)
      self.emit_register(class_index)
      self.emit_keyword_trailer(arguments)
      self.set_type_fact(destination, Type::CLASS_BASE + class_index)
      return destination
    end
    if self.call_arguments_have_spread?()
      arguments = self.parse_dynamic_keyword_arguments()
      return 0 if arguments == nil
      destination = self.allocate_register()
      if arguments[2] == nil
        self.emit_call_opcode(Opcode::NEW_SPREAD)
        self.emit_register(destination)
        self.emit_register(class_index)
        self.emit_register(arguments[0])
      else
        self.emit_call_opcode(Opcode::NEW_KEYWORDS)
        self.emit_register(destination)
        self.emit_register(class_index)
        self.emit_keyword_trailer(arguments)
      end
      self.set_type_fact(destination, Type::CLASS_BASE + class_index)
      return destination
    end
    parsed = self.parse_call_arguments()
    return 0 if parsed == nil
    # A block for initialize goes by NEW_KEYWORDS' block flag.
    if @current.kind() == :do
      array = self.allocate_register()
      self.emit_instruction3(Opcode::ARRAY, array, parsed[0], parsed[1])
      self.set_type_fact(array, Type::ARRAY)
      block = self.compile_block()
      destination = self.allocate_register()
      self.emit_call_opcode(Opcode::NEW_KEYWORDS)
      self.emit_register(destination)
      self.emit_register(class_index)
      self.emit_keyword_trailer([array, [], block])
      self.set_type_fact(destination, Type::CLASS_BASE + class_index)
      return destination
    end
    destination = self.allocate_register()
    self.emit_call_opcode(Opcode::NEW)
    self.emit_register(destination)
    self.emit_register(class_index)
    self.emit_register(parsed[0])
    self.emit_byte(parsed[1])
    self.set_type_fact(destination, Type::CLASS_BASE + class_index)
    destination
  end

  # A name with `[` after it: type arguments, unless it can only be a constant.
  def callable_name?(name)
    first = name[0]
    first < "A" || first > "Z" || self.find_function(name) != nil || self.kind_after_type_arguments() == :left_paren
  end

  # With `[` current: the token after its matching `]`.
  def kind_after_type_arguments()
    lookahead = @lexer.clone()
    brackets = 1
    while brackets > 0
      kind = lookahead.next_token().kind()
      return :eof if kind == :eof
      brackets = brackets + 1 if kind == :left_bracket
      brackets = brackets - 1 if kind == :right_bracket
    end
    lookahead.next_token().kind()
  end

  def is_builtin_scalar_target(name)
    return false if self.find_function(name) != nil
    return true if name == "gets"
    return true if name == "chr"
    return true if name == "to_f"
    return true if name == "to_i"
    return true if name == "to_sym"
    name == "diamond_json_stringify"
  end

  def parse_builtin_scalar_call(name)
    return self.parse_gets_call() if name == "gets"
    return self.parse_chr_call() if name == "chr"
    return self.parse_to_float_call() if name == "to_f"
    return self.parse_to_int_call() if name == "to_i"
    return self.parse_json_stringify_call() if name == "diamond_json_stringify"
    self.parse_to_sym_call()
  end

  def parse_gets_call()
    self.advance_token()
    if @current.kind() != :right_paren
      self.fail("expected ')' after arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    self.emit_instruction1(Opcode::GETS, destination)
    destination
  end

  def parse_scalar_conversion_call(opcode, type_fact)
    self.advance_token()
    self.skip_newlines()
    source = self.parse_expression()
    self.skip_newlines()
    if @current.kind() != :right_paren
      self.fail("expected ')' after arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    self.emit_instruction2(opcode, destination, source)
    self.set_type_fact(destination, type_fact)
    destination
  end

  def parse_chr_call() = self.parse_scalar_conversion_call(Opcode::CHR, Type::STRING)

  def parse_to_float_call() = self.parse_scalar_conversion_call(Opcode::TO_FLOAT, Type::FLOAT)

  def parse_to_int_call() = self.parse_scalar_conversion_call(Opcode::TO_INT, Type::INT)

  def parse_to_sym_call() = self.parse_scalar_conversion_call(Opcode::TO_SYMBOL, Type::SYMBOL)

  def parse_json_stringify_call()
    self.advance_token()
    self.skip_newlines()
    source = self.parse_expression()
    self.skip_newlines()
    options = nil
    if @current.kind() == :comma
      self.advance_token()
      self.skip_newlines()
      options = self.parse_expression()
      self.skip_newlines()
    end
    if @current.kind() != :right_paren
      self.fail("expected ')' after arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    if options == nil
      self.emit_instruction2(Opcode::JSON_STRINGIFY, destination, source)
    else
      self.emit_instruction3(Opcode::JSON_STRINGIFY_OPTIONS, destination, source, options)
    end
    self.set_type_fact(destination, Type::STRING)
    destination
  end

  def is_math_unary_target(name)
    return false if self.find_function(name) != nil
    return true if name == "sqrt"
    return true if name == "sin"
    return true if name == "cos"
    return true if name == "exp"
    return true if name == "log"
    return true if name == "tanh"
    name == "tan"
  end

  def is_math_binary_target(name)
    return false if self.find_function(name) != nil
    name == "pow"
  end

  def parse_math_unary_call(id)
    self.advance_token()
    self.skip_newlines()
    source = self.parse_expression()
    self.skip_newlines()
    if @current.kind() != :right_paren
      self.fail("expected ')' after arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    self.emit_byte(Opcode::MATH_UNARY)
    self.emit_register(destination)
    self.emit_register(source)
    self.emit_byte(id)
    self.set_type_fact(destination, Type::FLOAT)
    destination
  end

  def parse_math_binary_call(id)
    self.advance_token()
    self.skip_newlines()
    left = self.parse_expression()
    self.skip_newlines()
    if @current.kind() != :comma
      self.fail("expected ',' between arguments")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    right = self.parse_expression()
    self.skip_newlines()
    if @current.kind() != :right_paren
      self.fail("expected ')' after arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    self.emit_byte(Opcode::MATH_BINARY)
    self.emit_register(destination)
    self.emit_register(left)
    self.emit_register(right)
    self.emit_byte(id)
    self.set_type_fact(destination, Type::FLOAT)
    destination
  end

  def dot_construct_id(name, class_entry, local)
    return -1 if class_entry != nil
    return -1 if local != nil
    return -1 if self.find_function(name) != nil
    return -1 if @current.kind() != :dot
    return 0 if name == "Fiber"
    return 1 if name == "Regexp"
    return 2 if name == "TCPSocket"
    return 3 if name == "TCPServer"
    return 4 if name == "ProgramBuilder"
    -1
  end

  def parse_dot_construct_call(id)
    return self.parse_fiber_new_call() if id == 0
    return self.parse_regexp_new_call() if id == 1
    return self.parse_tcp_connect_call() if id == 2
    return self.parse_tcp_listen_call() if id == 3
    self.parse_program_builder_new_call()
  end

  def parse_program_builder_new_call()
    self.advance_token()
    if @current.kind() != :identifier || self.token_text(@current) != "new"
      self.fail("expected 'new' after 'ProgramBuilder'")
      return 0
    end
    self.advance_token()
    if @current.kind() != :left_paren
      self.fail("expected '(' after 'ProgramBuilder.new'")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    if @current.kind() != :right_paren
      self.fail("expected ')' after ProgramBuilder.new arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    self.emit_instruction1(Opcode::PROGRAM_BUILDER_NEW, destination)
    destination
  end

  def parse_fiber_new_call()
    self.advance_token()
    if @current.kind() != :identifier || self.token_text(@current) != "new"
      self.fail("expected 'new' after 'Fiber'")
      return 0
    end
    self.advance_token()
    if @current.kind() != :left_paren
      self.fail("expected '(' after 'Fiber.new'")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    callable = self.parse_expression()
    self.skip_newlines()
    if @current.kind() != :right_paren
      self.fail("expected ')' after Fiber.new argument")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    self.emit_instruction2(Opcode::FIBER_NEW, destination, callable)
    destination
  end

  def parse_regexp_new_call()
    self.advance_token()
    if @current.kind() != :identifier || self.token_text(@current) != "new"
      self.fail("expected 'new' after 'Regexp'")
      return 0
    end
    self.advance_token()
    if @current.kind() != :left_paren
      self.fail("expected '(' after 'Regexp.new'")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    pattern = self.parse_expression()
    self.skip_newlines()
    options = 0
    if @current.kind() == :comma
      self.advance_token()
      self.skip_newlines()
      options = self.parse_expression()
      self.skip_newlines()
    else
      options = self.allocate_register()
      zero = self.add_constant(0)
      self.emit_instruction2(Opcode::CONSTANT, options, zero)
    end
    if @current.kind() != :right_paren
      self.fail("expected ')' after Regexp.new arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    self.emit_instruction3(Opcode::REGEXP_NEW, destination, pattern, options)
    destination
  end

  def parse_tcp_connect_call()
    self.advance_token()
    if @current.kind() != :identifier || self.token_text(@current) != "connect"
      self.fail("expected 'connect' after 'TCPSocket'")
      return 0
    end
    self.advance_token()
    if @current.kind() != :left_paren
      self.fail("expected '(' after 'TCPSocket.connect'")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    host = self.parse_expression()
    self.skip_newlines()
    if @current.kind() != :comma
      self.fail("expected ',' after TCPSocket.connect host")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    port = self.parse_expression()
    self.skip_newlines()
    if @current.kind() != :right_paren
      self.fail("expected ')' after TCPSocket.connect arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    self.emit_instruction3(Opcode::TCP_CONNECT, destination, host, port)
    destination
  end

  def parse_tcp_listen_call()
    self.advance_token()
    if @current.kind() != :identifier || self.token_text(@current) != "listen"
      self.fail("expected 'listen' after 'TCPServer'")
      return 0
    end
    self.advance_token()
    if @current.kind() != :left_paren
      self.fail("expected '(' after 'TCPServer.listen'")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    port = self.parse_expression()
    self.skip_newlines()
    reuse_port = if @current.kind() == :comma
      self.advance_token()
      self.skip_newlines()
      if @current.kind() != :identifier || self.token_text(@current) != "reuse_port"
        self.fail("expected 'reuse_port' after ',' in TCPServer.listen arguments")
        return 0
      end
      self.advance_token()
      if @current.kind() != :colon
        self.fail("expected ':' after 'reuse_port'")
        return 0
      end
      self.advance_token()
      self.skip_newlines()
      result = self.parse_expression()
      self.skip_newlines()
      result
    else
      destination = self.allocate_register()
      self.emit_instruction2(Opcode::BOOL, destination, 0)
      destination
    end
    if @current.kind() != :right_paren
      self.fail("expected ')' after TCPServer.listen arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    self.emit_instruction3(Opcode::TCP_LISTEN, destination, port, reuse_port)
    destination
  end

  def is_file_open_target(name, class_entry, local)
    return false if class_entry != nil
    return false if local != nil
    return false if self.find_function(name) != nil
    return false if @current.kind() != :dot
    name == "File"
  end

  def parse_file_open_call()
    self.advance_token()
    if @current.kind() != :identifier || self.token_text(@current) != "open"
      self.fail("expected 'open' after 'File'")
      return 0
    end
    self.advance_token()
    if @current.kind() != :left_paren
      self.fail("expected '(' after 'File.open'")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    path_register = self.parse_expression()
    self.skip_newlines()
    if @current.kind() != :comma
      self.fail("expected ',' after File.open path")
      return 0
    end
    self.advance_token()
    self.skip_newlines()
    mode_register = self.parse_expression()
    self.skip_newlines()
    if @current.kind() != :right_paren
      self.fail("expected ')' after File.open arguments")
      return 0
    end
    self.advance_token()
    destination = self.allocate_register()
    self.emit_instruction3(Opcode::FILE_OPEN, destination, path_register, mode_register)
    destination
  end

  def parse_literal()
    destination = self.allocate_register()
    if @previous.kind() == :nil
      self.set_type_fact(destination, Type::NIL)
      # Sole-writer register; run_chunk's zero-init already covers nil,
      # matching compiler.c's parse_literal (no NIL opcode emitted here).
    else
      value = if @previous.kind() == :true
        1
      else
        0
      end
      self.emit_instruction2(Opcode::BOOL, destination, value)
      self.set_type_fact(destination, Type::BOOL)
    end
    destination
  end

  def parse_integer()
    text = self.token_text(@previous)
    digits = ""
    base = 10
    index = 0
    if text.length() > 2 && text[0] == "0"
      prefix = text[1].downcase()
      base = 16 if prefix == "x"
      base = 2 if prefix == "b"
      base = 8 if prefix == "o"
      index = 2 if base != 10
    end
    while index < text.length()
      character = text[index]
      digits = digits + character unless character == "_"
      index = index + 1
    end
    destination = self.allocate_register()
    constant = self.add_constant(digits.to_i(base))
    self.emit_instruction2(Opcode::CONSTANT, destination, constant)
    self.set_type_fact(destination, Type::INT)
    destination
  end

  def parse_float()
    text = self.token_text(@previous)
    digits = ""
    index = 0
    while index < text.length()
      character = text[index]
      digits = digits + character unless character == "_"
      index = index + 1
    end
    destination = self.allocate_register()
    constant = self.add_constant(digits.to_f())
    self.emit_instruction2(Opcode::CONSTANT, destination, constant)
    self.set_type_fact(destination, Type::FLOAT)
    destination
  end

  # A code point as UTF-8, for a \u escape.
  def utf8_escape(value)
    if value > 1114111 || (value >= 55296 && value <= 57343)
      self.fail("invalid \\u escape")
      return ""
    end
    return value.chr() if value < 128
    if value < 2048
      return (192 | (value >> 6)).chr() + (128 | (value & 63)).chr()
    end
    if value < 65536
      return (224 | (value >> 12)).chr() + (128 | ((value >> 6) & 63)).chr() + (128 | (value & 63)).chr()
    end
    (240 | (value >> 18)).chr() + (128 | ((value >> 12) & 63)).chr() +
      (128 | ((value >> 6) & 63)).chr() + (128 | (value & 63)).chr()
  end

  def decode_string_range(start, length)
    raw = @source.slice(start, length)
    result = ""
    index = 0
    while index < raw.length()
      character = raw[index]
      if character == "\\" && index + 1 < raw.length()
        index = index + 1
        escape = raw[index]
        if escape == "n"
          result = result + "\n"
        elsif escape == "r"
          result = result + "\r"
        elsif escape == "t"
          result = result + "\t"
        elsif escape == "0"
          result = result + 0.chr()
        elsif escape == "e"
          result = result + 27.chr()
        elsif escape == "x"
          value = 0
          digits = 0
          while digits < 2 && index + 1 < raw.length() && "0123456789abcdef".index_of(raw[index + 1].downcase()) != nil
            value = value * 16 + "0123456789abcdef".index_of(raw[index + 1].downcase())
            index = index + 1
            digits = digits + 1
          end
          self.fail("\\x needs a hex digit") if digits == 0
          result = result + value.chr()
        elsif escape == "u"
          digits = ""
          braced = index + 1 < raw.length() && raw[index + 1] == "{"
          index = index + 1 if braced
          while index + 1 < raw.length() && "0123456789abcdefABCDEF".index_of(raw[index + 1]) != nil &&
                (braced || digits.length() < 4)
            digits = digits + raw[index + 1]
            index = index + 1
          end
          if braced
            if index + 1 >= raw.length() || raw[index + 1] != "}" || digits.length() == 0 || digits.length() > 6
              self.fail("\\u{ needs hex digits and a closing }")
            end
            index = index + 1
          elsif digits.length() != 4
            self.fail("invalid \\u escape")
          end
          result = result + self.utf8_escape(digits.to_i(16)) unless @failed
        elsif escape == "\"" || escape == "\\" || escape == "#"
          result = result + escape
        else
          self.fail("unsupported string escape")
        end
      else
        result = result + character
      end
      index = index + 1
    end
    result
  end

  def parse_symbol()
    text = self.token_text(@previous)
    name = text.slice(1, text.length() - 1)
    destination = self.allocate_register()
    name_index = self.add_string(name)
    self.emit_instruction2(Opcode::SYMBOL, destination, name_index)
    self.set_type_fact(destination, Type::SYMBOL)
    destination
  end

  # /pattern/imx -- mirrors parse_regex_literal in src/compiler.c: the pattern is kept as written
  # (the regex engine reads its own escapes) except that \/ stands for a plain slash.
  def parse_regex_literal()
    span = @previous
    close = span.start() + span.length()
    ignore_case = false
    multiline = false
    extended = false
    while @source[close - 1] != "/"
      close = close - 1
      flag = @source[close]
      if flag == "i"
        ignore_case = true
      elsif flag == "m"
        multiline = true
      else
        extended = true
      end
    end
    options = (ignore_case ? 1 : 0) + (multiline ? 2 : 0) + (extended ? 4 : 0)
    pattern_start = span.start() + 1
    pattern_length = close - 1 - pattern_start
    raw = @source.slice(pattern_start, pattern_length)
    text = ""
    index = 0
    while index < raw.length()
      character = raw[index]
      if character == "\\" && index + 1 < raw.length()
        if raw[index + 1] == "/"
          text = text + "/"
        else
          text = text + character + raw[index + 1]
        end
        index = index + 2
        next
      end
      if character == "#" && raw[index + 1] == "{"
        self.fail("regex literals do not interpolate; build the pattern with Regexp.new")
        return 0
      end
      text = text + character
      index = index + 1
    end
    pattern_register = self.allocate_register()
    pattern = self.add_string(text)
    self.emit_instruction2(Opcode::STRING, pattern_register, pattern)
    options_register = self.allocate_register()
    options_constant = self.add_constant(options)
    self.emit_instruction2(Opcode::CONSTANT, options_register, options_constant)
    destination = self.allocate_register()
    self.emit_instruction3(Opcode::REGEXP_NEW, destination, pattern_register, options_register)
    destination
  end

  def parse_string()
    span = @previous
    finish = span.start() + span.length() - 1
    piece = span.start() + 1
    result = nil
    while piece < finish && !@failed
      index = piece
      while index + 1 < finish
        if @source[index] == "\\"
          index = index + 2
          next
        end
        break if @source[index] == "#" && @source[index + 1] == "{"
        index = index + 1
      end
      index = finish if index + 1 >= finish
      literal_register = self.allocate_register()
      literal = self.add_string(self.decode_string_range(piece, index - piece))
      self.emit_instruction2(Opcode::STRING, literal_register, literal)
      if result == nil
        result = literal_register
      else
        joined = self.allocate_register()
        self.emit_instruction3(Opcode::ADD, joined, result, literal_register)
        result = joined
      end
      break if index >= finish

      outer_lexer = @lexer
      outer_current = @current
      outer_previous = @previous
      embedded = Lexer.new(@source)
      embedded.restore_state(index + 2, index + 2, span.line(),
        span.column() + index - span.start() + 2, span.line(),
        span.column() + index - span.start() + 2)
      @lexer = embedded
      @current = @lexer.next_token()
      value = self.parse_expression()
      if @current.kind() != :right_brace
        self.fail("expected '}' after interpolation")
      end
      close = @current.start()
      @lexer = outer_lexer
      @current = outer_current
      @previous = outer_previous
      converted = self.allocate_register()
      self.emit_instruction2(Opcode::TO_STRING, converted, value)
      joined = self.allocate_register()
      self.emit_instruction3(Opcode::ADD, joined, result, converted)
      result = joined
      piece = close + 1
    end
    if result == nil
      result = self.allocate_register()
      literal = self.add_string("")
      self.emit_instruction2(Opcode::STRING, result, literal)
    end
    self.set_type_fact(result, Type::STRING)
    result
  end
end

# Convenience entry point mirroring diamond_compile's own two-step shape
# (build, then execute via diamond_program_chunk + diamond_vm_run) --
# here, ProgramBuilder#run does both at once. Returns the parser on
# failure (so the caller can read .error_message()) or runs the program
# and returns its result on success.
def parse_and_run(path)
  source = File.open(path, "r").read()
  builder = ProgramBuilder.new()
  expanded = builder.expand_source(path, source)
  parser = Parser.new(expanded, builder)
  if parser.compile()
    builder.run()
  else
    raise RuntimeError.new(parser.error_message())
  end
end

# The native prelude isn't one file: src/run_source.c concatenates
# lib/core/numeric.d6, lib/core.d6, lib/core/string_builder.d6,
# lib/core/json_codec.d6, and lib/core/json.d6, in that order, with no
# separators between them (see DIAMOND_CORE_*_SOURCE in run_source.c).
# Mirrored here so every self-hosted entry point that needs "the same
# prelude a natively-compiled program gets" (parse_and_run_with_core
# below, plus selfhost/self_parse_check.d6 and self_run_check.d6) reads
# it the same way instead of each hand-rolling its own file list.
def core_prelude_source()
  File.open("lib/core/numeric.d6", "r").read() +
    File.open("lib/core.d6", "r").read() +
    File.open("lib/core/string_builder.d6", "r").read() +
    File.open("lib/core/json_codec.d6", "r").read() +
    File.open("lib/core/json.d6", "r").read()
end

# Like parse_and_run, but splices the core prelude in front the same
# way src/run_source.c does natively (prelude source, then a
# "\n#line 1\n" reset so line numbers stay 1-based from the target's
# own first line), so a target program can call prelude-defined
# functions (mod, abs, ...) the way it always can when compiled
# natively. expand_source is still called on the target alone first,
# exactly as parse_and_run does -- its segment offsets stay relative to
# the unprefixed `expanded` string, so the prelude+reset prefix length
# is threaded into the parser via set_offset_correction rather than by
# re-deriving segments against the now-shifted combined string.
def parse_and_run_with_core(path)
  core_source = core_prelude_source()
  source = File.open(path, "r").read()
  builder = ProgramBuilder.new()
  expanded = builder.expand_source(path, source)
  reset = "\n#line 1\n"
  combined = core_source + reset + expanded
  parser = Parser.new(combined, builder)
  parser.set_offset_correction(core_source.length() + reset.length())
  if parser.compile()
    builder.run()
  else
    raise RuntimeError.new(parser.error_message())
  end
end
